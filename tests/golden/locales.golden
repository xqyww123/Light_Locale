  notes theorem
    "unitfactor_ee" =
      \<open>\<lbrakk>?u \<in> Units G;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> essentially_equal G
                                (?as[0 := ?as ! 0 \<otimes> ?u]) ?as\<close>
  notes theorem
    "factors_cong_unit" =
      \<open>\<lbrakk>?u \<in> Units G; ?a \<notin> Units G;
              factors G ?as ?a; set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> factors G (?as[0 := ?as ! 0 \<otimes> ?u])
                                (?a \<otimes> ?u)\<close>
  notes theorem
    "listassoc_wfactorsD" =
      \<open>\<lbrakk>?as [\<sim>] ?bs; wfactors G ?as ?a;
              wfactors G ?bs ?b; ?a \<in> carrier G; ?b \<in> carrier G;
              set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "ee_wfactorsD" =
      \<open>\<lbrakk>essentially_equal G ?as ?bs; wfactors G ?as ?a;
              wfactors G ?bs ?b; ?a \<in> carrier G; ?b \<in> carrier G;
              set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "ee_factorsD" =
      \<open>\<lbrakk>essentially_equal G ?as ?bs; factors G ?as ?a;
              factors G ?bs ?b; set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "wfactors_mult" =
      (\<open>\<lbrakk>wfactors G ?as ?a; wfactors G ?bs ?b;
               ?a \<in> carrier G; ?b \<in> carrier G;
               set ?as \<subseteq> carrier G;
               set ?bs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> wfactors G (?as @ ?bs)
                                 (?a \<otimes> ?b)\<close>)
      ["HOL.intro"]
  notes theorem
    "factorial_monoidI" =
      \<open>\<lbrakk>\<And>a.
                         \<lbrakk>a \<in> carrier G;
                          a \<notin> Units G\<rbrakk>
                         \<Longrightarrow> \<exists>fs.
        set fs \<subseteq> carrier G \<and> wfactors G fs a;
              \<And>a fs fs'.
                 \<lbrakk>a \<in> carrier G; set fs \<subseteq> carrier G;
                  set fs' \<subseteq> carrier G; wfactors G fs a;
                  wfactors G fs' a\<rbrakk>
                 \<Longrightarrow> essentially_equal G fs fs'\<rbrakk>
             \<Longrightarrow> factorial_monoid G\<close>
  notes theorem
    "eqc_listassoc_cong" =
      \<open>\<lbrakk>?as [\<sim>] ?bs; set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> map (assocs G) ?as =
                               map (assocs G) ?bs\<close>
  notes theorem
    "fmset_listassoc_cong" =
      \<open>\<lbrakk>?as [\<sim>] ?bs; set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> fmset G ?as = fmset G ?bs\<close>
  notes theorem
    "ee_fmset" =
      \<open>\<lbrakk>essentially_equal G ?as ?bs;
              set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> fmset G ?as = fmset G ?bs\<close>
  notes theorem
    "fmset_ee" =
      \<open>\<lbrakk>fmset G ?as = fmset G ?bs;
              set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> essentially_equal G ?as ?bs\<close>
  notes theorem
    "ee_is_fmset" =
      \<open>\<lbrakk>set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> essentially_equal G ?as ?bs =
                               (fmset G ?as = fmset G ?bs)\<close>
  notes theorem
    "fmset_wfactors_mult" =
      \<open>\<lbrakk>fmset G ?cs = fmset G ?as + fmset G ?bs;
              ?a \<in> carrier G; ?b \<in> carrier G; ?c \<in> carrier G;
              set ?as \<subseteq> carrier G; set ?bs \<subseteq> carrier G;
              set ?cs \<subseteq> carrier G; wfactors G ?as ?a;
              wfactors G ?bs ?b; wfactors G ?cs ?c\<rbrakk>
             \<Longrightarrow> ?c \<sim> ?a \<otimes> ?b\<close>
  notes theorem
    "fmsubset_divides" =
      \<open>\<lbrakk>fmset G ?as \<subseteq># fmset G ?bs;
              wfactors G ?as ?a; wfactors G ?bs ?b; ?a \<in> carrier G;
              ?b \<in> carrier G; set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?a divides ?b\<close>
  notes theorem
    "multlist_prime_pos" =
      \<open>\<lbrakk>Divisibility.prime G ?a; ?a \<in> carrier G;
              set ?as \<subseteq> carrier G;
              ?a divides foldr (\<otimes>) ?as \<one>\<rbrakk>
             \<Longrightarrow> \<exists>i<length ?as.
                                  ?a divides ?as ! i\<close>
  notes
    "comm_group_axioms" = (\<open>comm_group G\<close>)
      ["attribute" "internal"]
  notes theorem
    "inv_mult" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> inv (?x \<otimes> ?y) =
                               inv ?x \<otimes> inv ?y\<close>
  notes theorem
    "int_pow_distrib" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> (?x \<otimes> ?y) [^] ?i =
                               ?x [^] ?i \<otimes> ?y [^] ?i\<close>
  notes theorem
    "hom_group_mult" =
      \<open>\<lbrakk>?f \<in> hom ?H G; ?g \<in> hom ?H G\<rbrakk>
             \<Longrightarrow> (\<lambda>x. ?f x \<otimes> ?g x)
                               \<in> hom ?H G\<close>
  notes theorem
    "hom_imp_img_comm_group" =
      \<open>?h \<in> hom G ?H \<Longrightarrow>
             comm_group
              (?H\<lparr>carrier := ?h ` carrier G,
                    one := ?h \<one>\<rparr>)\<close>
  notes theorem
    "iso_imp_img_comm_group" =
      \<open>?h \<in> Group.iso G ?H \<Longrightarrow>
             comm_group (?H\<lparr>one := ?h \<one>\<rparr>)\<close>
  notes theorem
    "iso_imp_comm_group" =
      \<open>\<lbrakk>G \<cong> ?H; Group.monoid ?H\<rbrakk>
             \<Longrightarrow> comm_group ?H\<close>
  notes theorem
    "subgroup_imp_normal" =
      \<open>subgroup ?A G \<Longrightarrow> ?A \<lhd> G\<close>
  notes theorem
    "mult_subgroups" =
      \<open>\<lbrakk>subgroup ?H G; subgroup ?K G\<rbrakk>
             \<Longrightarrow> subgroup (?H <#> ?K) G\<close>
  notes theorem
    "normal_iff_subgroup" = \<open>?N \<lhd> G = subgroup ?N G\<close>
  notes theorem
    "set_mult_commute" =
      \<open>\<lbrakk>?N \<subseteq> carrier G; ?x \<in> rcosets ?N;
              ?y \<in> rcosets ?N\<rbrakk>
             \<Longrightarrow> ?x <#> ?y = ?y <#> ?x\<close>
  notes theorem
    "abelian_FactGroup" =
      \<open>subgroup ?N G \<Longrightarrow> comm_group (G Mod ?N)\<close>
  notes theorem
    "power_order_eq_one" =
      \<open>\<lbrakk>finite (carrier G); ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a [^] card (carrier G) = \<one>\<close>
  notes theorem
    "derived_eq_singleton" =
      \<open>?H \<subseteq> carrier G \<Longrightarrow>
             derived G ?H = {\<one>}\<close>
  notes theorem
    "abelian_ord_mul_divides" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ord (?x \<otimes> ?y) dvd
                               ord ?x * ord ?y\<close>
  notes theorem
    "hom_group_sum" =
      \<open>\<lbrakk>\<And>i.
                         i \<in> ?I \<Longrightarrow>
                         ?f i \<in> hom (?A i) G;
              \<And>i.
                 i \<in> ?I \<Longrightarrow> Group.group (?A i)\<rbrakk>
             \<Longrightarrow> (\<lambda>x.
                                   gfinprod G (\<lambda>i. ?f i (x i)) ?I)
                               \<in> hom (sum_group ?I ?A) G\<close>
  notes theorem
    "free_Abelian_group_universal" =
      (\<open>\<lbrakk>?f ` ?S \<subseteq> carrier G;
               \<And>h.
                  \<lbrakk>h \<in> hom (free_Abelian_group ?S) G;
                   \<And>x.
                      x \<in> ?S \<Longrightarrow>
                      h (frag_of x) = ?f x\<rbrakk>
                  \<Longrightarrow> ?thesis\<rbrakk>
              \<Longrightarrow> ?thesis\<close>)
      ["consumes" - 1, "case_names" "1"]
  notes theorem
    "eqpoll_homomorphisms_from_free_Abelian_group" =
      \<open>{f \<in> extensional (carrier (free_Abelian_group ?S)).
              f \<in> hom (free_Abelian_group ?S) G} \<approx>
             ?S \<rightarrow>\<^sub>E carrier G\<close>
locale abelian_monoid
  fixes G :: "('a, 'b) ring_scheme"  (structure)
  assumes "abelian_monoid G"
  notes
    "add.monoid_axioms" = (\<open>Group.monoid (add_monoid G)\<close>)
      ["attribute" "internal"]
  notes
    "add.m_closed" =
      (\<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?x \<oplus> ?y \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes
    "add.m_assoc" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y \<oplus> ?z =
                               ?x \<oplus> (?y \<oplus> ?z)\<close>
  notes
    "add.one_closed" = (\<open>\<zero> \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes
    "add.l_one" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              \<zero> \<oplus> ?x = ?x\<close>)
      ["simp"]
  notes
    "add.r_one" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              ?x \<oplus> \<zero> = ?x\<close>)
      ["simp"]
  notes theorem
    "add.Units_closed" =
      (\<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
              ?x \<in> carrier G\<close>)
      ["HOL.dest"]
  notes theorem
    "add.one_unique" =
      \<open>\<lbrakk>?u \<in> carrier G;
              \<And>x.
                 x \<in> carrier G \<Longrightarrow>
                 ?u \<oplus> x = x\<rbrakk>
             \<Longrightarrow> ?u = \<zero>\<close>
  notes theorem
    "add.inv_unique" =
      \<open>\<lbrakk>?y \<oplus> ?x = \<zero>; ?x \<oplus> ?y' = \<zero>;
              ?x \<in> carrier G; ?y \<in> carrier G;
              ?y' \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "add.Units_m_closed" =
      (\<open>\<lbrakk>?x \<in> Units (add_monoid G);
               ?y \<in> Units (add_monoid G)\<rbrakk>
              \<Longrightarrow> ?x \<oplus> ?y
                                \<in> Units (add_monoid G)\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.Units_one_closed" =
      (\<open>\<zero> \<in> Units (add_monoid G)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.Units_inv_closed" =
      (\<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
              inv\<^bsub>add_monoid G\<^esub> ?x \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.Units_l_inv_ex" =
      \<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
             \<exists>y\<in>carrier G. y \<oplus> ?x = \<zero>\<close>
  notes theorem
    "add.Units_r_inv_ex" =
      \<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
             \<exists>y\<in>carrier G. ?x \<oplus> y = \<zero>\<close>
  notes theorem
    "add.Units_l_inv" =
      (\<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
              inv\<^bsub>add_monoid G\<^esub> ?x \<oplus> ?x =
              \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.Units_r_inv" =
      (\<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
              ?x \<oplus> inv\<^bsub>add_monoid G\<^esub> ?x =
              \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.inv_one" =
      (\<open>inv\<^bsub>add_monoid G\<^esub> \<zero> = \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.Units_inv_Units" =
      (\<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
              inv\<^bsub>add_monoid G\<^esub> ?x
              \<in> Units (add_monoid G)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.Units_l_cancel" =
      (\<open>\<lbrakk>?x \<in> Units (add_monoid G); ?y \<in> carrier G;
               ?z \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?x \<oplus> ?y = ?x \<oplus> ?z) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "add.Units_inv_inv" =
      (\<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
              inv\<^bsub>add_monoid G\<^esub> (inv\<^bsub>add_monoid G\<^esub> ?x) =
              ?x\<close>)
      ["simp"]
  notes theorem
    "add.inv_inj_on_Units" =
      \<open>inj_on (m_inv (add_monoid G)) (Units (add_monoid G))\<close>
  notes theorem
    "add.Units_inv_comm" =
      \<open>\<lbrakk>?x \<oplus> ?y = \<zero>;
              ?x \<in> Units (add_monoid G);
              ?y \<in> Units (add_monoid G)\<rbrakk>
             \<Longrightarrow> ?y \<oplus> ?x = \<zero>\<close>
  notes theorem
    "add.carrier_not_empty" = \<open>carrier G \<noteq> {}\<close>
  notes theorem
    "add.group_l_invI" =
      \<open>(\<And>x.
                 x \<in> carrier G \<Longrightarrow>
                 \<exists>y\<in>carrier G.
                    y \<oplus> x = \<zero>) \<Longrightarrow>
             Group.group (add_monoid G)\<close>
  notes theorem
    "add.nat_pow_closed" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              [?n] \<cdot> ?x \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.nat_pow_0" = (\<open>[0] \<cdot> ?x = \<zero>\<close>) ["simp"]
  notes theorem
    "add.nat_pow_Suc" =
      (\<open>[Suc ?n] \<cdot> ?x = [?n] \<cdot> ?x \<oplus> ?x\<close>)
      ["simp"]
  notes theorem
    "add.nat_pow_one" = (\<open>[?n] \<cdot> \<zero> = \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.nat_pow_mult" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             [?n] \<cdot> ?x \<oplus> [?m] \<cdot> ?x =
             [(?n + ?m)] \<cdot> ?x\<close>
  notes theorem
    "add.nat_pow_comm" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             [?n] \<cdot> ?x \<oplus> [?m] \<cdot> ?x =
             [?m] \<cdot> ?x \<oplus> [?n] \<cdot> ?x\<close>
  notes theorem
    "add.nat_pow_Suc2" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             [Suc ?n] \<cdot> ?x = ?x \<oplus> [?n] \<cdot> ?x\<close>
  notes theorem
    "add.nat_pow_pow" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             [?m] \<cdot> ([?n] \<cdot> ?x) = [(?n * ?m)] \<cdot> ?x\<close>
  notes theorem
    "add.nat_pow_consistent" =
      \<open>[?n] \<cdot> ?x =
             ?x [^]\<^bsub>add_monoid G\<lparr>carrier := ?H\<rparr>\<^esub>
             ?n\<close>
  notes theorem
    "add.group_commutes_pow" =
      \<open>\<lbrakk>?x \<oplus> ?y = ?y \<oplus> ?x; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> [?n] \<cdot> ?x \<oplus> ?y =
                               ?y \<oplus> [?n] \<cdot> ?x\<close>
  notes theorem
    "add.pow_mult_distrib" =
      \<open>\<lbrakk>?x \<oplus> ?y = ?y \<oplus> ?x; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> [?n] \<cdot> (?x \<oplus> ?y) =
                               [?n] \<cdot> ?x \<oplus>
                               [?n] \<cdot> ?y\<close>
  notes theorem
    "add.monoid_incl_imp_submonoid" =
      \<open>\<lbrakk>?H \<subseteq> carrier G;
              Group.monoid
               (add_monoid G\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> submonoid ?H (add_monoid G)\<close>
  notes theorem
    "add.inv_unique'" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?x \<oplus> ?y = \<zero>; ?y \<oplus> ?x = \<zero>\<rbrakk>
             \<Longrightarrow> ?y =
                               inv\<^bsub>add_monoid G\<^esub> ?x\<close>
  notes theorem
    "add.m_inv_monoid_consistent" =
      \<open>\<lbrakk>?x \<in> Units
                                (add_monoid G\<lparr>carrier := ?H\<rparr>);
              submonoid ?H (add_monoid G)\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid G\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                               inv\<^bsub>add_monoid G\<^esub> ?x\<close>
  notes theorem
    "add.hom_imp_img_monoid" =
      \<open>?h \<in> hom (add_monoid G) ?H \<Longrightarrow>
             Group.monoid
              (?H\<lparr>carrier := ?h ` carrier G,
                    one := ?h \<zero>\<rparr>)\<close>
  notes theorem
    "add.monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier G; y \<in> carrier G\<rbrakk>
                 \<Longrightarrow> x \<oplus> y =
                                   y \<oplus> x) \<Longrightarrow>
             Group.comm_monoid (add_monoid G)\<close>
  notes theorem
    "add.units_group" = \<open>Group.group (units_of (add_monoid G))\<close>
  notes theorem
    "add.units_of_inv" =
      \<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
             inv\<^bsub>units_of (add_monoid G)\<^esub> ?x =
             inv\<^bsub>add_monoid G\<^esub> ?x\<close>
  notes theorem
    "add.set_mult_closed" =
      \<open>\<lbrakk>?H \<subseteq> carrier G;
              ?K \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid G\<^esub> ?K
                               \<subseteq> carrier G\<close>
  notes theorem
    "add.r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid G\<^esub> ?x
                               \<subseteq> carrier G\<close>
  notes theorem
    "add.order_gt_0_iff_finite" =
      \<open>(0 < Coset.order (add_monoid G)) = finite (carrier G)\<close>
  notes theorem
    "add.units_of_pow" =
      \<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
             ?x [^]\<^bsub>units_of (add_monoid G)\<^esub> ?n =
             [?n] \<cdot> ?x\<close>
  notes theorem
    "add.inv_char" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?x \<oplus> ?y = \<zero>; ?y \<oplus> ?x = \<zero>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid G\<^esub> ?x =
                               ?y\<close>
  notes theorem
    "add.inv_eq_imp_eq" =
      (\<open>\<lbrakk>inv\<^bsub>add_monoid G\<^esub> ?x =
                       inv\<^bsub>add_monoid G\<^esub> ?y;
               ?x \<in> Units (add_monoid G);
               ?y \<in> Units (add_monoid G)\<rbrakk>
              \<Longrightarrow> ?x = ?y\<close>)
      ["HOL.dest" !]
  notes theorem
    "add.inv_eq_one_eq" =
      \<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
             (inv\<^bsub>add_monoid G\<^esub> ?x = \<zero>) =
             (?x = \<zero>)\<close>
  notes theorem
    "add.monoid_cancelI" =
      \<open>\<lbrakk>\<And>a b c.
                         \<lbrakk>c \<oplus> a = c \<oplus> b;
                          a \<in> carrier G; b \<in> carrier G;
                          c \<in> carrier G\<rbrakk>
                         \<Longrightarrow> a = b;
              \<And>a b c.
                 \<lbrakk>a \<oplus> c = b \<oplus> c; a \<in> carrier G;
                  b \<in> carrier G; c \<in> carrier G\<rbrakk>
                 \<Longrightarrow> a = b\<rbrakk>
             \<Longrightarrow> monoid_cancel (add_monoid G)\<close>
  notes theorem
    "add.prod_unit_l" =
      \<open>\<lbrakk>?a \<oplus> ?b \<in> Units (add_monoid G);
              ?a \<in> Units (add_monoid G); ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?b \<in> Units (add_monoid G)\<close>
  notes theorem
    "add.prod_unit_r" =
      \<open>\<lbrakk>?a \<oplus> ?b \<in> Units (add_monoid G);
              ?b \<in> Units (add_monoid G); ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid G)\<close>
  notes theorem
    "add.divides_refl" =
      (\<open>?a \<in> carrier G \<Longrightarrow>
              ?a divides\<^bsub>add_monoid G\<^esub> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "add.divides_trans" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid G\<^esub> ?b;
               ?b divides\<^bsub>add_monoid G\<^esub> ?c;
               ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?a divides\<^bsub>add_monoid G\<^esub>
                                ?c\<close>)
      ["trans"]
  notes theorem
    "add.divides_mult_lI" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid G\<^esub> ?b;
               ?a \<in> carrier G; ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?c \<oplus>
                                 ?a) divides\<^bsub>add_monoid G\<^esub>
                                (?c \<oplus> ?b)\<close>)
      ["HOL.intro"]
  notes theorem
    "add.divides_prod_r" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid G\<^esub> ?b;
              ?a \<in> carrier G; ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>add_monoid G\<^esub>
                               (?b \<oplus> ?c)\<close>
  notes theorem
    "add.unit_divides" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid G);
              ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?u divides\<^bsub>add_monoid G\<^esub>
                               ?a\<close>
  notes theorem
    "add.associatedI2" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid G); ?a = ?b \<oplus> ?u;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid G\<^esub>
                               ?b\<close>
  notes theorem
    "add.associatedI2'" =
      \<open>\<lbrakk>?a = ?b \<oplus> ?u; ?u \<in> Units (add_monoid G);
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid G\<^esub>
                               ?b\<close>
  notes theorem
    "add.associated_refl" =
      (\<open>?a \<in> carrier G \<Longrightarrow>
              ?a \<sim>\<^bsub>add_monoid G\<^esub> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "add.associated_sym" =
      (\<open>?a \<sim>\<^bsub>add_monoid G\<^esub> ?b \<Longrightarrow>
              ?b \<sim>\<^bsub>add_monoid G\<^esub> ?a\<close>)
      ["sym"]
  notes theorem
    "add.associated_trans" =
      (\<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid G\<^esub> ?b;
               ?b \<sim>\<^bsub>add_monoid G\<^esub> ?c; ?a \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid G\<^esub>
                                ?c\<close>)
      ["trans"]
  notes theorem
    "add.division_equiv" =
      (\<open>equivalence
               \<lparr>carrier = carrier G,
                  eq = (\<sim>\<^bsub>add_monoid G\<^esub>),
                  le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.divides_cong_l" =
      (\<open>\<lbrakk>?x \<sim>\<^bsub>add_monoid G\<^esub> ?x';
               ?x' divides\<^bsub>add_monoid G\<^esub> ?y;
               ?x \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?x divides\<^bsub>add_monoid G\<^esub>
                                ?y\<close>)
      ["trans"]
  notes theorem
    "add.divides_cong_r" =
      (\<open>\<lbrakk>?x divides\<^bsub>add_monoid G\<^esub> ?y;
               ?y \<sim>\<^bsub>add_monoid G\<^esub> ?y';
               ?x \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?x divides\<^bsub>add_monoid G\<^esub>
                                ?y'\<close>)
      ["trans"]
  notes theorem
    "add.division_weak_partial_order" =
      (\<open>weak_partial_order
               \<lparr>carrier = carrier G,
                  eq = (\<sim>\<^bsub>add_monoid G\<^esub>),
                  le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "add.mult_cong_r" =
      \<open>\<lbrakk>?b \<sim>\<^bsub>add_monoid G\<^esub> ?b';
              ?a \<in> carrier G; ?b \<in> carrier G;
              ?b' \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<oplus>
                               ?b \<sim>\<^bsub>add_monoid G\<^esub>
                               ?a \<oplus> ?b'\<close>
  notes theorem
    "add.Units_assoc" =
      \<open>\<lbrakk>?a \<in> Units (add_monoid G);
              ?b \<in> Units (add_monoid G)\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid G\<^esub>
                               ?b\<close>
  notes theorem
    "add.Units_are_ones" =
      \<open>Units
              (add_monoid
                G) {.=}\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
             {\<zero>}\<close>
  notes theorem
    "add.properfactor_unitE" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid G);
              properfactor (add_monoid G) ?a ?u; ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "add.properfactor_divides" =
      \<open>properfactor (add_monoid G) ?a ?b \<Longrightarrow>
             ?a divides\<^bsub>add_monoid G\<^esub> ?b\<close>
  notes theorem
    "add.properfactor_trans1" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid G\<^esub> ?b;
               properfactor (add_monoid G) ?b ?c; ?a \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid G) ?a ?c\<close>)
      ["trans"]
  notes theorem
    "add.properfactor_trans2" =
      (\<open>\<lbrakk>properfactor (add_monoid G) ?a ?b;
               ?b divides\<^bsub>add_monoid G\<^esub> ?c;
               ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid G) ?a ?c\<close>)
      ["trans"]
  notes theorem
    "add.properfactor_cong_l" =
      (\<open>\<lbrakk>?x' \<sim>\<^bsub>add_monoid G\<^esub> ?x;
               properfactor (add_monoid G) ?x ?y; ?x \<in> carrier G;
               ?x' \<in> carrier G; ?y \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid G) ?x' ?y\<close>)
      ["trans"]
  notes theorem
    "add.properfactor_cong_r" =
      (\<open>\<lbrakk>properfactor (add_monoid G) ?x ?y;
               ?y \<sim>\<^bsub>add_monoid G\<^esub> ?y';
               ?x \<in> carrier G; ?y \<in> carrier G;
               ?y' \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid G) ?x ?y'\<close>)
      ["trans"]
  notes theorem
    "add.properfactor_prod_r" =
      \<open>\<lbrakk>properfactor (add_monoid G) ?a ?b; ?a \<in> carrier G;
              ?b \<in> carrier G; ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> properfactor (add_monoid G) ?a
                                (?b \<oplus> ?c)\<close>
  notes theorem
    "add.irreducible_prod_rI" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid G) ?a;
              ?b \<in> Units (add_monoid G); ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible (add_monoid G)
                                (?a \<oplus> ?b)\<close>
  notes theorem
    "add.listassoc_refl" =
      (\<open>set ?as \<subseteq> carrier G \<Longrightarrow>
              ?as [\<sim>]\<^bsub>add_monoid G\<^esub> ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.listassoc_sym" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid G\<^esub> ?bs;
               set ?as \<subseteq> carrier G;
               set ?bs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> ?bs [\<sim>]\<^bsub>add_monoid G\<^esub>
                                ?as\<close>)
      ["sym"]
  notes theorem
    "add.listassoc_trans" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid G\<^esub> ?bs;
               ?bs [\<sim>]\<^bsub>add_monoid G\<^esub> ?cs;
               set ?as \<subseteq> carrier G; set ?bs \<subseteq> carrier G;
               set ?cs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> ?as [\<sim>]\<^bsub>add_monoid G\<^esub>
                                ?cs\<close>)
      ["trans"]
  notes theorem
    "add.perm_assoc_switch" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid G\<^esub> ?bs;
              mset ?bs = mset ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  mset ?as = mset bs' \<and>
                                  bs' [\<sim>]\<^bsub>add_monoid G\<^esub>
                                  ?cs\<close>
  notes theorem
    "add.perm_assoc_switch_r" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              ?bs [\<sim>]\<^bsub>add_monoid G\<^esub> ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  ?as [\<sim>]\<^bsub>add_monoid G\<^esub>
                                  bs' \<and>
                                  mset bs' = mset ?cs\<close>
  notes theorem
    "add.perm_closed" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> set ?bs \<subseteq> carrier G\<close>
  notes theorem
    "add.irrlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              \<forall>a\<in>set ?as.
                 Divisibility.irreducible (add_monoid G) a\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible (add_monoid G)
                                   a\<close>
  notes theorem
    "add.essentially_equalI" =
      \<open>\<lbrakk>mset ?fs1.0 = mset ?fs1';
              ?fs1' [\<sim>]\<^bsub>add_monoid G\<^esub> ?fs2.0\<rbrakk>
             \<Longrightarrow> essentially_equal (add_monoid G) ?fs1.0
                                ?fs2.0\<close>
  notes theorem
    "add.essentially_equalE" =
      \<open>\<lbrakk>essentially_equal (add_monoid G) ?fs1.0 ?fs2.0;
              \<And>fs1'.
                 \<lbrakk>mset ?fs1.0 = mset fs1';
                  fs1' [\<sim>]\<^bsub>add_monoid G\<^esub> ?fs2.0\<rbrakk>
                 \<Longrightarrow> ?P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "add.ee_refl" =
      (\<open>set ?as \<subseteq> carrier G \<Longrightarrow>
              essentially_equal (add_monoid G) ?as ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.ee_sym" =
      (\<open>\<lbrakk>essentially_equal (add_monoid G) ?as ?bs;
               set ?as \<subseteq> carrier G;
               set ?bs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> essentially_equal (add_monoid G) ?bs
                                 ?as\<close>)
      ["sym"]
  notes theorem
    "add.ee_trans" =
      (\<open>\<lbrakk>essentially_equal (add_monoid G) ?as ?bs;
               essentially_equal (add_monoid G) ?bs ?cs;
               set ?as \<subseteq> carrier G; set ?bs \<subseteq> carrier G;
               set ?cs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> essentially_equal (add_monoid G) ?as
                                 ?cs\<close>)
      ["trans"]
  notes theorem
    "add.multlist_closed" =
      (\<open>set ?fs \<subseteq> carrier G \<Longrightarrow>
              foldr (\<oplus>) ?fs \<zero> \<in> carrier G\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.factorsI" =
      \<open>\<lbrakk>\<forall>f\<in>set ?fs.
                         Divisibility.irreducible (add_monoid G) f;
              foldr (\<oplus>) ?fs \<zero> = ?a\<rbrakk>
             \<Longrightarrow> factors (add_monoid G) ?fs ?a\<close>
  notes theorem
    "add.factors_wfactors" =
      \<open>\<lbrakk>factors (add_monoid G) ?as ?a;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid G) ?as ?a\<close>
  notes theorem
    "add.wfactors_factors" =
      \<open>\<lbrakk>wfactors (add_monoid G) ?as ?a;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> \<exists>a'.
                                  factors (add_monoid G) ?as a' \<and>
                                  a' \<sim>\<^bsub>add_monoid G\<^esub>
                                  ?a\<close>
  notes theorem
    "add.factors_closed" =
      (\<open>\<lbrakk>factors (add_monoid G) ?fs ?a;
               set ?fs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> ?a \<in> carrier G\<close>)
      ["HOL.dest"]
  notes theorem
    "add.nunit_factors" =
      \<open>\<lbrakk>?a \<notin> Units (add_monoid G);
              factors (add_monoid G) ?as ?a\<rbrakk>
             \<Longrightarrow> 0 < length ?as\<close>
  notes theorem
    "add.unit_wfactors" =
      (\<open>?a \<in> Units (add_monoid G) \<Longrightarrow>
              wfactors (add_monoid G) [] ?a\<close>)
      ["simp"]
  notes theorem
    "add.wfactors_cong_r" =
      (\<open>\<lbrakk>wfactors (add_monoid G) ?fs ?a;
               ?a \<sim>\<^bsub>add_monoid G\<^esub> ?a';
               ?a \<in> carrier G; ?a' \<in> carrier G;
               set ?fs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> wfactors (add_monoid G) ?fs ?a'\<close>)
      ["trans"]
  notes theorem
    "add.wfactors_prod_exists" =
      (\<open>\<lbrakk>\<forall>a\<in>set ?as.
                          Divisibility.irreducible (add_monoid G) a;
               set ?as \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> \<exists>a.
                                   a \<in> carrier G \<and>
                                   wfactors (add_monoid G) ?as a\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.factors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid G) ?a;
              factors (add_monoid G) ?fb ?b; ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> factors (add_monoid G) (?a # ?fb)
                                (?a \<oplus> ?b)\<close>
  notes theorem
    "add.factors_mult" =
      \<open>\<lbrakk>factors (add_monoid G) ?fa ?a;
              factors (add_monoid G) ?fb ?b; set ?fa \<subseteq> carrier G;
              set ?fb \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> factors (add_monoid G) (?fa @ ?fb)
                                (?a \<oplus> ?b)\<close>
  notes theorem
    "add.assocs_repr_independence" =
      \<open>\<lbrakk>?y \<in> closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                                {?x};
              ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                                {?x} =
                               closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                                {?y}\<close>
  notes theorem
    "add.assocs_self" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x \<in> closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                       {?x}\<close>
  notes theorem
    "add.assocs_repr_independenceD" =
      \<open>\<lbrakk>closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                       {?x} =
                      closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                       {?y};
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?y \<in> closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
   {?x}\<close>
  notes theorem
    "add.fmset_perm_cong" =
      \<open>mset ?as = mset ?bs \<Longrightarrow>
             fmset (add_monoid G) ?as = fmset (add_monoid G) ?bs\<close>
  notes theorem
    "add.mset_fmsetEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    ?P x \<and>
                    X =
                    closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                     {x}) \<Longrightarrow>
             \<exists>cs.
                (\<forall>c\<in>set cs. ?P c) \<and>
                fmset (add_monoid G) cs = ?Cs\<close>
  notes theorem
    "add.mset_wfactorsEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    (x \<in> carrier G \<and>
                     Divisibility.irreducible (add_monoid G) x) \<and>
                    X =
                    closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                     {x}) \<Longrightarrow>
             \<exists>c cs.
                c \<in> carrier G \<and>
                set cs \<subseteq> carrier G \<and>
                wfactors (add_monoid G) cs c \<and>
                fmset (add_monoid G) cs = ?Cs\<close>
  notes theorem
    "add.isgcd_divides_l" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid G\<^esub> ?b;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a gcdof\<^bsub>add_monoid G\<^esub> ?a ?b\<close>
  notes theorem
    "add.isgcd_divides_r" =
      \<open>\<lbrakk>?b divides\<^bsub>add_monoid G\<^esub> ?a;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?b gcdof\<^bsub>add_monoid G\<^esub> ?a ?b\<close>
  notes theorem
    "add.assoc_subst" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid G\<^esub> ?b;
              \<forall>a b.
                 a \<in> carrier G \<and>
                 b \<in> carrier G \<and>
                 a \<sim>\<^bsub>add_monoid G\<^esub> b \<longrightarrow>
                 ?f a \<in> carrier G \<and>
                 ?f b \<in> carrier G \<and>
                 ?f a \<sim>\<^bsub>add_monoid G\<^esub> ?f b;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?f ?a \<sim>\<^bsub>add_monoid G\<^esub>
                               ?f ?b\<close>
  notes theorem
    "add.ee_length" =
      \<open>essentially_equal (add_monoid G) ?as ?bs \<Longrightarrow>
             length ?as = length ?bs\<close>
  notes theorem
    "add.nat_pow_eone" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              [1] \<cdot> ?x = ?x\<close>)
      ["simp"]
  notes theorem
    "add.Units_pow_closed" =
      \<open>?x \<in> Units (add_monoid G) \<Longrightarrow>
             [?d] \<cdot> ?x \<in> Units (add_monoid G)\<close>
  notes
    "add.comm_monoid_axioms" =
      (\<open>Group.comm_monoid (add_monoid G)\<close>)
      ["attribute" "internal"]
  notes
    "add.m_comm" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y = ?y \<oplus> ?x\<close>
  notes theorem
    "add.m_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> (?y \<oplus> ?z) =
                               ?y \<oplus> (?x \<oplus> ?z)\<close>
  notes theorem
    "add.m_ac" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y \<oplus> ?z =
                               ?x \<oplus> (?y \<oplus> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y = ?y \<oplus> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> (?y \<oplus> ?z) =
                               ?y \<oplus> (?x \<oplus> ?z)\<close>
  notes theorem
    "add.submonoid_is_comm_monoid" =
      \<open>submonoid ?H (add_monoid G) \<Longrightarrow>
             Group.comm_monoid
              (add_monoid G\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "add.nat_pow_distrib" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> [?n] \<cdot> (?x \<oplus> ?y) =
                               [?n] \<cdot> ?x \<oplus>
                               [?n] \<cdot> ?y\<close>
  notes theorem
    "add.hom_imp_img_comm_monoid" =
      \<open>?h \<in> hom (add_monoid G) ?H \<Longrightarrow>
             Group.comm_monoid
              (?H\<lparr>carrier := ?h ` carrier G,
                    one := ?h \<zero>\<rparr>)\<close>
  notes theorem
    "add.units_comm_group" =
      \<open>comm_group (units_of (add_monoid G))\<close>
  notes theorem
    "add.finprod_empty" = (\<open>finsum G ?f {} = \<zero>\<close>) ["simp"]
  notes theorem
    "add.finprod_infinite" =
      (\<open>infinite ?A \<Longrightarrow>
              finsum G ?f ?A = \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.finprod_insert" =
      (\<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
               ?f \<in> ?F \<rightarrow> carrier G;
               ?f ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> finsum G ?f (insert ?a ?F) =
                                ?f ?a \<oplus> finsum G ?f ?F\<close>)
      ["simp"]
  notes theorem
    "add.finprod_one_eqI" =
      \<open>(\<And>x.
                 x \<in> ?A \<Longrightarrow>
                 ?f x = \<zero>) \<Longrightarrow>
             finsum G ?f ?A = \<zero>\<close>
  notes theorem
    "add.finprod_one" =
      (\<open>(\<Oplus>i\<in>?A. \<zero>) = \<zero>\<close>) ["simp"]
  notes theorem
    "add.finprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier G \<Longrightarrow>
              finsum G ?f ?A \<in> carrier G\<close>)
      ["simp"]
  notes theorem
    "add.funcset_Int_left" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> ?C;
               ?f \<in> ?B \<rightarrow> ?C\<rbrakk>
              \<Longrightarrow> ?f \<in> ?A \<inter> ?B \<rightarrow>
   ?C\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.funcset_Un_left" =
      (\<open>(?f \<in> ?A \<union> ?B \<rightarrow> ?C) =
              (?f \<in> ?A \<rightarrow> ?C \<and>
               ?f \<in> ?B \<rightarrow> ?C)\<close>)
      ["iff"]
  notes theorem
    "add.finprod_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier G;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finsum G ?g (?A \<union> ?B) \<oplus>
                               finsum G ?g (?A \<inter> ?B) =
                               finsum G ?g ?A \<oplus>
                               finsum G ?g ?B\<close>
  notes theorem
    "add.finprod_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier G;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finsum G ?g (?A \<union> ?B) =
                               finsum G ?g ?A \<oplus>
                               finsum G ?g ?B\<close>
  notes theorem
    "add.finprod_multf" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier G;
               ?g \<in> ?A \<rightarrow> carrier G\<rbrakk>
              \<Longrightarrow> (\<Oplus>x\<in>?A. ?f x \<oplus> ?g x) =
                                finsum G ?f ?A \<oplus>
                                finsum G ?g ?A\<close>)
      ["simp"]
  notes theorem
    "add.finprod_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier G;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum G ?f ?A = finsum G ?g ?B\<close>
  notes theorem
    "add.finprod_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier G) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum G ?f ?A = finsum G ?g ?B\<close>
  notes theorem
    "add.finprod_0" =
      (\<open>?f \<in> {0} \<rightarrow> carrier G \<Longrightarrow>
              finsum G ?f {..0} = ?f 0\<close>)
      ["simp"]
  notes theorem
    "add.finprod_0'" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier G \<Longrightarrow>
             ?f 0 \<oplus> finsum G ?f {Suc 0..?n} =
             finsum G ?f {..?n}\<close>
  notes theorem
    "add.finprod_Suc" =
      (\<open>?f \<in> {..Suc ?n} \<rightarrow> carrier G \<Longrightarrow>
              finsum G ?f {..Suc ?n} =
              ?f (Suc ?n) \<oplus> finsum G ?f {..?n}\<close>)
      ["simp"]
  notes theorem
    "add.finprod_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier G \<Longrightarrow>
             finsum G ?f {..Suc ?n} =
             (\<Oplus>i\<in>{..?n}. ?f (Suc i)) \<oplus> ?f 0\<close>
  notes theorem
    "add.finprod_Suc3" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier G \<Longrightarrow>
             finsum G ?f {..?n} = ?f ?n \<oplus> finsum G ?f {..<?n}\<close>
  notes theorem
    "add.finprod_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier G;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finsum G ?f (?h ` ?A) =
                               (\<Oplus>x\<in>?A. ?f (?h x))\<close>
  notes theorem
    "add.finprod_const" =
      \<open>?a \<in> carrier G \<Longrightarrow>
             (\<Oplus>x\<in>?A. ?a) = [card ?A] \<cdot> ?a\<close>
  notes theorem
    "add.finprod_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> (\<Oplus>j\<in>?A. if ?i = j then ?f j
            else \<zero>) =
                               ?f ?i\<close>
  notes theorem
    "add.finprod_singleton_swap" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> (\<Oplus>j\<in>?A. if j = ?i then ?f j
            else \<zero>) =
                               ?f ?i\<close>
  notes theorem
    "add.finprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<zero>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finsum G ?g ?A = finsum G ?h ?B\<close>
  notes theorem
    "add.finprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?g i = \<zero>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finsum G ?g ?B = finsum G ?h ?A\<close>
  notes theorem
    "add.finprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<zero>;
              \<And>i. i \<in> ?A - ?B \<Longrightarrow> ?g i = \<zero>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier G;
              ?h \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finsum G ?g ?A = finsum G ?h ?B\<close>
  notes theorem
    "add.finprod_UN_disjoint" =
      \<open>\<lbrakk>finite ?I;
              \<And>i. i \<in> ?I \<Longrightarrow> finite (?A i);
              pairwise (\<lambda>i j. disjnt (?A i) (?A j)) ?I;
              \<And>i x.
                 \<lbrakk>i \<in> ?I; x \<in> ?A i\<rbrakk>
                 \<Longrightarrow> ?g x \<in> carrier G\<rbrakk>
             \<Longrightarrow> finsum G ?g (\<Union> (?A ` ?I)) =
                               (\<Oplus>i\<in>?I. finsum G ?g
             (?A i))\<close>
  notes theorem
    "add.finprod_Union_disjoint" =
      \<open>\<lbrakk>finite ?C;
              \<And>A.
                 A \<in> ?C \<Longrightarrow>
                 finite A \<and> (\<forall>x\<in>A. ?f x \<in> carrier G);
              disjoint ?C\<rbrakk>
             \<Longrightarrow> finsum G ?f (\<Union> ?C) =
                               finsum G (finsum G ?f) ?C\<close>
  notes theorem
    "add.comm_inv_char" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?x \<oplus> ?y = \<zero>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid G\<^esub> ?x =
                               ?y\<close>
  notes theorem
    "add.unit_factor" =
      \<open>\<lbrakk>?a \<oplus> ?b \<in> Units (add_monoid G);
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid G)\<close>
  notes theorem
    "add.divides_mult_rI" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid G\<^esub> ?b;
               ?a \<in> carrier G; ?b \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?a \<oplus>
                                 ?c) divides\<^bsub>add_monoid G\<^esub>
                                (?b \<oplus> ?c)\<close>)
      ["HOL.intro"]
  notes theorem
    "add.divides_prod_l" =
      \<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G;
              ?c \<in> carrier G;
              ?a divides\<^bsub>add_monoid G\<^esub> ?b\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>add_monoid G\<^esub>
                               (?c \<oplus> ?b)\<close>
  notes theorem
    "add.divides_unit" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid G\<^esub> ?u;
              ?a \<in> carrier G; ?u \<in> Units (add_monoid G)\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid G)\<close>
  notes theorem
    "add.Unit_eq_dividesone" =
      \<open>?u \<in> carrier G \<Longrightarrow>
             (?u \<in> Units (add_monoid G)) =
             ?u divides\<^bsub>add_monoid G\<^esub> \<zero>\<close>
  notes theorem
    "add.mult_cong_l" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid G\<^esub> ?a';
              ?a \<in> carrier G; ?a' \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<oplus>
                               ?b \<sim>\<^bsub>add_monoid G\<^esub>
                               ?a' \<oplus> ?b\<close>
  notes theorem
    "add.Units_cong" =
      \<open>\<lbrakk>?a \<in> Units (add_monoid G);
              ?a \<sim>\<^bsub>add_monoid G\<^esub> ?b;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?b \<in> Units (add_monoid G)\<close>
  notes theorem
    "add.Units_Lower" =
      \<open>Units (add_monoid G) =
             Lower
              \<lparr>carrier = carrier G,
                 eq = (\<sim>\<^bsub>add_monoid G\<^esub>),
                 le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>
              (carrier G)\<close>
  notes theorem
    "add.properfactor_prod_l" =
      \<open>\<lbrakk>properfactor (add_monoid G) ?a ?b; ?a \<in> carrier G;
              ?b \<in> carrier G; ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> properfactor (add_monoid G) ?a
                                (?c \<oplus> ?b)\<close>
  notes theorem
    "add.irreducible_prod_lI" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid G) ?b;
              ?a \<in> Units (add_monoid G); ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible (add_monoid G)
                                (?a \<oplus> ?b)\<close>
  notes theorem
    "add.multlist_dividesI" =
      \<open>\<lbrakk>?f \<in> set ?fs;
              set ?fs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid G\<^esub>
                               foldr (\<oplus>) ?fs \<zero>\<close>
  notes theorem
    "add.multlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> foldr (\<oplus>) ?as \<zero> =
                               foldr (\<oplus>) ?bs \<zero>\<close>
  notes theorem
    "add.wfactors_perm_cong_l" =
      \<open>\<lbrakk>wfactors (add_monoid G) ?fs ?a; mset ?fs = mset ?fs';
              set ?fs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid G) ?fs' ?a\<close>
  notes theorem
    "add.perm_wfactorsD" =
      \<open>\<lbrakk>mset ?as = mset ?bs; wfactors (add_monoid G) ?as ?a;
              wfactors (add_monoid G) ?bs ?b; ?a \<in> carrier G;
              ?b \<in> carrier G; set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid G\<^esub>
                               ?b\<close>
  notes theorem
    "add.factors_dividesI" =
      \<open>\<lbrakk>factors (add_monoid G) ?fs ?a; ?f \<in> set ?fs;
              set ?fs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid G\<^esub>
                               ?a\<close>
  notes theorem
    "add.wfactors_dividesI" =
      \<open>\<lbrakk>wfactors (add_monoid G) ?fs ?a;
              set ?fs \<subseteq> carrier G; ?a \<in> carrier G;
              ?f \<in> set ?fs\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid G\<^esub>
                               ?a\<close>
  notes theorem
    "add.assocs_assoc" =
      \<open>\<lbrakk>?a \<in> closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                                {?b};
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid G\<^esub>
                               ?b\<close>
  notes theorem
    "add.assocs_eqD" =
      \<open>\<lbrakk>closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                       {?b} =
                      closure_of\<^bsub>\<lparr>carrier = carrier G, eq = (\<sim>\<^bsub>add_monoid G\<^esub>), le = (divides\<^bsub>add_monoid G\<^esub>)\<rparr>\<^esub>
                       {?a};
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid G\<^esub>
                               ?b\<close>
  notes theorem
    "add.gfinprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier G \<Longrightarrow>
              gfinprod (add_monoid G) ?f ?A \<in> carrier G\<close>)
      ["simp"]
  notes theorem
    "add.gfinprod_cong" =
      \<open>\<lbrakk>?A = ?B; ?f \<in> ?B \<rightarrow> carrier G;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid G) ?f ?A =
                               gfinprod (add_monoid G) ?g ?B\<close>
  notes theorem
    "add.gfinprod_eq_finprod" =
      (\<open>\<lbrakk>finite ?A;
               ?f \<in> ?A \<rightarrow> carrier G\<rbrakk>
              \<Longrightarrow> gfinprod (add_monoid G) ?f ?A =
                                finsum G ?f ?A\<close>)
      ["simp"]
  notes theorem
    "add.gfinprod_insert" =
      (\<open>\<lbrakk>finite {x \<in> ?A. ?f x \<noteq> \<zero>};
               ?f \<in> ?A \<rightarrow> carrier G;
               ?f ?i \<in> carrier G\<rbrakk>
              \<Longrightarrow> gfinprod (add_monoid G) ?f (insert ?i ?A) =
                                (if ?i \<in> ?A
                                 then gfinprod (add_monoid G) ?f ?A
                                 else ?f ?i \<oplus>
gfinprod (add_monoid G) ?f ?A)\<close>)
      ["simp"]
  notes theorem
    "add.gfinprod_distrib" =
      \<open>\<lbrakk>finite {x \<in> ?A. ?f x \<noteq> \<zero>};
              finite {x \<in> ?A. ?g x \<noteq> \<zero>};
              ?f \<in> ?A \<rightarrow> carrier G;
              ?g \<in> ?A \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid G)
                                (\<lambda>i. ?f i \<oplus> ?g i) ?A =
                               gfinprod (add_monoid G) ?f ?A \<oplus>
                               gfinprod (add_monoid G) ?g ?A\<close>
  notes theorem
    "add.gfinprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<zero>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid G) ?g ?A =
                               gfinprod (add_monoid G) ?h ?B\<close>
  notes theorem
    "add.gfinprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?g i = \<zero>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid G) ?g ?B =
                               gfinprod (add_monoid G) ?h ?A\<close>
  notes theorem
    "add.gfinprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<zero>;
              \<And>i. i \<in> ?A - ?B \<Longrightarrow> ?g i = \<zero>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier G;
              ?h \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid G) ?g ?A =
                               gfinprod (add_monoid G) ?h ?B\<close>
  notes
    "abelian_monoid_axioms" = (\<open>abelian_monoid G\<close>)
      ["attribute" "internal"]
  notes "a_comm_monoid" = \<open>Group.comm_monoid (add_monoid G)\<close>
  notes theorem "a_monoid" = \<open>Group.monoid (add_monoid G)\<close>
  notes theorem
    "a_closed" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y \<in> carrier G\<close>
  notes theorem "zero_closed" = \<open>\<zero> \<in> carrier G\<close>
  notes theorem
    "a_assoc" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y \<oplus> ?z =
                               ?x \<oplus> (?y \<oplus> ?z)\<close>
  notes theorem
    "l_zero" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             \<zero> \<oplus> ?x = ?x\<close>
  notes theorem
    "r_zero" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x \<oplus> \<zero> = ?x\<close>
  notes theorem
    "minus_unique" =
      \<open>\<lbrakk>?y \<oplus> ?x = \<zero>; ?x \<oplus> ?y' = \<zero>;
              ?x \<in> carrier G; ?y \<in> carrier G;
              ?y' \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "a_comm" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y = ?y \<oplus> ?x\<close>
  notes theorem
    "a_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> (?y \<oplus> ?z) =
                               ?y \<oplus> (?x \<oplus> ?z)\<close>
  notes theorem
    "a_ac" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y \<oplus> ?z =
                               ?x \<oplus> (?y \<oplus> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y = ?y \<oplus> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<oplus> (?y \<oplus> ?z) =
                               ?y \<oplus> (?x \<oplus> ?z)\<close>
  notes theorem "finsum_empty" = \<open>finsum G ?f {} = \<zero>\<close>
  notes theorem
    "finsum_insert" =
      \<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
              ?f \<in> ?F \<rightarrow> carrier G;
              ?f ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> finsum G ?f (insert ?a ?F) =
                               ?f ?a \<oplus> finsum G ?f ?F\<close>
  notes theorem
    "finsum_zero" = \<open>(\<Oplus>i\<in>?A. \<zero>) = \<zero>\<close>
  notes theorem
    "finsum_closed" =
      \<open>?f \<in> ?A \<rightarrow> carrier G \<Longrightarrow>
             finsum G ?f ?A \<in> carrier G\<close>
  notes theorem
    "finsum_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier G;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finsum G ?g (?A \<union> ?B) \<oplus>
                               finsum G ?g (?A \<inter> ?B) =
                               finsum G ?g ?A \<oplus>
                               finsum G ?g ?B\<close>
  notes theorem
    "finsum_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier G;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finsum G ?g (?A \<union> ?B) =
                               finsum G ?g ?A \<oplus>
                               finsum G ?g ?B\<close>
  notes theorem
    "finsum_addf" =
      \<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier G;
              ?g \<in> ?A \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> (\<Oplus>x\<in>?A. ?f x \<oplus> ?g x) =
                               finsum G ?f ?A \<oplus>
                               finsum G ?g ?A\<close>
  notes theorem
    "finsum_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier G;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum G ?f ?A = finsum G ?g ?B\<close>
  notes theorem
    "finsum_0" =
      \<open>?f \<in> {0} \<rightarrow> carrier G \<Longrightarrow>
             finsum G ?f {..0} = ?f 0\<close>
  notes theorem
    "finsum_Suc" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier G \<Longrightarrow>
             finsum G ?f {..Suc ?n} =
             ?f (Suc ?n) \<oplus> finsum G ?f {..?n}\<close>
  notes theorem
    "finsum_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier G \<Longrightarrow>
             finsum G ?f {..Suc ?n} =
             (\<Oplus>i\<in>{..?n}. ?f (Suc i)) \<oplus> ?f 0\<close>
  notes theorem
    "finsum_infinite" =
      \<open>infinite ?A \<Longrightarrow> finsum G ?f ?A = \<zero>\<close>
  notes theorem
    "finsum_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier G) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum G ?f ?A = finsum G ?g ?B\<close>
  notes theorem
    "finsum_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier G;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finsum G ?f (?h ` ?A) =
                               (\<Oplus>x\<in>?A. ?f (?h x))\<close>
  notes theorem
    "finsum_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> (\<Oplus>j\<in>?A. if ?i = j then ?f j
            else \<zero>) =
                               ?f ?i\<close>
  notes theorem
    "a_r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?H +> ?x \<subseteq> carrier G\<close>
  notes theorem
    "set_add_closed" =
      \<open>\<lbrakk>?A \<subseteq> carrier G;
              ?B \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?A <+> ?B \<subseteq> carrier G\<close>
  notes theorem
    "boundD_carrier" =
      \<open>\<lbrakk>bound \<zero> ?n ?f; ?n < ?m\<rbrakk>
             \<Longrightarrow> ?f ?m \<in> carrier G\<close>
locale Ring.ring
  fixes R :: "('a, 'b) ring_scheme"  (structure)
  assumes "ring R"
  notes
    "add.monoid_axioms" = (\<open>Group.monoid (add_monoid R)\<close>)
      ["attribute" "internal"]
  notes
    "add.m_closed" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<oplus> ?y \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes
    "add.m_assoc" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?z \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y \<oplus> ?z =
                               ?x \<oplus> (?y \<oplus> ?z)\<close>
  notes
    "add.one_closed" = (\<open>\<zero> \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes
    "add.l_one" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<zero> \<oplus> ?x = ?x\<close>)
      ["simp"]
  notes
    "add.r_one" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              ?x \<oplus> \<zero> = ?x\<close>)
      ["simp"]
  notes theorem
    "add.Units_closed" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              ?x \<in> carrier R\<close>)
      ["HOL.dest"]
  notes theorem
    "add.one_unique" =
      \<open>\<lbrakk>?u \<in> carrier R;
              \<And>x.
                 x \<in> carrier R \<Longrightarrow>
                 ?u \<oplus> x = x\<rbrakk>
             \<Longrightarrow> ?u = \<zero>\<close>
  notes theorem
    "add.inv_unique" =
      \<open>\<lbrakk>?y \<oplus> ?x = \<zero>; ?x \<oplus> ?y' = \<zero>;
              ?x \<in> carrier R; ?y \<in> carrier R;
              ?y' \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "add.Units_m_closed" =
      (\<open>\<lbrakk>?x \<in> Units (add_monoid R);
               ?y \<in> Units (add_monoid R)\<rbrakk>
              \<Longrightarrow> ?x \<oplus> ?y
                                \<in> Units (add_monoid R)\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.Units_one_closed" =
      (\<open>\<zero> \<in> Units (add_monoid R)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.Units_inv_closed" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              inv\<^bsub>add_monoid R\<^esub> ?x \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.Units_l_inv_ex" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             \<exists>y\<in>carrier R. y \<oplus> ?x = \<zero>\<close>
  notes theorem
    "add.Units_r_inv_ex" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             \<exists>y\<in>carrier R. ?x \<oplus> y = \<zero>\<close>
  notes theorem
    "add.Units_l_inv" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              inv\<^bsub>add_monoid R\<^esub> ?x \<oplus> ?x =
              \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.Units_r_inv" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              ?x \<oplus> inv\<^bsub>add_monoid R\<^esub> ?x =
              \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.inv_one" =
      (\<open>inv\<^bsub>add_monoid R\<^esub> \<zero> = \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.Units_inv_Units" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              inv\<^bsub>add_monoid R\<^esub> ?x
              \<in> Units (add_monoid R)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.Units_l_cancel" =
      (\<open>\<lbrakk>?x \<in> Units (add_monoid R); ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x \<oplus> ?y = ?x \<oplus> ?z) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "add.Units_inv_inv" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              inv\<^bsub>add_monoid R\<^esub> (inv\<^bsub>add_monoid R\<^esub> ?x) =
              ?x\<close>)
      ["simp"]
  notes theorem
    "add.inv_inj_on_Units" =
      \<open>inj_on (m_inv (add_monoid R)) (Units (add_monoid R))\<close>
  notes theorem
    "add.Units_inv_comm" =
      \<open>\<lbrakk>?x \<oplus> ?y = \<zero>;
              ?x \<in> Units (add_monoid R);
              ?y \<in> Units (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?y \<oplus> ?x = \<zero>\<close>
  notes theorem
    "add.carrier_not_empty" = \<open>carrier R \<noteq> {}\<close>
  notes theorem
    "add.group_l_invI" =
      \<open>(\<And>x.
                 x \<in> carrier R \<Longrightarrow>
                 \<exists>y\<in>carrier R.
                    y \<oplus> x = \<zero>) \<Longrightarrow>
             Group.group (add_monoid R)\<close>
  notes theorem
    "add.nat_pow_closed" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              [?n] \<cdot> ?x \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.nat_pow_0" = (\<open>[0] \<cdot> ?x = \<zero>\<close>) ["simp"]
  notes theorem
    "add.nat_pow_Suc" =
      (\<open>[Suc ?n] \<cdot> ?x = [?n] \<cdot> ?x \<oplus> ?x\<close>)
      ["simp"]
  notes theorem
    "add.nat_pow_one" = (\<open>[?n] \<cdot> \<zero> = \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.nat_pow_mult" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?n] \<cdot> ?x \<oplus> [?m] \<cdot> ?x =
             [(?n + ?m)] \<cdot> ?x\<close>
  notes theorem
    "add.nat_pow_comm" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?n] \<cdot> ?x \<oplus> [?m] \<cdot> ?x =
             [?m] \<cdot> ?x \<oplus> [?n] \<cdot> ?x\<close>
  notes theorem
    "add.nat_pow_Suc2" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [Suc ?n] \<cdot> ?x = ?x \<oplus> [?n] \<cdot> ?x\<close>
  notes theorem
    "add.nat_pow_pow" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?m] \<cdot> ([?n] \<cdot> ?x) = [(?n * ?m)] \<cdot> ?x\<close>
  notes theorem
    "add.nat_pow_consistent" =
      \<open>[?n] \<cdot> ?x =
             ?x [^]\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub>
             ?n\<close>
  notes theorem
    "add.group_commutes_pow" =
      \<open>\<lbrakk>?x \<oplus> ?y = ?y \<oplus> ?x; ?x \<in> carrier R;
              ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> [?n] \<cdot> ?x \<oplus> ?y =
                               ?y \<oplus> [?n] \<cdot> ?x\<close>
  notes theorem
    "add.pow_mult_distrib" =
      \<open>\<lbrakk>?x \<oplus> ?y = ?y \<oplus> ?x; ?x \<in> carrier R;
              ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> [?n] \<cdot> (?x \<oplus> ?y) =
                               [?n] \<cdot> ?x \<oplus>
                               [?n] \<cdot> ?y\<close>
  notes theorem
    "add.monoid_incl_imp_submonoid" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              Group.monoid
               (add_monoid R\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> submonoid ?H (add_monoid R)\<close>
  notes theorem
    "add.inv_unique'" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?x \<oplus> ?y = \<zero>; ?y \<oplus> ?x = \<zero>\<rbrakk>
             \<Longrightarrow> ?y =
                               inv\<^bsub>add_monoid R\<^esub> ?x\<close>
  notes theorem
    "add.m_inv_monoid_consistent" =
      \<open>\<lbrakk>?x \<in> Units
                                (add_monoid R\<lparr>carrier := ?H\<rparr>);
              submonoid ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                               inv\<^bsub>add_monoid R\<^esub> ?x\<close>
  notes theorem
    "add.hom_imp_img_monoid" =
      \<open>?h \<in> hom (add_monoid R) ?H \<Longrightarrow>
             Group.monoid
              (?H\<lparr>carrier := ?h ` carrier R,
                    one := ?h \<zero>\<rparr>)\<close>
  notes theorem
    "add.monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier R; y \<in> carrier R\<rbrakk>
                 \<Longrightarrow> x \<oplus> y =
                                   y \<oplus> x) \<Longrightarrow>
             Group.comm_monoid (add_monoid R)\<close>
  notes theorem
    "add.units_group" = \<open>Group.group (units_of (add_monoid R))\<close>
  notes theorem
    "add.units_of_inv" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             inv\<^bsub>units_of (add_monoid R)\<^esub> ?x =
             inv\<^bsub>add_monoid R\<^esub> ?x\<close>
  notes theorem
    "add.set_mult_closed" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              ?K \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid R\<^esub> ?K
                               \<subseteq> carrier R\<close>
  notes theorem
    "add.r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid R\<^esub> ?x
                               \<subseteq> carrier R\<close>
  notes theorem
    "add.order_gt_0_iff_finite" =
      \<open>(0 < Coset.order (add_monoid R)) = finite (carrier R)\<close>
  notes theorem
    "add.units_of_pow" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             ?x [^]\<^bsub>units_of (add_monoid R)\<^esub> ?n =
             [?n] \<cdot> ?x\<close>
  notes theorem
    "add.inv_char" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?x \<oplus> ?y = \<zero>; ?y \<oplus> ?x = \<zero>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid R\<^esub> ?x =
                               ?y\<close>
  notes theorem
    "add.inv_eq_imp_eq" =
      (\<open>\<lbrakk>inv\<^bsub>add_monoid R\<^esub> ?x =
                       inv\<^bsub>add_monoid R\<^esub> ?y;
               ?x \<in> Units (add_monoid R);
               ?y \<in> Units (add_monoid R)\<rbrakk>
              \<Longrightarrow> ?x = ?y\<close>)
      ["HOL.dest" !]
  notes theorem
    "add.inv_eq_one_eq" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             (inv\<^bsub>add_monoid R\<^esub> ?x = \<zero>) =
             (?x = \<zero>)\<close>
  notes theorem
    "add.monoid_cancelI" =
      \<open>\<lbrakk>\<And>a b c.
                         \<lbrakk>c \<oplus> a = c \<oplus> b;
                          a \<in> carrier R; b \<in> carrier R;
                          c \<in> carrier R\<rbrakk>
                         \<Longrightarrow> a = b;
              \<And>a b c.
                 \<lbrakk>a \<oplus> c = b \<oplus> c; a \<in> carrier R;
                  b \<in> carrier R; c \<in> carrier R\<rbrakk>
                 \<Longrightarrow> a = b\<rbrakk>
             \<Longrightarrow> monoid_cancel (add_monoid R)\<close>
  notes theorem
    "add.prod_unit_l" =
      \<open>\<lbrakk>?a \<oplus> ?b \<in> Units (add_monoid R);
              ?a \<in> Units (add_monoid R); ?a \<in> carrier R;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?b \<in> Units (add_monoid R)\<close>
  notes theorem
    "add.prod_unit_r" =
      \<open>\<lbrakk>?a \<oplus> ?b \<in> Units (add_monoid R);
              ?b \<in> Units (add_monoid R); ?a \<in> carrier R;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid R)\<close>
  notes theorem
    "add.divides_refl" =
      (\<open>?a \<in> carrier R \<Longrightarrow>
              ?a divides\<^bsub>add_monoid R\<^esub> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "add.divides_trans" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid R\<^esub> ?b;
               ?b divides\<^bsub>add_monoid R\<^esub> ?c;
               ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?a divides\<^bsub>add_monoid R\<^esub>
                                ?c\<close>)
      ["trans"]
  notes theorem
    "add.divides_mult_lI" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid R\<^esub> ?b;
               ?a \<in> carrier R; ?c \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?c \<oplus>
                                 ?a) divides\<^bsub>add_monoid R\<^esub>
                                (?c \<oplus> ?b)\<close>)
      ["HOL.intro"]
  notes theorem
    "add.divides_prod_r" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid R\<^esub> ?b;
              ?a \<in> carrier R; ?c \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>add_monoid R\<^esub>
                               (?b \<oplus> ?c)\<close>
  notes theorem
    "add.unit_divides" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid R);
              ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?u divides\<^bsub>add_monoid R\<^esub>
                               ?a\<close>
  notes theorem
    "add.associatedI2" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid R); ?a = ?b \<oplus> ?u;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid R\<^esub>
                               ?b\<close>
  notes theorem
    "add.associatedI2'" =
      \<open>\<lbrakk>?a = ?b \<oplus> ?u; ?u \<in> Units (add_monoid R);
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid R\<^esub>
                               ?b\<close>
  notes theorem
    "add.associated_refl" =
      (\<open>?a \<in> carrier R \<Longrightarrow>
              ?a \<sim>\<^bsub>add_monoid R\<^esub> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "add.associated_sym" =
      (\<open>?a \<sim>\<^bsub>add_monoid R\<^esub> ?b \<Longrightarrow>
              ?b \<sim>\<^bsub>add_monoid R\<^esub> ?a\<close>)
      ["sym"]
  notes theorem
    "add.associated_trans" =
      (\<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid R\<^esub> ?b;
               ?b \<sim>\<^bsub>add_monoid R\<^esub> ?c; ?a \<in> carrier R;
               ?c \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid R\<^esub>
                                ?c\<close>)
      ["trans"]
  notes theorem
    "add.division_equiv" =
      (\<open>equivalence
               \<lparr>carrier = carrier R,
                  eq = (\<sim>\<^bsub>add_monoid R\<^esub>),
                  le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.divides_cong_l" =
      (\<open>\<lbrakk>?x \<sim>\<^bsub>add_monoid R\<^esub> ?x';
               ?x' divides\<^bsub>add_monoid R\<^esub> ?y;
               ?x \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x divides\<^bsub>add_monoid R\<^esub>
                                ?y\<close>)
      ["trans"]
  notes theorem
    "add.divides_cong_r" =
      (\<open>\<lbrakk>?x divides\<^bsub>add_monoid R\<^esub> ?y;
               ?y \<sim>\<^bsub>add_monoid R\<^esub> ?y';
               ?x \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x divides\<^bsub>add_monoid R\<^esub>
                                ?y'\<close>)
      ["trans"]
  notes theorem
    "add.division_weak_partial_order" =
      (\<open>weak_partial_order
               \<lparr>carrier = carrier R,
                  eq = (\<sim>\<^bsub>add_monoid R\<^esub>),
                  le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "add.mult_cong_r" =
      \<open>\<lbrakk>?b \<sim>\<^bsub>add_monoid R\<^esub> ?b';
              ?a \<in> carrier R; ?b \<in> carrier R;
              ?b' \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<oplus>
                               ?b \<sim>\<^bsub>add_monoid R\<^esub>
                               ?a \<oplus> ?b'\<close>
  notes theorem
    "add.Units_assoc" =
      \<open>\<lbrakk>?a \<in> Units (add_monoid R);
              ?b \<in> Units (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid R\<^esub>
                               ?b\<close>
  notes theorem
    "add.Units_are_ones" =
      \<open>Units
              (add_monoid
                R) {.=}\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
             {\<zero>}\<close>
  notes theorem
    "add.properfactor_unitE" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid R);
              properfactor (add_monoid R) ?a ?u; ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "add.properfactor_divides" =
      \<open>properfactor (add_monoid R) ?a ?b \<Longrightarrow>
             ?a divides\<^bsub>add_monoid R\<^esub> ?b\<close>
  notes theorem
    "add.properfactor_trans1" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid R\<^esub> ?b;
               properfactor (add_monoid R) ?b ?c; ?a \<in> carrier R;
               ?c \<in> carrier R\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid R) ?a ?c\<close>)
      ["trans"]
  notes theorem
    "add.properfactor_trans2" =
      (\<open>\<lbrakk>properfactor (add_monoid R) ?a ?b;
               ?b divides\<^bsub>add_monoid R\<^esub> ?c;
               ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid R) ?a ?c\<close>)
      ["trans"]
  notes theorem
    "add.properfactor_cong_l" =
      (\<open>\<lbrakk>?x' \<sim>\<^bsub>add_monoid R\<^esub> ?x;
               properfactor (add_monoid R) ?x ?y; ?x \<in> carrier R;
               ?x' \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid R) ?x' ?y\<close>)
      ["trans"]
  notes theorem
    "add.properfactor_cong_r" =
      (\<open>\<lbrakk>properfactor (add_monoid R) ?x ?y;
               ?y \<sim>\<^bsub>add_monoid R\<^esub> ?y';
               ?x \<in> carrier R; ?y \<in> carrier R;
               ?y' \<in> carrier R\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid R) ?x ?y'\<close>)
      ["trans"]
  notes theorem
    "add.properfactor_prod_r" =
      \<open>\<lbrakk>properfactor (add_monoid R) ?a ?b; ?a \<in> carrier R;
              ?b \<in> carrier R; ?c \<in> carrier R\<rbrakk>
             \<Longrightarrow> properfactor (add_monoid R) ?a
                                (?b \<oplus> ?c)\<close>
  notes theorem
    "add.irreducible_prod_rI" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid R) ?a;
              ?b \<in> Units (add_monoid R); ?a \<in> carrier R;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible (add_monoid R)
                                (?a \<oplus> ?b)\<close>
  notes theorem
    "add.listassoc_refl" =
      (\<open>set ?as \<subseteq> carrier R \<Longrightarrow>
              ?as [\<sim>]\<^bsub>add_monoid R\<^esub> ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.listassoc_sym" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid R\<^esub> ?bs;
               set ?as \<subseteq> carrier R;
               set ?bs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> ?bs [\<sim>]\<^bsub>add_monoid R\<^esub>
                                ?as\<close>)
      ["sym"]
  notes theorem
    "add.listassoc_trans" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid R\<^esub> ?bs;
               ?bs [\<sim>]\<^bsub>add_monoid R\<^esub> ?cs;
               set ?as \<subseteq> carrier R; set ?bs \<subseteq> carrier R;
               set ?cs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> ?as [\<sim>]\<^bsub>add_monoid R\<^esub>
                                ?cs\<close>)
      ["trans"]
  notes theorem
    "add.perm_assoc_switch" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid R\<^esub> ?bs;
              mset ?bs = mset ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  mset ?as = mset bs' \<and>
                                  bs' [\<sim>]\<^bsub>add_monoid R\<^esub>
                                  ?cs\<close>
  notes theorem
    "add.perm_assoc_switch_r" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              ?bs [\<sim>]\<^bsub>add_monoid R\<^esub> ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  ?as [\<sim>]\<^bsub>add_monoid R\<^esub>
                                  bs' \<and>
                                  mset bs' = mset ?cs\<close>
  notes theorem
    "add.perm_closed" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> set ?bs \<subseteq> carrier R\<close>
  notes theorem
    "add.irrlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              \<forall>a\<in>set ?as.
                 Divisibility.irreducible (add_monoid R) a\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible (add_monoid R)
                                   a\<close>
  notes theorem
    "add.essentially_equalI" =
      \<open>\<lbrakk>mset ?fs1.0 = mset ?fs1';
              ?fs1' [\<sim>]\<^bsub>add_monoid R\<^esub> ?fs2.0\<rbrakk>
             \<Longrightarrow> essentially_equal (add_monoid R) ?fs1.0
                                ?fs2.0\<close>
  notes theorem
    "add.essentially_equalE" =
      \<open>\<lbrakk>essentially_equal (add_monoid R) ?fs1.0 ?fs2.0;
              \<And>fs1'.
                 \<lbrakk>mset ?fs1.0 = mset fs1';
                  fs1' [\<sim>]\<^bsub>add_monoid R\<^esub> ?fs2.0\<rbrakk>
                 \<Longrightarrow> ?P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "add.ee_refl" =
      (\<open>set ?as \<subseteq> carrier R \<Longrightarrow>
              essentially_equal (add_monoid R) ?as ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.ee_sym" =
      (\<open>\<lbrakk>essentially_equal (add_monoid R) ?as ?bs;
               set ?as \<subseteq> carrier R;
               set ?bs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> essentially_equal (add_monoid R) ?bs
                                 ?as\<close>)
      ["sym"]
  notes theorem
    "add.ee_trans" =
      (\<open>\<lbrakk>essentially_equal (add_monoid R) ?as ?bs;
               essentially_equal (add_monoid R) ?bs ?cs;
               set ?as \<subseteq> carrier R; set ?bs \<subseteq> carrier R;
               set ?cs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> essentially_equal (add_monoid R) ?as
                                 ?cs\<close>)
      ["trans"]
  notes theorem
    "add.multlist_closed" =
      (\<open>set ?fs \<subseteq> carrier R \<Longrightarrow>
              foldr (\<oplus>) ?fs \<zero> \<in> carrier R\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.factorsI" =
      \<open>\<lbrakk>\<forall>f\<in>set ?fs.
                         Divisibility.irreducible (add_monoid R) f;
              foldr (\<oplus>) ?fs \<zero> = ?a\<rbrakk>
             \<Longrightarrow> factors (add_monoid R) ?fs ?a\<close>
  notes theorem
    "add.factors_wfactors" =
      \<open>\<lbrakk>factors (add_monoid R) ?as ?a;
              set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid R) ?as ?a\<close>
  notes theorem
    "add.wfactors_factors" =
      \<open>\<lbrakk>wfactors (add_monoid R) ?as ?a;
              set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> \<exists>a'.
                                  factors (add_monoid R) ?as a' \<and>
                                  a' \<sim>\<^bsub>add_monoid R\<^esub>
                                  ?a\<close>
  notes theorem
    "add.factors_closed" =
      (\<open>\<lbrakk>factors (add_monoid R) ?fs ?a;
               set ?fs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> ?a \<in> carrier R\<close>)
      ["HOL.dest"]
  notes theorem
    "add.nunit_factors" =
      \<open>\<lbrakk>?a \<notin> Units (add_monoid R);
              factors (add_monoid R) ?as ?a\<rbrakk>
             \<Longrightarrow> 0 < length ?as\<close>
  notes theorem
    "add.unit_wfactors" =
      (\<open>?a \<in> Units (add_monoid R) \<Longrightarrow>
              wfactors (add_monoid R) [] ?a\<close>)
      ["simp"]
  notes theorem
    "add.wfactors_cong_r" =
      (\<open>\<lbrakk>wfactors (add_monoid R) ?fs ?a;
               ?a \<sim>\<^bsub>add_monoid R\<^esub> ?a';
               ?a \<in> carrier R; ?a' \<in> carrier R;
               set ?fs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> wfactors (add_monoid R) ?fs ?a'\<close>)
      ["trans"]
  notes theorem
    "add.wfactors_prod_exists" =
      (\<open>\<lbrakk>\<forall>a\<in>set ?as.
                          Divisibility.irreducible (add_monoid R) a;
               set ?as \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> \<exists>a.
                                   a \<in> carrier R \<and>
                                   wfactors (add_monoid R) ?as a\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "add.factors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid R) ?a;
              factors (add_monoid R) ?fb ?b; ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> factors (add_monoid R) (?a # ?fb)
                                (?a \<oplus> ?b)\<close>
  notes theorem
    "add.factors_mult" =
      \<open>\<lbrakk>factors (add_monoid R) ?fa ?a;
              factors (add_monoid R) ?fb ?b; set ?fa \<subseteq> carrier R;
              set ?fb \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> factors (add_monoid R) (?fa @ ?fb)
                                (?a \<oplus> ?b)\<close>
  notes theorem
    "add.assocs_repr_independence" =
      \<open>\<lbrakk>?y \<in> closure_of\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
                                {?x};
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> closure_of\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
                                {?x} =
                               closure_of\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
                                {?y}\<close>
  notes theorem
    "add.assocs_self" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             ?x \<in> closure_of\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
                       {?x}\<close>
  notes theorem
    "add.assocs_repr_independenceD" =
      \<open>\<lbrakk>closure_of\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
                       {?x} =
                      closure_of\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
                       {?y};
              ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?y \<in> closure_of\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
   {?x}\<close>
  notes theorem
    "add.fmset_perm_cong" =
      \<open>mset ?as = mset ?bs \<Longrightarrow>
             fmset (add_monoid R) ?as = fmset (add_monoid R) ?bs\<close>
  notes theorem
    "add.mset_fmsetEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    ?P x \<and>
                    X =
                    closure_of\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
                     {x}) \<Longrightarrow>
             \<exists>cs.
                (\<forall>c\<in>set cs. ?P c) \<and>
                fmset (add_monoid R) cs = ?Cs\<close>
  notes theorem
    "add.mset_wfactorsEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    (x \<in> carrier R \<and>
                     Divisibility.irreducible (add_monoid R) x) \<and>
                    X =
                    closure_of\<^bsub>\<lparr>carrier = carrier R, eq = (\<sim>\<^bsub>add_monoid R\<^esub>), le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>\<^esub>
                     {x}) \<Longrightarrow>
             \<exists>c cs.
                c \<in> carrier R \<and>
                set cs \<subseteq> carrier R \<and>
                wfactors (add_monoid R) cs c \<and>
                fmset (add_monoid R) cs = ?Cs\<close>
  notes theorem
    "add.isgcd_divides_l" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid R\<^esub> ?b;
              ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a gcdof\<^bsub>add_monoid R\<^esub> ?a ?b\<close>
  notes theorem
    "add.isgcd_divides_r" =
      \<open>\<lbrakk>?b divides\<^bsub>add_monoid R\<^esub> ?a;
              ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?b gcdof\<^bsub>add_monoid R\<^esub> ?a ?b\<close>
  notes theorem
    "add.assoc_subst" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid R\<^esub> ?b;
              \<forall>a b.
                 a \<in> carrier R \<and>
                 b \<in> carrier R \<and>
                 a \<sim>\<^bsub>add_monoid R\<^esub> b \<longrightarrow>
                 ?f a \<in> carrier R \<and>
                 ?f b \<in> carrier R \<and>
                 ?f a \<sim>\<^bsub>add_monoid R\<^esub> ?f b;
              ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?f ?a \<sim>\<^bsub>add_monoid R\<^esub>
                               ?f ?b\<close>
  notes theorem
    "add.ee_length" =
      \<open>essentially_equal (add_monoid R) ?as ?bs \<Longrightarrow>
             length ?as = length ?bs\<close>
  notes theorem
    "add.nat_pow_eone" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              [1] \<cdot> ?x = ?x\<close>)
      ["simp"]
  notes theorem
    "add.Units_pow_closed" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             [?d] \<cdot> ?x \<in> Units (add_monoid R)\<close>
  notes
    "add.comm_monoid_axioms" =
      (\<open>Group.comm_monoid (add_monoid R)\<close>)
      ["attribute" "internal"]
  notes
    "add.m_comm" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y = ?y \<oplus> ?x\<close>
  notes theorem
    "add.m_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?z \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x \<oplus> (?y \<oplus> ?z) =
                               ?y \<oplus> (?x \<oplus> ?z)\<close>
  notes theorem
    "add.m_ac" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?z \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y \<oplus> ?z =
                               ?x \<oplus> (?y \<oplus> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y = ?y \<oplus> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?z \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x \<oplus> (?y \<oplus> ?z) =
                               ?y \<oplus> (?x \<oplus> ?z)\<close>
  notes theorem
    "add.submonoid_is_comm_monoid" =
      \<open>submonoid ?H (add_monoid R) \<Longrightarrow>
             Group.comm_monoid
              (add_monoid R\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "add.nat_pow_distrib" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> [?n] \<cdot> (?x \<oplus> ?y) =
                               [?n] \<cdot> ?x \<oplus>
                               [?n] \<cdot> ?y\<close>
  notes theorem
    "add.hom_imp_img_comm_monoid" =
      \<open>?h \<in> hom (add_monoid R) ?H \<Longrightarrow>
             Group.comm_monoid
              (?H\<lparr>carrier := ?h ` carrier R,
                    one := ?h \<zero>\<rparr>)\<close>
  notes theorem
    "add.units_comm_group" =
      \<open>comm_group (units_of (add_monoid R))\<close>
  notes theorem
    "add.finprod_empty" = (\<open>finsum R ?f {} = \<zero>\<close>) ["simp"]
  notes theorem
    "add.finprod_infinite" =
      (\<open>infinite ?A \<Longrightarrow>
              finsum R ?f ?A = \<zero>\<close>)
      ["simp"]
  notes theorem
    "add.finprod_insert" =
      (\<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
               ?f \<in> ?F \<rightarrow> carrier R;
               ?f ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> finsum R ?f (insert ?a ?F) =
                                ?f ?a \<oplus> finsum R ?f ?F\<close>)
      ["simp"]
  notes theorem
    "add.finprod_one_eqI" =
      \<open>(\<And>x.
                 x \<in> ?A \<Longrightarrow>
                 ?f x = \<zero>) \<Longrightarrow>
             finsum R ?f ?A = \<zero>\<close>
  notes theorem
    "add.finprod_one" =
      (\<open>(\<Oplus>i\<in>?A. \<zero>) = \<zero>\<close>) ["simp"]
  notes theorem
    "add.finprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier R \<Longrightarrow>
              finsum R ?f ?A \<in> carrier R\<close>)
      ["simp"]
  notes theorem
    "add.funcset_Int_left" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> ?C;
               ?f \<in> ?B \<rightarrow> ?C\<rbrakk>
              \<Longrightarrow> ?f \<in> ?A \<inter> ?B \<rightarrow>
   ?C\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "add.funcset_Un_left" =
      (\<open>(?f \<in> ?A \<union> ?B \<rightarrow> ?C) =
              (?f \<in> ?A \<rightarrow> ?C \<and>
               ?f \<in> ?B \<rightarrow> ?C)\<close>)
      ["iff"]
  notes theorem
    "add.finprod_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier R;
              ?g \<in> ?B \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> finsum R ?g (?A \<union> ?B) \<oplus>
                               finsum R ?g (?A \<inter> ?B) =
                               finsum R ?g ?A \<oplus>
                               finsum R ?g ?B\<close>
  notes theorem
    "add.finprod_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier R;
              ?g \<in> ?B \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> finsum R ?g (?A \<union> ?B) =
                               finsum R ?g ?A \<oplus>
                               finsum R ?g ?B\<close>
  notes theorem
    "add.finprod_multf" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier R;
               ?g \<in> ?A \<rightarrow> carrier R\<rbrakk>
              \<Longrightarrow> (\<Oplus>x\<in>?A. ?f x \<oplus> ?g x) =
                                finsum R ?f ?A \<oplus>
                                finsum R ?g ?A\<close>)
      ["simp"]
  notes theorem
    "add.finprod_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier R;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum R ?f ?A = finsum R ?g ?B\<close>
  notes theorem
    "add.finprod_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier R) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum R ?f ?A = finsum R ?g ?B\<close>
  notes theorem
    "add.finprod_0" =
      (\<open>?f \<in> {0} \<rightarrow> carrier R \<Longrightarrow>
              finsum R ?f {..0} = ?f 0\<close>)
      ["simp"]
  notes theorem
    "add.finprod_0'" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier R \<Longrightarrow>
             ?f 0 \<oplus> finsum R ?f {Suc 0..?n} =
             finsum R ?f {..?n}\<close>
  notes theorem
    "add.finprod_Suc" =
      (\<open>?f \<in> {..Suc ?n} \<rightarrow> carrier R \<Longrightarrow>
              finsum R ?f {..Suc ?n} =
              ?f (Suc ?n) \<oplus> finsum R ?f {..?n}\<close>)
      ["simp"]
  notes theorem
    "add.finprod_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier R \<Longrightarrow>
             finsum R ?f {..Suc ?n} =
             (\<Oplus>i\<in>{..?n}. ?f (Suc i)) \<oplus> ?f 0\<close>
  notes theorem
    "add.finprod_Suc3" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier R \<Longrightarrow>
             finsum R ?f {..?n} = ?f ?n \<oplus> finsum R ?f {..<?n}\<close>
  notes theorem
    "add.finprod_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier R;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finsum R ?f (?h ` ?A) =
                               (\<Oplus>x\<in>?A. ?f (?h x))\<close>
  notes theorem
    "add.finprod_const" =
      \<open>?a \<in> carrier R \<Longrightarrow>
             (\<Oplus>x\<in>?A. ?a) = [card ?A] \<cdot> ?a\<close>
  notes theorem
    "add.finprod_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> (\<Oplus>j\<in>?A. if ?i = j then ?f j
            else \<zero>) =
                               ?f ?i\<close>
  notes theorem
    "add.finprod_singleton_swap" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> (\<Oplus>j\<in>?A. if j = ?i then ?f j
            else \<zero>) =
                               ?f ?i\<close>
  notes theorem
    "add.finprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<zero>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> finsum R ?g ?A = finsum R ?h ?B\<close>
  notes theorem
    "add.finprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?g i = \<zero>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> finsum R ?g ?B = finsum R ?h ?A\<close>
  notes theorem
    "add.finprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<zero>;
              \<And>i. i \<in> ?A - ?B \<Longrightarrow> ?g i = \<zero>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier R;
              ?h \<in> ?B \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> finsum R ?g ?A = finsum R ?h ?B\<close>
  notes theorem
    "add.finprod_UN_disjoint" =
      \<open>\<lbrakk>finite ?I;
              \<And>i. i \<in> ?I \<Longrightarrow> finite (?A i);
              pairwise (\<lambda>i j. disjnt (?A i) (?A j)) ?I;
              \<And>i x.
                 \<lbrakk>i \<in> ?I; x \<in> ?A i\<rbrakk>
                 \<Longrightarrow> ?g x \<in> carrier R\<rbrakk>
             \<Longrightarrow> finsum R ?g (\<Union> (?A ` ?I)) =
                               (\<Oplus>i\<in>?I. finsum R ?g
             (?A i))\<close>
  notes theorem
    "add.finprod_Union_disjoint" =
      \<open>\<lbrakk>finite ?C;
              \<And>A.
                 A \<in> ?C \<Longrightarrow>
                 finite A \<and> (\<forall>x\<in>A. ?f x \<in> carrier R);
              disjoint ?C\<rbrakk>
             \<Longrightarrow> finsum R ?f (\<Union> ?C) =
                               finsum R (finsum R ?f) ?C\<close>
  notes theorem
    "add.comm_inv_char" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?x \<oplus> ?y = \<zero>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid R\<^esub> ?x =
                               ?y\<close>
  notes theorem
    "add.unit_factor" =
      \<open>\<lbrakk>?a \<oplus> ?b \<in> Units (add_monoid R);
              ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid R)\<close>
  notes theorem
    "add.divides_mult_rI" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid R\<^esub> ?b;
               ?a \<in> carrier R; ?b \<in> carrier R;
               ?c \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?a \<oplus>
                                 ?c) divides\<^bsub>add_monoid R\<^esub>
                                (?b \<oplus> ?c)\<close>)
      ["HOL.intro"]
  notes theorem
    "add.divides_prod_l" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R;
              ?c \<in> carrier R;
              ?a divides\<^bsub>add_monoid R\<^esub> ?b\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>add_monoid R\<^esub>
                               (?c \<oplus> ?b)\<close>
  notes theorem
    "add.divides_unit" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid R\<^esub> ?u;
              ?a \<in> carrier R; ?u \<in> Units (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid R)\<close>
  notes theorem
    "add.Unit_eq_dividesone" =
      \<open>?u \<in> carrier R \<Longrightarrow>
             (?u \<in> Units (add_monoid R)) =
             ?u divides\<^bsub>add_monoid R\<^esub> \<zero>\<close>
  notes theorem
    "add.mult_cong_l" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid R\<^esub> ?a';
              ?a \<in> carrier R; ?a' \<in> carrier R;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<oplus>
                               ?b \<sim>\<^bsub>add_monoid R\<^esub>
                               ?a' \<oplus> ?b\<close>
  notes theorem
    "add.Units_cong" =
      \<open>\<lbrakk>?a \<in> Units (add_monoid R);
              ?a \<sim>\<^bsub>add_monoid R\<^esub> ?b;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?b \<in> Units (add_monoid R)\<close>
  notes theorem
    "add.Units_Lower" =
      \<open>Units (add_monoid R) =
             Lower
              \<lparr>carrier = carrier R,
                 eq = (\<sim>\<^bsub>add_monoid R\<^esub>),
                 le = (divides\<^bsub>add_monoid R\<^esub>)\<rparr>
              (carrier R)\<close>
  notes theorem
    "add.properfactor_prod_l" =
      \<open>\<lbrakk>properfactor (add_monoid R) ?a ?b; ?a \<in> carrier R;
              ?b \<in> carrier R; ?c \<in> carrier R\<rbrakk>
             \<Longrightarrow> properfactor (add_monoid R) ?a
                                (?c \<oplus> ?b)\<close>
  notes theorem
    "add.irreducible_prod_lI" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid R) ?b;
              ?a \<in> Units (add_monoid R); ?a \<in> carrier R;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible (add_monoid R)
                                (?a \<oplus> ?b)\<close>
  notes theorem
    "add.multlist_dividesI" =
      \<open>\<lbrakk>?f \<in> set ?fs;
              set ?fs \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid R\<^esub>
                               foldr (\<oplus>) ?fs \<zero>\<close>
  notes theorem
    "add.multlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> foldr (\<oplus>) ?as \<zero> =
                               foldr (\<oplus>) ?bs \<zero>\<close>
  notes theorem
    "add.wfactors_perm_cong_l" =
      \<open>\<lbrakk>wfactors (add_monoid R) ?fs ?a; mset ?fs = mset ?fs';
              set ?fs \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid R) ?fs' ?a\<close>
  notes theorem
    "add.perm_wfactorsD" =
      \<open>\<lbrakk>mset ?as = mset ?bs; wfactors (add_monoid R) ?as ?a;
              wfactors (add_monoid R) ?bs ?b; ?a \<in> carrier R;
              ?b \<in> carrier R; set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid R\<^esub>
                               ?b\<close>
  notes theorem
    "add.factors_dividesI" =
      \<open>\<lbrakk>factors (add_monoid R) ?fs ?a; ?f \<in> set ?fs;
