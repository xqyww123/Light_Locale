             \<Longrightarrow> up_ring.coeff P ?p ?m = \<zero>\<close>
  notes theorem
    "deg_belowI" =
      \<open>\<lbrakk>?n \<noteq> 0 \<Longrightarrow>
                      up_ring.coeff P ?p ?n \<noteq> \<zero>;
              ?p \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?n \<le> deg R ?p\<close>
  notes theorem
    "lcoeff_nonzero_deg" =
      \<open>\<lbrakk>deg R ?p \<noteq> 0; ?p \<in> carrier P\<rbrakk>
             \<Longrightarrow> lcoeff ?p \<noteq> \<zero>\<close>
  notes theorem
    "lcoeff_nonzero_nonzero" =
      \<open>\<lbrakk>deg R ?p = 0; ?p \<noteq> \<zero>\<^bsub>P\<^esub>;
