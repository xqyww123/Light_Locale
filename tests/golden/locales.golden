                                up_ring.monom P ?a
                                 ?n \<oplus>\<^bsub>P\<^esub>
                                up_ring.monom P ?b ?n\<close>)
      ["simp"]
  notes theorem
    "monom_one_Suc" =
      \<open>up_ring.monom P \<one> (Suc ?n) =
             up_ring.monom P \<one> ?n \<otimes>\<^bsub>P\<^esub>
             up_ring.monom P \<one> 1\<close>
  notes theorem
    "monom_one_Suc2" =
      \<open>up_ring.monom P \<one> (Suc ?n) =
