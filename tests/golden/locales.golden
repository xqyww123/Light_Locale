    "P.add.subgroup_imp_normal" =
      \<open>subgroup ?A (add_monoid P) \<Longrightarrow>
             ?A \<lhd> add_monoid P\<close>
  notes theorem
    "P.add.mult_subgroups" =
      \<open>\<lbrakk>subgroup ?H (add_monoid P);
