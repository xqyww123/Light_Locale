      ["simp"]
  notes
    "S.add.r_one" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              ?x \<oplus>\<^bsub>S\<^esub> \<zero>\<^bsub>S\<^esub> =
              ?x\<close>)
      ["simp"]
  notes theorem
    "S.add.Units_closed" =
