      \<open>\<lbrakk>?x \<in> carrier G; ?k dvd ord ?x;
              ?k \<noteq> 0\<rbrakk>
             \<Longrightarrow> ord (?x [^] ?k) = ord ?x div ?k\<close>
  notes theorem
    "ord_mul_divides" =
      \<open>\<lbrakk>?x \<otimes> ?y = ?y \<otimes> ?x; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ord (?x \<otimes> ?y) dvd
                               ord ?x * ord ?y\<close>
  notes theorem
    "ord_inj" =
      \<open>?a \<in> carrier G \<Longrightarrow>
             inj_on (([^]) ?a) {0..ord ?a - 1}\<close>
  notes theorem
    "ord_inj'" =
      \<open>?a \<in> carrier G \<Longrightarrow>
             inj_on (([^]) ?a) {1..ord ?a}\<close>
  notes theorem
    "ord_ge_1" =
      \<open>\<lbrakk>finite (carrier G); ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> 1 \<le> ord ?a\<close>
  notes theorem
    "ord_elems" =
      \<open>\<lbrakk>finite (carrier G); ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> {?a [^] x |x. x \<in> UNIV} =
                               {?a [^] x |x.
                                x \<in> {0..ord ?a - 1}}\<close>
  notes theorem
    "finite_cyclic_subgroup" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             finite (carrier (subgroup_generated G {?x})) =
             (\<exists>n. n \<noteq> 0 \<and> ?x [^] n = \<one>)\<close>
  notes theorem
    "infinite_cyclic_subgroup" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             infinite (carrier (subgroup_generated G {?x})) =
             (\<forall>m n.
                 ?x [^] m = ?x [^] n \<longrightarrow> m = n)\<close>
  notes theorem
    "finite_cyclic_subgroup_int" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             finite (carrier (subgroup_generated G {?x})) =
             (\<exists>i. i \<noteq> 0 \<and> ?x [^] i = \<one>)\<close>
  notes theorem
    "infinite_cyclic_subgroup_int" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             infinite (carrier (subgroup_generated G {?x})) =
             (\<forall>i j.
                 ?x [^] i = ?x [^] j \<longrightarrow> i = j)\<close>
  notes theorem
    "finite_cyclic_subgroup_order" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             finite (carrier (subgroup_generated G {?x})) =
             (ord ?x \<noteq> 0)\<close>
  notes theorem
    "infinite_cyclic_subgroup_order" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             infinite (carrier (subgroup_generated G {?x})) =
             (ord ?x = 0)\<close>
  notes theorem
    "generate_pow_on_finite_carrier" =
      \<open>\<lbrakk>finite (carrier G); ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> generate G {?a} =
                               {?a [^] k |k. k \<in> UNIV}\<close>
  notes theorem
    "ord_elems_inf_carrier" =
      \<open>\<lbrakk>?a \<in> carrier G; ord ?a \<noteq> 0\<rbrakk>
             \<Longrightarrow> {?a [^] x |x. x \<in> UNIV} =
                               {?a [^] x |x.
                                x \<in> {0..ord ?a - 1}}\<close>
  notes theorem
    "generate_pow_nat" =
      \<open>\<lbrakk>?a \<in> carrier G; ord ?a \<noteq> 0\<rbrakk>
             \<Longrightarrow> generate G {?a} =
                               {?a [^] k |k. k \<in> UNIV}\<close>
  notes theorem
    "generate_pow_card" =
      \<open>?a \<in> carrier G \<Longrightarrow>
             ord ?a = card (generate G {?a})\<close>
  notes theorem
    "cyclic_order_is_ord" =
      \<open>?g \<in> carrier G \<Longrightarrow>
             ord ?g = Coset.order (subgroup_generated G {?g})\<close>
  notes theorem
    "ord_dvd_group_order" =
      \<open>?a \<in> carrier G \<Longrightarrow>
             ord ?a dvd Coset.order G\<close>
  notes theorem
    "pow_order_eq_1" =
      \<open>?a \<in> carrier G \<Longrightarrow>
             ?a [^] Coset.order G = \<one>\<close>
  notes theorem
    "dvd_gcd" =
      (\<open>(\<And>q.
                  ?a * (?b div gcd ?a ?b) = ?b * q \<Longrightarrow>
