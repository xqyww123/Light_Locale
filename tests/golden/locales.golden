             \<Longrightarrow> add_monoid R
                               \<lparr>carrier :=
   ?N <#>\<^bsub>add_monoid R\<^esub> ?H\<rparr> Mod
                               ?N \<cong>
                               add_monoid R\<lparr>carrier := ?H\<rparr> Mod
                               ?H \<inter> ?N\<close>
  notes theorem
    "add.snd_iso_thme_recip" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              subgroup ?N (add_monoid R);
              subgroup ?H
