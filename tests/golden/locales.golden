      (\<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
              \<Longrightarrow> \<ominus>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
                                (?x \<oplus>\<^bsub>P\<^esub> ?y) =
                                ?y\<close>)
      ["Ring.algebra" add : cring \<zero>\<^bsub>P\<^esub>
