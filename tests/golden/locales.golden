                                ?z \<otimes>\<^bsub>P\<^esub>
                                ?x \<oplus>\<^bsub>P\<^esub>
                                ?z \<otimes>\<^bsub>P\<^esub> ?y\<close>)
      ["Ring.algebra" add : cring \<zero>\<^bsub>P\<^esub>
         (\<oplus>\<^bsub>P\<^esub>) a_inv P a_minus P
         \<one>\<^bsub>P\<^esub> (\<otimes>\<^bsub>P\<^esub>)]
      (\<open>?x \<in> carrier P \<Longrightarrow>
              \<zero>\<^bsub>P\<^esub> \<otimes>\<^bsub>P\<^esub> ?x =
