              ?g <# ?H1.0 #> inv ?g = ?g <# ?H2.0 #> inv ?g\<rbrakk>
             \<Longrightarrow> ?H1.0 = ?H2.0\<close>
  notes theorem
    "subgroup_conjugation_is_surj0" =
      \<open>\<lbrakk>?g \<in> carrier G; ?H \<subseteq> carrier G\<rbrakk>
