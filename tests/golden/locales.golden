                         i \<in> ?I \<Longrightarrow>
                         ?f i \<in> hom (?A i) (add_monoid P);
              \<And>i.
                 i \<in> ?I \<Longrightarrow> Group.group (?A i)\<rbrakk>
             \<Longrightarrow> (\<lambda>x.
                                   gfinprod (add_monoid P)
                                    (\<lambda>i. ?f i (x i)) ?I)
                               \<in> hom (sum_group ?I ?A)
(add_monoid P)\<close>
  notes theorem
    "P.add.free_Abelian_group_universal" =
