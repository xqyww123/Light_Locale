             \<Longrightarrow> ?H +> ?x <+> ?K = ?H <+> (?x <+ ?K)\<close>
  notes theorem
    "a_card_cosets_equal" =
      \<open>\<lbrakk>?c \<in> a_rcosets ?H; ?H \<subseteq> carrier R;
              finite (carrier R)\<rbrakk>
             \<Longrightarrow> card ?c = card ?H\<close>
  notes theorem
    "rcosets_subset_PowG" =
      \<open>additive_subgroup ?H R \<Longrightarrow>
