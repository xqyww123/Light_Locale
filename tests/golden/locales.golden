             \<Longrightarrow> ?H #>\<^bsub>add_monoid P\<^esub> ?x =
                               ?H #>\<^bsub>add_monoid P\<^esub> ?y\<close>
  notes theorem
    "P.add.coset_join2" =
      \<open>\<lbrakk>?x \<in> carrier P; subgroup ?H (add_monoid P);
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid P\<^esub> ?x =
                               ?H\<close>
  notes theorem
    "P.add.coset_join3" =
      \<open>\<lbrakk>?x \<in> carrier P; subgroup ?H (add_monoid P);
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid P\<^esub> ?H =
                               ?H\<close>
  notes theorem
    "P.add.rcosI" =
      \<open>\<lbrakk>?h \<in> ?H; ?H \<subseteq> carrier P;
              ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?h \<oplus>\<^bsub>P\<^esub> ?x
                               \<in> ?H #>\<^bsub>add_monoid P\<^esub>
                                     ?x\<close>
  notes theorem
    "P.add.rcosetsI" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid P\<^esub> ?x
                               \<in> rcosets\<^bsub>add_monoid P\<^esub> ?H\<close>
  notes theorem
    "P.add.rcos_self" =
      \<open>\<lbrakk>?x \<in> carrier P;
              subgroup ?H (add_monoid P)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H #>\<^bsub>add_monoid P\<^esub>
  ?x\<close>
  notes theorem
    "P.add.repr_independenceD" =
      \<open>\<lbrakk>subgroup ?H (add_monoid P); ?y \<in> carrier P;
              ?H #>\<^bsub>add_monoid P\<^esub> ?x =
              ?H #>\<^bsub>add_monoid P\<^esub> ?y\<rbrakk>
             \<Longrightarrow> ?y \<in> ?H #>\<^bsub>add_monoid P\<^esub>
  ?x\<close>
  notes theorem
    "P.add.normalI" =
      \<open>\<lbrakk>subgroup ?H (add_monoid P);
              \<forall>x\<in>carrier P.
                 ?H #>\<^bsub>add_monoid P\<^esub> x =
                 x <#\<^bsub>add_monoid P\<^esub> ?H\<rbrakk>
             \<Longrightarrow> ?H \<lhd> add_monoid P\<close>
  notes theorem
    "P.add.normal_inv_iff" =
      \<open>?N \<lhd> add_monoid P =
             (subgroup ?N (add_monoid P) \<and>
              (\<forall>x\<in>carrier P.
                  \<forall>h\<in>?N.
                     x \<oplus>\<^bsub>P\<^esub> h \<oplus>\<^bsub>P\<^esub>
                     \<ominus>\<^bsub>P\<^esub> x
                     \<in> ?N))\<close>
  notes theorem
    "P.add.normal_invI" =
      \<open>\<lbrakk>subgroup ?N (add_monoid P);
