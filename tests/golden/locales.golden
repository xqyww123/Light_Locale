  notes theorem
    "coeff_a_inv" =
      (\<open>?p \<in> carrier P \<Longrightarrow>
              up_ring.coeff P (\<ominus>\<^bsub>P\<^esub> ?p) ?n =
              \<ominus> up_ring.coeff P ?p ?n\<close>)
      ["simp"]
  notes theorem
    "UP_smult_l_distr" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R;
