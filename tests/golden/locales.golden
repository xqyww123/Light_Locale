             \<in> hom \<lparr>carrier = UNIV, monoid.mult = (+),
                          one = 0\<rparr>
                    (add_monoid R)\<close>
  notes theorem
    "R.add.canonical_inj_is_hom" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             group_hom (add_monoid R\<lparr>carrier := ?H\<rparr>)
              (add_monoid R) id\<close>
  notes theorem
    "R.add.group_comm_groupI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier R; y \<in> carrier R\<rbrakk>
                 \<Longrightarrow> x \<oplus> y =
                                   y \<oplus> x) \<Longrightarrow>
             comm_group (add_monoid R)\<close>
  notes theorem
    "R.add.incl_subgroup" =
      \<open>\<lbrakk>subgroup ?J (add_monoid R);
              subgroup ?I
               (add_monoid R\<lparr>carrier := ?J\<rparr>)\<rbrakk>
             \<Longrightarrow> subgroup ?I (add_monoid R)\<close>
  notes theorem
    "R.add.subgroup_incl" =
      \<open>\<lbrakk>subgroup ?I (add_monoid R);
              subgroup ?J (add_monoid R); ?I \<subseteq> ?J\<rbrakk>
             \<Longrightarrow> subgroup ?I
                                (add_monoid R
                                 \<lparr>carrier := ?J\<rparr>)\<close>
  notes theorem
    "R.add.subgroups_partial_order" =
      \<open>partial_order
              \<lparr>carrier = {H. subgroup H (add_monoid R)}, eq = (=),
                 le = (\<subseteq>)\<rparr>\<close>
  notes theorem
    "R.add.subgroup_self" =
      \<open>subgroup (carrier R) (add_monoid R)\<close>
  notes theorem
    "R.add.subgroup_imp_group" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             Group.group (add_monoid R\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "R.add.subgroup_mult_equality" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?h1.0 \<in> ?H;
              ?h2.0 \<in> ?H\<rbrakk>
             \<Longrightarrow> ?h1.0 \<otimes>\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub>
                               ?h2.0 =
                               ?h1.0 \<oplus> ?h2.0\<close>
  notes theorem
    "R.add.subgroups_Inter" =
      \<open>\<lbrakk>\<And>H.
                         H \<in> ?A \<Longrightarrow>
                         subgroup H (add_monoid R);
              ?A \<noteq> {}\<rbrakk>
             \<Longrightarrow> subgroup (\<Inter> ?A) (add_monoid R)\<close>
  notes theorem
    "R.add.subgroups_Inter_pair" =
      \<open>\<lbrakk>subgroup ?I (add_monoid R);
              subgroup ?J (add_monoid R)\<rbrakk>
             \<Longrightarrow> subgroup (?I \<inter> ?J)
                                (add_monoid R)\<close>
  notes theorem
    "R.add.subgroups_complete_lattice" =
      \<open>complete_lattice
              \<lparr>carrier = {H. subgroup H (add_monoid R)}, eq = (=),
