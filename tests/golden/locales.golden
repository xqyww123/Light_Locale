                                (?x \<oplus>\<^bsub>S\<^esub> ?y) =
                                ?y\<close>)
      ["Ring.algebra" ring \<zero>\<^bsub>S\<^esub>
         (\<oplus>\<^bsub>S\<^esub>) a_inv S a_minus S
         \<one>\<^bsub>S\<^esub> (\<otimes>\<^bsub>S\<^esub>)]
      (\<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
