              ?y \<in> ?H\<rbrakk>
             \<Longrightarrow> \<exists>h\<in>?H.
                                  ?y =
                                  h \<oplus>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.add.repr_independence" =
      \<open>\<lbrakk>?y \<in> ?H #>\<^bsub>add_monoid P\<^esub> ?x;
