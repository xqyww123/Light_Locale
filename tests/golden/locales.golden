             [(- int ?n)] \<cdot> ?x = \<ominus> ([?n] \<cdot> ?x)\<close>
  notes theorem
    "R.add.int_pow_mult" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [(?i + ?j)] \<cdot> ?x =
             [?i] \<cdot> ?x \<oplus> [?j] \<cdot> ?x\<close>
  notes theorem
    "R.add.int_pow_inv" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?i] \<cdot> (\<ominus> ?x) =
             \<ominus> ([?i] \<cdot> ?x)\<close>
  notes theorem
    "R.add.int_pow_pow" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?m] \<cdot> ([?n] \<cdot> ?x) = [(?n * ?m)] \<cdot> ?x\<close>
  notes theorem
    "R.add.int_pow_diff" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [(?n - ?m)] \<cdot> ?x =
             [?n] \<cdot> ?x \<oplus> \<ominus> ([?m] \<cdot> ?x)\<close>
  notes theorem
    "R.add.inj_on_multc" =
