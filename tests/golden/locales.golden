  notes theorem
    "P.add.set_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier P; ?H \<subseteq> carrier P;
              ?K \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?M <#>\<^bsub>add_monoid P\<^esub>
                               ?H <#>\<^bsub>add_monoid P\<^esub>
                               ?K =
                               ?M <#>\<^bsub>add_monoid P\<^esub>
                               (?H <#>\<^bsub>add_monoid P\<^esub>
                                ?K)\<close>
  notes theorem
    "P.add.coset_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier P; ?g \<in> carrier P;
