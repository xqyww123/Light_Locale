         \<one>\<^bsub>S\<^esub> (\<otimes>\<^bsub>S\<^esub>)]
      (\<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
              \<Longrightarrow> \<ominus>\<^bsub>S\<^esub> ?x \<otimes>\<^bsub>S\<^esub>
                                ?y =
                                \<ominus>\<^bsub>S\<^esub> (?x \<otimes>\<^bsub>S\<^esub>
                      ?y)\<close>)
      ["Ring.algebra" add : cring \<zero>\<^bsub>S\<^esub>
         (\<oplus>\<^bsub>S\<^esub>) a_inv S a_minus S
         \<one>\<^bsub>S\<^esub> (\<otimes>\<^bsub>S\<^esub>)]
      (\<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?x \<otimes>\<^bsub>S\<^esub>
                                \<ominus>\<^bsub>S\<^esub> ?y =
                                \<ominus>\<^bsub>S\<^esub> (?x \<otimes>\<^bsub>S\<^esub>
                      ?y)\<close>)
      ["Ring.algebra" add : cring \<zero>\<^bsub>S\<^esub>
         (\<oplus>\<^bsub>S\<^esub>) a_inv S a_minus S
         \<one>\<^bsub>S\<^esub> (\<otimes>\<^bsub>S\<^esub>)]
  notes theorem
    "S.cring_fieldI" =
      \<open>Units S =
             carrier S - {\<zero>\<^bsub>S\<^esub>} \<Longrightarrow>
             field S\<close>
  notes theorem
    "S.cring_fieldI2" =
      \<open>\<lbrakk>\<zero>\<^bsub>S\<^esub> \<noteq>
                      \<one>\<^bsub>S\<^esub>;
              \<And>a.
                 \<lbrakk>a \<in> carrier S;
                  a \<noteq> \<zero>\<^bsub>S\<^esub>\<rbrakk>
                 \<Longrightarrow> \<exists>b\<in>carrier S.
a \<otimes>\<^bsub>S\<^esub> b = \<one>\<^bsub>S\<^esub>\<rbrakk>
             \<Longrightarrow> field S\<close>
  notes theorem
    "S.sum_zero_eq_neg" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?x \<oplus>\<^bsub>S\<^esub> ?y =
              \<zero>\<^bsub>S\<^esub>\<rbrakk>
             \<Longrightarrow> ?x = \<ominus>\<^bsub>S\<^esub> ?y\<close>
  notes theorem
    "S.units_power_order_eq_one" =
      \<open>\<lbrakk>finite (Units S); ?a \<in> Units S\<rbrakk>
             \<Longrightarrow> ?a [^]\<^bsub>S\<^esub> card (Units S) =
                               \<one>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.field_intro2" =
      \<open>\<lbrakk>\<zero>\<^bsub>S\<^esub> \<noteq>
                      \<one>\<^bsub>S\<^esub>;
              \<And>x.
                 x \<in> carrier S -
                         {\<zero>\<^bsub>S\<^esub>} \<Longrightarrow>
                 x \<in> Units S\<rbrakk>
             \<Longrightarrow> field S\<close>
  notes theorem
    "S.cgenideal_ideal" =
      \<open>?a \<in> carrier S \<Longrightarrow>
             ideal (PIdl\<^bsub>S\<^esub> ?a) S\<close>
  notes theorem
    "S.cgenideal_eq_genideal" =
      \<open>?i \<in> carrier S \<Longrightarrow>
             PIdl\<^bsub>S\<^esub> ?i = Idl\<^bsub>S\<^esub> {?i}\<close>
  notes theorem
    "S.cgenideal_eq_rcos" =
      \<open>PIdl\<^bsub>S\<^esub> ?i =
             carrier S #>\<^bsub>S\<^esub> ?i\<close>
  notes theorem
    "S.cgenideal_is_principalideal" =
      \<open>?i \<in> carrier S \<Longrightarrow>
             principalideal (PIdl\<^bsub>S\<^esub> ?i) S\<close>
  notes theorem
    "S.cgenideal_prod" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> PIdl\<^bsub>S\<^esub> ?a <#>\<^bsub>S\<^esub>
                               PIdl\<^bsub>S\<^esub> ?b =
                               PIdl\<^bsub>S\<^esub> (?a \<otimes>\<^bsub>S\<^esub>
                ?b)\<close>
  notes theorem
    "S.zeroprimeideal_domainI" =
      \<open>primeideal {\<zero>\<^bsub>S\<^esub>} S \<Longrightarrow>
             domain S\<close>
  notes theorem
    "S.domain_eq_zeroprimeideal" =
      \<open>domain S = primeideal {\<zero>\<^bsub>S\<^esub>} S\<close>
  notes theorem
    "S.maximalideal_prime" =
      \<open>maximalideal ?I S \<Longrightarrow> primeideal ?I S\<close>
  notes theorem
    "S.trivialideals_fieldI" =
      \<open>\<lbrakk>carrier S \<noteq> {\<zero>\<^bsub>S\<^esub>};
              {I. ideal I S} =
              {{\<zero>\<^bsub>S\<^esub>}, carrier S}\<rbrakk>
             \<Longrightarrow> field S\<close>
  notes theorem
    "S.trivialideals_eq_field" =
      \<open>carrier S \<noteq> {\<zero>\<^bsub>S\<^esub>} \<Longrightarrow>
             ({I. ideal I S} = {{\<zero>\<^bsub>S\<^esub>}, carrier S}) =
             field S\<close>
  notes theorem
    "S.zeromaximalideal_fieldI" =
      \<open>maximalideal {\<zero>\<^bsub>S\<^esub>} S \<Longrightarrow>
             field S\<close>
  notes theorem
    "S.zeromaximalideal_eq_field" =
      \<open>maximalideal {\<zero>\<^bsub>S\<^esub>} S = field S\<close>
  notes theorem
    "S.quot_domain_imp_primeideal" =
      \<open>\<lbrakk>ideal ?P S; domain (S Quot ?P)\<rbrakk>
             \<Longrightarrow> primeideal ?P S\<close>
  notes theorem
    "S.quot_domain_iff_primeideal" =
      \<open>ideal ?P S \<Longrightarrow>
             domain (S Quot ?P) = primeideal ?P S\<close>
  notes theorem
    "S.ring_iso_imp_img_cring" =
      \<open>?h \<in> ring_iso S ?S \<Longrightarrow>
             cring
              (?S\<lparr>zero :=
                           ?h \<zero>\<^bsub>S\<^esub>\<rparr>)\<close>
  notes theorem
    "S.divides_one" =
      \<open>?a \<in> carrier S \<Longrightarrow>
             ?a divides\<^bsub>S\<^esub> \<one>\<^bsub>S\<^esub> =
             (?a \<in> Units S)\<close>
  notes theorem
    "S.to_contain_is_to_divide" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> (PIdl\<^bsub>S\<^esub> ?b
                                \<subseteq> PIdl\<^bsub>S\<^esub> ?a) =
                               ?a divides\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.associated_iff_same_ideal" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>S\<^esub> ?b =
                               (PIdl\<^bsub>S\<^esub> ?a =
                                PIdl\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.ideal_eq_carrier_iff" =
      \<open>?a \<in> carrier S \<Longrightarrow>
             (carrier S = PIdl\<^bsub>S\<^esub> ?a) =
             (?a \<in> Units S)\<close>
  notes theorem
    "S.subcringI'" =
      \<open>subring ?H S \<Longrightarrow> subcring ?H S\<close>
  notes theorem
    "S.carrier_is_subcring" = \<open>subcring (carrier S) S\<close>
  notes theorem
    "S.eval_poly_mult" =
      \<open>\<lbrakk>set ?p \<subseteq> carrier S;
              set ?q \<subseteq> carrier S; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> S.eval (S.poly_mult ?p ?q) ?a =
                               S.eval ?p ?a \<otimes>\<^bsub>S\<^esub>
                               S.eval ?q ?a\<close>
  notes theorem
    "S.eval_is_hom" =
      \<open>\<lbrakk>subring ?K S; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> (\<lambda>p. S.eval p ?a)
                               \<in> ring_hom (?K [X]\<^bsub>S\<^esub>)
S\<close>
  notes theorem
    "S.const_term_simprules" =
      \<open>set ?p \<subseteq> carrier S \<Longrightarrow>
             S.const_term ?p \<in> carrier S\<close>
      \<open>\<lbrakk>set ?p \<subseteq> carrier S;
              set ?q \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> S.const_term (S.poly_mult ?p ?q) =
                               S.const_term ?p \<otimes>\<^bsub>S\<^esub>
                               S.const_term ?q\<close>
      \<open>\<lbrakk>set ?p \<subseteq> carrier S;
              set ?q \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> S.const_term (S.poly_add ?p ?q) =
                               S.const_term ?p \<oplus>\<^bsub>S\<^esub>
                               S.const_term ?q\<close>
  notes theorem
    "S.ideal_prod_commute" =
      \<open>\<lbrakk>ideal ?I S; ideal ?J S\<rbrakk>
             \<Longrightarrow> ?I \<cdot>\<^bsub>S\<^esub> ?J =
                               ?J \<cdot>\<^bsub>S\<^esub> ?I\<close>
  notes theorem
    "S.ideal_prod_distr" =
      \<open>\<lbrakk>ideal ?I S; ideal ?J S; ideal ?K S\<rbrakk>
             \<Longrightarrow> ?I \<cdot>\<^bsub>S\<^esub>
                               (?J <+>\<^bsub>S\<^esub> ?K) =
                               ?I \<cdot>\<^bsub>S\<^esub>
                               ?J <+>\<^bsub>S\<^esub>
                               ?I \<cdot>\<^bsub>S\<^esub> ?K\<close>
      \<open>\<lbrakk>ideal ?I S; ideal ?J S; ideal ?K S\<rbrakk>
             \<Longrightarrow> (?J <+>\<^bsub>S\<^esub>
                                ?K) \<cdot>\<^bsub>S\<^esub>
                               ?I =
                               ?J \<cdot>\<^bsub>S\<^esub>
                               ?I <+>\<^bsub>S\<^esub>
                               ?K \<cdot>\<^bsub>S\<^esub> ?I\<close>
  notes theorem
    "S.ideal_prod_eq_inter" =
      \<open>\<lbrakk>ideal ?I S; ideal ?J S;
              ?I <+>\<^bsub>S\<^esub> ?J = carrier S\<rbrakk>
             \<Longrightarrow> ?I \<cdot>\<^bsub>S\<^esub> ?J =
                               ?I \<inter> ?J\<close>
  notes theorem
    "S.ideals_set_is_semiring" = \<open>semiring (ideals_set S)\<close>
  notes theorem
    "S.ideals_set_is_comm_monoid" =
      \<open>Group.comm_monoid (ideals_set S)\<close>
  notes theorem
    "S.ideal_prod_eq_Inter_aux" =
      \<open>\<lbrakk>?I \<in> {..Suc ?n} \<rightarrow> {J. ideal J S};
              \<And>i j.
                 \<lbrakk>i \<le> Suc ?n; j \<le> Suc ?n;
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>S\<^esub> ?I j =
                                   carrier S\<rbrakk>
             \<Longrightarrow> finprod (ideals_set S) ?I
                                {..?n} <+>\<^bsub>S\<^esub>
                               ?I (Suc ?n) =
                               carrier S\<close>
  notes theorem
    "S.ideal_prod_eq_Inter" =
      \<open>\<lbrakk>?I \<in> {..?n} \<rightarrow> {J. ideal J S};
              \<And>i j.
                 \<lbrakk>i \<in> {..?n}; j \<in> {..?n};
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>S\<^esub> ?I j =
                                   carrier S\<rbrakk>
             \<Longrightarrow> finprod (ideals_set S) ?I {..?n} =
                               \<Inter> (?I ` {..?n})\<close>
  notes theorem
    "S.inter_plus_ideal_eq_carrier" =
      \<open>\<lbrakk>\<And>i.
                         i \<le> Suc ?n \<Longrightarrow> ideal (?I i) S;
              \<And>i j.
                 \<lbrakk>i \<le> Suc ?n; j \<le> Suc ?n;
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>S\<^esub> ?I j =
                                   carrier S\<rbrakk>
             \<Longrightarrow> \<Inter> (?I ` {..?n}) <+>\<^bsub>S\<^esub>
                               ?I (Suc ?n) =
                               carrier S\<close>
  notes theorem
    "S.inter_plus_ideal_eq_carrier_arbitrary" =
      \<open>\<lbrakk>\<And>i.
                         i \<le> Suc ?n \<Longrightarrow> ideal (?I i) S;
              \<And>i j.
                 \<lbrakk>i \<le> Suc ?n; j \<le> Suc ?n;
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>S\<^esub> ?I j =
                                   carrier S;
              ?j \<le> Suc ?n\<rbrakk>
             \<Longrightarrow> \<Inter>
                                (?I `
                                 ({..Suc ?n} - {?j})) <+>\<^bsub>S\<^esub>
                               ?I ?j =
                               carrier S\<close>
  notes theorem
    "S.divides_ideal_prod_imp_primeideal" =
      \<open>\<lbrakk>ideal ?P S; ?P \<noteq> carrier S;
              \<And>I J.
                 \<lbrakk>ideal I S; ideal J S;
                  I \<cdot>\<^bsub>S\<^esub> J \<subseteq> ?P\<rbrakk>
                 \<Longrightarrow> I \<subseteq> ?P \<or>
                                   J \<subseteq> ?P\<rbrakk>
             \<Longrightarrow> primeideal ?P S\<close>
  notes theorem
    "S.canonical_proj_ext_is_surj" =
      \<open>\<lbrakk>\<And>i. i \<le> ?n \<Longrightarrow> ideal (?I i) S;
              \<And>i j.
                 \<lbrakk>i \<le> ?n; j \<le> ?n; i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>S\<^esub> ?I j =
                                   carrier S\<rbrakk>
             \<Longrightarrow> S.canonical_proj_ext ?I ?n ` carrier S =
                               carrier
                                (RDirProd_list
                                  (map (\<lambda>i. S Quot ?I i)
                                    [0..<Suc ?n]))\<close>
  notes theorem
    "S.chinese_remainder" =
      \<open>\<lbrakk>\<And>i. i \<le> ?n \<Longrightarrow> ideal (?I i) S;
              \<And>i j.
                 \<lbrakk>i \<le> ?n; j \<le> ?n; i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>S\<^esub> ?I j =
                                   carrier S\<rbrakk>
             \<Longrightarrow> S Quot \<Inter> (?I ` {..?n}) \<simeq>
                               RDirProd_list
                                (map (\<lambda>i. S Quot ?I i)
                                  [0..<Suc ?n])\<close>
  notes
    "ring.abelian_group.abelian_group_hom_axioms" =
      (\<open>abelian_group_hom R S h\<close>) ["attribute" "internal"]
  notes
    "ring.abelian_group.a_group_hom" =
      \<open>group_hom (add_monoid R) (add_monoid S) h\<close>
  notes theorem
    "ring.abelian_group.is_abelian_group_hom" =
      \<open>abelian_group_hom R S h\<close>
  notes theorem
    "ring.abelian_group.hom_add" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> h (?x \<oplus> ?y) =
                                h ?x \<oplus>\<^bsub>S\<^esub> h ?y\<close>)
      ["simp"]
  notes theorem
    "ring.abelian_group.hom_closed" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              h ?x \<in> carrier S\<close>)
      ["simp"]
  notes theorem
    "ring.abelian_group.zero_closed" =
      (\<open>h \<zero> \<in> carrier S\<close>) ["simp"]
  notes theorem
    "ring.abelian_group.hom_zero" =
      (\<open>h \<zero> = \<zero>\<^bsub>S\<^esub>\<close>) ["simp"]
  notes theorem
    "ring.abelian_group.a_inv_closed" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              h (\<ominus> ?x) \<in> carrier S\<close>)
      ["simp"]
  notes theorem
    "ring.abelian_group.hom_a_inv" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              h (\<ominus> ?x) = \<ominus>\<^bsub>S\<^esub> h ?x\<close>)
      ["simp"]
  notes theorem
    "ring.abelian_group.additive_subgroup_a_kernel" =
      \<open>additive_subgroup (a_kernel R S h) R\<close>
  notes theorem
    "ring.abelian_group.abelian_subgroup_a_kernel" =
      \<open>abelian_subgroup (a_kernel R S h) R\<close>
  notes theorem
    "ring.abelian_group.A_FactGroup_nonempty" =
      \<open>?X \<in> carrier (R A_Mod a_kernel R S h) \<Longrightarrow>
             ?X \<noteq> {}\<close>
  notes theorem
    "ring.abelian_group.FactGroup_the_elem_mem" =
      \<open>?X \<in> carrier (R A_Mod a_kernel R S h) \<Longrightarrow>
             the_elem (h ` ?X) \<in> carrier S\<close>
  notes theorem
    "ring.abelian_group.A_FactGroup_hom" =
      \<open>(\<lambda>X. the_elem (h ` X))
             \<in> hom (R A_Mod a_kernel R S h) (add_monoid S)\<close>
  notes theorem
    "ring.abelian_group.A_FactGroup_inj_on" =
      \<open>inj_on (\<lambda>X. the_elem (h ` X))
              (carrier (R A_Mod a_kernel R S h))\<close>
  notes theorem
    "ring.abelian_group.A_FactGroup_onto" =
      \<open>h ` carrier R = carrier S \<Longrightarrow>
             (\<lambda>X. the_elem (h ` X)) `
             carrier (R A_Mod a_kernel R S h) =
             carrier S\<close>
  notes theorem
    "ring.abelian_group.A_FactGroup_iso_set" =
      \<open>h ` carrier R = carrier S \<Longrightarrow>
             (\<lambda>X. the_elem (h ` X))
             \<in> Group.iso (R A_Mod a_kernel R S h) (add_monoid S)\<close>
  notes theorem
    "ring.abelian_group.A_FactGroup_iso" =
      \<open>h ` carrier R = carrier S \<Longrightarrow>
             R A_Mod a_kernel R S h \<cong> add_monoid S\<close>
  notes theorem
    "ring.abelian_group.kernel_zero" =
      (\<open>?i \<in> a_kernel ?R ?S h \<Longrightarrow>
              h ?i = \<zero>\<^bsub>?S\<^esub>\<close>)
      ["simp"]
  notes
    "ring.ring_hom_ring_axioms" = (\<open>ring_hom_ring R S h\<close>)
      ["attribute" "internal"]
  notes "ring.homh" = \<open>h \<in> ring_hom R S\<close>
  notes
    "ring.hom_mult" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> h (?x \<otimes> ?y) =
                                h ?x \<otimes>\<^bsub>S\<^esub>
                                h ?y\<close>)
      ["simp"]
  notes
    "ring.hom_one" = (\<open>h \<one> = \<one>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem "ring.is_ring_hom_ring" = \<open>ring_hom_ring R S h\<close>
  notes theorem
    "ring.kernel_is_ideal" = \<open>ideal (a_kernel R S h) R\<close>
  notes theorem
    "ring.rcos_imp_homeq" =
      \<open>\<lbrakk>?a \<in> carrier R;
              ?x \<in> a_kernel R S h +> ?a\<rbrakk>
             \<Longrightarrow> h ?x = h ?a\<close>
  notes theorem
    "ring.homeq_imp_rcos" =
      \<open>\<lbrakk>?a \<in> carrier R; ?x \<in> carrier R;
              h ?x = h ?a\<rbrakk>
             \<Longrightarrow> ?x \<in> a_kernel R S h +> ?a\<close>
  notes theorem
    "ring.rcos_eq_homeq" =
      \<open>?a \<in> carrier R \<Longrightarrow>
             a_kernel R S h +> ?a = {x \<in> carrier R. h x = h ?a}\<close>
  notes theorem
    "ring.hom_nat_pow" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             h (?x [^] ?n) = h ?x [^]\<^bsub>S\<^esub> ?n\<close>
  notes theorem
    "ring.inj_on_domain" =
      \<open>\<lbrakk>inj_on h (carrier R); domain S\<rbrakk>
             \<Longrightarrow> domain R\<close>
  notes theorem
    "ring.trivial_hom_iff" =
      \<open>(h ` carrier R = {\<zero>\<^bsub>S\<^esub>}) =
             (a_kernel R S h = carrier R)\<close>
  notes theorem
    "ring.trivial_ker_imp_inj" =
      \<open>a_kernel R S h = {\<zero>} \<Longrightarrow>
             inj_on h (carrier R)\<close>
  notes theorem
    "ring.inj_iff_trivial_ker" =
      \<open>inj_on h (carrier R) = (a_kernel R S h = {\<zero>})\<close>
  notes theorem
    "ring.set_add_ker_hom" =
      \<open>?I \<subseteq> carrier R \<Longrightarrow>
             h ` (?I <+> a_kernel R S h) = h ` ?I\<close>
      \<open>?I \<subseteq> carrier R \<Longrightarrow>
             h ` (a_kernel R S h <+> ?I) = h ` ?I\<close>
  notes theorem
    "ring.non_trivial_field_hom_imp_inj" =
      \<open>\<lbrakk>field R;
              h ` carrier R \<noteq> {\<zero>\<^bsub>S\<^esub>}\<rbrakk>
             \<Longrightarrow> inj_on h (carrier R)\<close>
  notes theorem
    "ring.img_is_add_subgroup" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             subgroup (h ` ?H) (add_monoid S)\<close>
  notes theorem
    "ring.ideal_vimage" =
      \<open>ideal ?I S \<Longrightarrow>
             ideal {r \<in> carrier R. h r \<in> ?I} R\<close>
  notes theorem
    "ring.the_elem_simp" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              the_elem (h ` (a_kernel R S h +> ?x)) = h ?x\<close>)
      ["simp"]
  notes theorem
    "ring.the_elem_inj" =
      \<open>\<lbrakk>?X \<in> carrier (R Quot a_kernel R S h);
              ?Y \<in> carrier (R Quot a_kernel R S h);
              the_elem (h ` ?X) = the_elem (h ` ?Y)\<rbrakk>
             \<Longrightarrow> ?X = ?Y\<close>
  notes theorem
    "ring.quot_mem" =
      \<open>?X \<in> carrier (R Quot a_kernel R S h) \<Longrightarrow>
             \<exists>x\<in>carrier R. ?X = a_kernel R S h +> x\<close>
  notes theorem
    "ring.the_elem_wf" =
      \<open>?X \<in> carrier (R Quot a_kernel R S h) \<Longrightarrow>
             \<exists>y\<in>carrier S. h ` ?X = {y}\<close>
  notes theorem
    "ring.the_elem_wf'" =
      \<open>?X \<in> carrier (R Quot a_kernel R S h) \<Longrightarrow>
             \<exists>r\<in>carrier R. h ` ?X = {h r}\<close>
  notes theorem
    "ring.the_elem_hom" =
      \<open>(\<lambda>X. the_elem (h ` X))
             \<in> ring_hom (R Quot a_kernel R S h) S\<close>
  notes theorem
    "ring.the_elem_surj" =
      \<open>(\<lambda>X. the_elem (h ` X)) `
             carrier (R Quot a_kernel R S h) =
             h ` carrier R\<close>
  notes theorem
    "ring.FactRing_iso_set_aux" =
      \<open>(\<lambda>X. the_elem (h ` X))
             \<in> ring_iso (R Quot a_kernel R S h)
                    (S\<lparr>carrier := h ` carrier R\<rparr>)\<close>
  notes theorem
    "ring.FactRing_iso_set" =
      \<open>h ` carrier R = carrier S \<Longrightarrow>
             (\<lambda>X. the_elem (h ` X))
             \<in> ring_iso (R Quot a_kernel R S h) S\<close>
  notes theorem
    "ring.FactRing_iso" =
      \<open>h ` carrier R = carrier S \<Longrightarrow>
             R Quot a_kernel R S h \<simeq> S\<close>
  notes theorem
    "ring.img_is_ring" =
      \<open>ring (S\<lparr>carrier := h ` carrier R\<rparr>)\<close>
  notes theorem
    "ring.img_is_cring" =
      \<open>cring S \<Longrightarrow>
             cring (S\<lparr>carrier := h ` carrier R\<rparr>)\<close>
  notes theorem
    "ring.img_is_domain" =
      \<open>domain S \<Longrightarrow>
             domain (S\<lparr>carrier := h ` carrier R\<rparr>)\<close>
  notes theorem
    "ring.primeideal_vimage" =
      \<open>\<lbrakk>cring R; primeideal ?P S\<rbrakk>
             \<Longrightarrow> primeideal {r \<in> carrier R. h r \<in> ?P}
                                R\<close>
  notes theorem
    "ring.hom_finsum" =
      (\<open>?f \<in> ?A \<rightarrow> carrier R \<Longrightarrow>
              h (finsum R ?f ?A) = finsum S (h \<circ> ?f) ?A\<close>)
      ["simp"]
  notes theorem
    "ring.img_is_subring" =
      \<open>subring ?K R \<Longrightarrow> subring (h ` ?K) S\<close>
  notes theorem
    "ring.img_is_subfield" =
      \<open>\<lbrakk>subfield ?K R;
              \<one>\<^bsub>S\<^esub> \<noteq>
              \<zero>\<^bsub>S\<^esub>\<rbrakk>
             \<Longrightarrow> inj_on h ?K\<close>
      \<open>\<lbrakk>subfield ?K R;
              \<one>\<^bsub>S\<^esub> \<noteq>
              \<zero>\<^bsub>S\<^esub>\<rbrakk>
             \<Longrightarrow> subfield (h ` ?K) S\<close>
  notes theorem
    "ring.induced_ring_hom" =
      \<open>subring ?K R \<Longrightarrow>
             ring_hom_ring (R\<lparr>carrier := ?K\<rparr>) S h\<close>
  notes theorem
    "ring.inj_on_subgroup_iff_trivial_ker" =
      \<open>subring ?K R \<Longrightarrow>
             inj_on h ?K =
             (a_kernel (R\<lparr>carrier := ?K\<rparr>) S h =
              {\<zero>})\<close>
  notes theorem
    "ring.inv_ring_hom" =
      \<open>\<lbrakk>inj_on h ?K; subring ?K R\<rbrakk>
             \<Longrightarrow> ring_hom_ring
                                (S\<lparr>carrier := h ` ?K\<rparr>) R
                                (inv_into ?K h)\<close>
  notes theorem
    "ring.eval_hom'" =
      \<open>\<lbrakk>?a \<in> carrier R;
              set ?p \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> h (R.eval ?p ?a) =
                               S.eval (map h ?p) (h ?a)\<close>
  notes theorem
    "ring.eval_hom" =
      \<open>\<lbrakk>subring ?K R; ?a \<in> carrier R;
              ?p \<in> carrier (?K [X])\<rbrakk>
             \<Longrightarrow> h (R.eval ?p ?a) =
                               S.eval (map h ?p) (h ?a)\<close>
  notes theorem
    "ring.coeff_hom'" =
      \<open>set ?p \<subseteq> carrier R \<Longrightarrow>
             h (R.coeff ?p ?i) = S.coeff (map h ?p) ?i\<close>
  notes theorem
    "ring.poly_add_hom'" =
      \<open>\<lbrakk>set ?p \<subseteq> carrier R;
              set ?q \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> S.normalize (map h (R.poly_add ?p ?q)) =
                               S.poly_add (map h ?p) (map h ?q)\<close>
  notes theorem
    "ring.poly_mult_hom'" =
      \<open>\<lbrakk>set ?p \<subseteq> carrier R;
              set ?q \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> S.normalize (map h (R.poly_mult ?p ?q)) =
                               S.poly_mult (map h ?p) (map h ?q)\<close>
  notes theorem
    "ring.combine_hom" =
      \<open>\<lbrakk>set ?Ks \<subseteq> carrier R;
              set ?Us \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> S.combine (map h ?Ks) (map h ?Us) =
                               h (R.combine ?Ks ?Us)\<close>
  notes theorem
    "ring.line_extension_hom" =
      \<open>\<lbrakk>?K \<subseteq> carrier R; ?a \<in> carrier R;
              ?E \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> S.line_extension (h ` ?K) (h ?a) (h ` ?E) =
                               h ` R.line_extension ?K ?a ?E\<close>
  notes theorem
    "ring.Span_hom" =
      \<open>\<lbrakk>?K \<subseteq> carrier R;
              set ?Us \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> S.Span (h ` ?K) (map h ?Us) =
                               h ` R.Span ?K ?Us\<close>
  notes theorem
    "ring.inj_on_subgroup_iff_trivial_ker" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             inj_on h ?H =
             (a_kernel (R\<lparr>carrier := ?H\<rparr>) S h =
              {\<zero>})\<close>
  notes theorem
    "ring.inj_on_Span_iff_trivial_ker" =
      \<open>\<lbrakk>subfield ?K R; set ?Us \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> inj_on h (R.Span ?K ?Us) =
                               (a_kernel
                                 (R\<lparr>carrier := R.Span ?K ?Us\<rparr>)
                                 S h =
                                {\<zero>})\<close>
  notes theorem
    "ring.inj_hom_preserves_independent" =
      \<open>\<lbrakk>subfield ?K R;
              \<one>\<^bsub>S\<^esub> \<noteq> \<zero>\<^bsub>S\<^esub>;
              inj_on h (R.Span ?K ?Us); R.independent ?K ?Us\<rbrakk>
             \<Longrightarrow> S.independent (h ` ?K) (map h ?Us)\<close>
  notes theorem
    "ring.inj_hom_dimension" =
      \<open>\<lbrakk>subfield ?K R;
              \<one>\<^bsub>S\<^esub> \<noteq> \<zero>\<^bsub>S\<^esub>;
              inj_on h ?E; R.dimension ?n ?K ?E\<rbrakk>
             \<Longrightarrow> S.dimension ?n (h ` ?K) (h ` ?E)\<close>
  notes theorem
    "ring.rank_nullity_theorem" =
      \<open>\<lbrakk>subfield ?K R;
              \<one>\<^bsub>S\<^esub> \<noteq> \<zero>\<^bsub>S\<^esub>;
              R.dimension ?n ?K ?E;
              R.dimension ?m ?K
               (a_kernel (R\<lparr>carrier := ?E\<rparr>) S h)\<rbrakk>
             \<Longrightarrow> S.dimension (?n - ?m) (h ` ?K)
                                (h ` ?E)\<close>
  notes theorem
    "ring.img_is_subalgebra" =
      \<open>\<lbrakk>?K \<subseteq> carrier R; subalgebra ?K ?V R\<rbrakk>
             \<Longrightarrow> subalgebra (h ` ?K) (h ` ?V) S\<close>
  notes theorem
    "ring.infinite_dimension_hom" =
      \<open>\<lbrakk>subfield ?K R;
              \<one>\<^bsub>S\<^esub> \<noteq> \<zero>\<^bsub>S\<^esub>;
              inj_on h ?E; subalgebra ?K ?E R;
              R.infinite_dimension ?K ?E\<rbrakk>
             \<Longrightarrow> S.infinite_dimension (h ` ?K)
                                (h ` ?E)\<close>
  notes theorem
    "ring.subfield_polynomial_hom" =
      \<open>\<lbrakk>subfield ?K R;
              \<one>\<^bsub>S\<^esub> \<noteq> \<zero>\<^bsub>S\<^esub>;
              ?p \<in> carrier (?K [X])\<rbrakk>
             \<Longrightarrow> map h ?p
                               \<in> carrier
(h ` ?K [X]\<^bsub>S\<^esub>)\<close>
  notes
    "ring_hom_cring_axioms" = (\<open>ring_hom_cring R S h\<close>)
      ["attribute" "internal"]
  notes "homh" = (\<open>h \<in> ring_hom R S\<close>) ["simp", "HOL.intro"]
  notes
    "hom_closed" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              h ?x \<in> carrier S\<close>)
      ["simp", "HOL.intro"]
  notes
    "hom_mult" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> h (?x \<otimes> ?y) =
                                h ?x \<otimes>\<^bsub>S\<^esub>
                                h ?y\<close>)
      ["simp"]
  notes
    "hom_add" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> h (?x \<oplus> ?y) =
                                h ?x \<oplus>\<^bsub>S\<^esub> h ?y\<close>)
      ["simp"]
  notes
    "hom_one" = (\<open>h \<one> = \<one>\<^bsub>S\<^esub>\<close>) ["simp"]
  notes theorem
    "hom_zero" = (\<open>h \<zero> = \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "hom_a_inv" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              h (\<ominus> ?x) = \<ominus>\<^bsub>S\<^esub> h ?x\<close>)
      ["simp"]
  notes theorem
    "hom_finsum" =
      (\<open>?f \<in> ?A \<rightarrow> carrier R \<Longrightarrow>
              h (finsum R ?f ?A) = finsum S (h \<circ> ?f) ?A\<close>)
      ["simp"]
  notes theorem
    "hom_finprod" =
      \<open>?f \<in> ?A \<rightarrow> carrier R \<Longrightarrow>
             h (finprod R ?f ?A) = finprod S (h \<circ> ?f) ?A\<close>
  notes theorem
    "hom_pow" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              h (?x [^] ?n) = h ?x [^]\<^bsub>S\<^esub> ?n\<close>)
      ["simp"]
  notes theorem
    "hom_sub" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> h (?x \<ominus> ?y) =
                                h ?x \<ominus>\<^bsub>S\<^esub> h
                           ?y\<close>)
      ["simp"]
  notes "P_def" = (\<open>P \<equiv> UP R\<close>) ["attribute" "internal"]
  notes (\<open>P \<equiv> UP R\<close>) ["simp"]
  notes theorem
    "up_eqI" =
      \<open>\<lbrakk>\<And>n. up_ring.coeff P ?p n = up_ring.coeff P ?q n;
              ?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?p = ?q\<close>
  notes theorem
    "coeff_closed" =
      (\<open>?p \<in> carrier P \<Longrightarrow>
              up_ring.coeff P ?p ?n \<in> carrier R\<close>)
      ["simp"]
  notes (\<open>P \<equiv> UP R\<close>) ["simp" del]
  notes theorem
    "eval_on_carrier" =
      \<open>?p \<in> carrier P \<Longrightarrow>
             UnivPoly.eval R ?S ?phi ?s ?p =
             (\<Oplus>\<^bsub>?S\<^esub>i\<in>{..deg R
            ?p}. ?phi (up_ring.coeff P ?p i) \<otimes>\<^bsub>?S\<^esub>
                 ?s [^]\<^bsub>?S\<^esub> i)\<close>
  notes theorem
    "eval_extensional" =
      \<open>UnivPoly.eval R ?S ?phi ?p
             \<in> extensional (carrier P)\<close>
  notes
    "P.add.monoid_axioms" = (\<open>Group.monoid (add_monoid P)\<close>)
