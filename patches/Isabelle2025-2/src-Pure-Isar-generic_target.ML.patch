+        let val thy_ctxt = Proof_Context.init_global (Proof_Context.theory_of lthy1) in
+          thm_def np (name_thm1 np (Light_Locale_Axiom_Facts.light_export lthy1 thy_ctxt th)) lthy1
+          |>> pair (name_thm2 np (Light_Locale_Axiom_Facts.light_export lthy1 lthy1 th))
+        end
+      else
+        thm_definition (np, Goal.norm_result lthy1 th) lthy1
+        |>> apsnd (Exported_Premises.put (Light_Locale_Axiom_Facts.premise_count lthy1));
+    val ((local_facts, global_facts), lthy') = prepare_notes export (flat groups) lthy;
+    val hook_facts =
+      unflat groups global_facts |> map (fn group => (#1 (List.last group), maps #2 group));
