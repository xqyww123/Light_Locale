             \<Longrightarrow> (?a \<oplus> ?b) \<odot>\<^bsub>P\<^esub>
                               ?p =
                               ?a \<odot>\<^bsub>P\<^esub>
                               ?p \<oplus>\<^bsub>P\<^esub>
                               ?b \<odot>\<^bsub>P\<^esub> ?p\<close>
  notes theorem
    "UP_smult_r_distr" =
      \<open>\<lbrakk>?a \<in> carrier R; ?p \<in> carrier P;
              ?q \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<odot>\<^bsub>P\<^esub>
                               (?p \<oplus>\<^bsub>P\<^esub> ?q) =
                               ?a \<odot>\<^bsub>P\<^esub>
                               ?p \<oplus>\<^bsub>P\<^esub>
                               ?a \<odot>\<^bsub>P\<^esub> ?q\<close>
  notes theorem
    "UP_smult_assoc1" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R;
              ?p \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<otimes> ?b \<odot>\<^bsub>P\<^esub> ?p =
                               ?a \<odot>\<^bsub>P\<^esub>
                               (?b \<odot>\<^bsub>P\<^esub> ?p)\<close>
  notes theorem
    "UP_smult_zero" =
      (\<open>?p \<in> carrier P \<Longrightarrow>
              \<zero> \<odot>\<^bsub>P\<^esub> ?p =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "UP_smult_one" =
