diff -ruN a/src/Pure/exported_premises.ML b/src/Pure/exported_premises.ML
--- a/src/Pure/exported_premises.ML	1970-01-01 00:00:00.000000000 +0000
+++ b/src/Pure/exported_premises.ML
@@ -0,0 +1,135 @@
+(*  Title:      Pure/exported_premises.ML
+
+K, the exported-premise count of a theorem: its leading K premises are contextual
+assumptions an export pasted on, recorded in the "exprem" tag.  Pure's own
+transformations on the copying paths keep K themselves, each through the gated writer
+whose precondition it meets; on an untagged theorem the gate returns the
+transformation's stock output itself.  So do Local_Defs.unfold/fold and
+Object_Logic.gen_rulify ([unfolded], [folded], [rule_format]); simplification and the
+kernel's inference rules clear K.  light_export copies K back with Rule_Cases.save.
+Custom export layers (Assumption.add_assms) run under thm_export's single shift, and
+other fact functions (HOL tools, user code) under the fallback in Morphism.morphism;
+both are assumed to meet shift_count's precondition.  Where a transformation does not,
+the user sets K by hand with [exported_premises n] -- in Pure this happens only at prop
+level: an equation that rewrites an implication (a rewrites mixin, an
+[unfolded]/[folded] argument, a declared rulify rule) can delete, merge, split or
+reorder leading premises, and a prop-valued defines heading the conclusion splits
+premises off into K.
+
+The "consumes" primitives of Rule_Cases live here so that get_consumes can default
+to K.
+*)
+
+signature EXPORTED_PREMISES =
+sig
+  val lookup_consumes: thm -> int option
+  val get_consumes: thm -> int
+  val put_consumes: int option -> thm -> thm
+  val exported_premises_tagN: string
+  val count_of: thm -> int
+  val put: int -> thm -> thm
+  val with_count: (int -> thm -> thm -> int) -> thm -> thm -> thm
+  val keep_count: thm -> thm -> thm
+  val keeping_count: (thm -> thm) -> thm -> thm
+  val shift_count: thm -> thm -> thm
+  val restore_counts: thm list -> thm list -> thm list
+  val own_prems: thm -> term list
+  val own_major_prem: thm -> term
+  val strong_consumes: thm -> int
+  val put_major_prem_first: thm -> thm
+end;
+
+structure Exported_Premises: EXPORTED_PREMISES =
+struct
+
+(* tags *)
+
+fun lookup_nat_tag tagN th =
+  (case AList.lookup (op =) (Thm.get_tags th) tagN of
+    NONE => NONE
+  | SOME s =>
+      (case Lexicon.read_nat s of
+        SOME n => SOME n
+      | _ => raise THM ("Malformed '" ^ tagN ^ "' tag of theorem", 0, [th])));
+
+val exported_premises_tagN = "exprem";
+
+val count_of = the_default 0 o lookup_nat_tag exported_premises_tagN;
+
+(*K = 0 removes every entry; otherwise the value changes in place, since
+  Thm.eq_thm_strict compares tags in order*)
+fun set 0 = Thm.untag_rule exported_premises_tagN
+  | set k = Thm.map_tags (Properties.put (exported_premises_tagN, string_of_int k));
+
+(*put k th: K becomes k when 0 < k <= nprems th, otherwise the tag is removed ("unknown");
+  th itself when it already carries that value*)
+fun put k th =
+  let val k' = if 0 < k andalso k <= Thm.nprems_of th then k else 0
+  in if count_of th = k' then th else set k' th end;
+
+(*an untagged th gives th' itself; otherwise th' gets the rule's K through put*)
+fun with_count rule th th' =
+  (case count_of th of
+    0 => th'
+  | k => put (rule k th th') th');
+
+(*th' derived from th by a step that adds, removes or reorders no premise in front of or
+  among the leading K; it may change their content (instantiation, rewriting) and add
+  premises only behind them (a conclusion split off at the end)*)
+val keep_count = with_count (fn k => fn _ => fn _ => k);
+
+(*f th with th's K, for an f that meets keep_count's precondition.  Wrapping the function
+  value keeps whatever f staged before it saw th (a simpset built once per partial application);
+  where stock is a fun clause over a named theorem, or the result comes out of a case branch,
+  the writer is appended instead.*)
+fun keeping_count f th = keep_count th (f th);
+
+(*th' derived from th by a step whose every added or removed premise lies in front: K moves
+  by the difference of the premise counts*)
+val shift_count = with_count (fn k => fn th => fn th' => k + Thm.nprems_of th' - Thm.nprems_of th);
+
+(*wrapped around each fact function of a morphism: an output that lost its input's K gets it
+  back by shift_count (precondition: file head of exported_premises.ML). It cannot tell a
+  lost K from one the function's own rule took to 0, and writes K + the difference there
+  too. One output per input, in input order; when the lengths differ nothing is done
+  (Eisbach's match changes the length).*)
+fun restore_counts ths ths' =
+  if length ths <> length ths' orelse forall (fn th => count_of th = 0) ths then ths'
+  else map2 (fn th => fn th' => if count_of th' > 0 then th' else shift_count th th') ths ths';
+
+val consumes_tagN = "consumes";
+
+val lookup_consumes = lookup_nat_tag consumes_tagN;
+
+(*a rule consumes at least its exported premises*)
+fun get_consumes th = Integer.max (count_of th) (the_default 0 (lookup_consumes th));
+
+fun put_consumes NONE th = th
+  | put_consumes (SOME n) th = th
+      |> Thm.untag_rule consumes_tagN
+      |> Thm.tag_rule (consumes_tagN, string_of_int (if n < 0 then Thm.nprems_of th + n else n));
+
+
+(* the rule's own premises *)
+
+fun own_prems th = drop (count_of th) (Thm.prems_of th);
+
+fun own_major_prem th =
+  (case own_prems th of
+    prem :: _ => Logic.strip_assums_concl prem
+  | [] => Thm.major_prem_of th);
+
+fun strong_consumes th = get_consumes th - count_of th;
+
+
+(* operations on the exported premises *)
+
+(*rotate the first own premise in front of the exported ones; with nothing to rotate the rule
+  is returned as it is, since permute_prems clears the tags*)
+fun put_major_prem_first th =
+  let val k = count_of th and n = Thm.nprems_of th in
+    if k = 0 orelse n = k then th
+    else th |> Thm.permute_prems 0 k |> Thm.permute_prems 1 (n - 1 - k)
+  end;
+
+end;
