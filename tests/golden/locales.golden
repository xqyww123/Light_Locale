             \<Longrightarrow> ?y \<oplus> ?x = \<zero>\<close>
  notes theorem
    "R.add.inv_equality" =
      \<open>\<lbrakk>?y \<oplus> ?x = \<zero>; ?x \<in> carrier R;
              ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> \<ominus> ?x = ?y\<close>
  notes theorem
    "R.add.inv_solve_left" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R;
