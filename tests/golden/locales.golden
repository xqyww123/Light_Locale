  notes theorem
    "S.a_coset_join1" =
      \<open>\<lbrakk>?H +>\<^bsub>S\<^esub> ?x = ?H; ?x \<in> carrier S;
              subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H\<close>
  notes theorem
