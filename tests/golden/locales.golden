             \<Longrightarrow> (\<Oplus>\<^bsub>P\<^esub>k\<in>{..?n +
                            ?m}. \<Oplus>\<^bsub>P\<^esub>i\<in>{..k}. ?f
                                  i \<otimes>\<^bsub>P\<^esub>
                                 ?g (k - i)) =
                               (\<Oplus>\<^bsub>P\<^esub>k\<in>{..?n +
                            ?m}. \<Oplus>\<^bsub>P\<^esub>i\<in>{..?n + ?m -
                             k}. ?f k \<otimes>\<^bsub>P\<^esub>
                                 ?g i)\<close>
  notes theorem
    "P.cauchy_product" =
      \<open>\<lbrakk>bound \<zero>\<^bsub>P\<^esub> ?n ?f;
              bound \<zero>\<^bsub>P\<^esub> ?m ?g;
              ?f \<in> {..?n} \<rightarrow> carrier P;
              ?g \<in> {..?m} \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> (\<Oplus>\<^bsub>P\<^esub>k\<in>{..?n +
