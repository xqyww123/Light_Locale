  notes theorem
    "S.add.one_unique" =
      \<open>\<lbrakk>?u \<in> carrier S;
              \<And>x.
                 x \<in> carrier S \<Longrightarrow>
                 ?u \<oplus>\<^bsub>S\<^esub> x = x\<rbrakk>
             \<Longrightarrow> ?u = \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.add.inv_unique" =
      \<open>\<lbrakk>?y \<oplus>\<^bsub>S\<^esub> ?x =
                      \<zero>\<^bsub>S\<^esub>;
              ?x \<oplus>\<^bsub>S\<^esub> ?y' = \<zero>\<^bsub>S\<^esub>;
              ?x \<in> carrier S; ?y \<in> carrier S;
              ?y' \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "S.add.Units_m_closed" =
