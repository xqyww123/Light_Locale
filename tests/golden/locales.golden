      \<open>\<lbrakk>finite (carrier R); ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> generate (add_monoid R) {?a} =
                               {[k] \<cdot> ?a |k. k \<in> UNIV}\<close>
  notes theorem
    "R.add.ord_elems_inf_carrier" =
