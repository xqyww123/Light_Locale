                      \<ominus>\<^bsub>P\<^esub> ?y =
                      ?M;
              ?x \<in> carrier P; ?y \<in> carrier P;
              ?M \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid P\<^esub> ?x =
