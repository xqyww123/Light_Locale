             \<Longrightarrow> ?a gcdof\<^bsub>P\<^esub> ?a ?b\<close>
  notes theorem
    "P.isgcd_divides_r" =
      \<open>\<lbrakk>?b divides\<^bsub>P\<^esub> ?a; ?a \<in> carrier P;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?b gcdof\<^bsub>P\<^esub> ?a ?b\<close>
  notes theorem
    "P.assoc_subst" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>P\<^esub> ?b;
              \<forall>a b.
                 a \<in> carrier P \<and>
                 b \<in> carrier P \<and>
                 a \<sim>\<^bsub>P\<^esub> b \<longrightarrow>
                 ?f a \<in> carrier P \<and>
                 ?f b \<in> carrier P \<and>
                 ?f a \<sim>\<^bsub>P\<^esub> ?f b;
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?f ?a \<sim>\<^bsub>P\<^esub> ?f ?b\<close>
