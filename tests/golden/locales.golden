              ?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> [?n] \<cdot>\<^bsub>S\<^esub> (?x \<oplus>\<^bsub>S\<^esub>
                        ?y) =
                               [?n] \<cdot>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub>
                               [?n] \<cdot>\<^bsub>S\<^esub> ?y\<close>
