              ?x \<otimes>\<^bsub>P\<^esub> ?y' = \<one>\<^bsub>P\<^esub>;
              ?x \<in> carrier P; ?y \<in> carrier P;
              ?y' \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "P.Units_m_closed" =
      (\<open>\<lbrakk>?x \<in> Units P; ?y \<in> Units P\<rbrakk>
              \<Longrightarrow> ?x \<otimes>\<^bsub>P\<^esub> ?y
                                \<in> Units P\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "P.Units_one_closed" =
      (\<open>\<one>\<^bsub>P\<^esub> \<in> Units P\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.Units_inv_closed" =
      (\<open>?x \<in> Units P \<Longrightarrow>
              inv\<^bsub>P\<^esub> ?x \<in> carrier P\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.Units_l_inv_ex" =
      \<open>?x \<in> Units P \<Longrightarrow>
             \<exists>y\<in>carrier P.
                y \<otimes>\<^bsub>P\<^esub> ?x =
                \<one>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.Units_r_inv_ex" =
      \<open>?x \<in> Units P \<Longrightarrow>
             \<exists>y\<in>carrier P.
                ?x \<otimes>\<^bsub>P\<^esub> y =
                \<one>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.Units_l_inv" =
      (\<open>?x \<in> Units P \<Longrightarrow>
              inv\<^bsub>P\<^esub> ?x \<otimes>\<^bsub>P\<^esub> ?x =
              \<one>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.Units_r_inv" =
      (\<open>?x \<in> Units P \<Longrightarrow>
              ?x \<otimes>\<^bsub>P\<^esub> inv\<^bsub>P\<^esub> ?x =
              \<one>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.inv_one" =
      (\<open>inv\<^bsub>P\<^esub> \<one>\<^bsub>P\<^esub> =
              \<one>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.Units_inv_Units" =
      (\<open>?x \<in> Units P \<Longrightarrow>
              inv\<^bsub>P\<^esub> ?x \<in> Units P\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.Units_l_cancel" =
      (\<open>\<lbrakk>?x \<in> Units P; ?y \<in> carrier P;
               ?z \<in> carrier P\<rbrakk>
              \<Longrightarrow> (?x \<otimes>\<^bsub>P\<^esub> ?y =
                                 ?x \<otimes>\<^bsub>P\<^esub> ?z) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "P.Units_inv_inv" =
      (\<open>?x \<in> Units P \<Longrightarrow>
              inv\<^bsub>P\<^esub> (inv\<^bsub>P\<^esub> ?x) = ?x\<close>)
      ["simp"]
  notes theorem
    "P.inv_inj_on_Units" = \<open>inj_on (m_inv P) (Units P)\<close>
  notes theorem
    "P.Units_inv_comm" =
      \<open>\<lbrakk>?x \<otimes>\<^bsub>P\<^esub> ?y =
                      \<one>\<^bsub>P\<^esub>;
              ?x \<in> Units P; ?y \<in> Units P\<rbrakk>
             \<Longrightarrow> ?y \<otimes>\<^bsub>P\<^esub> ?x =
                               \<one>\<^bsub>P\<^esub>\<close>
  notes theorem "P.carrier_not_empty" = \<open>carrier P \<noteq> {}\<close>
  notes theorem
    "P.group_l_invI" =
      \<open>(\<And>x.
                 x \<in> carrier P \<Longrightarrow>
                 \<exists>y\<in>carrier P.
                    y \<otimes>\<^bsub>P\<^esub> x =
                    \<one>\<^bsub>P\<^esub>) \<Longrightarrow>
             Group.group P\<close>
  notes theorem
    "P.nat_pow_closed" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              ?x [^]\<^bsub>P\<^esub> ?n \<in> carrier P\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.nat_pow_0" =
      (\<open>?x [^]\<^bsub>P\<^esub> 0 = \<one>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.nat_pow_Suc" =
      (\<open>?x [^]\<^bsub>P\<^esub> Suc ?n =
              ?x [^]\<^bsub>P\<^esub> ?n \<otimes>\<^bsub>P\<^esub>
              ?x\<close>)
      ["simp"]
  notes theorem
    "P.nat_pow_one" =
      (\<open>\<one>\<^bsub>P\<^esub> [^]\<^bsub>P\<^esub> ?n =
              \<one>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.nat_pow_mult" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             ?x [^]\<^bsub>P\<^esub> ?n \<otimes>\<^bsub>P\<^esub>
             ?x [^]\<^bsub>P\<^esub> ?m =
             ?x [^]\<^bsub>P\<^esub> (?n + ?m)\<close>
  notes theorem
    "P.nat_pow_comm" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             ?x [^]\<^bsub>P\<^esub> ?n \<otimes>\<^bsub>P\<^esub>
             ?x [^]\<^bsub>P\<^esub> ?m =
             ?x [^]\<^bsub>P\<^esub> ?m \<otimes>\<^bsub>P\<^esub>
             ?x [^]\<^bsub>P\<^esub> ?n\<close>
  notes theorem
    "P.nat_pow_Suc2" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             ?x [^]\<^bsub>P\<^esub> Suc ?n =
             ?x \<otimes>\<^bsub>P\<^esub>
             ?x [^]\<^bsub>P\<^esub> ?n\<close>
  notes theorem
    "P.nat_pow_pow" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             (?x [^]\<^bsub>P\<^esub> ?n) [^]\<^bsub>P\<^esub> ?m =
             ?x [^]\<^bsub>P\<^esub> (?n * ?m)\<close>
  notes theorem
    "P.nat_pow_consistent" =
      \<open>?x [^]\<^bsub>P\<^esub> ?n =
             ?x [^]\<^bsub>P\<lparr>carrier := ?H\<rparr>\<^esub> ?n\<close>
  notes theorem
    "P.group_commutes_pow" =
      \<open>\<lbrakk>?x \<otimes>\<^bsub>P\<^esub> ?y =
                      ?y \<otimes>\<^bsub>P\<^esub> ?x;
              ?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x [^]\<^bsub>P\<^esub>
                               ?n \<otimes>\<^bsub>P\<^esub>
                               ?y =
                               ?y \<otimes>\<^bsub>P\<^esub>
                               ?x [^]\<^bsub>P\<^esub> ?n\<close>
  notes theorem
    "P.pow_mult_distrib" =
      \<open>\<lbrakk>?x \<otimes>\<^bsub>P\<^esub> ?y =
                      ?y \<otimes>\<^bsub>P\<^esub> ?x;
              ?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> (?x \<otimes>\<^bsub>P\<^esub>
                                ?y) [^]\<^bsub>P\<^esub>
                               ?n =
                               ?x [^]\<^bsub>P\<^esub>
                               ?n \<otimes>\<^bsub>P\<^esub>
                               ?y [^]\<^bsub>P\<^esub> ?n\<close>
  notes theorem
    "P.monoid_incl_imp_submonoid" =
      \<open>\<lbrakk>?H \<subseteq> carrier P;
              Group.monoid (P\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> submonoid ?H P\<close>
  notes theorem
    "P.inv_unique'" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?x \<otimes>\<^bsub>P\<^esub> ?y = \<one>\<^bsub>P\<^esub>;
              ?y \<otimes>\<^bsub>P\<^esub> ?x =
              \<one>\<^bsub>P\<^esub>\<rbrakk>
             \<Longrightarrow> ?y = inv\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.m_inv_monoid_consistent" =
      \<open>\<lbrakk>?x \<in> Units (P\<lparr>carrier := ?H\<rparr>);
              submonoid ?H P\<rbrakk>
             \<Longrightarrow> inv\<^bsub>P\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                               inv\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.hom_imp_img_monoid" =
      \<open>?h \<in> hom P ?H \<Longrightarrow>
             Group.monoid
              (?H\<lparr>carrier := ?h ` carrier P,
                    one := ?h \<one>\<^bsub>P\<^esub>\<rparr>)\<close>
  notes theorem
    "P.monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier P; y \<in> carrier P\<rbrakk>
                 \<Longrightarrow> x \<otimes>\<^bsub>P\<^esub> y =
                                   y \<otimes>\<^bsub>P\<^esub>
                                   x) \<Longrightarrow>
             Group.comm_monoid P\<close>
  notes theorem "P.units_group" = \<open>Group.group (units_of P)\<close>
  notes theorem
    "P.units_of_inv" =
      \<open>?x \<in> Units P \<Longrightarrow>
             inv\<^bsub>units_of P\<^esub> ?x =
             inv\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.set_mult_closed" =
      \<open>\<lbrakk>?H \<subseteq> carrier P;
              ?K \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>P\<^esub> ?K
                               \<subseteq> carrier P\<close>
  notes theorem
    "P.r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>P\<^esub> ?x
                               \<subseteq> carrier P\<close>
  notes theorem
    "P.order_gt_0_iff_finite" =
      \<open>(0 < Coset.order P) = finite (carrier P)\<close>
  notes theorem
    "P.units_of_pow" =
      \<open>?x \<in> Units P \<Longrightarrow>
             ?x [^]\<^bsub>units_of P\<^esub> ?n =
             ?x [^]\<^bsub>P\<^esub> ?n\<close>
  notes theorem
    "P.inv_char" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?x \<otimes>\<^bsub>P\<^esub> ?y = \<one>\<^bsub>P\<^esub>;
              ?y \<otimes>\<^bsub>P\<^esub> ?x =
              \<one>\<^bsub>P\<^esub>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>P\<^esub> ?x = ?y\<close>
  notes theorem
    "P.inv_eq_imp_eq" =
      (\<open>\<lbrakk>inv\<^bsub>P\<^esub> ?x = inv\<^bsub>P\<^esub> ?y;
               ?x \<in> Units P; ?y \<in> Units P\<rbrakk>
              \<Longrightarrow> ?x = ?y\<close>)
      ["HOL.dest" !]
  notes theorem
    "P.inv_eq_one_eq" =
      \<open>?x \<in> Units P \<Longrightarrow>
             (inv\<^bsub>P\<^esub> ?x = \<one>\<^bsub>P\<^esub>) =
             (?x = \<one>\<^bsub>P\<^esub>)\<close>
  notes theorem
    "P.monoid_cancelI" =
      \<open>\<lbrakk>\<And>a b c.
                         \<lbrakk>c \<otimes>\<^bsub>P\<^esub> a =
                                  c \<otimes>\<^bsub>P\<^esub> b;
                          a \<in> carrier P; b \<in> carrier P;
                          c \<in> carrier P\<rbrakk>
                         \<Longrightarrow> a = b;
              \<And>a b c.
                 \<lbrakk>a \<otimes>\<^bsub>P\<^esub> c =
                          b \<otimes>\<^bsub>P\<^esub> c;
                  a \<in> carrier P; b \<in> carrier P;
                  c \<in> carrier P\<rbrakk>
                 \<Longrightarrow> a = b\<rbrakk>
             \<Longrightarrow> monoid_cancel P\<close>
  notes theorem
    "P.prod_unit_l" =
      \<open>\<lbrakk>?a \<otimes>\<^bsub>P\<^esub> ?b \<in> Units P;
              ?a \<in> Units P; ?a \<in> carrier P;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?b \<in> Units P\<close>
  notes theorem
    "P.prod_unit_r" =
      \<open>\<lbrakk>?a \<otimes>\<^bsub>P\<^esub> ?b \<in> Units P;
              ?b \<in> Units P; ?a \<in> carrier P;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<in> Units P\<close>
  notes theorem
    "P.divides_refl" =
      (\<open>?a \<in> carrier P \<Longrightarrow>
              ?a divides\<^bsub>P\<^esub> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "P.divides_trans" =
      (\<open>\<lbrakk>?a divides\<^bsub>P\<^esub> ?b;
               ?b divides\<^bsub>P\<^esub> ?c; ?a \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?a divides\<^bsub>P\<^esub> ?c\<close>)
      ["trans"]
  notes theorem
    "P.divides_mult_lI" =
      (\<open>\<lbrakk>?a divides\<^bsub>P\<^esub> ?b; ?a \<in> carrier P;
               ?c \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?c \<otimes>\<^bsub>P\<^esub>
                                ?a divides\<^bsub>P\<^esub>
                                ?c \<otimes>\<^bsub>P\<^esub> ?b\<close>)
      ["HOL.intro"]
  notes theorem
    "P.divides_prod_r" =
      \<open>\<lbrakk>?a divides\<^bsub>P\<^esub> ?b; ?a \<in> carrier P;
              ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>P\<^esub>
                               ?b \<otimes>\<^bsub>P\<^esub> ?c\<close>
  notes theorem
    "P.unit_divides" =
      \<open>\<lbrakk>?u \<in> Units P; ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?u divides\<^bsub>P\<^esub> ?a\<close>
  notes theorem
    "P.associatedI2" =
      \<open>\<lbrakk>?u \<in> Units P;
              ?a = ?b \<otimes>\<^bsub>P\<^esub> ?u;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.associatedI2'" =
      \<open>\<lbrakk>?a = ?b \<otimes>\<^bsub>P\<^esub> ?u;
              ?u \<in> Units P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.associated_refl" =
      (\<open>?a \<in> carrier P \<Longrightarrow>
              ?a \<sim>\<^bsub>P\<^esub> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "P.associated_sym" =
      (\<open>?a \<sim>\<^bsub>P\<^esub> ?b \<Longrightarrow>
              ?b \<sim>\<^bsub>P\<^esub> ?a\<close>)
      ["sym"]
  notes theorem
    "P.associated_trans" =
      (\<open>\<lbrakk>?a \<sim>\<^bsub>P\<^esub> ?b;
               ?b \<sim>\<^bsub>P\<^esub> ?c; ?a \<in> carrier P;
               ?c \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?a \<sim>\<^bsub>P\<^esub> ?c\<close>)
      ["trans"]
  notes theorem
    "P.division_equiv" = (\<open>equivalence (division_rel P)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.divides_cong_l" =
      (\<open>\<lbrakk>?x \<sim>\<^bsub>P\<^esub> ?x';
               ?x' divides\<^bsub>P\<^esub> ?y; ?x \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?x divides\<^bsub>P\<^esub> ?y\<close>)
      ["trans"]
  notes theorem
    "P.divides_cong_r" =
      (\<open>\<lbrakk>?x divides\<^bsub>P\<^esub> ?y;
               ?y \<sim>\<^bsub>P\<^esub> ?y'; ?x \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?x divides\<^bsub>P\<^esub> ?y'\<close>)
      ["trans"]
  notes theorem
    "P.division_weak_partial_order" =
      (\<open>weak_partial_order (division_rel P)\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "P.mult_cong_r" =
      \<open>\<lbrakk>?b \<sim>\<^bsub>P\<^esub> ?b'; ?a \<in> carrier P;
              ?b \<in> carrier P; ?b' \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<otimes>\<^bsub>P\<^esub>
                               ?b \<sim>\<^bsub>P\<^esub>
                               ?a \<otimes>\<^bsub>P\<^esub> ?b'\<close>
  notes theorem
    "P.Units_assoc" =
      \<open>\<lbrakk>?a \<in> Units P; ?b \<in> Units P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.Units_are_ones" =
      \<open>Units P {.=}\<^bsub>division_rel P\<^esub>
             {\<one>\<^bsub>P\<^esub>}\<close>
  notes theorem
    "P.properfactor_unitE" =
      \<open>\<lbrakk>?u \<in> Units P; properfactor P ?a ?u;
              ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "P.properfactor_divides" =
      \<open>properfactor P ?a ?b \<Longrightarrow>
             ?a divides\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.properfactor_trans1" =
      (\<open>\<lbrakk>?a divides\<^bsub>P\<^esub> ?b; properfactor P ?b ?c;
               ?a \<in> carrier P; ?c \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor P ?a ?c\<close>)
      ["trans"]
  notes theorem
    "P.properfactor_trans2" =
      (\<open>\<lbrakk>properfactor P ?a ?b; ?b divides\<^bsub>P\<^esub> ?c;
               ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor P ?a ?c\<close>)
      ["trans"]
  notes theorem
    "P.properfactor_cong_l" =
      (\<open>\<lbrakk>?x' \<sim>\<^bsub>P\<^esub> ?x; properfactor P ?x ?y;
               ?x \<in> carrier P; ?x' \<in> carrier P;
               ?y \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor P ?x' ?y\<close>)
      ["trans"]
  notes theorem
    "P.properfactor_cong_r" =
      (\<open>\<lbrakk>properfactor P ?x ?y; ?y \<sim>\<^bsub>P\<^esub> ?y';
               ?x \<in> carrier P; ?y \<in> carrier P;
               ?y' \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor P ?x ?y'\<close>)
      ["trans"]
  notes theorem
    "P.properfactor_prod_r" =
      \<open>\<lbrakk>properfactor P ?a ?b; ?a \<in> carrier P;
              ?b \<in> carrier P; ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> properfactor P ?a
                                (?b \<otimes>\<^bsub>P\<^esub> ?c)\<close>
  notes theorem
    "P.irreducible_prod_rI" =
      \<open>\<lbrakk>Divisibility.irreducible P ?a; ?b \<in> Units P;
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible P
                                (?a \<otimes>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.listassoc_refl" =
      (\<open>set ?as \<subseteq> carrier P \<Longrightarrow>
              ?as [\<sim>]\<^bsub>P\<^esub> ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "P.listassoc_sym" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>P\<^esub> ?bs;
               set ?as \<subseteq> carrier P;
               set ?bs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> ?bs [\<sim>]\<^bsub>P\<^esub> ?as\<close>)
      ["sym"]
  notes theorem
    "P.listassoc_trans" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>P\<^esub> ?bs;
               ?bs [\<sim>]\<^bsub>P\<^esub> ?cs;
               set ?as \<subseteq> carrier P; set ?bs \<subseteq> carrier P;
               set ?cs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> ?as [\<sim>]\<^bsub>P\<^esub> ?cs\<close>)
      ["trans"]
  notes theorem
    "P.perm_assoc_switch" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>P\<^esub> ?bs;
              mset ?bs = mset ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  mset ?as = mset bs' \<and>
                                  bs' [\<sim>]\<^bsub>P\<^esub> ?cs\<close>
  notes theorem
    "P.perm_assoc_switch_r" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              ?bs [\<sim>]\<^bsub>P\<^esub> ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  ?as [\<sim>]\<^bsub>P\<^esub> bs' \<and>
                                  mset bs' = mset ?cs\<close>
  notes theorem
    "P.perm_closed" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> set ?bs \<subseteq> carrier P\<close>
  notes theorem
    "P.irrlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              \<forall>a\<in>set ?as. Divisibility.irreducible P a\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible P a\<close>
  notes theorem
    "P.essentially_equalI" =
      \<open>\<lbrakk>mset ?fs1.0 = mset ?fs1';
              ?fs1' [\<sim>]\<^bsub>P\<^esub> ?fs2.0\<rbrakk>
             \<Longrightarrow> essentially_equal P ?fs1.0 ?fs2.0\<close>
  notes theorem
    "P.essentially_equalE" =
      \<open>\<lbrakk>essentially_equal P ?fs1.0 ?fs2.0;
              \<And>fs1'.
                 \<lbrakk>mset ?fs1.0 = mset fs1';
                  fs1' [\<sim>]\<^bsub>P\<^esub> ?fs2.0\<rbrakk>
                 \<Longrightarrow> ?P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "P.ee_refl" =
      (\<open>set ?as \<subseteq> carrier P \<Longrightarrow>
              essentially_equal P ?as ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "P.ee_sym" =
      (\<open>\<lbrakk>essentially_equal P ?as ?bs;
               set ?as \<subseteq> carrier P;
               set ?bs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> essentially_equal P ?bs ?as\<close>)
      ["sym"]
  notes theorem
    "P.ee_trans" =
      (\<open>\<lbrakk>essentially_equal P ?as ?bs;
               essentially_equal P ?bs ?cs; set ?as \<subseteq> carrier P;
               set ?bs \<subseteq> carrier P;
               set ?cs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> essentially_equal P ?as ?cs\<close>)
      ["trans"]
  notes theorem
    "P.multlist_closed" =
      (\<open>set ?fs \<subseteq> carrier P \<Longrightarrow>
              foldr (\<otimes>\<^bsub>P\<^esub>) ?fs \<one>\<^bsub>P\<^esub>
              \<in> carrier P\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "P.factorsI" =
      \<open>\<lbrakk>\<forall>f\<in>set ?fs. Divisibility.irreducible P f;
              foldr (\<otimes>\<^bsub>P\<^esub>) ?fs
               \<one>\<^bsub>P\<^esub> =
              ?a\<rbrakk>
             \<Longrightarrow> factors P ?fs ?a\<close>
  notes theorem
    "P.factors_wfactors" =
      \<open>\<lbrakk>factors P ?as ?a;
              set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> wfactors P ?as ?a\<close>
  notes theorem
    "P.wfactors_factors" =
      \<open>\<lbrakk>wfactors P ?as ?a;
              set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> \<exists>a'.
                                  factors P ?as a' \<and>
                                  a' \<sim>\<^bsub>P\<^esub> ?a\<close>
  notes theorem
    "P.factors_closed" =
      (\<open>\<lbrakk>factors P ?fs ?a;
               set ?fs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> ?a \<in> carrier P\<close>)
      ["HOL.dest"]
  notes theorem
    "P.nunit_factors" =
      \<open>\<lbrakk>?a \<notin> Units P; factors P ?as ?a\<rbrakk>
             \<Longrightarrow> 0 < length ?as\<close>
  notes theorem
    "P.unit_wfactors" =
      (\<open>?a \<in> Units P \<Longrightarrow> wfactors P [] ?a\<close>)
      ["simp"]
  notes theorem
    "P.wfactors_cong_r" =
      (\<open>\<lbrakk>wfactors P ?fs ?a; ?a \<sim>\<^bsub>P\<^esub> ?a';
               ?a \<in> carrier P; ?a' \<in> carrier P;
               set ?fs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> wfactors P ?fs ?a'\<close>)
      ["trans"]
  notes theorem
    "P.wfactors_prod_exists" =
      (\<open>\<lbrakk>\<forall>a\<in>set ?as. Divisibility.irreducible P a;
               set ?as \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> \<exists>a.
                                   a \<in> carrier P \<and>
                                   wfactors P ?as a\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.factors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible P ?a; factors P ?fb ?b;
              ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> factors P (?a # ?fb)
                                (?a \<otimes>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.factors_mult" =
      \<open>\<lbrakk>factors P ?fa ?a; factors P ?fb ?b;
              set ?fa \<subseteq> carrier P;
              set ?fb \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> factors P (?fa @ ?fb)
