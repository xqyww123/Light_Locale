              ?thesis\<close>)
      ["consumes" - 1, "case_names" "1"]
  notes theorem
    "ord_le_group_order" =
      \<open>\<lbrakk>finite (carrier G); ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> ord ?a \<le> Coset.order G\<close>
  notes theorem
    "ord_pow_gen" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ord (?x [^] ?k) =
             (if ?k = 0 then 1 else ord ?x div gcd (ord ?x) ?k)\<close>
  notes theorem
    "pow_ord_eq_ord_iff" =
      \<open>\<lbrakk>finite (carrier G); ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> (ord (?a [^] ?k) = ord ?a) =
                               coprime ?k (ord ?a)\<close>
  notes theorem
    "element_generates_subgroup" =
      \<open>\<lbrakk>finite (carrier G); ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> subgroup
                                {?a [^] i |i. i \<in> {0..ord ?a - 1}}
                                G\<close>
  notes theorem
    "id_in_auto" = \<open>(\<lambda>x\<in>carrier G. x) \<in> auto G\<close>
  notes theorem
    "mult_funcset" =
