             \<Longrightarrow> ?M #>\<^bsub>add_monoid P\<^esub>
                               ?g #>\<^bsub>add_monoid P\<^esub>
                               ?h =
                               ?M #>\<^bsub>add_monoid P\<^esub>
                               ?g \<oplus>\<^bsub>P\<^esub> ?h\<close>
  notes theorem
    "P.add.coset_assoc" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
