(* The test sessions of the light locale component (plan section 7), kept out of the component's
   own ROOT: build them with an extra "-d contrib/light_locale/tests".  Light_Locale_Base's parent
   is Light_Locale_Golden, so building the tests runs the golden comparison first.  Each session
   has its own directory (sessions.scala:908-924 rejects a shared one). *)

session Light_Locale_Golden in "Golden" = "HOL-Algebra" +
  description "
    Plan section 7 test 1 (invariance): reference output of stock Isabelle.  Run on light's stock
    tree (ISABELLE_IDENTIFIER ends with -light_locale-stock) it records tests/golden/*.golden; run
    anywhere else it compares byte for byte.
  "
  theories
    Golden_Facts
    Golden_Transfer
    Golden_Structures

session Light_Locale_Base in "Base" = Light_Locale_Golden +
  description "
    Plan section 7: the test fixtures -- the gate fixture LF with its heavy twin D, the auxiliary
    pair LM/DM.  No global declarations.
  "
  sessions Light_Locale
  theories
    Light_Locale_Base
    Base_Split
    Base_Downstream_Simp
    Base_Elim_Bang
    Base_Dest_Bang
    Base_Intro_Bang

