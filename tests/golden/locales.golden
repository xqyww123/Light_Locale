              ?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> [?n] \<cdot>\<^bsub>P\<^esub> (?x \<oplus>\<^bsub>P\<^esub>
                        ?y) =
                               [?n] \<cdot>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
