  notes theorem
    "add.iso_imp_comm_group" =
      \<open>\<lbrakk>add_monoid R \<cong> ?H; Group.monoid ?H\<rbrakk>
             \<Longrightarrow> comm_group ?H\<close>
  notes theorem
    "add.subgroup_imp_normal" =
      \<open>subgroup ?A (add_monoid R) \<Longrightarrow>
             ?A \<lhd> add_monoid R\<close>
  notes theorem
    "add.mult_subgroups" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              subgroup ?K (add_monoid R)\<rbrakk>
             \<Longrightarrow> subgroup
                                (?H <#>\<^bsub>add_monoid R\<^esub> ?K)
                                (add_monoid R)\<close>
  notes theorem
    "add.normal_iff_subgroup" =
      \<open>?N \<lhd> add_monoid R = subgroup ?N (add_monoid R)\<close>
  notes theorem
    "add.set_mult_commute" =
      \<open>\<lbrakk>?N \<subseteq> carrier R;
              ?x \<in> rcosets\<^bsub>add_monoid R\<^esub> ?N;
              ?y \<in> rcosets\<^bsub>add_monoid R\<^esub> ?N\<rbrakk>
             \<Longrightarrow> ?x <#>\<^bsub>add_monoid R\<^esub> ?y =
                               ?y <#>\<^bsub>add_monoid R\<^esub> ?x\<close>
  notes theorem
    "add.abelian_FactGroup" =
      \<open>subgroup ?N (add_monoid R) \<Longrightarrow>
             comm_group (add_monoid R Mod ?N)\<close>
  notes theorem
    "add.power_order_eq_one" =
      \<open>\<lbrakk>finite (carrier R); ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> [card (carrier R)] \<cdot> ?a =
                               \<zero>\<close>
  notes theorem
    "add.derived_eq_singleton" =
      \<open>?H \<subseteq> carrier R \<Longrightarrow>
             derived (add_monoid R) ?H = {\<zero>}\<close>
  notes theorem
    "add.abelian_ord_mul_divides" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> add.ord (?x \<oplus> ?y) dvd
                               add.ord ?x * add.ord ?y\<close>
  notes theorem
    "add.hom_group_sum" =
      \<open>\<lbrakk>\<And>i.
                         i \<in> ?I \<Longrightarrow>
                         ?f i \<in> hom (?A i) (add_monoid R);
              \<And>i.
                 i \<in> ?I \<Longrightarrow> Group.group (?A i)\<rbrakk>
             \<Longrightarrow> (\<lambda>x.
                                   gfinprod (add_monoid R)
                                    (\<lambda>i. ?f i (x i)) ?I)
                               \<in> hom (sum_group ?I ?A)
(add_monoid R)\<close>
  notes theorem
    "add.free_Abelian_group_universal" =
      (\<open>\<lbrakk>?f ` ?S \<subseteq> carrier R;
               \<And>h.
                  \<lbrakk>h \<in> hom (free_Abelian_group ?S)
                                    (add_monoid R);
                   \<And>x.
                      x \<in> ?S \<Longrightarrow>
                      h (frag_of x) = ?f x\<rbrakk>
                  \<Longrightarrow> ?thesis\<rbrakk>
              \<Longrightarrow> ?thesis\<close>)
      ["consumes" - 1, "case_names" "1"]
  notes theorem
    "add.eqpoll_homomorphisms_from_free_Abelian_group" =
      \<open>{f \<in> extensional (carrier (free_Abelian_group ?S)).
              f \<in> hom (free_Abelian_group ?S) (add_monoid R)} \<approx>
             ?S \<rightarrow>\<^sub>E carrier R\<close>
  notes
    "abelian_group_axioms" = (\<open>abelian_group R\<close>)
      ["attribute" "internal"]
  notes "a_comm_group" = \<open>comm_group (add_monoid R)\<close>
  notes theorem "a_group" = \<open>Group.group (add_monoid R)\<close>
  notes theorem
    "a_inv_closed" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             \<ominus> ?x \<in> carrier R\<close>
  notes theorem
    "minus_closed" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<ominus> ?y \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "l_neg" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<ominus> ?x \<oplus> ?x = \<zero>\<close>)
      ["simp" del]
  notes theorem
    "r_neg" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              ?x \<oplus> \<ominus> ?x = \<zero>\<close>)
      ["simp" del]
  notes theorem
    "minus_minus" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             \<ominus> (\<ominus> ?x) = ?x\<close>
  notes theorem "a_inv_inj" = \<open>inj_on (a_inv R) (carrier R)\<close>
  notes theorem
    "minus_equality" =
      \<open>\<lbrakk>?y \<oplus> ?x = \<zero>; ?x \<in> carrier R;
