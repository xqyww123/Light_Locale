                                 \<lparr>carrier :=
     ?N <#>\<^bsub>add_monoid S\<^esub> ?H\<rparr>)\<close>
  notes theorem
    "S.add.normal_in_normal_set_mult" =
      \<open>\<lbrakk>?N \<lhd> add_monoid S;
              subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?N \<lhd>
                               add_monoid S
                               \<lparr>carrier :=
   ?N <#>\<^bsub>add_monoid S\<^esub> ?H\<rparr>\<close>
  notes theorem
    "S.add.weak_snd_iso_thme" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              ?N \<lhd> add_monoid S\<rbrakk>
             \<Longrightarrow> add_monoid S
                               \<lparr>carrier :=
   ?N <#>\<^bsub>add_monoid S\<^esub> ?H\<rparr> Mod
                               ?N \<cong>
                               add_monoid S\<lparr>carrier := ?H\<rparr> Mod
                               ?N \<inter> ?H\<close>
  notes theorem
    "S.add.snd_iso_thme" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              subgroup ?N (add_monoid S);
              subgroup ?H
               (add_monoid S
                \<lparr>carrier :=
                          normalizer (add_monoid S) ?N\<rparr>)\<rbrakk>
             \<Longrightarrow> add_monoid S
                               \<lparr>carrier :=
   ?N <#>\<^bsub>add_monoid S\<^esub> ?H\<rparr> Mod
                               ?N \<cong>
                               add_monoid S\<lparr>carrier := ?H\<rparr> Mod
                               ?H \<inter> ?N\<close>
  notes theorem
    "S.add.snd_iso_thme_recip" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              subgroup ?N (add_monoid S);
              subgroup ?H
               (add_monoid S
                \<lparr>carrier :=
                          normalizer (add_monoid S) ?N\<rparr>)\<rbrakk>
             \<Longrightarrow> add_monoid S
                               \<lparr>carrier :=
   ?H <#>\<^bsub>add_monoid S\<^esub> ?N\<rparr> Mod
                               ?N \<cong>
                               add_monoid S\<lparr>carrier := ?H\<rparr> Mod
                               ?H \<inter> ?N\<close>
  notes theorem
    "S.add.distinc" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              ?H1.0 \<lhd> add_monoid S\<lparr>carrier := ?H\<rparr>;
              subgroup ?K (add_monoid S);
              ?K1.0 \<lhd>
              add_monoid S\<lparr>carrier := ?K\<rparr>\<rbrakk>
             \<Longrightarrow> subgroup (?H \<inter> ?K)
                                (add_monoid S
                                 \<lparr>carrier :=
     normalizer (add_monoid S)
      (?H1.0 <#>\<^bsub>add_monoid S\<^esub>
       ?H \<inter> ?K1.0)\<rparr>)\<close>
  notes theorem
    "S.add.preliminary1" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              ?H1.0 \<lhd> add_monoid S\<lparr>carrier := ?H\<rparr>;
              subgroup ?K (add_monoid S);
              ?K1.0 \<lhd>
              add_monoid S\<lparr>carrier := ?K\<rparr>\<rbrakk>
             \<Longrightarrow> ?H \<inter> ?K \<inter>
                               (?H1.0 <#>\<^bsub>add_monoid S\<^esub>
                                ?H \<inter> ?K1.0) =
                               ?H1.0 \<inter>
                               ?K <#>\<^bsub>add_monoid S\<^esub>
                               ?H \<inter> ?K1.0\<close>
  notes theorem
    "S.add.preliminary2" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              ?H1.0 \<lhd> add_monoid S\<lparr>carrier := ?H\<rparr>;
              subgroup ?K (add_monoid S);
              ?K1.0 \<lhd>
              add_monoid S\<lparr>carrier := ?K\<rparr>\<rbrakk>
             \<Longrightarrow> ?H1.0 <#>\<^bsub>add_monoid S\<^esub>
                               ?H \<inter> ?K1.0 \<lhd>
                               add_monoid S
                               \<lparr>carrier :=
   ?H1.0 <#>\<^bsub>add_monoid S\<^esub> ?H \<inter> ?K\<rparr>\<close>
  notes theorem
    "S.add.Zassenhaus_1" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              ?H1.0 \<lhd> add_monoid S\<lparr>carrier := ?H\<rparr>;
              subgroup ?K (add_monoid S);
              ?K1.0 \<lhd>
              add_monoid S\<lparr>carrier := ?K\<rparr>\<rbrakk>
             \<Longrightarrow> add_monoid S
                               \<lparr>carrier :=
   ?H1.0 <#>\<^bsub>add_monoid S\<^esub> ?H \<inter> ?K\<rparr> Mod
                               (?H1.0 <#>\<^bsub>add_monoid S\<^esub>
                                ?H \<inter> ?K1.0) \<cong>
                               add_monoid S
                               \<lparr>carrier := ?H \<inter> ?K\<rparr> Mod
                               (?H1.0 \<inter>
                                ?K <#>\<^bsub>add_monoid S\<^esub>
                                ?H \<inter> ?K1.0)\<close>
  notes theorem
    "S.add.Zassenhaus" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              ?H1.0 \<lhd> add_monoid S\<lparr>carrier := ?H\<rparr>;
              subgroup ?K (add_monoid S);
              ?K1.0 \<lhd>
              add_monoid S\<lparr>carrier := ?K\<rparr>\<rbrakk>
             \<Longrightarrow> add_monoid S
                               \<lparr>carrier :=
   ?H1.0 <#>\<^bsub>add_monoid S\<^esub> ?H \<inter> ?K\<rparr> Mod
                               (?H1.0 <#>\<^bsub>add_monoid S\<^esub>
                                ?H \<inter> ?K1.0) \<cong>
                               add_monoid S
                               \<lparr>carrier :=
   ?K1.0 <#>\<^bsub>add_monoid S\<^esub> ?H \<inter> ?K\<rparr> Mod
                               (?K1.0 <#>\<^bsub>add_monoid S\<^esub>
                                ?K \<inter> ?H1.0)\<close>
  notes theorem
    "S.add.solvable_imp_subgroup" =
      \<open>solvable_seq (add_monoid S) ?H \<Longrightarrow>
             subgroup ?H (add_monoid S)\<close>
  notes theorem
    "S.add.augment_solvable_seq" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              solvable_seq (add_monoid S)
               (derived (add_monoid S) ?H)\<rbrakk>
             \<Longrightarrow> solvable_seq (add_monoid S) ?H\<close>
  notes theorem
    "S.add.trivial_derived_seq_imp_solvable" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              (derived (add_monoid S) ^^ ?n) ?H =
              {\<zero>\<^bsub>S\<^esub>}\<rbrakk>
             \<Longrightarrow> solvable_seq (add_monoid S) ?H\<close>
  notes theorem
    "S.add.solvable_imp_trivial_derived_seq" =
      \<open>solvable_seq (add_monoid S) ?H \<Longrightarrow>
             \<exists>n.
                (derived (add_monoid S) ^^ n) ?H =
                {\<zero>\<^bsub>S\<^esub>}\<close>
  notes theorem
    "S.add.solvable_iff_trivial_derived_seq" =
      \<open>solvable (add_monoid S) =
             (\<exists>n.
                 (derived (add_monoid S) ^^ n) (carrier S) =
                 {\<zero>\<^bsub>S\<^esub>})\<close>
  notes theorem
    "S.add.solvable_subgroup" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              solvable (add_monoid S)\<rbrakk>
             \<Longrightarrow> solvable_seq (add_monoid S) ?H\<close>
  notes theorem
    "S.add.lcos_self" =
      \<open>\<lbrakk>?x \<in> carrier S;
              subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?x <#\<^bsub>add_monoid S\<^esub>
  ?H\<close>
  notes theorem
    "S.add.lcosets_part_G" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             \<Union> (lcosets\<^bsub>add_monoid S\<^esub> ?H) =
             carrier S\<close>
  notes theorem
    "S.add.lcosets_subset_PowG" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             lcosets\<^bsub>add_monoid S\<^esub> ?H
             \<subseteq> Pow (carrier S)\<close>
  notes theorem
    "S.add.lcos_disjoint" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              ?a \<in> lcosets\<^bsub>add_monoid S\<^esub> ?H;
              ?b \<in> lcosets\<^bsub>add_monoid S\<^esub> ?H;
              ?a \<noteq> ?b\<rbrakk>
             \<Longrightarrow> ?a \<inter> ?b = {}\<close>
  notes theorem
    "S.add.inj_on_f'" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> inj_on
                                (\<lambda>y.
                                    y \<oplus>\<^bsub>S\<^esub>
                                    \<ominus>\<^bsub>S\<^esub> ?a)
                                (?a <#\<^bsub>add_monoid S\<^esub>
                                 ?H)\<close>
  notes theorem
    "S.add.inj_on_f''" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> inj_on
                                ((\<oplus>\<^bsub>S\<^esub>)
                                  (\<ominus>\<^bsub>S\<^esub> ?a))
                                (?a <#\<^bsub>add_monoid S\<^esub>
                                 ?H)\<close>
  notes theorem
    "S.add.inj_on_g'" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> inj_on ((\<oplus>\<^bsub>S\<^esub>) ?a)
                                ?H\<close>
  notes theorem
    "S.add.l_card_cosets_equal" =
      \<open>\<lbrakk>?c \<in> lcosets\<^bsub>add_monoid S\<^esub> ?H;
              ?H \<subseteq> carrier S; finite (carrier S)\<rbrakk>
             \<Longrightarrow> card ?H = card ?c\<close>
  notes theorem
    "S.add.l_lagrange" =
      \<open>\<lbrakk>finite (carrier S);
              subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> card
                                (lcosets\<^bsub>add_monoid S\<^esub> ?H) *
                               card ?H =
                               Coset.order (add_monoid S)\<close>
  notes theorem
    "S.add.prime_order_simple" =
      \<open>normalization_semidom_class.prime
              (Coset.order (add_monoid S)) \<Longrightarrow>
             simple_group (add_monoid S)\<close>
  notes theorem
    "S.add.self_factor_not_simple" =
      \<open>\<not> simple_group (add_monoid S Mod carrier S)\<close>
  notes theorem
    "S.add.normal_subgroup_set_mult_closed" =
      \<open>\<lbrakk>?M \<lhd> add_monoid S;
              ?N \<lhd> add_monoid S\<rbrakk>
             \<Longrightarrow> ?M <#>\<^bsub>add_monoid S\<^esub> ?N \<lhd>
                               add_monoid S\<close>
  notes
    "S.add.comm_monoid_cancel_axioms" =
      (\<open>comm_monoid_cancel (add_monoid S)\<close>)
      ["attribute" "internal"]
  notes theorem
    "S.add.is_comm_monoid_cancel" =
      \<open>comm_monoid_cancel (add_monoid S)\<close>
  notes theorem
    "S.add.divides_mult_r" =
      (\<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
               ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> (?a \<oplus>\<^bsub>S\<^esub>
                                 ?c) divides\<^bsub>add_monoid S\<^esub>
                                (?b \<oplus>\<^bsub>S\<^esub> ?c) =
                                ?a divides\<^bsub>add_monoid S\<^esub>
                                ?b\<close>)
      ["simp"]
  notes theorem
    "S.add.assoc_r_cancel" =
      \<open>\<lbrakk>?a \<oplus>\<^bsub>S\<^esub>
                      ?b \<sim>\<^bsub>add_monoid S\<^esub>
                      ?a' \<oplus>\<^bsub>S\<^esub> ?b;
              ?a \<in> carrier S; ?a' \<in> carrier S;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid S\<^esub>
                               ?a'\<close>
  notes theorem
    "S.add.properfactorI3" =
      \<open>\<lbrakk>?p = ?a \<oplus>\<^bsub>S\<^esub> ?b;
              ?b \<notin> Units (add_monoid S); ?a \<in> carrier S;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> properfactor (add_monoid S) ?a ?p\<close>
  notes theorem
    "S.add.properfactor_mult_rI" =
      (\<open>\<lbrakk>properfactor (add_monoid S) ?a ?b;
               ?a \<in> carrier S; ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid S)
                                 (?a \<oplus>\<^bsub>S\<^esub> ?c)
                                 (?b \<oplus>\<^bsub>S\<^esub> ?c)\<close>)
      ["HOL.intro"]
  notes theorem
    "S.add.properfactor_mult_r" =
      (\<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
               ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid S)
                                 (?a \<oplus>\<^bsub>S\<^esub> ?c)
                                 (?b \<oplus>\<^bsub>S\<^esub> ?c) =
                                properfactor (add_monoid S) ?a ?b\<close>)
      ["simp"]
  notes theorem
    "S.add.irreducible_prodE" =
      (\<open>\<lbrakk>Divisibility.irreducible (add_monoid S)
                        (?a \<oplus>\<^bsub>S\<^esub> ?b);
               ?a \<in> carrier S; ?b \<in> carrier S;
               \<lbrakk>Divisibility.irreducible (add_monoid S) ?a;
                ?b \<in> Units (add_monoid S)\<rbrakk>
               \<Longrightarrow> ?P;
               \<lbrakk>?a \<in> Units (add_monoid S);
                Divisibility.irreducible (add_monoid S) ?b\<rbrakk>
               \<Longrightarrow> ?P\<rbrakk>
              \<Longrightarrow> ?P\<close>)
      ["HOL.elim"]
  notes theorem
    "S.add.prime_divides" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
              Divisibility.prime (add_monoid S) ?p;
              ?p divides\<^bsub>add_monoid S\<^esub>
              (?a \<oplus>\<^bsub>S\<^esub> ?b)\<rbrakk>
             \<Longrightarrow> ?p divides\<^bsub>add_monoid S\<^esub>
                               ?a \<or>
                               ?p divides\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.prime_irreducible" =
      \<open>Divisibility.prime (add_monoid S) ?p \<Longrightarrow>
             Divisibility.irreducible (add_monoid S) ?p\<close>
  notes theorem
    "S.add.prime_pow_divides_iff" =
      \<open>\<lbrakk>?p \<in> carrier S; ?a \<in> carrier S;
              ?b \<in> carrier S; Divisibility.prime (add_monoid S) ?p;
              \<not> ?p divides\<^bsub>add_monoid S\<^esub> ?a\<rbrakk>
             \<Longrightarrow> [?n] \<cdot>\<^bsub>S\<^esub> ?p divides\<^bsub>add_monoid S\<^esub>
                               (?a \<oplus>\<^bsub>S\<^esub> ?b) =
                               [?n] \<cdot>\<^bsub>S\<^esub> ?p divides\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.multlist_listassoc_cong" =
      \<open>\<lbrakk>?fs [\<sim>]\<^bsub>add_monoid S\<^esub> ?fs';
              set ?fs \<subseteq> carrier S;
              set ?fs' \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> foldr (\<oplus>\<^bsub>S\<^esub>) ?fs
                                \<zero>\<^bsub>S\<^esub> \<sim>\<^bsub>add_monoid S\<^esub>
                               foldr (\<oplus>\<^bsub>S\<^esub>) ?fs'
                                \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.add.multlist_ee_cong" =
      \<open>\<lbrakk>essentially_equal (add_monoid S) ?fs ?fs';
              set ?fs \<subseteq> carrier S;
              set ?fs' \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> foldr (\<oplus>\<^bsub>S\<^esub>) ?fs
                                \<zero>\<^bsub>S\<^esub> \<sim>\<^bsub>add_monoid S\<^esub>
                               foldr (\<oplus>\<^bsub>S\<^esub>) ?fs'
                                \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.add.unit_wfactors_empty" =
      \<open>\<lbrakk>?a \<in> Units (add_monoid S);
              wfactors (add_monoid S) ?fs ?a;
              set ?fs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?fs = []\<close>
  notes theorem
    "S.add.wfactors_listassoc_cong_l" =
      \<open>\<lbrakk>wfactors (add_monoid S) ?fs ?a;
              ?fs [\<sim>]\<^bsub>add_monoid S\<^esub> ?fs';
              ?a \<in> carrier S; set ?fs \<subseteq> carrier S;
              set ?fs' \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid S) ?fs' ?a\<close>
  notes theorem
    "S.add.wfactors_ee_cong_l" =
      (\<open>\<lbrakk>essentially_equal (add_monoid S) ?as ?bs;
               wfactors (add_monoid S) ?bs ?b; ?b \<in> carrier S;
               set ?as \<subseteq> carrier S;
               set ?bs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> wfactors (add_monoid S) ?as ?b\<close>)
      ["trans"]
  notes theorem
    "S.add.unitfactor_ee" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid S);
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> essentially_equal (add_monoid S)
                                (?as[0 :=
 ?as ! 0 \<oplus>\<^bsub>S\<^esub> ?u])
                                ?as\<close>
  notes theorem
    "S.add.factors_cong_unit" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid S);
              ?a \<notin> Units (add_monoid S);
              factors (add_monoid S) ?as ?a;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> factors (add_monoid S)
                                (?as[0 :=
 ?as ! 0 \<oplus>\<^bsub>S\<^esub> ?u])
                                (?a \<oplus>\<^bsub>S\<^esub> ?u)\<close>
  notes theorem
    "S.add.listassoc_wfactorsD" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid S\<^esub> ?bs;
