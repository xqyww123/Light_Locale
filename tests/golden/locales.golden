      ["Ring.algebra" ring \<zero>\<^bsub>P\<^esub>
         (\<oplus>\<^bsub>P\<^esub>) a_inv P a_minus P
         \<one>\<^bsub>P\<^esub> (\<otimes>\<^bsub>P\<^esub>)]
      (\<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
              \<Longrightarrow> \<ominus>\<^bsub>P\<^esub> (?x \<oplus>\<^bsub>P\<^esub>
                      ?y) =
                                \<ominus>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
                                \<ominus>\<^bsub>P\<^esub> ?y\<close>)
      ["Ring.algebra" ring \<zero>\<^bsub>P\<^esub>
         (\<oplus>\<^bsub>P\<^esub>) a_inv P a_minus P
