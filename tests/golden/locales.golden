                               \<ominus> ?x \<oplus> \<ominus> ?y\<close>
  notes theorem
    "r_neg1" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> \<ominus> ?x \<oplus> (?x \<oplus> ?y) =
                               ?y\<close>
  notes theorem
    "r_neg2" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x \<oplus> (\<ominus> ?x \<oplus> ?y) =
                               ?y\<close>
  notes theorem
    "minus_eq" = \<open>?x \<ominus> ?y = ?x \<oplus> \<ominus> ?y\<close>
  notes theorem
    "a_repr_independence'" =
      \<open>\<lbrakk>?y \<in> ?H #>\<^bsub>add_monoid R\<^esub> ?x;
