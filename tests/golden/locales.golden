  notes theorem
    "S.add.hom_imp_img_monoid" =
      \<open>?h \<in> hom (add_monoid S) ?H \<Longrightarrow>
             Group.monoid
              (?H\<lparr>carrier := ?h ` carrier S,
                    one := ?h \<zero>\<^bsub>S\<^esub>\<rparr>)\<close>
  notes theorem
    "S.add.monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier S; y \<in> carrier S\<rbrakk>
