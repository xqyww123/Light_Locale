  notes theorem
    "lcoeff_nonzero2" =
      \<open>\<lbrakk>?p \<in> carrier P;
              ?p \<noteq> \<zero>\<^bsub>P\<^esub>\<rbrakk>
             \<Longrightarrow> lcoeff ?p \<noteq> \<zero>\<close>
  notes theorem
    "coeff_minus" =
      (\<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
