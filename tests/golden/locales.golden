                                 ?n \<ominus> up_ring.coeff P ?q ?n\<close>)
      ["simp"]
  notes theorem
    "lcoeff_closed" =
      (\<open>?p \<in> carrier P \<Longrightarrow>
              lcoeff ?p \<in> carrier R\<close>)
      ["simp"]
  notes theorem
    "deg_smult_decr" =
      \<open>\<lbrakk>?a \<in> carrier R; ?f \<in> carrier P\<rbrakk>
             \<Longrightarrow> deg R (?a \<odot>\<^bsub>P\<^esub> ?f)
                               \<le> deg R ?f\<close>
  notes theorem
    "coeff_monom_mult" =
      \<open>\<lbrakk>?c \<in> carrier R; ?p \<in> carrier P\<rbrakk>
             \<Longrightarrow> up_ring.coeff P
                                (up_ring.monom P ?c
                                  ?n \<otimes>\<^bsub>P\<^esub>
                                 ?p)
                                (?m + ?n) =
                               ?c \<otimes> up_ring.coeff P ?p ?m\<close>
  notes theorem
    "deg_lcoeff_cancel" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?r \<in> carrier P; deg R ?r \<noteq> 0;
              deg R ?p \<le> deg R ?r; deg R ?q \<le> deg R ?r;
              up_ring.coeff P ?p (deg R ?r) =
              \<ominus> up_ring.coeff P ?q (deg R ?r)\<rbrakk>
             \<Longrightarrow> deg R (?p \<oplus>\<^bsub>P\<^esub> ?q)
                               < deg R ?r\<close>
  notes theorem
    "monom_deg_mult" =
      \<open>\<lbrakk>?f \<in> carrier P; ?g \<in> carrier P;
              deg R ?g \<le> deg R ?f; ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> deg R
                                (?g \<otimes>\<^bsub>P\<^esub>
                                 up_ring.monom P ?a (deg R ?f - deg R ?g))
                               \<le> deg R ?f\<close>
  notes theorem
    "deg_zero_impl_monom" =
      \<open>\<lbrakk>?f \<in> carrier P; deg R ?f = 0\<rbrakk>
             \<Longrightarrow> ?f =
                               up_ring.monom P (up_ring.coeff P ?f 0)
                                0\<close>
  notes theorem
    "deg_nzero_nzero" =
      \<open>deg R ?p \<noteq> 0 \<Longrightarrow>
             ?p \<noteq> \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "deg_add_eq" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              deg R ?q \<noteq> deg R ?p\<rbrakk>
             \<Longrightarrow> deg R (?p \<oplus>\<^bsub>P\<^esub> ?q) =
                               max (deg R ?p) (deg R ?q)\<close>
  notes theorem
    "deg_minus_eq" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              deg R ?q \<noteq> deg R ?p\<rbrakk>
             \<Longrightarrow> deg R (?p \<ominus>\<^bsub>P\<^esub> ?q) =
                               max (deg R ?p) (deg R ?q)\<close>
  notes
    "P.comm_monoid_axioms" = (\<open>Group.comm_monoid P\<close>)
      ["attribute" "internal"]
  notes
    "P.m_comm" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>P\<^esub> ?y =
                               ?y \<otimes>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.m_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>P\<^esub>
                               (?y \<otimes>\<^bsub>P\<^esub> ?z) =
                               ?y \<otimes>\<^bsub>P\<^esub>
                               (?x \<otimes>\<^bsub>P\<^esub> ?z)\<close>
  notes theorem
    "P.m_ac" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>P\<^esub>
                               ?y \<otimes>\<^bsub>P\<^esub>
                               ?z =
                               ?x \<otimes>\<^bsub>P\<^esub>
                               (?y \<otimes>\<^bsub>P\<^esub> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>P\<^esub> ?y =
                               ?y \<otimes>\<^bsub>P\<^esub> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>P\<^esub>
                               (?y \<otimes>\<^bsub>P\<^esub> ?z) =
                               ?y \<otimes>\<^bsub>P\<^esub>
                               (?x \<otimes>\<^bsub>P\<^esub> ?z)\<close>
  notes theorem
    "P.submonoid_is_comm_monoid" =
      \<open>submonoid ?H P \<Longrightarrow>
             Group.comm_monoid (P\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "P.nat_pow_distrib" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> (?x \<otimes>\<^bsub>P\<^esub>
                                ?y) [^]\<^bsub>P\<^esub>
                               ?n =
                               ?x [^]\<^bsub>P\<^esub>
                               ?n \<otimes>\<^bsub>P\<^esub>
                               ?y [^]\<^bsub>P\<^esub> ?n\<close>
  notes theorem
    "P.hom_imp_img_comm_monoid" =
      \<open>?h \<in> hom P ?H \<Longrightarrow>
             Group.comm_monoid
              (?H\<lparr>carrier := ?h ` carrier P,
                    one := ?h \<one>\<^bsub>P\<^esub>\<rparr>)\<close>
  notes theorem
    "P.units_comm_group" = \<open>comm_group (units_of P)\<close>
  notes theorem
    "P.finprod_empty" =
      (\<open>finprod P ?f {} = \<one>\<^bsub>P\<^esub>\<close>) ["simp"]
  notes theorem
    "P.finprod_infinite" =
      (\<open>infinite ?A \<Longrightarrow>
              finprod P ?f ?A = \<one>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.finprod_insert" =
      (\<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
               ?f \<in> ?F \<rightarrow> carrier P;
               ?f ?a \<in> carrier P\<rbrakk>
              \<Longrightarrow> finprod P ?f (insert ?a ?F) =
                                ?f ?a \<otimes>\<^bsub>P\<^esub>
                                finprod P ?f ?F\<close>)
      ["simp"]
  notes theorem
    "P.finprod_one_eqI" =
      \<open>(\<And>x.
                 x \<in> ?A \<Longrightarrow>
                 ?f x = \<one>\<^bsub>P\<^esub>) \<Longrightarrow>
             finprod P ?f ?A = \<one>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.finprod_one" =
      (\<open>(\<Otimes>\<^bsub>P\<^esub>i\<in>?A. \<one>\<^bsub>P\<^esub>) =
              \<one>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.finprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier P \<Longrightarrow>
              finprod P ?f ?A \<in> carrier P\<close>)
      ["simp"]
  notes theorem
    "P.funcset_Int_left" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> ?C;
               ?f \<in> ?B \<rightarrow> ?C\<rbrakk>
              \<Longrightarrow> ?f \<in> ?A \<inter> ?B \<rightarrow>
   ?C\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "P.funcset_Un_left" =
      (\<open>(?f \<in> ?A \<union> ?B \<rightarrow> ?C) =
              (?f \<in> ?A \<rightarrow> ?C \<and>
               ?f \<in> ?B \<rightarrow> ?C)\<close>)
      ["iff"]
  notes theorem
    "P.finprod_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier P;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finprod P ?g
                                (?A \<union> ?B) \<otimes>\<^bsub>P\<^esub>
                               finprod P ?g (?A \<inter> ?B) =
                               finprod P ?g ?A \<otimes>\<^bsub>P\<^esub>
                               finprod P ?g ?B\<close>
  notes theorem
    "P.finprod_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier P;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finprod P ?g (?A \<union> ?B) =
                               finprod P ?g ?A \<otimes>\<^bsub>P\<^esub>
                               finprod P ?g ?B\<close>
  notes theorem
    "P.finprod_multf" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier P;
               ?g \<in> ?A \<rightarrow> carrier P\<rbrakk>
              \<Longrightarrow> (\<Otimes>\<^bsub>P\<^esub>x\<in>?A. ?f
                                x \<otimes>\<^bsub>P\<^esub>
                               ?g x) =
                                finprod P ?f ?A \<otimes>\<^bsub>P\<^esub>
                                finprod P ?g ?A\<close>)
      ["simp"]
  notes theorem
    "P.finprod_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier P;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finprod P ?f ?A = finprod P ?g ?B\<close>
  notes theorem
    "P.finprod_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier P) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finprod P ?f ?A = finprod P ?g ?B\<close>
  notes theorem
    "P.finprod_0" =
      (\<open>?f \<in> {0} \<rightarrow> carrier P \<Longrightarrow>
              finprod P ?f {..0} = ?f 0\<close>)
      ["simp"]
  notes theorem
    "P.finprod_0'" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier P \<Longrightarrow>
             ?f 0 \<otimes>\<^bsub>P\<^esub> finprod P ?f {Suc 0..?n} =
             finprod P ?f {..?n}\<close>
  notes theorem
    "P.finprod_Suc" =
      (\<open>?f \<in> {..Suc ?n} \<rightarrow> carrier P \<Longrightarrow>
              finprod P ?f {..Suc ?n} =
              ?f (Suc ?n) \<otimes>\<^bsub>P\<^esub>
              finprod P ?f {..?n}\<close>)
      ["simp"]
  notes theorem
    "P.finprod_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier P \<Longrightarrow>
             finprod P ?f {..Suc ?n} =
             (\<Otimes>\<^bsub>P\<^esub>i\<in>{..?n}. ?f
                 (Suc i)) \<otimes>\<^bsub>P\<^esub>
             ?f 0\<close>
  notes theorem
    "P.finprod_Suc3" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier P \<Longrightarrow>
             finprod P ?f {..?n} =
             ?f ?n \<otimes>\<^bsub>P\<^esub> finprod P ?f {..<?n}\<close>
  notes theorem
    "P.finprod_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier P;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finprod P ?f (?h ` ?A) =
                               (\<Otimes>\<^bsub>P\<^esub>x\<in>?A. ?f
                               (?h x))\<close>
  notes theorem
    "P.finprod_const" =
      \<open>?a \<in> carrier P \<Longrightarrow>
             (\<Otimes>\<^bsub>P\<^esub>x\<in>?A. ?a) =
             ?a [^]\<^bsub>P\<^esub> card ?A\<close>
  notes theorem
    "P.finprod_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> (\<Otimes>\<^bsub>P\<^esub>j\<in>?A. if ?i =
                                 j
                              then ?f j else \<one>\<^bsub>P\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "P.finprod_singleton_swap" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> (\<Otimes>\<^bsub>P\<^esub>j\<in>?A. if j =
                                 ?i
                              then ?f j else \<one>\<^bsub>P\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "P.finprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<one>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finprod P ?g ?A = finprod P ?h ?B\<close>
  notes theorem
    "P.finprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?g i = \<one>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finprod P ?g ?B = finprod P ?h ?A\<close>
  notes theorem
    "P.finprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<one>\<^bsub>P\<^esub>;
              \<And>i.
                 i \<in> ?A - ?B \<Longrightarrow>
                 ?g i = \<one>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier P;
              ?h \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finprod P ?g ?A = finprod P ?h ?B\<close>
  notes theorem
    "P.finprod_UN_disjoint" =
      \<open>\<lbrakk>finite ?I;
              \<And>i. i \<in> ?I \<Longrightarrow> finite (?A i);
              pairwise (\<lambda>i j. disjnt (?A i) (?A j)) ?I;
              \<And>i x.
                 \<lbrakk>i \<in> ?I; x \<in> ?A i\<rbrakk>
                 \<Longrightarrow> ?g x \<in> carrier P\<rbrakk>
             \<Longrightarrow> finprod P ?g (\<Union> (?A ` ?I)) =
                               (\<Otimes>\<^bsub>P\<^esub>i\<in>?I. finprod
                               P ?g (?A i))\<close>
  notes theorem
    "P.finprod_Union_disjoint" =
      \<open>\<lbrakk>finite ?C;
              \<And>A.
                 A \<in> ?C \<Longrightarrow>
                 finite A \<and> (\<forall>x\<in>A. ?f x \<in> carrier P);
              disjoint ?C\<rbrakk>
             \<Longrightarrow> finprod P ?f (\<Union> ?C) =
                               finprod P (finprod P ?f) ?C\<close>
  notes theorem
    "P.comm_inv_char" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?x \<otimes>\<^bsub>P\<^esub> ?y =
              \<one>\<^bsub>P\<^esub>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>P\<^esub> ?x = ?y\<close>
  notes theorem
    "P.unit_factor" =
      \<open>\<lbrakk>?a \<otimes>\<^bsub>P\<^esub> ?b \<in> Units P;
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<in> Units P\<close>
  notes theorem
    "P.divides_mult_rI" =
      (\<open>\<lbrakk>?a divides\<^bsub>P\<^esub> ?b; ?a \<in> carrier P;
               ?b \<in> carrier P; ?c \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?a \<otimes>\<^bsub>P\<^esub>
                                ?c divides\<^bsub>P\<^esub>
                                ?b \<otimes>\<^bsub>P\<^esub> ?c\<close>)
      ["HOL.intro"]
  notes theorem
    "P.divides_prod_l" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P;
              ?c \<in> carrier P; ?a divides\<^bsub>P\<^esub> ?b\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>P\<^esub>
                               ?c \<otimes>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.divides_unit" =
      \<open>\<lbrakk>?a divides\<^bsub>P\<^esub> ?u; ?a \<in> carrier P;
              ?u \<in> Units P\<rbrakk>
             \<Longrightarrow> ?a \<in> Units P\<close>
  notes theorem
    "P.Unit_eq_dividesone" =
      \<open>?u \<in> carrier P \<Longrightarrow>
             (?u \<in> Units P) =
             ?u divides\<^bsub>P\<^esub> \<one>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.mult_cong_l" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>P\<^esub> ?a'; ?a \<in> carrier P;
              ?a' \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<otimes>\<^bsub>P\<^esub>
                               ?b \<sim>\<^bsub>P\<^esub>
                               ?a' \<otimes>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.Units_cong" =
      \<open>\<lbrakk>?a \<in> Units P; ?a \<sim>\<^bsub>P\<^esub> ?b;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?b \<in> Units P\<close>
  notes theorem
    "P.Units_Lower" =
      \<open>Units P = Lower (division_rel P) (carrier P)\<close>
  notes theorem
    "P.properfactor_prod_l" =
      \<open>\<lbrakk>properfactor P ?a ?b; ?a \<in> carrier P;
              ?b \<in> carrier P; ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> properfactor P ?a
                                (?c \<otimes>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.irreducible_prod_lI" =
      \<open>\<lbrakk>Divisibility.irreducible P ?b; ?a \<in> Units P;
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible P
                                (?a \<otimes>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.multlist_dividesI" =
      \<open>\<lbrakk>?f \<in> set ?fs;
              set ?fs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>P\<^esub>
                               foldr (\<otimes>\<^bsub>P\<^esub>) ?fs
                                \<one>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.multlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> foldr (\<otimes>\<^bsub>P\<^esub>) ?as
                                \<one>\<^bsub>P\<^esub> =
                               foldr (\<otimes>\<^bsub>P\<^esub>) ?bs
                                \<one>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.wfactors_perm_cong_l" =
      \<open>\<lbrakk>wfactors P ?fs ?a; mset ?fs = mset ?fs';
              set ?fs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> wfactors P ?fs' ?a\<close>
  notes theorem
    "P.perm_wfactorsD" =
      \<open>\<lbrakk>mset ?as = mset ?bs; wfactors P ?as ?a;
              wfactors P ?bs ?b; ?a \<in> carrier P; ?b \<in> carrier P;
              set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.factors_dividesI" =
      \<open>\<lbrakk>factors P ?fs ?a; ?f \<in> set ?fs;
              set ?fs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>P\<^esub> ?a\<close>
  notes theorem
    "P.wfactors_dividesI" =
      \<open>\<lbrakk>wfactors P ?fs ?a; set ?fs \<subseteq> carrier P;
              ?a \<in> carrier P; ?f \<in> set ?fs\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>P\<^esub> ?a\<close>
  notes theorem
    "P.assocs_assoc" =
      \<open>\<lbrakk>?a \<in> assocs P ?b; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.assocs_eqD" =
      \<open>\<lbrakk>assocs P ?b = assocs P ?a; ?a \<in> carrier P;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.gfinprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier P \<Longrightarrow>
              gfinprod P ?f ?A \<in> carrier P\<close>)
      ["simp"]
  notes theorem
    "P.gfinprod_cong" =
      \<open>\<lbrakk>?A = ?B; ?f \<in> ?B \<rightarrow> carrier P;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> gfinprod P ?f ?A = gfinprod P ?g ?B\<close>
  notes theorem
    "P.gfinprod_eq_finprod" =
      (\<open>\<lbrakk>finite ?A;
               ?f \<in> ?A \<rightarrow> carrier P\<rbrakk>
              \<Longrightarrow> gfinprod P ?f ?A = finprod P ?f ?A\<close>)
      ["simp"]
  notes theorem
    "P.gfinprod_insert" =
      (\<open>\<lbrakk>finite
                        {x \<in> ?A. ?f x \<noteq> \<one>\<^bsub>P\<^esub>};
               ?f \<in> ?A \<rightarrow> carrier P;
               ?f ?i \<in> carrier P\<rbrakk>
              \<Longrightarrow> gfinprod P ?f (insert ?i ?A) =
                                (if ?i \<in> ?A then gfinprod P ?f ?A
                                 else ?f ?i \<otimes>\<^bsub>P\<^esub>
gfinprod P ?f ?A)\<close>)
      ["simp"]
  notes theorem
    "P.gfinprod_distrib" =
      \<open>\<lbrakk>finite
                       {x \<in> ?A. ?f x \<noteq> \<one>\<^bsub>P\<^esub>};
              finite {x \<in> ?A. ?g x \<noteq> \<one>\<^bsub>P\<^esub>};
              ?f \<in> ?A \<rightarrow> carrier P;
              ?g \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> gfinprod P
                                (\<lambda>i.
                                    ?f i \<otimes>\<^bsub>P\<^esub> ?g i)
                                ?A =
                               gfinprod P ?f ?A \<otimes>\<^bsub>P\<^esub>
                               gfinprod P ?g ?A\<close>
  notes theorem
    "P.gfinprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<one>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> gfinprod P ?g ?A = gfinprod P ?h ?B\<close>
  notes theorem
    "P.gfinprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?g i = \<one>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> gfinprod P ?g ?B = gfinprod P ?h ?A\<close>
  notes theorem
    "P.gfinprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<one>\<^bsub>P\<^esub>;
              \<And>i.
                 i \<in> ?A - ?B \<Longrightarrow>
                 ?g i = \<one>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier P;
              ?h \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> gfinprod P ?g ?A = gfinprod P ?h ?B\<close>
