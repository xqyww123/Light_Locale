              ?x \<otimes>\<^bsub>S\<^esub> inv\<^bsub>S\<^esub> ?x =
              \<one>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.inv_one" =
      (\<open>inv\<^bsub>S\<^esub> \<one>\<^bsub>S\<^esub> =
              \<one>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.Units_inv_Units" =
      (\<open>?x \<in> Units S \<Longrightarrow>
              inv\<^bsub>S\<^esub> ?x \<in> Units S\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "S.Units_l_cancel" =
      (\<open>\<lbrakk>?x \<in> Units S; ?y \<in> carrier S;
               ?z \<in> carrier S\<rbrakk>
              \<Longrightarrow> (?x \<otimes>\<^bsub>S\<^esub> ?y =
                                 ?x \<otimes>\<^bsub>S\<^esub> ?z) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "S.Units_inv_inv" =
      (\<open>?x \<in> Units S \<Longrightarrow>
              inv\<^bsub>S\<^esub> (inv\<^bsub>S\<^esub> ?x) = ?x\<close>)
      ["simp"]
  notes theorem
    "S.inv_inj_on_Units" = \<open>inj_on (m_inv S) (Units S)\<close>
  notes theorem
    "S.Units_inv_comm" =
      \<open>\<lbrakk>?x \<otimes>\<^bsub>S\<^esub> ?y =
                      \<one>\<^bsub>S\<^esub>;
              ?x \<in> Units S; ?y \<in> Units S\<rbrakk>
             \<Longrightarrow> ?y \<otimes>\<^bsub>S\<^esub> ?x =
                               \<one>\<^bsub>S\<^esub>\<close>
  notes theorem "S.carrier_not_empty" = \<open>carrier S \<noteq> {}\<close>
  notes theorem
    "S.group_l_invI" =
      \<open>(\<And>x.
                 x \<in> carrier S \<Longrightarrow>
                 \<exists>y\<in>carrier S.
                    y \<otimes>\<^bsub>S\<^esub> x =
                    \<one>\<^bsub>S\<^esub>) \<Longrightarrow>
             Group.group S\<close>
  notes theorem
    "S.nat_pow_closed" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              ?x [^]\<^bsub>S\<^esub> ?n \<in> carrier S\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "S.nat_pow_0" =
      (\<open>?x [^]\<^bsub>S\<^esub> 0 = \<one>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.nat_pow_Suc" =
      (\<open>?x [^]\<^bsub>S\<^esub> Suc ?n =
              ?x [^]\<^bsub>S\<^esub> ?n \<otimes>\<^bsub>S\<^esub>
              ?x\<close>)
      ["simp"]
  notes theorem
    "S.nat_pow_one" =
      (\<open>\<one>\<^bsub>S\<^esub> [^]\<^bsub>S\<^esub> ?n =
              \<one>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.nat_pow_mult" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             ?x [^]\<^bsub>S\<^esub> ?n \<otimes>\<^bsub>S\<^esub>
             ?x [^]\<^bsub>S\<^esub> ?m =
             ?x [^]\<^bsub>S\<^esub> (?n + ?m)\<close>
  notes theorem
    "S.nat_pow_comm" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             ?x [^]\<^bsub>S\<^esub> ?n \<otimes>\<^bsub>S\<^esub>
             ?x [^]\<^bsub>S\<^esub> ?m =
             ?x [^]\<^bsub>S\<^esub> ?m \<otimes>\<^bsub>S\<^esub>
             ?x [^]\<^bsub>S\<^esub> ?n\<close>
  notes theorem
    "S.nat_pow_Suc2" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             ?x [^]\<^bsub>S\<^esub> Suc ?n =
             ?x \<otimes>\<^bsub>S\<^esub>
             ?x [^]\<^bsub>S\<^esub> ?n\<close>
  notes theorem
    "S.nat_pow_pow" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             (?x [^]\<^bsub>S\<^esub> ?n) [^]\<^bsub>S\<^esub> ?m =
             ?x [^]\<^bsub>S\<^esub> (?n * ?m)\<close>
  notes theorem
    "S.nat_pow_consistent" =
      \<open>?x [^]\<^bsub>S\<^esub> ?n =
             ?x [^]\<^bsub>S\<lparr>carrier := ?H\<rparr>\<^esub> ?n\<close>
  notes theorem
    "S.group_commutes_pow" =
      \<open>\<lbrakk>?x \<otimes>\<^bsub>S\<^esub> ?y =
                      ?y \<otimes>\<^bsub>S\<^esub> ?x;
              ?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x [^]\<^bsub>S\<^esub>
                               ?n \<otimes>\<^bsub>S\<^esub>
                               ?y =
                               ?y \<otimes>\<^bsub>S\<^esub>
                               ?x [^]\<^bsub>S\<^esub> ?n\<close>
  notes theorem
    "S.pow_mult_distrib" =
      \<open>\<lbrakk>?x \<otimes>\<^bsub>S\<^esub> ?y =
                      ?y \<otimes>\<^bsub>S\<^esub> ?x;
              ?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> (?x \<otimes>\<^bsub>S\<^esub>
                                ?y) [^]\<^bsub>S\<^esub>
                               ?n =
                               ?x [^]\<^bsub>S\<^esub>
                               ?n \<otimes>\<^bsub>S\<^esub>
                               ?y [^]\<^bsub>S\<^esub> ?n\<close>
  notes theorem
    "S.monoid_incl_imp_submonoid" =
      \<open>\<lbrakk>?H \<subseteq> carrier S;
              Group.monoid (S\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> submonoid ?H S\<close>
  notes theorem
    "S.inv_unique'" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?x \<otimes>\<^bsub>S\<^esub> ?y = \<one>\<^bsub>S\<^esub>;
              ?y \<otimes>\<^bsub>S\<^esub> ?x =
              \<one>\<^bsub>S\<^esub>\<rbrakk>
             \<Longrightarrow> ?y = inv\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.m_inv_monoid_consistent" =
      \<open>\<lbrakk>?x \<in> Units (S\<lparr>carrier := ?H\<rparr>);
              submonoid ?H S\<rbrakk>
             \<Longrightarrow> inv\<^bsub>S\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                               inv\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.hom_imp_img_monoid" =
      \<open>?h \<in> hom S ?H \<Longrightarrow>
             Group.monoid
              (?H\<lparr>carrier := ?h ` carrier S,
                    one := ?h \<one>\<^bsub>S\<^esub>\<rparr>)\<close>
  notes theorem
    "S.monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier S; y \<in> carrier S\<rbrakk>
                 \<Longrightarrow> x \<otimes>\<^bsub>S\<^esub> y =
                                   y \<otimes>\<^bsub>S\<^esub>
                                   x) \<Longrightarrow>
             Group.comm_monoid S\<close>
  notes theorem "S.units_group" = \<open>Group.group (units_of S)\<close>
  notes theorem
    "S.units_of_inv" =
      \<open>?x \<in> Units S \<Longrightarrow>
             inv\<^bsub>units_of S\<^esub> ?x =
             inv\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.set_mult_closed" =
      \<open>\<lbrakk>?H \<subseteq> carrier S;
              ?K \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>S\<^esub> ?K
                               \<subseteq> carrier S\<close>
  notes theorem
    "S.r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?x \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>S\<^esub> ?x
                               \<subseteq> carrier S\<close>
  notes theorem
    "S.order_gt_0_iff_finite" =
      \<open>(0 < Coset.order S) = finite (carrier S)\<close>
  notes theorem
    "S.units_of_pow" =
      \<open>?x \<in> Units S \<Longrightarrow>
             ?x [^]\<^bsub>units_of S\<^esub> ?n =
             ?x [^]\<^bsub>S\<^esub> ?n\<close>
  notes theorem
    "S.inv_char" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?x \<otimes>\<^bsub>S\<^esub> ?y = \<one>\<^bsub>S\<^esub>;
              ?y \<otimes>\<^bsub>S\<^esub> ?x =
              \<one>\<^bsub>S\<^esub>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>S\<^esub> ?x = ?y\<close>
  notes theorem
    "S.inv_eq_imp_eq" =
      (\<open>\<lbrakk>inv\<^bsub>S\<^esub> ?x = inv\<^bsub>S\<^esub> ?y;
               ?x \<in> Units S; ?y \<in> Units S\<rbrakk>
              \<Longrightarrow> ?x = ?y\<close>)
      ["HOL.dest" !]
  notes theorem
    "S.inv_eq_one_eq" =
      \<open>?x \<in> Units S \<Longrightarrow>
             (inv\<^bsub>S\<^esub> ?x = \<one>\<^bsub>S\<^esub>) =
             (?x = \<one>\<^bsub>S\<^esub>)\<close>
  notes theorem
    "S.monoid_cancelI" =
      \<open>\<lbrakk>\<And>a b c.
                         \<lbrakk>c \<otimes>\<^bsub>S\<^esub> a =
                                  c \<otimes>\<^bsub>S\<^esub> b;
                          a \<in> carrier S; b \<in> carrier S;
                          c \<in> carrier S\<rbrakk>
                         \<Longrightarrow> a = b;
              \<And>a b c.
                 \<lbrakk>a \<otimes>\<^bsub>S\<^esub> c =
                          b \<otimes>\<^bsub>S\<^esub> c;
                  a \<in> carrier S; b \<in> carrier S;
                  c \<in> carrier S\<rbrakk>
                 \<Longrightarrow> a = b\<rbrakk>
             \<Longrightarrow> monoid_cancel S\<close>
  notes theorem
    "S.prod_unit_l" =
      \<open>\<lbrakk>?a \<otimes>\<^bsub>S\<^esub> ?b \<in> Units S;
              ?a \<in> Units S; ?a \<in> carrier S;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?b \<in> Units S\<close>
  notes theorem
    "S.prod_unit_r" =
      \<open>\<lbrakk>?a \<otimes>\<^bsub>S\<^esub> ?b \<in> Units S;
              ?b \<in> Units S; ?a \<in> carrier S;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<in> Units S\<close>
  notes theorem
    "S.divides_refl" =
      (\<open>?a \<in> carrier S \<Longrightarrow>
              ?a divides\<^bsub>S\<^esub> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "S.divides_trans" =
      (\<open>\<lbrakk>?a divides\<^bsub>S\<^esub> ?b;
               ?b divides\<^bsub>S\<^esub> ?c; ?a \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?a divides\<^bsub>S\<^esub> ?c\<close>)
      ["trans"]
  notes theorem
    "S.divides_mult_lI" =
      (\<open>\<lbrakk>?a divides\<^bsub>S\<^esub> ?b; ?a \<in> carrier S;
               ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?c \<otimes>\<^bsub>S\<^esub>
                                ?a divides\<^bsub>S\<^esub>
                                ?c \<otimes>\<^bsub>S\<^esub> ?b\<close>)
      ["HOL.intro"]
  notes theorem
    "S.divides_prod_r" =
      \<open>\<lbrakk>?a divides\<^bsub>S\<^esub> ?b; ?a \<in> carrier S;
              ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>S\<^esub>
                               ?b \<otimes>\<^bsub>S\<^esub> ?c\<close>
  notes theorem
    "S.unit_divides" =
      \<open>\<lbrakk>?u \<in> Units S; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?u divides\<^bsub>S\<^esub> ?a\<close>
  notes theorem
    "S.associatedI2" =
      \<open>\<lbrakk>?u \<in> Units S;
              ?a = ?b \<otimes>\<^bsub>S\<^esub> ?u;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.associatedI2'" =
      \<open>\<lbrakk>?a = ?b \<otimes>\<^bsub>S\<^esub> ?u;
              ?u \<in> Units S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.associated_refl" =
      (\<open>?a \<in> carrier S \<Longrightarrow>
              ?a \<sim>\<^bsub>S\<^esub> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "S.associated_sym" =
      (\<open>?a \<sim>\<^bsub>S\<^esub> ?b \<Longrightarrow>
              ?b \<sim>\<^bsub>S\<^esub> ?a\<close>)
      ["sym"]
  notes theorem
    "S.associated_trans" =
      (\<open>\<lbrakk>?a \<sim>\<^bsub>S\<^esub> ?b;
               ?b \<sim>\<^bsub>S\<^esub> ?c; ?a \<in> carrier S;
               ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?a \<sim>\<^bsub>S\<^esub> ?c\<close>)
      ["trans"]
  notes theorem
    "S.division_equiv" = (\<open>equivalence (division_rel S)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "S.divides_cong_l" =
      (\<open>\<lbrakk>?x \<sim>\<^bsub>S\<^esub> ?x';
               ?x' divides\<^bsub>S\<^esub> ?y; ?x \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?x divides\<^bsub>S\<^esub> ?y\<close>)
      ["trans"]
  notes theorem
    "S.divides_cong_r" =
      (\<open>\<lbrakk>?x divides\<^bsub>S\<^esub> ?y;
               ?y \<sim>\<^bsub>S\<^esub> ?y'; ?x \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?x divides\<^bsub>S\<^esub> ?y'\<close>)
      ["trans"]
  notes theorem
    "S.division_weak_partial_order" =
      (\<open>weak_partial_order (division_rel S)\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "S.mult_cong_r" =
      \<open>\<lbrakk>?b \<sim>\<^bsub>S\<^esub> ?b'; ?a \<in> carrier S;
              ?b \<in> carrier S; ?b' \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<otimes>\<^bsub>S\<^esub>
                               ?b \<sim>\<^bsub>S\<^esub>
                               ?a \<otimes>\<^bsub>S\<^esub> ?b'\<close>
  notes theorem
    "S.Units_assoc" =
      \<open>\<lbrakk>?a \<in> Units S; ?b \<in> Units S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.Units_are_ones" =
      \<open>Units S {.=}\<^bsub>division_rel S\<^esub>
             {\<one>\<^bsub>S\<^esub>}\<close>
  notes theorem
    "S.properfactor_unitE" =
      \<open>\<lbrakk>?u \<in> Units S; properfactor S ?a ?u;
              ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "S.properfactor_divides" =
      \<open>properfactor S ?a ?b \<Longrightarrow>
             ?a divides\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.properfactor_trans1" =
      (\<open>\<lbrakk>?a divides\<^bsub>S\<^esub> ?b; properfactor S ?b ?c;
               ?a \<in> carrier S; ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor S ?a ?c\<close>)
      ["trans"]
  notes theorem
    "S.properfactor_trans2" =
      (\<open>\<lbrakk>properfactor S ?a ?b; ?b divides\<^bsub>S\<^esub> ?c;
               ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor S ?a ?c\<close>)
      ["trans"]
  notes theorem
    "S.properfactor_cong_l" =
      (\<open>\<lbrakk>?x' \<sim>\<^bsub>S\<^esub> ?x; properfactor S ?x ?y;
               ?x \<in> carrier S; ?x' \<in> carrier S;
               ?y \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor S ?x' ?y\<close>)
      ["trans"]
  notes theorem
    "S.properfactor_cong_r" =
      (\<open>\<lbrakk>properfactor S ?x ?y; ?y \<sim>\<^bsub>S\<^esub> ?y';
               ?x \<in> carrier S; ?y \<in> carrier S;
               ?y' \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor S ?x ?y'\<close>)
      ["trans"]
  notes theorem
    "S.properfactor_prod_r" =
      \<open>\<lbrakk>properfactor S ?a ?b; ?a \<in> carrier S;
              ?b \<in> carrier S; ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> properfactor S ?a
                                (?b \<otimes>\<^bsub>S\<^esub> ?c)\<close>
  notes theorem
    "S.irreducible_prod_rI" =
      \<open>\<lbrakk>Divisibility.irreducible S ?a; ?b \<in> Units S;
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible S
                                (?a \<otimes>\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.listassoc_refl" =
      (\<open>set ?as \<subseteq> carrier S \<Longrightarrow>
              ?as [\<sim>]\<^bsub>S\<^esub> ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "S.listassoc_sym" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>S\<^esub> ?bs;
               set ?as \<subseteq> carrier S;
               set ?bs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> ?bs [\<sim>]\<^bsub>S\<^esub> ?as\<close>)
      ["sym"]
  notes theorem
    "S.listassoc_trans" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>S\<^esub> ?bs;
               ?bs [\<sim>]\<^bsub>S\<^esub> ?cs;
               set ?as \<subseteq> carrier S; set ?bs \<subseteq> carrier S;
               set ?cs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> ?as [\<sim>]\<^bsub>S\<^esub> ?cs\<close>)
      ["trans"]
  notes theorem
    "S.perm_assoc_switch" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>S\<^esub> ?bs;
              mset ?bs = mset ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  mset ?as = mset bs' \<and>
                                  bs' [\<sim>]\<^bsub>S\<^esub> ?cs\<close>
  notes theorem
    "S.perm_assoc_switch_r" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              ?bs [\<sim>]\<^bsub>S\<^esub> ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  ?as [\<sim>]\<^bsub>S\<^esub> bs' \<and>
                                  mset bs' = mset ?cs\<close>
  notes theorem
    "S.perm_closed" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> set ?bs \<subseteq> carrier S\<close>
  notes theorem
    "S.irrlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              \<forall>a\<in>set ?as. Divisibility.irreducible S a\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible S a\<close>
  notes theorem
    "S.essentially_equalI" =
      \<open>\<lbrakk>mset ?fs1.0 = mset ?fs1';
              ?fs1' [\<sim>]\<^bsub>S\<^esub> ?fs2.0\<rbrakk>
             \<Longrightarrow> essentially_equal S ?fs1.0 ?fs2.0\<close>
  notes theorem
    "S.essentially_equalE" =
      \<open>\<lbrakk>essentially_equal S ?fs1.0 ?fs2.0;
              \<And>fs1'.
                 \<lbrakk>mset ?fs1.0 = mset fs1';
                  fs1' [\<sim>]\<^bsub>S\<^esub> ?fs2.0\<rbrakk>
                 \<Longrightarrow> ?P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "S.ee_refl" =
      (\<open>set ?as \<subseteq> carrier S \<Longrightarrow>
              essentially_equal S ?as ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "S.ee_sym" =
      (\<open>\<lbrakk>essentially_equal S ?as ?bs;
               set ?as \<subseteq> carrier S;
               set ?bs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> essentially_equal S ?bs ?as\<close>)
      ["sym"]
  notes theorem
    "S.ee_trans" =
      (\<open>\<lbrakk>essentially_equal S ?as ?bs;
               essentially_equal S ?bs ?cs; set ?as \<subseteq> carrier S;
               set ?bs \<subseteq> carrier S;
               set ?cs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> essentially_equal S ?as ?cs\<close>)
      ["trans"]
  notes theorem
    "S.multlist_closed" =
      (\<open>set ?fs \<subseteq> carrier S \<Longrightarrow>
              foldr (\<otimes>\<^bsub>S\<^esub>) ?fs \<one>\<^bsub>S\<^esub>
              \<in> carrier S\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "S.factorsI" =
      \<open>\<lbrakk>\<forall>f\<in>set ?fs. Divisibility.irreducible S f;
              foldr (\<otimes>\<^bsub>S\<^esub>) ?fs
               \<one>\<^bsub>S\<^esub> =
              ?a\<rbrakk>
             \<Longrightarrow> factors S ?fs ?a\<close>
  notes theorem
    "S.factors_wfactors" =
      \<open>\<lbrakk>factors S ?as ?a;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> wfactors S ?as ?a\<close>
  notes theorem
    "S.wfactors_factors" =
      \<open>\<lbrakk>wfactors S ?as ?a;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> \<exists>a'.
                                  factors S ?as a' \<and>
                                  a' \<sim>\<^bsub>S\<^esub> ?a\<close>
  notes theorem
    "S.factors_closed" =
      (\<open>\<lbrakk>factors S ?fs ?a;
               set ?fs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> ?a \<in> carrier S\<close>)
      ["HOL.dest"]
  notes theorem
    "S.nunit_factors" =
      \<open>\<lbrakk>?a \<notin> Units S; factors S ?as ?a\<rbrakk>
             \<Longrightarrow> 0 < length ?as\<close>
  notes theorem
    "S.unit_wfactors" =
      (\<open>?a \<in> Units S \<Longrightarrow> wfactors S [] ?a\<close>)
      ["simp"]
  notes theorem
    "S.wfactors_cong_r" =
      (\<open>\<lbrakk>wfactors S ?fs ?a; ?a \<sim>\<^bsub>S\<^esub> ?a';
               ?a \<in> carrier S; ?a' \<in> carrier S;
               set ?fs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> wfactors S ?fs ?a'\<close>)
      ["trans"]
  notes theorem
    "S.wfactors_prod_exists" =
      (\<open>\<lbrakk>\<forall>a\<in>set ?as. Divisibility.irreducible S a;
