+(*the writer of the implicit structure (light locales, plan decision 16 (a)): the placeholder
+  is fixed once, outside body mode so that its internal name is the literal one that struct_tr
+  inserts; its declared type follows the value*)
+fun declare_implicit_structure t ctxt =
+  let
+    val x = Syntax_Trans.implicit_structure_;
+    val ctxt' =
+      if Variable.is_fixed ctxt x then ctxt
+      else
+        ctxt
+        |> Variable.set_body false
+        |> add_fixes [(Binding.name x, NONE, NoSyn)] |> #2
+        |> Variable.restore_body ctxt;
+  in
+    ctxt'
+    |> Variable.declare_constraints (Free (x, Term.fastype_of t))
+    |> Syntax_Trans.put_implicit_structure (SOME t)
+  end;
+
 
 
