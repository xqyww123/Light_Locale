  notes theorem
    "add.gfinprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier R \<Longrightarrow>
              gfinprod (add_monoid R) ?f ?A \<in> carrier R\<close>)
      ["simp"]
  notes theorem
    "add.gfinprod_cong" =
      \<open>\<lbrakk>?A = ?B; ?f \<in> ?B \<rightarrow> carrier R;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid R) ?f ?A =
                               gfinprod (add_monoid R) ?g ?B\<close>
  notes theorem
    "add.gfinprod_eq_finprod" =
      (\<open>\<lbrakk>finite ?A;
               ?f \<in> ?A \<rightarrow> carrier R\<rbrakk>
