      ["HOL.intro", "simp"]
  notes theorem
    "P.add.Units_inv_closed" =
      (\<open>?x \<in> Units (add_monoid P) \<Longrightarrow>
              inv\<^bsub>add_monoid P\<^esub> ?x \<in> carrier P\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.add.Units_l_inv_ex" =
      \<open>?x \<in> Units (add_monoid P) \<Longrightarrow>
