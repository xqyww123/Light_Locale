              wfactors (add_monoid S) ?bs ?b; ?a \<in> carrier S;
              ?b \<in> carrier S; set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.ee_wfactorsD" =
      \<open>\<lbrakk>essentially_equal (add_monoid S) ?as ?bs;
              wfactors (add_monoid S) ?as ?a;
              wfactors (add_monoid S) ?bs ?b; ?a \<in> carrier S;
              ?b \<in> carrier S; set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.ee_factorsD" =
      \<open>\<lbrakk>essentially_equal (add_monoid S) ?as ?bs;
              factors (add_monoid S) ?as ?a; factors (add_monoid S) ?bs ?b;
              set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.wfactors_mult" =
      (\<open>\<lbrakk>wfactors (add_monoid S) ?as ?a;
               wfactors (add_monoid S) ?bs ?b; ?a \<in> carrier S;
               ?b \<in> carrier S; set ?as \<subseteq> carrier S;
               set ?bs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> wfactors (add_monoid S) (?as @ ?bs)
                                 (?a \<oplus>\<^bsub>S\<^esub> ?b)\<close>)
      ["HOL.intro"]
  notes theorem
    "S.add.factorial_monoidI" =
      \<open>\<lbrakk>\<And>a.
                         \<lbrakk>a \<in> carrier S;
                          a \<notin> Units (add_monoid S)\<rbrakk>
                         \<Longrightarrow> \<exists>fs.
        set fs \<subseteq> carrier S \<and> wfactors (add_monoid S) fs a;
              \<And>a fs fs'.
                 \<lbrakk>a \<in> carrier S; set fs \<subseteq> carrier S;
                  set fs' \<subseteq> carrier S;
                  wfactors (add_monoid S) fs a;
                  wfactors (add_monoid S) fs' a\<rbrakk>
                 \<Longrightarrow> essentially_equal (add_monoid S) fs
                                    fs'\<rbrakk>
             \<Longrightarrow> factorial_monoid (add_monoid S)\<close>
  notes theorem
    "S.add.eqc_listassoc_cong" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid S\<^esub> ?bs;
              set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> map (\<lambda>x.
 closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
  {x})
                                ?as =
                               map (\<lambda>x.
 closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
  {x})
                                ?bs\<close>
  notes theorem
    "S.add.fmset_listassoc_cong" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid S\<^esub> ?bs;
              set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> fmset (add_monoid S) ?as =
                               fmset (add_monoid S) ?bs\<close>
  notes theorem
    "S.add.ee_fmset" =
      \<open>\<lbrakk>essentially_equal (add_monoid S) ?as ?bs;
              set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> fmset (add_monoid S) ?as =
                               fmset (add_monoid S) ?bs\<close>
  notes theorem
    "S.add.fmset_ee" =
      \<open>\<lbrakk>fmset (add_monoid S) ?as = fmset (add_monoid S) ?bs;
              set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> essentially_equal (add_monoid S) ?as
                                ?bs\<close>
  notes theorem
    "S.add.ee_is_fmset" =
      \<open>\<lbrakk>set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> essentially_equal (add_monoid S) ?as ?bs =
                               (fmset (add_monoid S) ?as =
                                fmset (add_monoid S) ?bs)\<close>
  notes theorem
    "S.add.fmset_wfactors_mult" =
      \<open>\<lbrakk>fmset (add_monoid S) ?cs =
                      fmset (add_monoid S) ?as + fmset (add_monoid S) ?bs;
              ?a \<in> carrier S; ?b \<in> carrier S; ?c \<in> carrier S;
              set ?as \<subseteq> carrier S; set ?bs \<subseteq> carrier S;
              set ?cs \<subseteq> carrier S; wfactors (add_monoid S) ?as ?a;
              wfactors (add_monoid S) ?bs ?b;
              wfactors (add_monoid S) ?cs ?c\<rbrakk>
             \<Longrightarrow> ?c \<sim>\<^bsub>add_monoid S\<^esub>
                               ?a \<oplus>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.add.fmsubset_divides" =
      \<open>\<lbrakk>fmset (add_monoid S) ?as \<subseteq>#
                      fmset (add_monoid S) ?bs;
              wfactors (add_monoid S) ?as ?a;
              wfactors (add_monoid S) ?bs ?b; ?a \<in> carrier S;
              ?b \<in> carrier S; set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.multlist_prime_pos" =
      \<open>\<lbrakk>Divisibility.prime (add_monoid S) ?a;
              ?a \<in> carrier S; set ?as \<subseteq> carrier S;
              ?a divides\<^bsub>add_monoid S\<^esub>
              foldr (\<oplus>\<^bsub>S\<^esub>) ?as
               \<zero>\<^bsub>S\<^esub>\<rbrakk>
             \<Longrightarrow> \<exists>i<length ?as.
                                  ?a divides\<^bsub>add_monoid S\<^esub>
                                  ?as ! i\<close>
  notes
    "S.add.comm_group_axioms" = (\<open>comm_group (add_monoid S)\<close>)
      ["attribute" "internal"]
  notes theorem
    "S.add.inv_mult" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
