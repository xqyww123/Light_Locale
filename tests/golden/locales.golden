              \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.add.nat_pow_Suc" =
      (\<open>[Suc ?n] \<cdot>\<^bsub>S\<^esub> ?x =
              [?n] \<cdot>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub>
