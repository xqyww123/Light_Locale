                               ?a \<odot>\<^bsub>P\<^esub> ?p\<close>
  notes theorem
    "monom_one" =
      (\<open>up_ring.monom P \<one> 0 = \<one>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "monom_add" =
      (\<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
