      ["simp"]
  notes theorem
    "deg_zero" = (\<open>deg R \<zero>\<^bsub>P\<^esub> = 0\<close>)
      ["simp"]
  notes theorem
    "deg_one" = (\<open>deg R \<one>\<^bsub>P\<^esub> = 0\<close>) ["simp"]
  notes theorem
    "deg_uminus" =
      (\<open>?p \<in> carrier P \<Longrightarrow>
              deg R (\<ominus>\<^bsub>P\<^esub> ?p) = deg R ?p\<close>)
      ["simp"]
  notes theorem
    "deg_smult_ring" =
      (\<open>\<lbrakk>?a \<in> carrier R; ?p \<in> carrier P\<rbrakk>
              \<Longrightarrow> deg R (?a \<odot>\<^bsub>P\<^esub> ?p)
                                \<le> (if ?a = \<zero> then 0
 else deg R ?p)\<close>)
      ["simp"]
  notes theorem
    "deg_mult_ring" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
             \<Longrightarrow> deg R (?p \<otimes>\<^bsub>P\<^esub> ?q)
                               \<le> deg R ?p + deg R ?q\<close>
  notes theorem
    "coeff_finsum" =
      \<open>\<lbrakk>finite ?A;
              ?p \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> up_ring.coeff P (finsum P ?p ?A) ?k =
                               (\<Oplus>i\<in>?A. up_ring.coeff P (?p i)
             ?k)\<close>
  notes theorem
    "up_repr" =
      \<open>?p \<in> carrier P \<Longrightarrow>
