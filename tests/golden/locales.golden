             \<Longrightarrow> ?H <+> (?K +> ?x) = ?H <+> ?K +> ?x\<close>
  notes theorem
    "a_rcos_assoc_lcos" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?K \<subseteq> carrier R;
