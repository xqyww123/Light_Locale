      ["simp"]
  notes theorem
    "P.add.nat_pow_one" =
      (\<open>[?n] \<cdot>\<^bsub>P\<^esub> \<zero>\<^bsub>P\<^esub> =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.nat_pow_mult" =
      \<open>?x \<in> carrier P \<Longrightarrow>
