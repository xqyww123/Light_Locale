                               finsum R ?g ?A\<close>
  notes theorem
    "finsum_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier R;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum R ?f ?A = finsum R ?g ?B\<close>
  notes theorem
    "finsum_0" =
      \<open>?f \<in> {0} \<rightarrow> carrier R \<Longrightarrow>
             finsum R ?f {..0} = ?f 0\<close>
  notes theorem
    "finsum_Suc" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier R \<Longrightarrow>
             finsum R ?f {..Suc ?n} =
             ?f (Suc ?n) \<oplus> finsum R ?f {..?n}\<close>
  notes theorem
    "finsum_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier R \<Longrightarrow>
             finsum R ?f {..Suc ?n} =
             (\<Oplus>i\<in>{..?n}. ?f (Suc i)) \<oplus> ?f 0\<close>
  notes theorem
    "finsum_infinite" =
      \<open>infinite ?A \<Longrightarrow> finsum R ?f ?A = \<zero>\<close>
  notes theorem
    "finsum_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier R) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum R ?f ?A = finsum R ?g ?B\<close>
  notes theorem
    "finsum_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier R;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finsum R ?f (?h ` ?A) =
                               (\<Oplus>x\<in>?A. ?f (?h x))\<close>
  notes theorem
    "finsum_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> (\<Oplus>j\<in>?A. if ?i = j then ?f j
            else \<zero>) =
                               ?f ?i\<close>
  notes theorem
    "a_r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H +> ?x \<subseteq> carrier R\<close>
  notes theorem
    "set_add_closed" =
      \<open>\<lbrakk>?A \<subseteq> carrier R;
              ?B \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?A <+> ?B \<subseteq> carrier R\<close>
  notes theorem
    "boundD_carrier" =
      \<open>\<lbrakk>bound \<zero> ?n ?f; ?n < ?m\<rbrakk>
             \<Longrightarrow> ?f ?m \<in> carrier R\<close>
