             [?n] \<cdot>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.add.nat_pow_pow" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             [?m] \<cdot>\<^bsub>P\<^esub> ([?n] \<cdot>\<^bsub>P\<^esub> ?x) =
