                               RDirProd (P Quot ?I) (P Quot ?J)\<close>
  notes theorem
    "P.canonical_proj_ext_zero" =
      (\<open>P.canonical_proj_ext ?I 0 =
              (\<lambda>a. [?I 0 +>\<^bsub>P\<^esub> a])\<close>)
      ["simp"]
  notes theorem
    "P.canonical_proj_ext_tl" =
      \<open>P.canonical_proj_ext ?I (Suc ?n) =
             (\<lambda>a.
                 (?I 0 +>\<^bsub>P\<^esub> a) #
                 P.canonical_proj_ext (\<lambda>i. ?I (Suc i)) ?n a)\<close>
  notes theorem
    "P.canonical_proj_ext_is_hom" =
      \<open>(\<And>i.
                 i \<le> ?n \<Longrightarrow>
                 ideal (?I i) P) \<Longrightarrow>
             P.canonical_proj_ext ?I ?n
             \<in> ring_hom P
                    (RDirProd_list
                      (map (\<lambda>i. P Quot ?I i) [0..<Suc ?n]))\<close>
  notes theorem
    "P.RDirProd_Quot_list_is_ring" =
      \<open>(\<And>i.
                 i \<le> ?n \<Longrightarrow>
                 ideal (?I i) P) \<Longrightarrow>
             ring
              (RDirProd_list
                (map (\<lambda>i. P Quot ?I i) [0..<Suc ?n]))\<close>
  notes theorem
    "P.canonical_proj_ext_ring_hom" =
      \<open>(\<And>i.
                 i \<le> ?n \<Longrightarrow>
                 ideal (?I i) P) \<Longrightarrow>
             ring_hom_ring P
              (RDirProd_list (map (\<lambda>i. P Quot ?I i) [0..<Suc ?n]))
              (P.canonical_proj_ext ?I ?n)\<close>
  notes theorem
    "P.canonical_proj_ext_ker" =
      \<open>(\<And>i.
                 i \<le> ?n \<Longrightarrow>
                 ideal (?I i) P) \<Longrightarrow>
             a_kernel P
              (RDirProd_list (map (\<lambda>i. P Quot ?I i) [0..<Suc ?n]))
              (P.canonical_proj_ext ?I ?n) =
             \<Inter> (?I ` {..?n})\<close>
  notes theorem
    "P.generate_ring_in_carrier" =
      \<open>\<lbrakk>?H \<subseteq> carrier P;
              ?h \<in> generate_ring P ?H\<rbrakk>
             \<Longrightarrow> ?h \<in> carrier P\<close>
  notes theorem
    "P.generate_ring_incl" =
      \<open>?H \<subseteq> carrier P \<Longrightarrow>
             generate_ring P ?H \<subseteq> carrier P\<close>
  notes theorem
    "P.zero_in_generate" =
      \<open>\<zero>\<^bsub>P\<^esub> \<in> generate_ring P ?H\<close>
  notes theorem
    "P.generate_ring_is_subring" =
      \<open>?H \<subseteq> carrier P \<Longrightarrow>
             subring (generate_ring P ?H) P\<close>
  notes theorem
    "P.generate_ring_is_ring" =
      \<open>?H \<subseteq> carrier P \<Longrightarrow>
             ring (P\<lparr>carrier := generate_ring P ?H\<rparr>)\<close>
  notes theorem
    "P.generate_ring_min_subring1" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; subring ?E P;
              ?H \<subseteq> ?E\<rbrakk>
             \<Longrightarrow> generate_ring P ?H \<subseteq> ?E\<close>
  notes theorem
    "P.generate_ringI" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; subring ?E P;
              ?H \<subseteq> ?E;
              \<And>K.
                 \<lbrakk>subring K P; ?H \<subseteq> K\<rbrakk>
                 \<Longrightarrow> ?E \<subseteq> K\<rbrakk>
             \<Longrightarrow> ?E = generate_ring P ?H\<close>
  notes theorem
    "P.generate_ringE" =
      \<open>\<lbrakk>?H \<subseteq> carrier P;
              ?E = generate_ring P ?H\<rbrakk>
             \<Longrightarrow> subring ?E P\<close>
      \<open>\<lbrakk>?H \<subseteq> carrier P;
              ?E = generate_ring P ?H\<rbrakk>
             \<Longrightarrow> ?H \<subseteq> ?E\<close>
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?E = generate_ring P ?H;
              subring ?K P; ?H \<subseteq> ?K\<rbrakk>
             \<Longrightarrow> ?E \<subseteq> ?K\<close>
  notes theorem
    "P.generate_ring_min_subring2" =
      \<open>?H \<subseteq> carrier P \<Longrightarrow>
             generate_ring P ?H =
             \<Inter> {K. subring K P \<and> ?H \<subseteq> K}\<close>
  notes theorem
    "P.mono_generate_ring" =
      \<open>\<lbrakk>?I \<subseteq> ?J; ?J \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> generate_ring P ?I
                               \<subseteq> generate_ring P ?J\<close>
  notes theorem
    "P.subring_gen_incl" =
      \<open>\<lbrakk>subring ?H P; subring ?K P; ?I \<subseteq> ?H;
              ?I \<subseteq> ?K\<rbrakk>
             \<Longrightarrow> generate_ring
                                (P\<lparr>carrier := ?K\<rparr>) ?I
                               \<subseteq> generate_ring
      (P\<lparr>carrier := ?H\<rparr>) ?I\<close>
  notes theorem
    "P.subring_gen_equality" =
      \<open>\<lbrakk>subring ?H P; ?K \<subseteq> ?H\<rbrakk>
             \<Longrightarrow> generate_ring P ?K =
                               generate_ring
                                (P\<lparr>carrier := ?H\<rparr>) ?K\<close>
  notes
    "UP_ring_axioms" = (\<open>UP_ring R\<close>) ["attribute" "internal"]
  notes theorem
    "coeff_monom" =
      (\<open>?a \<in> carrier R \<Longrightarrow>
              up_ring.coeff P (up_ring.monom P ?a ?m) ?n =
              (if ?m = ?n then ?a else \<zero>)\<close>)
      ["simp"]
  notes theorem
    "coeff_zero" =
      (\<open>up_ring.coeff P \<zero>\<^bsub>P\<^esub> ?n = \<zero>\<close>)
      ["simp"]
  notes theorem
    "coeff_one" =
      (\<open>up_ring.coeff P \<one>\<^bsub>P\<^esub> ?n =
              (if ?n = 0 then \<one> else \<zero>)\<close>)
      ["simp"]
  notes theorem
    "coeff_smult" =
      (\<open>\<lbrakk>?a \<in> carrier R; ?p \<in> carrier P\<rbrakk>
              \<Longrightarrow> up_ring.coeff P
                                 (?a \<odot>\<^bsub>P\<^esub> ?p) ?n =
                                ?a \<otimes> up_ring.coeff P ?p ?n\<close>)
      ["simp"]
  notes theorem
    "coeff_add" =
      (\<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
              \<Longrightarrow> up_ring.coeff P
                                 (?p \<oplus>\<^bsub>P\<^esub> ?q) ?n =
                                up_ring.coeff P ?p ?n \<oplus>
                                up_ring.coeff P ?q ?n\<close>)
      ["simp"]
  notes theorem
    "coeff_mult" =
      (\<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
              \<Longrightarrow> up_ring.coeff P
                                 (?p \<otimes>\<^bsub>P\<^esub> ?q) ?n =
                                (\<Oplus>i\<in>{..?n}. up_ring.coeff P ?p
                  i \<otimes>
                 up_ring.coeff P ?q (?n - i))\<close>)
      ["simp"]
  notes theorem
    "UP_mult_closed" =
      (\<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?p \<otimes>\<^bsub>P\<^esub> ?q
                                \<in> carrier P\<close>)
      ["simp"]
  notes theorem
    "UP_one_closed" =
      (\<open>\<one>\<^bsub>P\<^esub> \<in> carrier P\<close>) ["simp"]
  notes theorem
    "UP_zero_closed" =
      (\<open>\<zero>\<^bsub>P\<^esub> \<in> carrier P\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "UP_a_closed" =
      (\<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?p \<oplus>\<^bsub>P\<^esub> ?q
                                \<in> carrier P\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "monom_closed" =
      (\<open>?a \<in> carrier R \<Longrightarrow>
              up_ring.monom P ?a ?n \<in> carrier P\<close>)
      ["simp"]
  notes theorem
    "UP_smult_closed" =
      (\<open>\<lbrakk>?a \<in> carrier R; ?p \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?a \<odot>\<^bsub>P\<^esub> ?p
                                \<in> carrier P\<close>)
      ["simp"]
  notes theorem
    "UP_a_assoc" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?r \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?p \<oplus>\<^bsub>P\<^esub>
                               ?q \<oplus>\<^bsub>P\<^esub>
                               ?r =
                               ?p \<oplus>\<^bsub>P\<^esub>
                               (?q \<oplus>\<^bsub>P\<^esub> ?r)\<close>
  notes theorem
    "UP_l_zero" =
      (\<open>?p \<in> carrier P \<Longrightarrow>
              \<zero>\<^bsub>P\<^esub> \<oplus>\<^bsub>P\<^esub> ?p =
              ?p\<close>)
      ["simp"]
  notes theorem
    "UP_l_neg_ex" =
      \<open>?p \<in> carrier P \<Longrightarrow>
             \<exists>q\<in>carrier P.
                q \<oplus>\<^bsub>P\<^esub> ?p =
                \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "UP_a_comm" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?p \<oplus>\<^bsub>P\<^esub> ?q =
                               ?q \<oplus>\<^bsub>P\<^esub> ?p\<close>
  notes theorem
    "UP_m_assoc" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?r \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?p \<otimes>\<^bsub>P\<^esub>
                               ?q \<otimes>\<^bsub>P\<^esub>
                               ?r =
                               ?p \<otimes>\<^bsub>P\<^esub>
                               (?q \<otimes>\<^bsub>P\<^esub> ?r)\<close>
  notes theorem
    "UP_r_one" =
      (\<open>?p \<in> carrier P \<Longrightarrow>
              ?p \<otimes>\<^bsub>P\<^esub> \<one>\<^bsub>P\<^esub> =
              ?p\<close>)
      ["simp"]
  notes theorem
    "UP_l_one" =
      (\<open>?p \<in> carrier P \<Longrightarrow>
              \<one>\<^bsub>P\<^esub> \<otimes>\<^bsub>P\<^esub> ?p =
              ?p\<close>)
      ["simp"]
  notes theorem
    "UP_l_distr" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?r \<in> carrier P\<rbrakk>
             \<Longrightarrow> (?p \<oplus>\<^bsub>P\<^esub>
                                ?q) \<otimes>\<^bsub>P\<^esub>
                               ?r =
                               ?p \<otimes>\<^bsub>P\<^esub>
                               ?r \<oplus>\<^bsub>P\<^esub>
                               ?q \<otimes>\<^bsub>P\<^esub> ?r\<close>
  notes theorem
    "UP_r_distr" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?r \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?r \<otimes>\<^bsub>P\<^esub>
                               (?p \<oplus>\<^bsub>P\<^esub> ?q) =
                               ?r \<otimes>\<^bsub>P\<^esub>
                               ?p \<oplus>\<^bsub>P\<^esub>
                               ?r \<otimes>\<^bsub>P\<^esub> ?q\<close>
