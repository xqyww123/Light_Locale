                               (fmset (add_monoid P) ?as =
                                fmset (add_monoid P) ?bs)\<close>
  notes theorem
    "P.add.fmset_wfactors_mult" =
      \<open>\<lbrakk>fmset (add_monoid P) ?cs =
                      fmset (add_monoid P) ?as + fmset (add_monoid P) ?bs;
              ?a \<in> carrier P; ?b \<in> carrier P; ?c \<in> carrier P;
              set ?as \<subseteq> carrier P; set ?bs \<subseteq> carrier P;
              set ?cs \<subseteq> carrier P; wfactors (add_monoid P) ?as ?a;
              wfactors (add_monoid P) ?bs ?b;
              wfactors (add_monoid P) ?cs ?c\<rbrakk>
             \<Longrightarrow> ?c \<sim>\<^bsub>add_monoid P\<^esub>
                               ?a \<oplus>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.add.fmsubset_divides" =
      \<open>\<lbrakk>fmset (add_monoid P) ?as \<subseteq>#
                      fmset (add_monoid P) ?bs;
              wfactors (add_monoid P) ?as ?a;
              wfactors (add_monoid P) ?bs ?b; ?a \<in> carrier P;
              ?b \<in> carrier P; set ?as \<subseteq> carrier P;
              set ?bs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>add_monoid P\<^esub>
                               ?b\<close>
  notes theorem
    "P.add.multlist_prime_pos" =
