  notes theorem
    "R.add.pow_eq_div2" =
      \<open>\<lbrakk>?x \<in> carrier R;
              [?m] \<cdot> ?x = [?n] \<cdot> ?x\<rbrakk>
             \<Longrightarrow> [(?m - ?n)] \<cdot> ?x = \<zero>\<close>
  notes theorem
    "R.add.triv_subgroup" = \<open>subgroup {\<zero>} (add_monoid R)\<close>
  notes theorem
    "R.add.subgroup_Units" =
