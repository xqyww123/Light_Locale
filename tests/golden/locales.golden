  notes theorem
    "add.int_pow_neg_int" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [(- int ?n)] \<cdot> ?x = \<ominus> ([?n] \<cdot> ?x)\<close>
  notes theorem
    "add.int_pow_mult" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [(?i + ?j)] \<cdot> ?x =
             [?i] \<cdot> ?x \<oplus> [?j] \<cdot> ?x\<close>
  notes theorem
    "add.int_pow_inv" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?i] \<cdot> (\<ominus> ?x) =
             \<ominus> ([?i] \<cdot> ?x)\<close>
  notes theorem
    "add.int_pow_pow" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?m] \<cdot> ([?n] \<cdot> ?x) = [(?n * ?m)] \<cdot> ?x\<close>
  notes theorem
    "add.int_pow_diff" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [(?n - ?m)] \<cdot> ?x =
             [?n] \<cdot> ?x \<oplus> \<ominus> ([?m] \<cdot> ?x)\<close>
  notes theorem
    "add.inj_on_multc" =
      \<open>?c \<in> carrier R \<Longrightarrow>
             inj_on (\<lambda>x. x \<oplus> ?c) (carrier R)\<close>
  notes theorem
    "add.inj_on_cmult" =
      \<open>?c \<in> carrier R \<Longrightarrow>
             inj_on ((\<oplus>) ?c) (carrier R)\<close>
  notes theorem
    "add.int_pow_mult_distrib" =
      \<open>\<lbrakk>?x \<oplus> ?y = ?y \<oplus> ?x; ?x \<in> carrier R;
              ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> [?i] \<cdot> (?x \<oplus> ?y) =
                               [?i] \<cdot> ?x \<oplus>
                               [?i] \<cdot> ?y\<close>
  notes theorem
    "add.pow_eq_div2" =
      \<open>\<lbrakk>?x \<in> carrier R;
              [?m] \<cdot> ?x = [?n] \<cdot> ?x\<rbrakk>
             \<Longrightarrow> [(?m - ?n)] \<cdot> ?x = \<zero>\<close>
  notes theorem
    "add.triv_subgroup" = \<open>subgroup {\<zero>} (add_monoid R)\<close>
  notes theorem
    "add.subgroup_Units" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             ?H \<subseteq> Units
                             (add_monoid R
                              \<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "add.m_inv_consistent" =
      (\<open>\<lbrakk>subgroup ?H (add_monoid R); ?x \<in> ?H\<rbrakk>
              \<Longrightarrow> inv\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                                \<ominus> ?x\<close>)
      ["simp"]
  notes theorem
    "add.int_pow_consistent" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> [?n] \<cdot> ?x =
                               ?x [^]\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub>
                               ?n\<close>
  notes theorem
    "add.one_in_subset" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?H \<noteq> {};
              \<forall>a\<in>?H. \<ominus> a \<in> ?H;
              \<forall>a\<in>?H.
                 \<forall>b\<in>?H. a \<oplus> b \<in> ?H\<rbrakk>
             \<Longrightarrow> \<zero> \<in> ?H\<close>
  notes theorem
    "add.subgroupI" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?H \<noteq> {};
              \<And>a. a \<in> ?H \<Longrightarrow> \<ominus> a \<in> ?H;
              \<And>a b.
                 \<lbrakk>a \<in> ?H; b \<in> ?H\<rbrakk>
                 \<Longrightarrow> a \<oplus> b \<in> ?H\<rbrakk>
             \<Longrightarrow> subgroup ?H (add_monoid R)\<close>
  notes theorem
    "add.subgroupE" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             ?H \<subseteq> carrier R\<close>
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             ?H \<noteq> {}\<close>
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?a \<in> ?H\<rbrakk>
             \<Longrightarrow> \<ominus> ?a \<in> ?H\<close>
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?a \<in> ?H;
              ?b \<in> ?H\<rbrakk>
             \<Longrightarrow> ?a \<oplus> ?b \<in> ?H\<close>
  notes theorem
    "add.submonoid_subgroupI" =
      \<open>\<lbrakk>submonoid ?H (add_monoid R);
              \<And>a.
                 a \<in> ?H \<Longrightarrow> \<ominus> a \<in> ?H\<rbrakk>
             \<Longrightarrow> subgroup ?H (add_monoid R)\<close>
  notes theorem
    "add.group_incl_imp_subgroup" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              Group.group
               (add_monoid R\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> subgroup ?H (add_monoid R)\<close>
  notes theorem
    "add.hom_restrict" =
      \<open>\<lbrakk>?h \<in> hom (add_monoid R) ?H;
              \<And>g.
                 g \<in> carrier R \<Longrightarrow> ?h g = ?t g\<rbrakk>
             \<Longrightarrow> ?t \<in> hom (add_monoid R) ?H\<close>
  notes theorem
    "add.hom_compose" =
      \<open>\<lbrakk>?h \<in> hom (add_monoid R) ?H;
              ?i \<in> hom ?H ?I\<rbrakk>
             \<Longrightarrow> compose (carrier R) ?i ?h
                               \<in> hom (add_monoid R) ?I\<close>
  notes theorem
    "add.restrict_hom_iff" =
      (\<open>((\<lambda>x. if x \<in> carrier R then ?f x else ?g x)
               \<in> hom (add_monoid R) ?H) =
              (?f \<in> hom (add_monoid R) ?H)\<close>)
      ["simp"]
  notes theorem
    "add.hom_eq" =
      \<open>\<lbrakk>?f \<in> hom (add_monoid R) ?H;
              \<And>x.
                 x \<in> carrier R \<Longrightarrow> ?f' x = ?f x\<rbrakk>
             \<Longrightarrow> ?f' \<in> hom (add_monoid R) ?H\<close>
  notes theorem
    "add.iso_eq" =
      \<open>\<lbrakk>?f \<in> Group.iso (add_monoid R) ?H;
              \<And>x.
                 x \<in> carrier R \<Longrightarrow> ?f' x = ?f x\<rbrakk>
             \<Longrightarrow> ?f' \<in> Group.iso (add_monoid R) ?H\<close>
  notes theorem
    "add.iso_set_sym" =
      \<open>?h \<in> Group.iso (add_monoid R) ?H \<Longrightarrow>
             inv_into (carrier R) ?h
             \<in> Group.iso ?H (add_monoid R)\<close>
  notes theorem
    "add.iso_sym" =
      \<open>add_monoid R \<cong> ?H \<Longrightarrow>
             ?H \<cong> add_monoid R\<close>
  notes theorem
    "add.hom_imp_img_group" =
      \<open>?h \<in> hom (add_monoid R) ?H \<Longrightarrow>
             Group.group
              (?H\<lparr>carrier := ?h ` carrier R,
                    one := ?h \<zero>\<rparr>)\<close>
  notes theorem
    "add.iso_imp_group" =
      \<open>\<lbrakk>add_monoid R \<cong> ?H; Group.monoid ?H\<rbrakk>
             \<Longrightarrow> Group.group ?H\<close>
  notes theorem
    "add.iso_imp_img_group" =
      \<open>?h \<in> Group.iso (add_monoid R) ?H \<Longrightarrow>
             Group.group (?H\<lparr>one := ?h \<zero>\<rparr>)\<close>
  notes theorem
    "add.iso_iff_group_isomorphisms" =
      \<open>(?f \<in> Group.iso (add_monoid R) ?H) =
             (\<exists>g. group_isomorphisms (add_monoid R) ?H ?f g)\<close>
  notes theorem
    "add.DirProd_iso_set_trans" =
      \<open>\<lbrakk>?g \<in> Group.iso (add_monoid R) ?G2.0;
              ?h \<in> Group.iso ?H ?I\<rbrakk>
             \<Longrightarrow> (\<lambda>(x, y). (?g x, ?h y))
                               \<in> Group.iso
(add_monoid R \<times>\<times> ?H) (?G2.0 \<times>\<times> ?I)\<close>
  notes theorem
    "add.DirProd_iso_trans" =
      \<open>\<lbrakk>add_monoid R \<cong> ?G2.0; ?H \<cong> ?I\<rbrakk>
             \<Longrightarrow> add_monoid R \<times>\<times> ?H \<cong>
                               ?G2.0 \<times>\<times> ?I\<close>
  notes theorem
    "add.int_pow_is_hom" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             (\<lambda>k. [k] \<cdot> ?x)
             \<in> hom \<lparr>carrier = UNIV, monoid.mult = (+),
                          one = 0\<rparr>
                    (add_monoid R)\<close>
  notes theorem
    "add.canonical_inj_is_hom" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             group_hom (add_monoid R\<lparr>carrier := ?H\<rparr>)
              (add_monoid R) id\<close>
  notes theorem
    "add.group_comm_groupI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier R; y \<in> carrier R\<rbrakk>
                 \<Longrightarrow> x \<oplus> y =
                                   y \<oplus> x) \<Longrightarrow>
             comm_group (add_monoid R)\<close>
  notes theorem
    "add.incl_subgroup" =
      \<open>\<lbrakk>subgroup ?J (add_monoid R);
              subgroup ?I
               (add_monoid R\<lparr>carrier := ?J\<rparr>)\<rbrakk>
             \<Longrightarrow> subgroup ?I (add_monoid R)\<close>
  notes theorem
    "add.subgroup_incl" =
      \<open>\<lbrakk>subgroup ?I (add_monoid R);
              subgroup ?J (add_monoid R); ?I \<subseteq> ?J\<rbrakk>
             \<Longrightarrow> subgroup ?I
                                (add_monoid R
                                 \<lparr>carrier := ?J\<rparr>)\<close>
  notes theorem
    "add.subgroups_partial_order" =
      \<open>partial_order
              \<lparr>carrier = {H. subgroup H (add_monoid R)}, eq = (=),
                 le = (\<subseteq>)\<rparr>\<close>
  notes theorem
    "add.subgroup_self" = \<open>subgroup (carrier R) (add_monoid R)\<close>
  notes theorem
    "add.subgroup_imp_group" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             Group.group (add_monoid R\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "add.subgroup_mult_equality" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?h1.0 \<in> ?H;
              ?h2.0 \<in> ?H\<rbrakk>
             \<Longrightarrow> ?h1.0 \<otimes>\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub>
                               ?h2.0 =
                               ?h1.0 \<oplus> ?h2.0\<close>
  notes theorem
    "add.subgroups_Inter" =
      \<open>\<lbrakk>\<And>H.
                         H \<in> ?A \<Longrightarrow>
                         subgroup H (add_monoid R);
              ?A \<noteq> {}\<rbrakk>
             \<Longrightarrow> subgroup (\<Inter> ?A) (add_monoid R)\<close>
  notes theorem
    "add.subgroups_Inter_pair" =
      \<open>\<lbrakk>subgroup ?I (add_monoid R);
              subgroup ?J (add_monoid R)\<rbrakk>
             \<Longrightarrow> subgroup (?I \<inter> ?J)
                                (add_monoid R)\<close>
  notes theorem
    "add.subgroups_complete_lattice" =
      \<open>complete_lattice
              \<lparr>carrier = {H. subgroup H (add_monoid R)}, eq = (=),
                 le = (\<subseteq>)\<rparr>\<close>
  notes theorem
    "add.surj_const_mult" =
      \<open>?a \<in> carrier R \<Longrightarrow>
             (\<oplus>) ?a ` carrier R = carrier R\<close>
  notes theorem
    "add.l_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x \<oplus> ?a = ?x) =
                                (?a = \<zero>)\<close>)
      ["simp"]
  notes theorem
    "add.r_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?a \<oplus> ?x = ?x) =
                                (?a = \<zero>)\<close>)
      ["simp"]
  notes theorem
    "add.l_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x = ?x \<oplus> ?a) =
                                (?a = \<zero>)\<close>)
      ["simp"]
  notes theorem
    "add.r_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x = ?a \<oplus> ?x) =
                                (?a = \<zero>)\<close>)
      ["simp"]
  notes theorem
    "add.diff_neutralizes" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              ?R \<in> rcosets\<^bsub>add_monoid R\<^esub> ?H;
              ?r1.0 \<in> ?R; ?r2.0 \<in> ?R\<rbrakk>
             \<Longrightarrow> ?r1.0 \<oplus> \<ominus> ?r2.0
                               \<in> ?H\<close>
  notes theorem
    "add.setmult_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              ?K \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid R\<^esub> ?K
                               \<subseteq> carrier R\<close>
  notes theorem
    "add.set_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier R; ?H \<subseteq> carrier R;
              ?K \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?M <#>\<^bsub>add_monoid R\<^esub>
                               ?H <#>\<^bsub>add_monoid R\<^esub>
                               ?K =
                               ?M <#>\<^bsub>add_monoid R\<^esub>
                               (?H <#>\<^bsub>add_monoid R\<^esub>
                                ?K)\<close>
  notes theorem
    "add.coset_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier R; ?g \<in> carrier R;
              ?h \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid R\<^esub>
                               ?g #>\<^bsub>add_monoid R\<^esub>
                               ?h =
                               ?M #>\<^bsub>add_monoid R\<^esub>
                               ?g \<oplus> ?h\<close>
  notes theorem
    "add.coset_assoc" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?H \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub>
                               (?H #>\<^bsub>add_monoid R\<^esub> ?y) =
                               ?x <#\<^bsub>add_monoid R\<^esub>
                               ?H #>\<^bsub>add_monoid R\<^esub>
                               ?y\<close>
  notes theorem
    "add.coset_mult_one" =
      (\<open>?M \<subseteq> carrier R \<Longrightarrow>
              ?M #>\<^bsub>add_monoid R\<^esub> \<zero> = ?M\<close>)
      ["simp"]
  notes theorem
    "add.coset_mult_inv1" =
      \<open>\<lbrakk>?M #>\<^bsub>add_monoid R\<^esub>
                      ?x \<oplus> \<ominus> ?y =
                      ?M;
              ?x \<in> carrier R; ?y \<in> carrier R;
              ?M \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid R\<^esub> ?x =
                               ?M #>\<^bsub>add_monoid R\<^esub> ?y\<close>
  notes theorem
    "add.coset_mult_inv2" =
      \<open>\<lbrakk>?M #>\<^bsub>add_monoid R\<^esub> ?x =
                      ?M #>\<^bsub>add_monoid R\<^esub> ?y;
              ?x \<in> carrier R; ?y \<in> carrier R;
              ?M \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid R\<^esub>
                               ?x \<oplus> \<ominus> ?y =
                               ?M\<close>
  notes theorem
    "add.coset_join1" =
      \<open>\<lbrakk>?H #>\<^bsub>add_monoid R\<^esub> ?x = ?H;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H\<close>
  notes theorem
    "add.solve_equation" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?x \<in> ?H;
              ?y \<in> ?H\<rbrakk>
             \<Longrightarrow> \<exists>h\<in>?H. ?y = h \<oplus> ?x\<close>
  notes theorem
    "add.repr_independence" =
      \<open>\<lbrakk>?y \<in> ?H #>\<^bsub>add_monoid R\<^esub> ?x;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid R\<^esub> ?x =
                               ?H #>\<^bsub>add_monoid R\<^esub> ?y\<close>
  notes theorem
    "add.coset_join2" =
      \<open>\<lbrakk>?x \<in> carrier R; subgroup ?H (add_monoid R);
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid R\<^esub> ?x =
                               ?H\<close>
  notes theorem
    "add.coset_join3" =
      \<open>\<lbrakk>?x \<in> carrier R; subgroup ?H (add_monoid R);
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub> ?H =
                               ?H\<close>
  notes theorem
    "add.rcosI" =
      \<open>\<lbrakk>?h \<in> ?H; ?H \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?h \<oplus> ?x
                               \<in> ?H #>\<^bsub>add_monoid R\<^esub>
                                     ?x\<close>
  notes theorem
    "add.rcosetsI" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid R\<^esub> ?x
                               \<in> rcosets\<^bsub>add_monoid R\<^esub> ?H\<close>
  notes theorem
    "add.rcos_self" =
      \<open>\<lbrakk>?x \<in> carrier R;
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H #>\<^bsub>add_monoid R\<^esub>
  ?x\<close>
  notes theorem
    "add.repr_independenceD" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?y \<in> carrier R;
              ?H #>\<^bsub>add_monoid R\<^esub> ?x =
              ?H #>\<^bsub>add_monoid R\<^esub> ?y\<rbrakk>
             \<Longrightarrow> ?y \<in> ?H #>\<^bsub>add_monoid R\<^esub>
  ?x\<close>
  notes theorem
    "add.normalI" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              \<forall>x\<in>carrier R.
                 ?H #>\<^bsub>add_monoid R\<^esub> x =
                 x <#\<^bsub>add_monoid R\<^esub> ?H\<rbrakk>
             \<Longrightarrow> ?H \<lhd> add_monoid R\<close>
  notes theorem
    "add.normal_inv_iff" =
      \<open>?N \<lhd> add_monoid R =
             (subgroup ?N (add_monoid R) \<and>
              (\<forall>x\<in>carrier R.
                  \<forall>h\<in>?N.
                     x \<oplus> h \<oplus> \<ominus> x \<in> ?N))\<close>
  notes theorem
    "add.normal_invI" =
      \<open>\<lbrakk>subgroup ?N (add_monoid R);
              \<And>x h.
                 \<lbrakk>x \<in> carrier R; h \<in> ?N\<rbrakk>
                 \<Longrightarrow> x \<oplus> h \<oplus> \<ominus> x
                                   \<in> ?N\<rbrakk>
             \<Longrightarrow> ?N \<lhd> add_monoid R\<close>
  notes theorem
    "add.normal_invE" =
      \<open>?N \<lhd> add_monoid R \<Longrightarrow>
             subgroup ?N (add_monoid R)\<close>
      \<open>\<lbrakk>?N \<lhd> add_monoid R; ?x \<in> carrier R;
              ?h \<in> ?N\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?h \<oplus> \<ominus> ?x
                               \<in> ?N\<close>
  notes theorem
    "add.one_is_normal" = \<open>{\<zero>} \<lhd> add_monoid R\<close>
  notes theorem
    "add.normal_subgroup_intersect" =
      \<open>\<lbrakk>?M \<lhd> add_monoid R;
              ?N \<lhd> add_monoid R\<rbrakk>
             \<Longrightarrow> ?M \<inter> ?N \<lhd> add_monoid R\<close>
  notes theorem
    "add.setmult_lcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?K \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub>
                               ?H <#>\<^bsub>add_monoid R\<^esub>
                               ?K =
                               ?x <#\<^bsub>add_monoid R\<^esub>
                               (?H <#>\<^bsub>add_monoid R\<^esub>
                                ?K)\<close>
  notes theorem
    "add.l_repr_independence" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid R\<^esub> ?H;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub> ?H =
                               ?y <#\<^bsub>add_monoid R\<^esub> ?H\<close>
  notes theorem
    "add.lcos_m_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier R; ?g \<in> carrier R;
              ?h \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?g <#\<^bsub>add_monoid R\<^esub>
                               (?h <#\<^bsub>add_monoid R\<^esub> ?M) =
                               ?g \<oplus> ?h <#\<^bsub>add_monoid R\<^esub>
                               ?M\<close>
  notes theorem
    "add.lcos_mult_one" =
      \<open>?M \<subseteq> carrier R \<Longrightarrow>
             \<zero> <#\<^bsub>add_monoid R\<^esub> ?M = ?M\<close>
  notes theorem
    "add.l_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub> ?H
                               \<subseteq> carrier R\<close>
  notes theorem
    "add.l_coset_carrier" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid R\<^esub> ?H;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?y \<in> carrier R\<close>
  notes theorem
    "add.l_coset_swap" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid R\<^esub> ?H;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?y <#\<^bsub>add_monoid R\<^esub>
  ?H\<close>
  notes theorem
    "add.subgroup_mult_id" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             ?H <#>\<^bsub>add_monoid R\<^esub> ?H = ?H\<close>
  notes theorem
    "add.setmult_rcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?K \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid R\<^esub>
                               (?K #>\<^bsub>add_monoid R\<^esub> ?x) =
                               ?H <#>\<^bsub>add_monoid R\<^esub>
                               ?K #>\<^bsub>add_monoid R\<^esub>
                               ?x\<close>
  notes theorem
