                 \<Longrightarrow> x \<oplus>\<^bsub>P\<^esub>
                                   h \<oplus>\<^bsub>P\<^esub>
                                   \<ominus>\<^bsub>P\<^esub> x
                                   \<in> ?N\<rbrakk>
             \<Longrightarrow> ?N \<lhd> add_monoid P\<close>
  notes theorem
    "P.add.normal_invE" =
      \<open>?N \<lhd> add_monoid P \<Longrightarrow>
             subgroup ?N (add_monoid P)\<close>
      \<open>\<lbrakk>?N \<lhd> add_monoid P; ?x \<in> carrier P;
              ?h \<in> ?N\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub>
                               ?h \<oplus>\<^bsub>P\<^esub>
                               \<ominus>\<^bsub>P\<^esub> ?x
                               \<in> ?N\<close>
  notes theorem
    "P.add.one_is_normal" =
      \<open>{\<zero>\<^bsub>P\<^esub>} \<lhd> add_monoid P\<close>
  notes theorem
    "P.add.normal_subgroup_intersect" =
      \<open>\<lbrakk>?M \<lhd> add_monoid P;
              ?N \<lhd> add_monoid P\<rbrakk>
             \<Longrightarrow> ?M \<inter> ?N \<lhd> add_monoid P\<close>
  notes theorem
    "P.add.setmult_lcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?K \<subseteq> carrier P;
