                         i \<in> ?I \<Longrightarrow>
                         ?f i \<in> hom (?A i) (add_monoid S);
              \<And>i.
                 i \<in> ?I \<Longrightarrow> Group.group (?A i)\<rbrakk>
             \<Longrightarrow> (\<lambda>x.
                                   gfinprod (add_monoid S)
