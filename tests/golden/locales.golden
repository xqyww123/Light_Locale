              (RDirProd_list (map (\<lambda>i. S Quot ?I i) [0..<Suc ?n]))
              (S.canonical_proj_ext ?I ?n) =
             \<Inter> (?I ` {..?n})\<close>
  notes theorem
    "S.generate_ring_in_carrier" =
      \<open>\<lbrakk>?H \<subseteq> carrier S;
              ?h \<in> generate_ring S ?H\<rbrakk>
             \<Longrightarrow> ?h \<in> carrier S\<close>
  notes theorem
    "S.generate_ring_incl" =
      \<open>?H \<subseteq> carrier S \<Longrightarrow>
             generate_ring S ?H \<subseteq> carrier S\<close>
  notes theorem
    "S.zero_in_generate" =
      \<open>\<zero>\<^bsub>S\<^esub> \<in> generate_ring S ?H\<close>
  notes theorem
    "S.generate_ring_is_subring" =
      \<open>?H \<subseteq> carrier S \<Longrightarrow>
             subring (generate_ring S ?H) S\<close>
  notes theorem
    "S.generate_ring_is_ring" =
      \<open>?H \<subseteq> carrier S \<Longrightarrow>
             ring (S\<lparr>carrier := generate_ring S ?H\<rparr>)\<close>
  notes theorem
    "S.generate_ring_min_subring1" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; subring ?E S;
              ?H \<subseteq> ?E\<rbrakk>
             \<Longrightarrow> generate_ring S ?H \<subseteq> ?E\<close>
  notes theorem
    "S.generate_ringI" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; subring ?E S;
              ?H \<subseteq> ?E;
              \<And>K.
                 \<lbrakk>subring K S; ?H \<subseteq> K\<rbrakk>
                 \<Longrightarrow> ?E \<subseteq> K\<rbrakk>
             \<Longrightarrow> ?E = generate_ring S ?H\<close>
  notes theorem
    "S.generate_ringE" =
      \<open>\<lbrakk>?H \<subseteq> carrier S;
              ?E = generate_ring S ?H\<rbrakk>
             \<Longrightarrow> subring ?E S\<close>
      \<open>\<lbrakk>?H \<subseteq> carrier S;
              ?E = generate_ring S ?H\<rbrakk>
             \<Longrightarrow> ?H \<subseteq> ?E\<close>
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?E = generate_ring S ?H;
              subring ?K S; ?H \<subseteq> ?K\<rbrakk>
             \<Longrightarrow> ?E \<subseteq> ?K\<close>
  notes theorem
    "S.generate_ring_min_subring2" =
      \<open>?H \<subseteq> carrier S \<Longrightarrow>
             generate_ring S ?H =
             \<Inter> {K. subring K S \<and> ?H \<subseteq> K}\<close>
  notes theorem
    "S.mono_generate_ring" =
      \<open>\<lbrakk>?I \<subseteq> ?J; ?J \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> generate_ring S ?I
                               \<subseteq> generate_ring S ?J\<close>
  notes theorem
    "S.subring_gen_incl" =
      \<open>\<lbrakk>subring ?H S; subring ?K S; ?I \<subseteq> ?H;
              ?I \<subseteq> ?K\<rbrakk>
             \<Longrightarrow> generate_ring
                                (S\<lparr>carrier := ?K\<rparr>) ?I
                               \<subseteq> generate_ring
      (S\<lparr>carrier := ?H\<rparr>) ?I\<close>
  notes theorem
    "S.subring_gen_equality" =
      \<open>\<lbrakk>subring ?H S; ?K \<subseteq> ?H\<rbrakk>
             \<Longrightarrow> generate_ring S ?K =
                               generate_ring
                                (S\<lparr>carrier := ?H\<rparr>) ?K\<close>
  notes
    "S.comm_monoid_axioms" = (\<open>Group.comm_monoid S\<close>)
      ["attribute" "internal"]
  notes
    "S.m_comm" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>S\<^esub> ?y =
                               ?y \<otimes>\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.m_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>S\<^esub>
                               (?y \<otimes>\<^bsub>S\<^esub> ?z) =
                               ?y \<otimes>\<^bsub>S\<^esub>
                               (?x \<otimes>\<^bsub>S\<^esub> ?z)\<close>
  notes theorem
    "S.m_ac" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>S\<^esub>
                               ?y \<otimes>\<^bsub>S\<^esub>
                               ?z =
                               ?x \<otimes>\<^bsub>S\<^esub>
                               (?y \<otimes>\<^bsub>S\<^esub> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>S\<^esub> ?y =
                               ?y \<otimes>\<^bsub>S\<^esub> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<otimes>\<^bsub>S\<^esub>
                               (?y \<otimes>\<^bsub>S\<^esub> ?z) =
                               ?y \<otimes>\<^bsub>S\<^esub>
                               (?x \<otimes>\<^bsub>S\<^esub> ?z)\<close>
  notes theorem
    "S.submonoid_is_comm_monoid" =
      \<open>submonoid ?H S \<Longrightarrow>
             Group.comm_monoid (S\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "S.nat_pow_distrib" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> (?x \<otimes>\<^bsub>S\<^esub>
                                ?y) [^]\<^bsub>S\<^esub>
                               ?n =
                               ?x [^]\<^bsub>S\<^esub>
                               ?n \<otimes>\<^bsub>S\<^esub>
                               ?y [^]\<^bsub>S\<^esub> ?n\<close>
  notes theorem
    "S.hom_imp_img_comm_monoid" =
      \<open>?h \<in> hom S ?H \<Longrightarrow>
             Group.comm_monoid
              (?H\<lparr>carrier := ?h ` carrier S,
                    one := ?h \<one>\<^bsub>S\<^esub>\<rparr>)\<close>
  notes theorem
    "S.units_comm_group" = \<open>comm_group (units_of S)\<close>
  notes theorem
    "S.finprod_empty" =
      (\<open>finprod S ?f {} = \<one>\<^bsub>S\<^esub>\<close>) ["simp"]
  notes theorem
    "S.finprod_infinite" =
      (\<open>infinite ?A \<Longrightarrow>
              finprod S ?f ?A = \<one>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.finprod_insert" =
      (\<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
               ?f \<in> ?F \<rightarrow> carrier S;
               ?f ?a \<in> carrier S\<rbrakk>
              \<Longrightarrow> finprod S ?f (insert ?a ?F) =
                                ?f ?a \<otimes>\<^bsub>S\<^esub>
                                finprod S ?f ?F\<close>)
      ["simp"]
  notes theorem
    "S.finprod_one_eqI" =
      \<open>(\<And>x.
                 x \<in> ?A \<Longrightarrow>
                 ?f x = \<one>\<^bsub>S\<^esub>) \<Longrightarrow>
             finprod S ?f ?A = \<one>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.finprod_one" =
      (\<open>(\<Otimes>\<^bsub>S\<^esub>i\<in>?A. \<one>\<^bsub>S\<^esub>) =
              \<one>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.finprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier S \<Longrightarrow>
              finprod S ?f ?A \<in> carrier S\<close>)
      ["simp"]
  notes theorem
    "S.funcset_Int_left" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> ?C;
               ?f \<in> ?B \<rightarrow> ?C\<rbrakk>
              \<Longrightarrow> ?f \<in> ?A \<inter> ?B \<rightarrow>
   ?C\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "S.funcset_Un_left" =
      (\<open>(?f \<in> ?A \<union> ?B \<rightarrow> ?C) =
              (?f \<in> ?A \<rightarrow> ?C \<and>
               ?f \<in> ?B \<rightarrow> ?C)\<close>)
      ["iff"]
  notes theorem
    "S.finprod_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier S;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finprod S ?g
                                (?A \<union> ?B) \<otimes>\<^bsub>S\<^esub>
                               finprod S ?g (?A \<inter> ?B) =
                               finprod S ?g ?A \<otimes>\<^bsub>S\<^esub>
                               finprod S ?g ?B\<close>
  notes theorem
    "S.finprod_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier S;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finprod S ?g (?A \<union> ?B) =
                               finprod S ?g ?A \<otimes>\<^bsub>S\<^esub>
                               finprod S ?g ?B\<close>
  notes theorem
    "S.finprod_multf" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier S;
               ?g \<in> ?A \<rightarrow> carrier S\<rbrakk>
              \<Longrightarrow> (\<Otimes>\<^bsub>S\<^esub>x\<in>?A. ?f
                                x \<otimes>\<^bsub>S\<^esub>
                               ?g x) =
                                finprod S ?f ?A \<otimes>\<^bsub>S\<^esub>
                                finprod S ?g ?A\<close>)
      ["simp"]
  notes theorem
    "S.finprod_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier S;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finprod S ?f ?A = finprod S ?g ?B\<close>
  notes theorem
    "S.finprod_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier S) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finprod S ?f ?A = finprod S ?g ?B\<close>
  notes theorem
    "S.finprod_0" =
      (\<open>?f \<in> {0} \<rightarrow> carrier S \<Longrightarrow>
              finprod S ?f {..0} = ?f 0\<close>)
      ["simp"]
  notes theorem
    "S.finprod_0'" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier S \<Longrightarrow>
             ?f 0 \<otimes>\<^bsub>S\<^esub> finprod S ?f {Suc 0..?n} =
             finprod S ?f {..?n}\<close>
  notes theorem
    "S.finprod_Suc" =
      (\<open>?f \<in> {..Suc ?n} \<rightarrow> carrier S \<Longrightarrow>
              finprod S ?f {..Suc ?n} =
              ?f (Suc ?n) \<otimes>\<^bsub>S\<^esub>
              finprod S ?f {..?n}\<close>)
      ["simp"]
  notes theorem
    "S.finprod_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier S \<Longrightarrow>
             finprod S ?f {..Suc ?n} =
             (\<Otimes>\<^bsub>S\<^esub>i\<in>{..?n}. ?f
                 (Suc i)) \<otimes>\<^bsub>S\<^esub>
             ?f 0\<close>
  notes theorem
    "S.finprod_Suc3" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier S \<Longrightarrow>
             finprod S ?f {..?n} =
             ?f ?n \<otimes>\<^bsub>S\<^esub> finprod S ?f {..<?n}\<close>
  notes theorem
    "S.finprod_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier S;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finprod S ?f (?h ` ?A) =
                               (\<Otimes>\<^bsub>S\<^esub>x\<in>?A. ?f
                               (?h x))\<close>
  notes theorem
    "S.finprod_const" =
      \<open>?a \<in> carrier S \<Longrightarrow>
             (\<Otimes>\<^bsub>S\<^esub>x\<in>?A. ?a) =
             ?a [^]\<^bsub>S\<^esub> card ?A\<close>
  notes theorem
    "S.finprod_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> (\<Otimes>\<^bsub>S\<^esub>j\<in>?A. if ?i =
                                 j
                              then ?f j else \<one>\<^bsub>S\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "S.finprod_singleton_swap" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> (\<Otimes>\<^bsub>S\<^esub>j\<in>?A. if j =
                                 ?i
                              then ?f j else \<one>\<^bsub>S\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "S.finprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<one>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finprod S ?g ?A = finprod S ?h ?B\<close>
  notes theorem
    "S.finprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?g i = \<one>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finprod S ?g ?B = finprod S ?h ?A\<close>
  notes theorem
    "S.finprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<one>\<^bsub>S\<^esub>;
              \<And>i.
                 i \<in> ?A - ?B \<Longrightarrow>
                 ?g i = \<one>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier S;
              ?h \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finprod S ?g ?A = finprod S ?h ?B\<close>
  notes theorem
    "S.finprod_UN_disjoint" =
      \<open>\<lbrakk>finite ?I;
              \<And>i. i \<in> ?I \<Longrightarrow> finite (?A i);
              pairwise (\<lambda>i j. disjnt (?A i) (?A j)) ?I;
              \<And>i x.
                 \<lbrakk>i \<in> ?I; x \<in> ?A i\<rbrakk>
                 \<Longrightarrow> ?g x \<in> carrier S\<rbrakk>
             \<Longrightarrow> finprod S ?g (\<Union> (?A ` ?I)) =
                               (\<Otimes>\<^bsub>S\<^esub>i\<in>?I. finprod
                               S ?g (?A i))\<close>
  notes theorem
    "S.finprod_Union_disjoint" =
      \<open>\<lbrakk>finite ?C;
              \<And>A.
                 A \<in> ?C \<Longrightarrow>
                 finite A \<and> (\<forall>x\<in>A. ?f x \<in> carrier S);
              disjoint ?C\<rbrakk>
             \<Longrightarrow> finprod S ?f (\<Union> ?C) =
                               finprod S (finprod S ?f) ?C\<close>
  notes theorem
    "S.comm_inv_char" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?x \<otimes>\<^bsub>S\<^esub> ?y =
              \<one>\<^bsub>S\<^esub>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>S\<^esub> ?x = ?y\<close>
  notes theorem
    "S.unit_factor" =
      \<open>\<lbrakk>?a \<otimes>\<^bsub>S\<^esub> ?b \<in> Units S;
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<in> Units S\<close>
  notes theorem
    "S.divides_mult_rI" =
      (\<open>\<lbrakk>?a divides\<^bsub>S\<^esub> ?b; ?a \<in> carrier S;
               ?b \<in> carrier S; ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?a \<otimes>\<^bsub>S\<^esub>
                                ?c divides\<^bsub>S\<^esub>
                                ?b \<otimes>\<^bsub>S\<^esub> ?c\<close>)
      ["HOL.intro"]
  notes theorem
    "S.divides_prod_l" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
              ?c \<in> carrier S; ?a divides\<^bsub>S\<^esub> ?b\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>S\<^esub>
                               ?c \<otimes>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.divides_unit" =
      \<open>\<lbrakk>?a divides\<^bsub>S\<^esub> ?u; ?a \<in> carrier S;
              ?u \<in> Units S\<rbrakk>
             \<Longrightarrow> ?a \<in> Units S\<close>
  notes theorem
    "S.Unit_eq_dividesone" =
      \<open>?u \<in> carrier S \<Longrightarrow>
             (?u \<in> Units S) =
             ?u divides\<^bsub>S\<^esub> \<one>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.mult_cong_l" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>S\<^esub> ?a'; ?a \<in> carrier S;
              ?a' \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<otimes>\<^bsub>S\<^esub>
                               ?b \<sim>\<^bsub>S\<^esub>
                               ?a' \<otimes>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.Units_cong" =
      \<open>\<lbrakk>?a \<in> Units S; ?a \<sim>\<^bsub>S\<^esub> ?b;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?b \<in> Units S\<close>
  notes theorem
    "S.Units_Lower" =
      \<open>Units S = Lower (division_rel S) (carrier S)\<close>
  notes theorem
    "S.properfactor_prod_l" =
      \<open>\<lbrakk>properfactor S ?a ?b; ?a \<in> carrier S;
              ?b \<in> carrier S; ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> properfactor S ?a
                                (?c \<otimes>\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.irreducible_prod_lI" =
      \<open>\<lbrakk>Divisibility.irreducible S ?b; ?a \<in> Units S;
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible S
                                (?a \<otimes>\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.multlist_dividesI" =
      \<open>\<lbrakk>?f \<in> set ?fs;
              set ?fs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>S\<^esub>
                               foldr (\<otimes>\<^bsub>S\<^esub>) ?fs
                                \<one>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.multlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> foldr (\<otimes>\<^bsub>S\<^esub>) ?as
                                \<one>\<^bsub>S\<^esub> =
                               foldr (\<otimes>\<^bsub>S\<^esub>) ?bs
                                \<one>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.wfactors_perm_cong_l" =
      \<open>\<lbrakk>wfactors S ?fs ?a; mset ?fs = mset ?fs';
              set ?fs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> wfactors S ?fs' ?a\<close>
  notes theorem
    "S.perm_wfactorsD" =
      \<open>\<lbrakk>mset ?as = mset ?bs; wfactors S ?as ?a;
              wfactors S ?bs ?b; ?a \<in> carrier S; ?b \<in> carrier S;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.factors_dividesI" =
      \<open>\<lbrakk>factors S ?fs ?a; ?f \<in> set ?fs;
              set ?fs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>S\<^esub> ?a\<close>
  notes theorem
    "S.wfactors_dividesI" =
      \<open>\<lbrakk>wfactors S ?fs ?a; set ?fs \<subseteq> carrier S;
              ?a \<in> carrier S; ?f \<in> set ?fs\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>S\<^esub> ?a\<close>
  notes theorem
    "S.assocs_assoc" =
      \<open>\<lbrakk>?a \<in> assocs S ?b; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.assocs_eqD" =
      \<open>\<lbrakk>assocs S ?b = assocs S ?a; ?a \<in> carrier S;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.gfinprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier S \<Longrightarrow>
              gfinprod S ?f ?A \<in> carrier S\<close>)
      ["simp"]
  notes theorem
    "S.gfinprod_cong" =
      \<open>\<lbrakk>?A = ?B; ?f \<in> ?B \<rightarrow> carrier S;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> gfinprod S ?f ?A = gfinprod S ?g ?B\<close>
  notes theorem
    "S.gfinprod_eq_finprod" =
      (\<open>\<lbrakk>finite ?A;
               ?f \<in> ?A \<rightarrow> carrier S\<rbrakk>
              \<Longrightarrow> gfinprod S ?f ?A = finprod S ?f ?A\<close>)
      ["simp"]
  notes theorem
    "S.gfinprod_insert" =
      (\<open>\<lbrakk>finite
                        {x \<in> ?A. ?f x \<noteq> \<one>\<^bsub>S\<^esub>};
               ?f \<in> ?A \<rightarrow> carrier S;
               ?f ?i \<in> carrier S\<rbrakk>
              \<Longrightarrow> gfinprod S ?f (insert ?i ?A) =
                                (if ?i \<in> ?A then gfinprod S ?f ?A
                                 else ?f ?i \<otimes>\<^bsub>S\<^esub>
gfinprod S ?f ?A)\<close>)
      ["simp"]
  notes theorem
    "S.gfinprod_distrib" =
      \<open>\<lbrakk>finite
                       {x \<in> ?A. ?f x \<noteq> \<one>\<^bsub>S\<^esub>};
              finite {x \<in> ?A. ?g x \<noteq> \<one>\<^bsub>S\<^esub>};
              ?f \<in> ?A \<rightarrow> carrier S;
              ?g \<in> ?A \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> gfinprod S
                                (\<lambda>i.
                                    ?f i \<otimes>\<^bsub>S\<^esub> ?g i)
                                ?A =
                               gfinprod S ?f ?A \<otimes>\<^bsub>S\<^esub>
                               gfinprod S ?g ?A\<close>
  notes theorem
    "S.gfinprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<one>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> gfinprod S ?g ?A = gfinprod S ?h ?B\<close>
  notes theorem
    "S.gfinprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?g i = \<one>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> gfinprod S ?g ?B = gfinprod S ?h ?A\<close>
  notes theorem
    "S.gfinprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<one>\<^bsub>S\<^esub>;
              \<And>i.
                 i \<in> ?A - ?B \<Longrightarrow>
                 ?g i = \<one>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier S;
              ?h \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> gfinprod S ?g ?A = gfinprod S ?h ?B\<close>
