  notes theorem
    "deg_aboveI" =
      \<open>\<lbrakk>\<And>m.
                         ?n < m \<Longrightarrow>
                         up_ring.coeff P ?p m = \<zero>;
              ?p \<in> carrier P\<rbrakk>
             \<Longrightarrow> deg R ?p \<le> ?n\<close>
  notes theorem
    "deg_aboveD" =
