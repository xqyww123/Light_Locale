      ["Ring.algebra" add : cring \<zero>\<^bsub>S\<^esub>
         (\<oplus>\<^bsub>S\<^esub>) a_inv S a_minus S
         \<one>\<^bsub>S\<^esub> (\<otimes>\<^bsub>S\<^esub>)]
      (\<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
               ?z \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                                (?y \<oplus>\<^bsub>S\<^esub> ?z) =
                                ?y \<oplus>\<^bsub>S\<^esub>
                                (?x \<oplus>\<^bsub>S\<^esub> ?z)\<close>)
      ["Ring.algebra" add : cring \<zero>\<^bsub>S\<^esub>
         (\<oplus>\<^bsub>S\<^esub>) a_inv S a_minus S
         \<one>\<^bsub>S\<^esub> (\<otimes>\<^bsub>S\<^esub>)]
      (\<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
