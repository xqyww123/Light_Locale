  notes
    "R.extensions_def" =
      (\<open>R.extensions \<equiv>
              {L. field L \<and>
                  R.indexed_const \<in> ring_hom R L \<and>
                  Ball (carrier L) R.carrier_coeff \<and>
                  (\<forall>\<P>\<in>carrier L.
                      \<forall>P\<in>carrier (poly_ring R).
                         \<forall>i.
                            \<not> R.index_free \<P>
                                    (P, i) \<longrightarrow>
                            \<X>\<^bsub>(P, i)\<^esub>
                            \<in> carrier L \<and>
                            ring.eval L (R.\<sigma> P)
                             \<X>\<^bsub>(P, i)\<^esub> =
                            \<zero>\<^bsub>L\<^esub>)}\<close>)
