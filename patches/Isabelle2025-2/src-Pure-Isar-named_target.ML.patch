-fun operations Theory =
+(*a light locale stores only syntax declarations; the others go to the theory or stay in the
+  open layers*)
+fun light_declaration locale (params as {syntax, pervasive, ...}) =
+  if syntax then Generic_Target.locale_declaration locale params
+  else if pervasive then Generic_Target.light_theory_declaration
+  else Generic_Target.light_standard_declaration (K true);
+
+(*an import of a heavy locale is syntax-only*)
+fun light_dependency locale registration lthy =
+  let
+    val level =
+      if Locale.is_light (Proof_Context.theory_of lthy) (#1 (#inst registration))
+      then Locale.Full else Locale.Syntax_only;
+  in
+    Generic_Target.gen_locale_dependency (Locale.add_registration_level level)
+      locale registration lthy
+  end;
+
+fun operations _ Theory =
       {define = Generic_Target.define Generic_Target.theory_target_foundation,
        notes = Generic_Target.notes Generic_Target.theory_target_notes,
        abbrev = Generic_Target.theory_abbrev,
@@ -101,15 +119,21 @@
        locale_dependency = fn _ => error "Not possible in theory target",
        pretty = fn ctxt => [Pretty.block [Pretty.keyword1 "theory", Pretty.brk 1,
         Pretty.str (Context.theory_base_name (Proof_Context.theory_of ctxt))]]}
-  | operations (Locale locale) =
-      {define = Generic_Target.define (locale_foundation locale),
-       notes = Generic_Target.notes (Generic_Target.locale_target_notes locale),
-       abbrev = Generic_Target.locale_abbrev locale,
-       declaration = Generic_Target.locale_declaration locale,
-       theory_registration = fn _ => error "Not possible in locale target",
-       locale_dependency = Generic_Target.locale_dependency locale,
-       pretty = fn ctxt => [Locale.pretty_locale (Proof_Context.theory_of ctxt) false locale]}
-  | operations (Class class) =
+  | operations thy (Locale locale) =
+      let val light = Locale.is_light thy locale in
+        {define = Generic_Target.define (locale_foundation locale),
+         notes =
+           if light then Generic_Target.light_notes locale
+           else Generic_Target.notes (Generic_Target.locale_target_notes locale),
+         abbrev = Generic_Target.locale_abbrev locale,
+         declaration =
+           if light then light_declaration locale else Generic_Target.locale_declaration locale,
+         theory_registration = fn _ => error "Not possible in locale target",
+         locale_dependency =
+           if light then light_dependency locale else Generic_Target.locale_dependency locale,
+         pretty = fn ctxt => [Locale.pretty_locale (Proof_Context.theory_of ctxt) false locale]}
+      end
+  | operations _ (Class class) =
       {define = Generic_Target.define (class_foundation class),
        notes = Generic_Target.notes (Generic_Target.locale_target_notes class),
        abbrev = Class.abbrev class,
