  notes theorem
    "P.add.monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier P; y \<in> carrier P\<rbrakk>
                 \<Longrightarrow> x \<oplus>\<^bsub>P\<^esub> y =
                                   y \<oplus>\<^bsub>P\<^esub>
                                   x) \<Longrightarrow>
             Group.comm_monoid (add_monoid P)\<close>
  notes theorem
    "P.add.units_group" =
      \<open>Group.group (units_of (add_monoid P))\<close>
  notes theorem
