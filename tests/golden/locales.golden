  notes theorem
    "R.a_l_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x <+ ?H \<subseteq> carrier R\<close>
  notes theorem
    "R.a_l_coset_swap" =
      \<open>\<lbrakk>?y \<in> ?x <+ ?H; ?x \<in> carrier R;
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?y <+ ?H\<close>
  notes theorem
    "R.a_l_coset_carrier" =
      \<open>\<lbrakk>?y \<in> ?x <+ ?H; ?x \<in> carrier R;
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?y \<in> carrier R\<close>
  notes theorem
    "R.a_l_repr_imp_subset" =
      \<open>\<lbrakk>?y \<in> ?x <+ ?H; ?x \<in> carrier R;
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?y <+ ?H \<subseteq> ?x <+ ?H\<close>
  notes theorem
    "R.a_l_repr_independence" =
      \<open>\<lbrakk>?y \<in> ?x <+ ?H; ?x \<in> carrier R;
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x <+ ?H = ?y <+ ?H\<close>
  notes theorem
    "R.setadd_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              ?K \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?H <+> ?K \<subseteq> carrier R\<close>
  notes theorem
    "R.subgroup_add_id" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             ?H <+> ?H = ?H\<close>
  notes theorem
    "R.a_setmult_rcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?K \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H <+> (?K +> ?x) = ?H <+> ?K +> ?x\<close>
  notes theorem
    "R.a_rcos_assoc_lcos" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?K \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H +> ?x <+> ?K = ?H <+> (?x <+ ?K)\<close>
  notes theorem
    "R.a_card_cosets_equal" =
      \<open>\<lbrakk>?c \<in> a_rcosets ?H; ?H \<subseteq> carrier R;
              finite (carrier R)\<rbrakk>
             \<Longrightarrow> card ?c = card ?H\<close>
  notes theorem
    "R.rcosets_subset_PowG" =
      \<open>additive_subgroup ?H R \<Longrightarrow>
             a_rcosets ?H \<subseteq> Pow (carrier R)\<close>
  notes theorem
    "R.a_lagrange" =
      \<open>\<lbrakk>finite (carrier R); additive_subgroup ?H R\<rbrakk>
             \<Longrightarrow> card (a_rcosets ?H) * card ?H =
                               Coset.order R\<close>
  notes theorem
    "R.add_additive_subgroups" =
      \<open>\<lbrakk>additive_subgroup ?H R;
              additive_subgroup ?K R\<rbrakk>
             \<Longrightarrow> additive_subgroup (?H <+> ?K) R\<close>
  notes
    "R.monoid_axioms" = (\<open>Group.monoid R\<close>)
      ["attribute" "internal"]
  notes
    "R.m_closed" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<otimes> ?y \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes
    "R.m_assoc" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?z \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x \<otimes> ?y \<otimes> ?z =
                               ?x \<otimes> (?y \<otimes> ?z)\<close>
  notes
    "R.one_closed" = (\<open>\<one> \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes
    "R.l_one" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<one> \<otimes> ?x = ?x\<close>)
      ["simp"]
  notes
    "R.r_one" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              ?x \<otimes> \<one> = ?x\<close>)
      ["simp"]
  notes theorem
    "R.Units_closed" =
      (\<open>?x \<in> Units R \<Longrightarrow> ?x \<in> carrier R\<close>)
      ["HOL.dest"]
  notes theorem
    "R.one_unique" =
      \<open>\<lbrakk>?u \<in> carrier R;
              \<And>x.
                 x \<in> carrier R \<Longrightarrow>
                 ?u \<otimes> x = x\<rbrakk>
             \<Longrightarrow> ?u = \<one>\<close>
  notes theorem
    "R.inv_unique" =
      \<open>\<lbrakk>?y \<otimes> ?x = \<one>; ?x \<otimes> ?y' = \<one>;
              ?x \<in> carrier R; ?y \<in> carrier R;
              ?y' \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "R.Units_m_closed" =
      (\<open>\<lbrakk>?x \<in> Units R; ?y \<in> Units R\<rbrakk>
              \<Longrightarrow> ?x \<otimes> ?y \<in> Units R\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "R.Units_one_closed" = (\<open>\<one> \<in> Units R\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "R.Units_inv_closed" =
      (\<open>?x \<in> Units R \<Longrightarrow>
              inv ?x \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "R.Units_l_inv_ex" =
      \<open>?x \<in> Units R \<Longrightarrow>
             \<exists>y\<in>carrier R. y \<otimes> ?x = \<one>\<close>
  notes theorem
    "R.Units_r_inv_ex" =
      \<open>?x \<in> Units R \<Longrightarrow>
             \<exists>y\<in>carrier R. ?x \<otimes> y = \<one>\<close>
  notes theorem
    "R.Units_l_inv" =
      (\<open>?x \<in> Units R \<Longrightarrow>
              inv ?x \<otimes> ?x = \<one>\<close>)
      ["simp"]
  notes theorem
    "R.Units_r_inv" =
      (\<open>?x \<in> Units R \<Longrightarrow>
              ?x \<otimes> inv ?x = \<one>\<close>)
      ["simp"]
  notes theorem "R.inv_one" = (\<open>inv \<one> = \<one>\<close>) ["simp"]
  notes theorem
    "R.Units_inv_Units" =
      (\<open>?x \<in> Units R \<Longrightarrow>
              inv ?x \<in> Units R\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "R.Units_l_cancel" =
      (\<open>\<lbrakk>?x \<in> Units R; ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x \<otimes> ?y = ?x \<otimes> ?z) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "R.Units_inv_inv" =
      (\<open>?x \<in> Units R \<Longrightarrow> inv (inv ?x) = ?x\<close>)
      ["simp"]
  notes theorem
    "R.inv_inj_on_Units" = \<open>inj_on (m_inv R) (Units R)\<close>
  notes theorem
    "R.Units_inv_comm" =
      \<open>\<lbrakk>?x \<otimes> ?y = \<one>; ?x \<in> Units R;
              ?y \<in> Units R\<rbrakk>
             \<Longrightarrow> ?y \<otimes> ?x = \<one>\<close>
  notes theorem "R.carrier_not_empty" = \<open>carrier R \<noteq> {}\<close>
  notes theorem
    "R.group_l_invI" =
      \<open>(\<And>x.
                 x \<in> carrier R \<Longrightarrow>
                 \<exists>y\<in>carrier R.
                    y \<otimes> x = \<one>) \<Longrightarrow>
             Group.group R\<close>
  notes theorem
    "R.nat_pow_closed" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              ?x [^] ?n \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes theorem "R.nat_pow_0" = (\<open>?x [^] 0 = \<one>\<close>) ["simp"]
  notes theorem
    "R.nat_pow_Suc" =
      (\<open>?x [^] Suc ?n = ?x [^] ?n \<otimes> ?x\<close>) ["simp"]
  notes theorem
    "R.nat_pow_one" = (\<open>\<one> [^] ?n = \<one>\<close>) ["simp"]
  notes theorem
    "R.nat_pow_mult" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             ?x [^] ?n \<otimes> ?x [^] ?m = ?x [^] (?n + ?m)\<close>
  notes theorem
    "R.nat_pow_comm" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             ?x [^] ?n \<otimes> ?x [^] ?m =
             ?x [^] ?m \<otimes> ?x [^] ?n\<close>
  notes theorem
    "R.nat_pow_Suc2" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             ?x [^] Suc ?n = ?x \<otimes> ?x [^] ?n\<close>
  notes theorem
    "R.nat_pow_pow" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             (?x [^] ?n) [^] ?m = ?x [^] (?n * ?m)\<close>
  notes theorem
    "R.nat_pow_consistent" =
      \<open>?x [^] ?n =
             ?x [^]\<^bsub>R\<lparr>carrier := ?H\<rparr>\<^esub> ?n\<close>
  notes theorem
    "R.group_commutes_pow" =
      \<open>\<lbrakk>?x \<otimes> ?y = ?y \<otimes> ?x; ?x \<in> carrier R;
              ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x [^] ?n \<otimes> ?y =
                               ?y \<otimes> ?x [^] ?n\<close>
  notes theorem
    "R.pow_mult_distrib" =
      \<open>\<lbrakk>?x \<otimes> ?y = ?y \<otimes> ?x; ?x \<in> carrier R;
              ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> (?x \<otimes> ?y) [^] ?n =
                               ?x [^] ?n \<otimes> ?y [^] ?n\<close>
  notes theorem
    "R.monoid_incl_imp_submonoid" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              Group.monoid (R\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> submonoid ?H R\<close>
  notes theorem
    "R.inv_unique'" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?x \<otimes> ?y = \<one>; ?y \<otimes> ?x = \<one>\<rbrakk>
             \<Longrightarrow> ?y = inv ?x\<close>
  notes theorem
    "R.m_inv_monoid_consistent" =
      \<open>\<lbrakk>?x \<in> Units (R\<lparr>carrier := ?H\<rparr>);
              submonoid ?H R\<rbrakk>
             \<Longrightarrow> inv\<^bsub>R\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                               inv ?x\<close>
  notes theorem
    "R.hom_imp_img_monoid" =
      \<open>?h \<in> hom R ?H \<Longrightarrow>
             Group.monoid
              (?H\<lparr>carrier := ?h ` carrier R,
                    one := ?h \<one>\<rparr>)\<close>
  notes theorem
    "R.monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier R; y \<in> carrier R\<rbrakk>
                 \<Longrightarrow> x \<otimes> y =
                                   y \<otimes> x) \<Longrightarrow>
             Group.comm_monoid R\<close>
  notes theorem "R.units_group" = \<open>Group.group (units_of R)\<close>
  notes theorem
    "R.units_of_inv" =
      \<open>?x \<in> Units R \<Longrightarrow>
             inv\<^bsub>units_of R\<^esub> ?x = inv ?x\<close>
  notes theorem
    "R.set_mult_closed" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              ?K \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?H <#> ?K \<subseteq> carrier R\<close>
  notes theorem
    "R.r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H #> ?x \<subseteq> carrier R\<close>
  notes theorem
    "R.order_gt_0_iff_finite" =
      \<open>(0 < Coset.order R) = finite (carrier R)\<close>
  notes theorem
    "R.units_of_pow" =
      \<open>?x \<in> Units R \<Longrightarrow>
             ?x [^]\<^bsub>units_of R\<^esub> ?n = ?x [^] ?n\<close>
  notes theorem
    "R.inv_char" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?x \<otimes> ?y = \<one>; ?y \<otimes> ?x = \<one>\<rbrakk>
             \<Longrightarrow> inv ?x = ?y\<close>
  notes theorem
    "R.inv_eq_imp_eq" =
      (\<open>\<lbrakk>inv ?x = inv ?y; ?x \<in> Units R;
               ?y \<in> Units R\<rbrakk>
              \<Longrightarrow> ?x = ?y\<close>)
      ["HOL.dest" !]
  notes theorem
    "R.inv_eq_one_eq" =
      \<open>?x \<in> Units R \<Longrightarrow>
             (inv ?x = \<one>) = (?x = \<one>)\<close>
  notes theorem
    "R.monoid_cancelI" =
      \<open>\<lbrakk>\<And>a b c.
                         \<lbrakk>c \<otimes> a = c \<otimes> b;
                          a \<in> carrier R; b \<in> carrier R;
                          c \<in> carrier R\<rbrakk>
                         \<Longrightarrow> a = b;
              \<And>a b c.
                 \<lbrakk>a \<otimes> c = b \<otimes> c; a \<in> carrier R;
                  b \<in> carrier R; c \<in> carrier R\<rbrakk>
                 \<Longrightarrow> a = b\<rbrakk>
             \<Longrightarrow> monoid_cancel R\<close>
  notes theorem
    "R.prod_unit_l" =
      \<open>\<lbrakk>?a \<otimes> ?b \<in> Units R; ?a \<in> Units R;
              ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?b \<in> Units R\<close>
  notes theorem
    "R.prod_unit_r" =
      \<open>\<lbrakk>?a \<otimes> ?b \<in> Units R; ?b \<in> Units R;
              ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<in> Units R\<close>
  notes theorem
    "R.divides_refl" =
      (\<open>?a \<in> carrier R \<Longrightarrow> ?a divides ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "R.divides_trans" =
      (\<open>\<lbrakk>?a divides ?b; ?b divides ?c;
               ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?a divides ?c\<close>)
      ["trans"]
  notes theorem
    "R.divides_mult_lI" =
      (\<open>\<lbrakk>?a divides ?b; ?a \<in> carrier R;
               ?c \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?c \<otimes> ?a divides
                                ?c \<otimes> ?b\<close>)
      ["HOL.intro"]
  notes theorem
    "R.divides_prod_r" =
      \<open>\<lbrakk>?a divides ?b; ?a \<in> carrier R;
              ?c \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a divides ?b \<otimes> ?c\<close>
  notes theorem
    "R.unit_divides" =
      \<open>\<lbrakk>?u \<in> Units R; ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?u divides ?a\<close>
  notes theorem
    "R.associatedI2" =
      \<open>\<lbrakk>?u \<in> Units R; ?a = ?b \<otimes> ?u;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "R.associatedI2'" =
      \<open>\<lbrakk>?a = ?b \<otimes> ?u; ?u \<in> Units R;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "R.associated_refl" =
      (\<open>?a \<in> carrier R \<Longrightarrow> ?a \<sim> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "R.associated_sym" =
      (\<open>?a \<sim> ?b \<Longrightarrow> ?b \<sim> ?a\<close>) ["sym"]
  notes theorem
    "R.associated_trans" =
      (\<open>\<lbrakk>?a \<sim> ?b; ?b \<sim> ?c; ?a \<in> carrier R;
               ?c \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?a \<sim> ?c\<close>)
      ["trans"]
  notes theorem
    "R.division_equiv" = (\<open>equivalence (division_rel R)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "R.divides_cong_l" =
      (\<open>\<lbrakk>?x \<sim> ?x'; ?x' divides ?y;
               ?x \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x divides ?y\<close>)
      ["trans"]
  notes theorem
    "R.divides_cong_r" =
      (\<open>\<lbrakk>?x divides ?y; ?y \<sim> ?y';
               ?x \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x divides ?y'\<close>)
      ["trans"]
  notes theorem
    "R.division_weak_partial_order" =
      (\<open>weak_partial_order (division_rel R)\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "R.mult_cong_r" =
      \<open>\<lbrakk>?b \<sim> ?b'; ?a \<in> carrier R; ?b \<in> carrier R;
              ?b' \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<otimes> ?b \<sim>
                               ?a \<otimes> ?b'\<close>
  notes theorem
    "R.Units_assoc" =
      \<open>\<lbrakk>?a \<in> Units R; ?b \<in> Units R\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "R.Units_are_ones" =
      \<open>Units R {.=}\<^bsub>division_rel R\<^esub> {\<one>}\<close>
  notes theorem
    "R.properfactor_unitE" =
      \<open>\<lbrakk>?u \<in> Units R; properfactor R ?a ?u;
              ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "R.properfactor_divides" =
      \<open>properfactor R ?a ?b \<Longrightarrow> ?a divides ?b\<close>
  notes theorem
    "R.properfactor_trans1" =
      (\<open>\<lbrakk>?a divides ?b; properfactor R ?b ?c;
               ?a \<in> carrier R; ?c \<in> carrier R\<rbrakk>
              \<Longrightarrow> properfactor R ?a ?c\<close>)
      ["trans"]
  notes theorem
    "R.properfactor_trans2" =
      (\<open>\<lbrakk>properfactor R ?a ?b; ?b divides ?c;
               ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
              \<Longrightarrow> properfactor R ?a ?c\<close>)
      ["trans"]
  notes theorem
    "R.properfactor_cong_l" =
      (\<open>\<lbrakk>?x' \<sim> ?x; properfactor R ?x ?y;
               ?x \<in> carrier R; ?x' \<in> carrier R;
               ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> properfactor R ?x' ?y\<close>)
      ["trans"]
  notes theorem
    "R.properfactor_cong_r" =
      (\<open>\<lbrakk>properfactor R ?x ?y; ?y \<sim> ?y';
               ?x \<in> carrier R; ?y \<in> carrier R;
               ?y' \<in> carrier R\<rbrakk>
              \<Longrightarrow> properfactor R ?x ?y'\<close>)
      ["trans"]
  notes theorem
    "R.properfactor_prod_r" =
      \<open>\<lbrakk>properfactor R ?a ?b; ?a \<in> carrier R;
              ?b \<in> carrier R; ?c \<in> carrier R\<rbrakk>
             \<Longrightarrow> properfactor R ?a (?b \<otimes> ?c)\<close>
  notes theorem
    "R.irreducible_prod_rI" =
      \<open>\<lbrakk>Divisibility.irreducible R ?a; ?b \<in> Units R;
              ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible R
                                (?a \<otimes> ?b)\<close>
  notes theorem
    "R.listassoc_refl" =
      (\<open>set ?as \<subseteq> carrier R \<Longrightarrow>
              ?as [\<sim>] ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "R.listassoc_sym" =
      (\<open>\<lbrakk>?as [\<sim>] ?bs; set ?as \<subseteq> carrier R;
               set ?bs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> ?bs [\<sim>] ?as\<close>)
      ["sym"]
  notes theorem
    "R.listassoc_trans" =
      (\<open>\<lbrakk>?as [\<sim>] ?bs; ?bs [\<sim>] ?cs;
               set ?as \<subseteq> carrier R; set ?bs \<subseteq> carrier R;
               set ?cs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> ?as [\<sim>] ?cs\<close>)
      ["trans"]
  notes theorem
    "R.perm_assoc_switch" =
      \<open>\<lbrakk>?as [\<sim>] ?bs; mset ?bs = mset ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  mset ?as = mset bs' \<and>
                                  bs' [\<sim>] ?cs\<close>
  notes theorem
    "R.perm_assoc_switch_r" =
      \<open>\<lbrakk>mset ?as = mset ?bs; ?bs [\<sim>] ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  ?as [\<sim>] bs' \<and>
                                  mset bs' = mset ?cs\<close>
  notes theorem
    "R.perm_closed" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> set ?bs \<subseteq> carrier R\<close>
  notes theorem
    "R.irrlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              \<forall>a\<in>set ?as. Divisibility.irreducible R a\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible R a\<close>
  notes theorem
    "R.essentially_equalI" =
      \<open>\<lbrakk>mset ?fs1.0 = mset ?fs1';
              ?fs1' [\<sim>] ?fs2.0\<rbrakk>
             \<Longrightarrow> essentially_equal R ?fs1.0 ?fs2.0\<close>
  notes theorem
    "R.essentially_equalE" =
      \<open>\<lbrakk>essentially_equal R ?fs1.0 ?fs2.0;
              \<And>fs1'.
                 \<lbrakk>mset ?fs1.0 = mset fs1';
                  fs1' [\<sim>] ?fs2.0\<rbrakk>
                 \<Longrightarrow> ?P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "R.ee_refl" =
      (\<open>set ?as \<subseteq> carrier R \<Longrightarrow>
              essentially_equal R ?as ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "R.ee_sym" =
      (\<open>\<lbrakk>essentially_equal R ?as ?bs;
               set ?as \<subseteq> carrier R;
               set ?bs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> essentially_equal R ?bs ?as\<close>)
      ["sym"]
  notes theorem
    "R.ee_trans" =
      (\<open>\<lbrakk>essentially_equal R ?as ?bs;
               essentially_equal R ?bs ?cs; set ?as \<subseteq> carrier R;
               set ?bs \<subseteq> carrier R;
               set ?cs \<subseteq> carrier R\<rbrakk>
              \<Longrightarrow> essentially_equal R ?as ?cs\<close>)
      ["trans"]
  notes theorem
    "R.multlist_closed" =
      (\<open>set ?fs \<subseteq> carrier R \<Longrightarrow>
              foldr (\<otimes>) ?fs \<one> \<in> carrier R\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "R.factorsI" =
      \<open>\<lbrakk>\<forall>f\<in>set ?fs. Divisibility.irreducible R f;
              foldr (\<otimes>) ?fs \<one> = ?a\<rbrakk>
             \<Longrightarrow> factors R ?fs ?a\<close>
  notes theorem
    "R.factors_wfactors" =
      \<open>\<lbrakk>factors R ?as ?a;
              set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> wfactors R ?as ?a\<close>
  notes theorem
    "R.wfactors_factors" =
      \<open>\<lbrakk>wfactors R ?as ?a;
              set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> \<exists>a'.
                                  factors R ?as a' \<and>
                                  a' \<sim> ?a\<close>
  notes theorem
    "R.factors_closed" =
      (\<open>\<lbrakk>factors R ?fs ?a;
               set ?fs \<subseteq> carrier R\<rbrakk>
