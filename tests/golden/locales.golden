  notes theorem
    "R.add.inv_solve_left'" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R;
              ?c \<in> carrier R\<rbrakk>
             \<Longrightarrow> (\<ominus> ?b \<oplus> ?c = ?a) =
