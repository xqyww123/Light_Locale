                               \<ominus>\<^bsub>P\<^esub> ?y =
                               ?M\<close>
  notes theorem
    "P.add.coset_join1" =
      \<open>\<lbrakk>?H #>\<^bsub>add_monoid P\<^esub> ?x = ?H;
