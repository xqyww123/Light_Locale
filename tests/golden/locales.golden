  notes theorem
    "P.add.nat_pow_0" =
      (\<open>[0] \<cdot>\<^bsub>P\<^esub> ?x =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.nat_pow_Suc" =
      (\<open>[Suc ?n] \<cdot>\<^bsub>P\<^esub> ?x =
              [?n] \<cdot>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
