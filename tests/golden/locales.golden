             \<Longrightarrow> up_ring.coeff P ?p 0 \<noteq> \<zero>\<close>
  notes theorem
    "lcoeff_nonzero" =
      \<open>\<lbrakk>?p \<noteq> \<zero>\<^bsub>P\<^esub>;
              ?p \<in> carrier P\<rbrakk>
             \<Longrightarrow> lcoeff ?p \<noteq> \<zero>\<close>
  notes theorem
    "deg_eqI" =
      \<open>\<lbrakk>\<And>m.
                         ?n < m \<Longrightarrow>
                         up_ring.coeff P ?p m = \<zero>;
              \<And>n.
                 n \<noteq> 0 \<Longrightarrow>
                 up_ring.coeff P ?p n \<noteq> \<zero>;
              ?p \<in> carrier P\<rbrakk>
             \<Longrightarrow> deg R ?p = ?n\<close>
  notes theorem
    "deg_add" =
      (\<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
              \<Longrightarrow> deg R (?p \<oplus>\<^bsub>P\<^esub> ?q)
                                \<le> max (deg R ?p) (deg R ?q)\<close>)
      ["simp"]
  notes theorem
    "deg_monom_le" =
      \<open>?a \<in> carrier R \<Longrightarrow>
