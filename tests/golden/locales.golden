locale Group.monoid
  fixes G :: "('a, 'b) monoid_scheme"  (structure)
  assumes "Group.monoid G"
  notes
    "monoid_axioms" = (\<open>Group.monoid G\<close>)
      ["attribute" "internal"]
  notes
    "m_closed" =
      (\<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?x \<otimes> ?y \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes
    "m_assoc" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<otimes> ?y \<otimes> ?z =
                               ?x \<otimes> (?y \<otimes> ?z)\<close>
  notes
    "one_closed" = (\<open>\<one> \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes
    "l_one" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              \<one> \<otimes> ?x = ?x\<close>)
      ["simp"]
  notes
    "r_one" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              ?x \<otimes> \<one> = ?x\<close>)
      ["simp"]
  notes theorem
    "Units_closed" =
      (\<open>?x \<in> Units G \<Longrightarrow> ?x \<in> carrier G\<close>)
      ["HOL.dest"]
  notes theorem
    "one_unique" =
      \<open>\<lbrakk>?u \<in> carrier G;
              \<And>x.
                 x \<in> carrier G \<Longrightarrow>
                 ?u \<otimes> x = x\<rbrakk>
             \<Longrightarrow> ?u = \<one>\<close>
  notes theorem
    "inv_unique" =
      \<open>\<lbrakk>?y \<otimes> ?x = \<one>; ?x \<otimes> ?y' = \<one>;
              ?x \<in> carrier G; ?y \<in> carrier G;
              ?y' \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "Units_m_closed" =
      (\<open>\<lbrakk>?x \<in> Units G; ?y \<in> Units G\<rbrakk>
              \<Longrightarrow> ?x \<otimes> ?y \<in> Units G\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "Units_one_closed" = (\<open>\<one> \<in> Units G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "Units_inv_closed" =
      (\<open>?x \<in> Units G \<Longrightarrow>
              inv ?x \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "Units_l_inv_ex" =
      \<open>?x \<in> Units G \<Longrightarrow>
             \<exists>y\<in>carrier G. y \<otimes> ?x = \<one>\<close>
  notes theorem
    "Units_r_inv_ex" =
      \<open>?x \<in> Units G \<Longrightarrow>
             \<exists>y\<in>carrier G. ?x \<otimes> y = \<one>\<close>
  notes theorem
    "Units_l_inv" =
      (\<open>?x \<in> Units G \<Longrightarrow>
              inv ?x \<otimes> ?x = \<one>\<close>)
      ["simp"]
  notes theorem
    "Units_r_inv" =
      (\<open>?x \<in> Units G \<Longrightarrow>
              ?x \<otimes> inv ?x = \<one>\<close>)
      ["simp"]
  notes theorem "inv_one" = (\<open>inv \<one> = \<one>\<close>) ["simp"]
  notes theorem
    "Units_inv_Units" =
      (\<open>?x \<in> Units G \<Longrightarrow>
              inv ?x \<in> Units G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "Units_l_cancel" =
      (\<open>\<lbrakk>?x \<in> Units G; ?y \<in> carrier G;
               ?z \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?x \<otimes> ?y = ?x \<otimes> ?z) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "Units_inv_inv" =
      (\<open>?x \<in> Units G \<Longrightarrow> inv (inv ?x) = ?x\<close>)
      ["simp"]
  notes theorem
    "inv_inj_on_Units" = \<open>inj_on (m_inv G) (Units G)\<close>
  notes theorem
    "Units_inv_comm" =
      \<open>\<lbrakk>?x \<otimes> ?y = \<one>; ?x \<in> Units G;
              ?y \<in> Units G\<rbrakk>
             \<Longrightarrow> ?y \<otimes> ?x = \<one>\<close>
  notes theorem "carrier_not_empty" = \<open>carrier G \<noteq> {}\<close>
  notes theorem
    "group_l_invI" =
      \<open>(\<And>x.
                 x \<in> carrier G \<Longrightarrow>
                 \<exists>y\<in>carrier G.
                    y \<otimes> x = \<one>) \<Longrightarrow>
             Group.group G\<close>
  notes theorem
    "nat_pow_closed" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              ?x [^] ?n \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes theorem "nat_pow_0" = (\<open>?x [^] 0 = \<one>\<close>) ["simp"]
  notes theorem
    "nat_pow_Suc" = (\<open>?x [^] Suc ?n = ?x [^] ?n \<otimes> ?x\<close>)
      ["simp"]
  notes theorem
    "nat_pow_one" = (\<open>\<one> [^] ?n = \<one>\<close>) ["simp"]
  notes theorem
    "nat_pow_mult" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] ?n \<otimes> ?x [^] ?m = ?x [^] (?n + ?m)\<close>
  notes theorem
    "nat_pow_comm" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] ?n \<otimes> ?x [^] ?m =
             ?x [^] ?m \<otimes> ?x [^] ?n\<close>
  notes theorem
    "nat_pow_Suc2" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] Suc ?n = ?x \<otimes> ?x [^] ?n\<close>
  notes theorem
    "nat_pow_pow" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             (?x [^] ?n) [^] ?m = ?x [^] (?n * ?m)\<close>
  notes theorem
    "nat_pow_consistent" =
      \<open>?x [^] ?n =
             ?x [^]\<^bsub>G\<lparr>carrier := ?H\<rparr>\<^esub> ?n\<close>
  notes theorem
    "group_commutes_pow" =
      \<open>\<lbrakk>?x \<otimes> ?y = ?y \<otimes> ?x; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x [^] ?n \<otimes> ?y =
                               ?y \<otimes> ?x [^] ?n\<close>
  notes theorem
    "pow_mult_distrib" =
      \<open>\<lbrakk>?x \<otimes> ?y = ?y \<otimes> ?x; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> (?x \<otimes> ?y) [^] ?n =
                               ?x [^] ?n \<otimes> ?y [^] ?n\<close>
  notes theorem
    "monoid_incl_imp_submonoid" =
      \<open>\<lbrakk>?H \<subseteq> carrier G;
              Group.monoid (G\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> submonoid ?H G\<close>
  notes theorem
    "inv_unique'" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?x \<otimes> ?y = \<one>; ?y \<otimes> ?x = \<one>\<rbrakk>
             \<Longrightarrow> ?y = inv ?x\<close>
  notes theorem
    "m_inv_monoid_consistent" =
      \<open>\<lbrakk>?x \<in> Units (G\<lparr>carrier := ?H\<rparr>);
              submonoid ?H G\<rbrakk>
             \<Longrightarrow> inv\<^bsub>G\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                               inv ?x\<close>
  notes theorem
    "hom_imp_img_monoid" =
      \<open>?h \<in> hom G ?H \<Longrightarrow>
             Group.monoid
              (?H\<lparr>carrier := ?h ` carrier G,
                    one := ?h \<one>\<rparr>)\<close>
  notes theorem
    "monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier G; y \<in> carrier G\<rbrakk>
                 \<Longrightarrow> x \<otimes> y =
                                   y \<otimes> x) \<Longrightarrow>
             Group.comm_monoid G\<close>
  notes theorem "units_group" = \<open>Group.group (units_of G)\<close>
  notes theorem
    "units_of_inv" =
      \<open>?x \<in> Units G \<Longrightarrow>
             inv\<^bsub>units_of G\<^esub> ?x = inv ?x\<close>
  notes theorem
    "set_mult_closed" =
      \<open>\<lbrakk>?H \<subseteq> carrier G;
              ?K \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?H <#> ?K \<subseteq> carrier G\<close>
  notes theorem
    "r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?H #> ?x \<subseteq> carrier G\<close>
  notes theorem
    "order_gt_0_iff_finite" =
      \<open>(0 < Coset.order G) = finite (carrier G)\<close>
  notes theorem
    "units_of_pow" =
      \<open>?x \<in> Units G \<Longrightarrow>
             ?x [^]\<^bsub>units_of G\<^esub> ?n = ?x [^] ?n\<close>
  notes theorem
    "inv_char" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?x \<otimes> ?y = \<one>; ?y \<otimes> ?x = \<one>\<rbrakk>
             \<Longrightarrow> inv ?x = ?y\<close>
  notes theorem
    "inv_eq_imp_eq" =
      (\<open>\<lbrakk>inv ?x = inv ?y; ?x \<in> Units G;
               ?y \<in> Units G\<rbrakk>
              \<Longrightarrow> ?x = ?y\<close>)
      ["HOL.dest" !]
  notes theorem
    "inv_eq_one_eq" =
      \<open>?x \<in> Units G \<Longrightarrow>
             (inv ?x = \<one>) = (?x = \<one>)\<close>
  notes theorem
    "monoid_cancelI" =
      \<open>\<lbrakk>\<And>a b c.
                         \<lbrakk>c \<otimes> a = c \<otimes> b;
                          a \<in> carrier G; b \<in> carrier G;
                          c \<in> carrier G\<rbrakk>
                         \<Longrightarrow> a = b;
              \<And>a b c.
                 \<lbrakk>a \<otimes> c = b \<otimes> c; a \<in> carrier G;
                  b \<in> carrier G; c \<in> carrier G\<rbrakk>
                 \<Longrightarrow> a = b\<rbrakk>
             \<Longrightarrow> monoid_cancel G\<close>
  notes theorem
    "prod_unit_l" =
      \<open>\<lbrakk>?a \<otimes> ?b \<in> Units G; ?a \<in> Units G;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?b \<in> Units G\<close>
  notes theorem
    "prod_unit_r" =
      \<open>\<lbrakk>?a \<otimes> ?b \<in> Units G; ?b \<in> Units G;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<in> Units G\<close>
  notes theorem
    "divides_refl" =
      (\<open>?a \<in> carrier G \<Longrightarrow> ?a divides ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "divides_trans" =
      (\<open>\<lbrakk>?a divides ?b; ?b divides ?c;
               ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?a divides ?c\<close>)
      ["trans"]
  notes theorem
    "divides_mult_lI" =
      (\<open>\<lbrakk>?a divides ?b; ?a \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?c \<otimes> ?a divides
                                ?c \<otimes> ?b\<close>)
      ["HOL.intro"]
  notes theorem
    "divides_prod_r" =
      \<open>\<lbrakk>?a divides ?b; ?a \<in> carrier G;
              ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a divides ?b \<otimes> ?c\<close>
  notes theorem
    "unit_divides" =
      \<open>\<lbrakk>?u \<in> Units G; ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?u divides ?a\<close>
  notes theorem
    "associatedI2" =
      \<open>\<lbrakk>?u \<in> Units G; ?a = ?b \<otimes> ?u;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "associatedI2'" =
      \<open>\<lbrakk>?a = ?b \<otimes> ?u; ?u \<in> Units G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "associated_refl" =
      (\<open>?a \<in> carrier G \<Longrightarrow> ?a \<sim> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "associated_sym" =
      (\<open>?a \<sim> ?b \<Longrightarrow> ?b \<sim> ?a\<close>) ["sym"]
  notes theorem
    "associated_trans" =
      (\<open>\<lbrakk>?a \<sim> ?b; ?b \<sim> ?c; ?a \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?a \<sim> ?c\<close>)
      ["trans"]
  notes theorem
    "division_equiv" = (\<open>equivalence (division_rel G)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "divides_cong_l" =
      (\<open>\<lbrakk>?x \<sim> ?x'; ?x' divides ?y;
               ?x \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?x divides ?y\<close>)
      ["trans"]
  notes theorem
    "divides_cong_r" =
      (\<open>\<lbrakk>?x divides ?y; ?y \<sim> ?y';
               ?x \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?x divides ?y'\<close>)
      ["trans"]
  notes theorem
    "division_weak_partial_order" =
      (\<open>weak_partial_order (division_rel G)\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "mult_cong_r" =
      \<open>\<lbrakk>?b \<sim> ?b'; ?a \<in> carrier G; ?b \<in> carrier G;
              ?b' \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<otimes> ?b \<sim>
                               ?a \<otimes> ?b'\<close>
  notes theorem
    "Units_assoc" =
      \<open>\<lbrakk>?a \<in> Units G; ?b \<in> Units G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "Units_are_ones" =
      \<open>Units G {.=}\<^bsub>division_rel G\<^esub> {\<one>}\<close>
  notes theorem
    "properfactor_unitE" =
      \<open>\<lbrakk>?u \<in> Units G; properfactor G ?a ?u;
              ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "properfactor_divides" =
      \<open>properfactor G ?a ?b \<Longrightarrow> ?a divides ?b\<close>
  notes theorem
    "properfactor_trans1" =
      (\<open>\<lbrakk>?a divides ?b; properfactor G ?b ?c;
               ?a \<in> carrier G; ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G ?a ?c\<close>)
      ["trans"]
  notes theorem
    "properfactor_trans2" =
      (\<open>\<lbrakk>properfactor G ?a ?b; ?b divides ?c;
               ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G ?a ?c\<close>)
      ["trans"]
  notes theorem
    "properfactor_cong_l" =
      (\<open>\<lbrakk>?x' \<sim> ?x; properfactor G ?x ?y;
               ?x \<in> carrier G; ?x' \<in> carrier G;
               ?y \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G ?x' ?y\<close>)
      ["trans"]
  notes theorem
    "properfactor_cong_r" =
      (\<open>\<lbrakk>properfactor G ?x ?y; ?y \<sim> ?y';
               ?x \<in> carrier G; ?y \<in> carrier G;
               ?y' \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G ?x ?y'\<close>)
      ["trans"]
  notes theorem
    "properfactor_prod_r" =
      \<open>\<lbrakk>properfactor G ?a ?b; ?a \<in> carrier G;
              ?b \<in> carrier G; ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> properfactor G ?a (?b \<otimes> ?c)\<close>
  notes theorem
    "irreducible_prod_rI" =
      \<open>\<lbrakk>Divisibility.irreducible G ?a; ?b \<in> Units G;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible G
                                (?a \<otimes> ?b)\<close>
  notes theorem
    "listassoc_refl" =
      (\<open>set ?as \<subseteq> carrier G \<Longrightarrow>
              ?as [\<sim>] ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "listassoc_sym" =
      (\<open>\<lbrakk>?as [\<sim>] ?bs; set ?as \<subseteq> carrier G;
               set ?bs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> ?bs [\<sim>] ?as\<close>)
      ["sym"]
  notes theorem
    "listassoc_trans" =
      (\<open>\<lbrakk>?as [\<sim>] ?bs; ?bs [\<sim>] ?cs;
               set ?as \<subseteq> carrier G; set ?bs \<subseteq> carrier G;
               set ?cs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> ?as [\<sim>] ?cs\<close>)
      ["trans"]
  notes theorem
    "perm_assoc_switch" =
      \<open>\<lbrakk>?as [\<sim>] ?bs; mset ?bs = mset ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  mset ?as = mset bs' \<and>
                                  bs' [\<sim>] ?cs\<close>
  notes theorem
    "perm_assoc_switch_r" =
      \<open>\<lbrakk>mset ?as = mset ?bs; ?bs [\<sim>] ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  ?as [\<sim>] bs' \<and>
                                  mset bs' = mset ?cs\<close>
  notes theorem
    "perm_closed" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> set ?bs \<subseteq> carrier G\<close>
  notes theorem
    "irrlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              \<forall>a\<in>set ?as. Divisibility.irreducible G a\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible G a\<close>
  notes theorem
    "essentially_equalI" =
      \<open>\<lbrakk>mset ?fs1.0 = mset ?fs1';
              ?fs1' [\<sim>] ?fs2.0\<rbrakk>
             \<Longrightarrow> essentially_equal G ?fs1.0 ?fs2.0\<close>
  notes theorem
    "essentially_equalE" =
      \<open>\<lbrakk>essentially_equal G ?fs1.0 ?fs2.0;
              \<And>fs1'.
                 \<lbrakk>mset ?fs1.0 = mset fs1';
                  fs1' [\<sim>] ?fs2.0\<rbrakk>
                 \<Longrightarrow> ?P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "ee_refl" =
      (\<open>set ?as \<subseteq> carrier G \<Longrightarrow>
              essentially_equal G ?as ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "ee_sym" =
      (\<open>\<lbrakk>essentially_equal G ?as ?bs;
               set ?as \<subseteq> carrier G;
               set ?bs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> essentially_equal G ?bs ?as\<close>)
      ["sym"]
  notes theorem
    "ee_trans" =
      (\<open>\<lbrakk>essentially_equal G ?as ?bs;
               essentially_equal G ?bs ?cs; set ?as \<subseteq> carrier G;
               set ?bs \<subseteq> carrier G;
               set ?cs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> essentially_equal G ?as ?cs\<close>)
      ["trans"]
  notes theorem
    "multlist_closed" =
      (\<open>set ?fs \<subseteq> carrier G \<Longrightarrow>
              foldr (\<otimes>) ?fs \<one> \<in> carrier G\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "factorsI" =
      \<open>\<lbrakk>\<forall>f\<in>set ?fs. Divisibility.irreducible G f;
              foldr (\<otimes>) ?fs \<one> = ?a\<rbrakk>
             \<Longrightarrow> factors G ?fs ?a\<close>
  notes theorem
    "factors_wfactors" =
      \<open>\<lbrakk>factors G ?as ?a;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> wfactors G ?as ?a\<close>
  notes theorem
    "wfactors_factors" =
      \<open>\<lbrakk>wfactors G ?as ?a;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> \<exists>a'.
                                  factors G ?as a' \<and>
                                  a' \<sim> ?a\<close>
  notes theorem
    "factors_closed" =
      (\<open>\<lbrakk>factors G ?fs ?a;
               set ?fs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> ?a \<in> carrier G\<close>)
      ["HOL.dest"]
  notes theorem
    "nunit_factors" =
      \<open>\<lbrakk>?a \<notin> Units G; factors G ?as ?a\<rbrakk>
             \<Longrightarrow> 0 < length ?as\<close>
  notes theorem
    "unit_wfactors" =
      (\<open>?a \<in> Units G \<Longrightarrow> wfactors G [] ?a\<close>)
      ["simp"]
  notes theorem
    "wfactors_cong_r" =
      (\<open>\<lbrakk>wfactors G ?fs ?a; ?a \<sim> ?a'; ?a \<in> carrier G;
               ?a' \<in> carrier G; set ?fs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> wfactors G ?fs ?a'\<close>)
      ["trans"]
  notes theorem
    "wfactors_prod_exists" =
      (\<open>\<lbrakk>\<forall>a\<in>set ?as. Divisibility.irreducible G a;
               set ?as \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> \<exists>a.
                                   a \<in> carrier G \<and>
                                   wfactors G ?as a\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "factors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible G ?a; factors G ?fb ?b;
              ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> factors G (?a # ?fb)
                                (?a \<otimes> ?b)\<close>
  notes theorem
    "factors_mult" =
      \<open>\<lbrakk>factors G ?fa ?a; factors G ?fb ?b;
              set ?fa \<subseteq> carrier G;
              set ?fb \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> factors G (?fa @ ?fb)
                                (?a \<otimes> ?b)\<close>
  notes theorem
    "assocs_repr_independence" =
      \<open>\<lbrakk>?y \<in> assocs G ?x; ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> assocs G ?x = assocs G ?y\<close>
  notes theorem
    "assocs_self" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x \<in> assocs G ?x\<close>
  notes theorem
    "assocs_repr_independenceD" =
      \<open>\<lbrakk>assocs G ?x = assocs G ?y; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?y \<in> assocs G ?x\<close>
  notes theorem
    "fmset_perm_cong" =
      \<open>mset ?as = mset ?bs \<Longrightarrow>
             fmset G ?as = fmset G ?bs\<close>
  notes theorem
    "mset_fmsetEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x. ?P x \<and> X = assocs G x) \<Longrightarrow>
             \<exists>cs.
                (\<forall>c\<in>set cs. ?P c) \<and>
                fmset G cs = ?Cs\<close>
  notes theorem
    "mset_wfactorsEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    (x \<in> carrier G \<and>
                     Divisibility.irreducible G x) \<and>
                    X = assocs G x) \<Longrightarrow>
             \<exists>c cs.
                c \<in> carrier G \<and>
                set cs \<subseteq> carrier G \<and>
                wfactors G cs c \<and> fmset G cs = ?Cs\<close>
  notes theorem
    "isgcd_divides_l" =
      \<open>\<lbrakk>?a divides ?b; ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a gcdof ?a ?b\<close>
  notes theorem
    "isgcd_divides_r" =
      \<open>\<lbrakk>?b divides ?a; ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?b gcdof ?a ?b\<close>
  notes theorem
    "assoc_subst" =
      \<open>\<lbrakk>?a \<sim> ?b;
              \<forall>a b.
                 a \<in> carrier G \<and>
                 b \<in> carrier G \<and> a \<sim> b \<longrightarrow>
                 ?f a \<in> carrier G \<and>
                 ?f b \<in> carrier G \<and> ?f a \<sim> ?f b;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?f ?a \<sim> ?f ?b\<close>
  notes theorem
    "ee_length" =
      \<open>essentially_equal G ?as ?bs \<Longrightarrow>
             length ?as = length ?bs\<close>
  notes theorem
    "nat_pow_eone" =
      (\<open>?x \<in> carrier G \<Longrightarrow> ?x [^] 1 = ?x\<close>)
      ["simp"]
  notes theorem
    "Units_pow_closed" =
      \<open>?x \<in> Units G \<Longrightarrow>
             ?x [^] ?d \<in> Units G\<close>
locale comm_group
  fixes G :: "('a, 'b) monoid_scheme"  (structure)
  assumes "comm_group G"
  notes
    "monoid_axioms" = (\<open>Group.monoid G\<close>)
      ["attribute" "internal"]
  notes
    "m_closed" =
      (\<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?x \<otimes> ?y \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes
    "m_assoc" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<otimes> ?y \<otimes> ?z =
                               ?x \<otimes> (?y \<otimes> ?z)\<close>
  notes
    "one_closed" = (\<open>\<one> \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes
    "l_one" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              \<one> \<otimes> ?x = ?x\<close>)
      ["simp"]
  notes
    "r_one" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              ?x \<otimes> \<one> = ?x\<close>)
      ["simp"]
  notes theorem
    "Units_closed" =
      (\<open>?x \<in> Units G \<Longrightarrow> ?x \<in> carrier G\<close>)
      ["HOL.dest"]
  notes theorem
    "one_unique" =
      \<open>\<lbrakk>?u \<in> carrier G;
              \<And>x.
                 x \<in> carrier G \<Longrightarrow>
                 ?u \<otimes> x = x\<rbrakk>
             \<Longrightarrow> ?u = \<one>\<close>
  notes theorem
    "inv_unique" =
      \<open>\<lbrakk>?y \<otimes> ?x = \<one>; ?x \<otimes> ?y' = \<one>;
              ?x \<in> carrier G; ?y \<in> carrier G;
              ?y' \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "Units_m_closed" =
      (\<open>\<lbrakk>?x \<in> Units G; ?y \<in> Units G\<rbrakk>
              \<Longrightarrow> ?x \<otimes> ?y \<in> Units G\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "Units_one_closed" = (\<open>\<one> \<in> Units G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "Units_inv_closed" =
      (\<open>?x \<in> Units G \<Longrightarrow>
              inv ?x \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "Units_l_inv_ex" =
      \<open>?x \<in> Units G \<Longrightarrow>
             \<exists>y\<in>carrier G. y \<otimes> ?x = \<one>\<close>
  notes theorem
    "Units_r_inv_ex" =
      \<open>?x \<in> Units G \<Longrightarrow>
             \<exists>y\<in>carrier G. ?x \<otimes> y = \<one>\<close>
  notes theorem
    "Units_l_inv" =
      (\<open>?x \<in> Units G \<Longrightarrow>
              inv ?x \<otimes> ?x = \<one>\<close>)
      ["simp"]
  notes theorem
    "Units_r_inv" =
      (\<open>?x \<in> Units G \<Longrightarrow>
              ?x \<otimes> inv ?x = \<one>\<close>)
      ["simp"]
  notes theorem "inv_one" = (\<open>inv \<one> = \<one>\<close>) ["simp"]
  notes theorem
    "Units_inv_Units" =
      (\<open>?x \<in> Units G \<Longrightarrow>
              inv ?x \<in> Units G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "Units_l_cancel" =
      (\<open>\<lbrakk>?x \<in> Units G; ?y \<in> carrier G;
               ?z \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?x \<otimes> ?y = ?x \<otimes> ?z) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "Units_inv_inv" =
      (\<open>?x \<in> Units G \<Longrightarrow> inv (inv ?x) = ?x\<close>)
      ["simp"]
  notes theorem
    "inv_inj_on_Units" = \<open>inj_on (m_inv G) (Units G)\<close>
  notes theorem
    "Units_inv_comm" =
      \<open>\<lbrakk>?x \<otimes> ?y = \<one>; ?x \<in> Units G;
              ?y \<in> Units G\<rbrakk>
             \<Longrightarrow> ?y \<otimes> ?x = \<one>\<close>
  notes theorem "carrier_not_empty" = \<open>carrier G \<noteq> {}\<close>
  notes theorem
    "group_l_invI" =
      \<open>(\<And>x.
                 x \<in> carrier G \<Longrightarrow>
                 \<exists>y\<in>carrier G.
                    y \<otimes> x = \<one>) \<Longrightarrow>
             Group.group G\<close>
  notes theorem
    "nat_pow_closed" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              ?x [^] ?n \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes theorem "nat_pow_0" = (\<open>?x [^] 0 = \<one>\<close>) ["simp"]
  notes theorem
    "nat_pow_Suc" = (\<open>?x [^] Suc ?n = ?x [^] ?n \<otimes> ?x\<close>)
      ["simp"]
  notes theorem
    "nat_pow_one" = (\<open>\<one> [^] ?n = \<one>\<close>) ["simp"]
  notes theorem
    "nat_pow_mult" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] ?n \<otimes> ?x [^] ?m = ?x [^] (?n + ?m)\<close>
  notes theorem
    "nat_pow_comm" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] ?n \<otimes> ?x [^] ?m =
             ?x [^] ?m \<otimes> ?x [^] ?n\<close>
  notes theorem
    "nat_pow_Suc2" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] Suc ?n = ?x \<otimes> ?x [^] ?n\<close>
  notes theorem
    "nat_pow_pow" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             (?x [^] ?n) [^] ?m = ?x [^] (?n * ?m)\<close>
  notes theorem
    "nat_pow_consistent" =
      \<open>?x [^] ?n =
             ?x [^]\<^bsub>G\<lparr>carrier := ?H\<rparr>\<^esub> ?n\<close>
  notes theorem
    "group_commutes_pow" =
      \<open>\<lbrakk>?x \<otimes> ?y = ?y \<otimes> ?x; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x [^] ?n \<otimes> ?y =
                               ?y \<otimes> ?x [^] ?n\<close>
  notes theorem
    "pow_mult_distrib" =
      \<open>\<lbrakk>?x \<otimes> ?y = ?y \<otimes> ?x; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> (?x \<otimes> ?y) [^] ?n =
                               ?x [^] ?n \<otimes> ?y [^] ?n\<close>
  notes theorem
    "monoid_incl_imp_submonoid" =
      \<open>\<lbrakk>?H \<subseteq> carrier G;
              Group.monoid (G\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> submonoid ?H G\<close>
  notes theorem
    "inv_unique'" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?x \<otimes> ?y = \<one>; ?y \<otimes> ?x = \<one>\<rbrakk>
             \<Longrightarrow> ?y = inv ?x\<close>
  notes theorem
    "m_inv_monoid_consistent" =
      \<open>\<lbrakk>?x \<in> Units (G\<lparr>carrier := ?H\<rparr>);
              submonoid ?H G\<rbrakk>
             \<Longrightarrow> inv\<^bsub>G\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                               inv ?x\<close>
  notes theorem
    "hom_imp_img_monoid" =
      \<open>?h \<in> hom G ?H \<Longrightarrow>
             Group.monoid
              (?H\<lparr>carrier := ?h ` carrier G,
                    one := ?h \<one>\<rparr>)\<close>
  notes theorem
    "monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier G; y \<in> carrier G\<rbrakk>
                 \<Longrightarrow> x \<otimes> y =
                                   y \<otimes> x) \<Longrightarrow>
             Group.comm_monoid G\<close>
  notes theorem "units_group" = \<open>Group.group (units_of G)\<close>
  notes theorem
    "units_of_inv" =
      \<open>?x \<in> Units G \<Longrightarrow>
             inv\<^bsub>units_of G\<^esub> ?x = inv ?x\<close>
  notes theorem
    "set_mult_closed" =
      \<open>\<lbrakk>?H \<subseteq> carrier G;
              ?K \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?H <#> ?K \<subseteq> carrier G\<close>
  notes theorem
    "r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?H #> ?x \<subseteq> carrier G\<close>
  notes theorem
    "order_gt_0_iff_finite" =
      \<open>(0 < Coset.order G) = finite (carrier G)\<close>
  notes theorem
    "units_of_pow" =
      \<open>?x \<in> Units G \<Longrightarrow>
             ?x [^]\<^bsub>units_of G\<^esub> ?n = ?x [^] ?n\<close>
  notes theorem
    "inv_char" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?x \<otimes> ?y = \<one>; ?y \<otimes> ?x = \<one>\<rbrakk>
             \<Longrightarrow> inv ?x = ?y\<close>
  notes theorem
    "inv_eq_imp_eq" =
      (\<open>\<lbrakk>inv ?x = inv ?y; ?x \<in> Units G;
               ?y \<in> Units G\<rbrakk>
              \<Longrightarrow> ?x = ?y\<close>)
      ["HOL.dest" !]
  notes theorem
    "inv_eq_one_eq" =
      \<open>?x \<in> Units G \<Longrightarrow>
             (inv ?x = \<one>) = (?x = \<one>)\<close>
  notes theorem
    "monoid_cancelI" =
      \<open>\<lbrakk>\<And>a b c.
                         \<lbrakk>c \<otimes> a = c \<otimes> b;
                          a \<in> carrier G; b \<in> carrier G;
                          c \<in> carrier G\<rbrakk>
                         \<Longrightarrow> a = b;
              \<And>a b c.
                 \<lbrakk>a \<otimes> c = b \<otimes> c; a \<in> carrier G;
                  b \<in> carrier G; c \<in> carrier G\<rbrakk>
                 \<Longrightarrow> a = b\<rbrakk>
             \<Longrightarrow> monoid_cancel G\<close>
  notes theorem
    "prod_unit_l" =
      \<open>\<lbrakk>?a \<otimes> ?b \<in> Units G; ?a \<in> Units G;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?b \<in> Units G\<close>
  notes theorem
    "prod_unit_r" =
      \<open>\<lbrakk>?a \<otimes> ?b \<in> Units G; ?b \<in> Units G;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<in> Units G\<close>
  notes theorem
    "divides_refl" =
      (\<open>?a \<in> carrier G \<Longrightarrow> ?a divides ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "divides_trans" =
      (\<open>\<lbrakk>?a divides ?b; ?b divides ?c;
               ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?a divides ?c\<close>)
      ["trans"]
  notes theorem
    "divides_mult_lI" =
      (\<open>\<lbrakk>?a divides ?b; ?a \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?c \<otimes> ?a divides
                                ?c \<otimes> ?b\<close>)
      ["HOL.intro"]
  notes theorem
    "divides_prod_r" =
      \<open>\<lbrakk>?a divides ?b; ?a \<in> carrier G;
              ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a divides ?b \<otimes> ?c\<close>
  notes theorem
    "unit_divides" =
      \<open>\<lbrakk>?u \<in> Units G; ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?u divides ?a\<close>
  notes theorem
    "associatedI2" =
      \<open>\<lbrakk>?u \<in> Units G; ?a = ?b \<otimes> ?u;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "associatedI2'" =
      \<open>\<lbrakk>?a = ?b \<otimes> ?u; ?u \<in> Units G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "associated_refl" =
      (\<open>?a \<in> carrier G \<Longrightarrow> ?a \<sim> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "associated_sym" =
      (\<open>?a \<sim> ?b \<Longrightarrow> ?b \<sim> ?a\<close>) ["sym"]
  notes theorem
    "associated_trans" =
      (\<open>\<lbrakk>?a \<sim> ?b; ?b \<sim> ?c; ?a \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?a \<sim> ?c\<close>)
      ["trans"]
  notes theorem
    "division_equiv" = (\<open>equivalence (division_rel G)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "divides_cong_l" =
      (\<open>\<lbrakk>?x \<sim> ?x'; ?x' divides ?y;
               ?x \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?x divides ?y\<close>)
      ["trans"]
  notes theorem
    "divides_cong_r" =
      (\<open>\<lbrakk>?x divides ?y; ?y \<sim> ?y';
               ?x \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?x divides ?y'\<close>)
      ["trans"]
  notes theorem
    "division_weak_partial_order" =
      (\<open>weak_partial_order (division_rel G)\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "mult_cong_r" =
      \<open>\<lbrakk>?b \<sim> ?b'; ?a \<in> carrier G; ?b \<in> carrier G;
              ?b' \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<otimes> ?b \<sim>
                               ?a \<otimes> ?b'\<close>
  notes theorem
    "Units_assoc" =
      \<open>\<lbrakk>?a \<in> Units G; ?b \<in> Units G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "Units_are_ones" =
      \<open>Units G {.=}\<^bsub>division_rel G\<^esub> {\<one>}\<close>
  notes theorem
    "properfactor_unitE" =
      \<open>\<lbrakk>?u \<in> Units G; properfactor G ?a ?u;
              ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "properfactor_divides" =
      \<open>properfactor G ?a ?b \<Longrightarrow> ?a divides ?b\<close>
  notes theorem
    "properfactor_trans1" =
      (\<open>\<lbrakk>?a divides ?b; properfactor G ?b ?c;
               ?a \<in> carrier G; ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G ?a ?c\<close>)
      ["trans"]
  notes theorem
    "properfactor_trans2" =
      (\<open>\<lbrakk>properfactor G ?a ?b; ?b divides ?c;
               ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G ?a ?c\<close>)
      ["trans"]
  notes theorem
    "properfactor_cong_l" =
      (\<open>\<lbrakk>?x' \<sim> ?x; properfactor G ?x ?y;
               ?x \<in> carrier G; ?x' \<in> carrier G;
               ?y \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G ?x' ?y\<close>)
      ["trans"]
  notes theorem
    "properfactor_cong_r" =
      (\<open>\<lbrakk>properfactor G ?x ?y; ?y \<sim> ?y';
               ?x \<in> carrier G; ?y \<in> carrier G;
               ?y' \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G ?x ?y'\<close>)
      ["trans"]
  notes theorem
    "properfactor_prod_r" =
      \<open>\<lbrakk>properfactor G ?a ?b; ?a \<in> carrier G;
              ?b \<in> carrier G; ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> properfactor G ?a (?b \<otimes> ?c)\<close>
  notes theorem
    "irreducible_prod_rI" =
      \<open>\<lbrakk>Divisibility.irreducible G ?a; ?b \<in> Units G;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible G
                                (?a \<otimes> ?b)\<close>
  notes theorem
    "listassoc_refl" =
      (\<open>set ?as \<subseteq> carrier G \<Longrightarrow>
              ?as [\<sim>] ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "listassoc_sym" =
      (\<open>\<lbrakk>?as [\<sim>] ?bs; set ?as \<subseteq> carrier G;
               set ?bs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> ?bs [\<sim>] ?as\<close>)
      ["sym"]
  notes theorem
    "listassoc_trans" =
      (\<open>\<lbrakk>?as [\<sim>] ?bs; ?bs [\<sim>] ?cs;
               set ?as \<subseteq> carrier G; set ?bs \<subseteq> carrier G;
               set ?cs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> ?as [\<sim>] ?cs\<close>)
      ["trans"]
  notes theorem
    "perm_assoc_switch" =
      \<open>\<lbrakk>?as [\<sim>] ?bs; mset ?bs = mset ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  mset ?as = mset bs' \<and>
                                  bs' [\<sim>] ?cs\<close>
  notes theorem
    "perm_assoc_switch_r" =
      \<open>\<lbrakk>mset ?as = mset ?bs; ?bs [\<sim>] ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  ?as [\<sim>] bs' \<and>
                                  mset bs' = mset ?cs\<close>
  notes theorem
    "perm_closed" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> set ?bs \<subseteq> carrier G\<close>
  notes theorem
    "irrlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              \<forall>a\<in>set ?as. Divisibility.irreducible G a\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible G a\<close>
  notes theorem
    "essentially_equalI" =
      \<open>\<lbrakk>mset ?fs1.0 = mset ?fs1';
              ?fs1' [\<sim>] ?fs2.0\<rbrakk>
             \<Longrightarrow> essentially_equal G ?fs1.0 ?fs2.0\<close>
  notes theorem
    "essentially_equalE" =
      \<open>\<lbrakk>essentially_equal G ?fs1.0 ?fs2.0;
              \<And>fs1'.
                 \<lbrakk>mset ?fs1.0 = mset fs1';
                  fs1' [\<sim>] ?fs2.0\<rbrakk>
                 \<Longrightarrow> ?P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "ee_refl" =
      (\<open>set ?as \<subseteq> carrier G \<Longrightarrow>
              essentially_equal G ?as ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "ee_sym" =
      (\<open>\<lbrakk>essentially_equal G ?as ?bs;
               set ?as \<subseteq> carrier G;
               set ?bs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> essentially_equal G ?bs ?as\<close>)
      ["sym"]
  notes theorem
    "ee_trans" =
      (\<open>\<lbrakk>essentially_equal G ?as ?bs;
               essentially_equal G ?bs ?cs; set ?as \<subseteq> carrier G;
               set ?bs \<subseteq> carrier G;
               set ?cs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> essentially_equal G ?as ?cs\<close>)
      ["trans"]
  notes theorem
    "multlist_closed" =
      (\<open>set ?fs \<subseteq> carrier G \<Longrightarrow>
              foldr (\<otimes>) ?fs \<one> \<in> carrier G\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "factorsI" =
      \<open>\<lbrakk>\<forall>f\<in>set ?fs. Divisibility.irreducible G f;
              foldr (\<otimes>) ?fs \<one> = ?a\<rbrakk>
             \<Longrightarrow> factors G ?fs ?a\<close>
  notes theorem
    "factors_wfactors" =
      \<open>\<lbrakk>factors G ?as ?a;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> wfactors G ?as ?a\<close>
  notes theorem
    "wfactors_factors" =
      \<open>\<lbrakk>wfactors G ?as ?a;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> \<exists>a'.
                                  factors G ?as a' \<and>
                                  a' \<sim> ?a\<close>
  notes theorem
    "factors_closed" =
      (\<open>\<lbrakk>factors G ?fs ?a;
               set ?fs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> ?a \<in> carrier G\<close>)
      ["HOL.dest"]
  notes theorem
    "nunit_factors" =
      \<open>\<lbrakk>?a \<notin> Units G; factors G ?as ?a\<rbrakk>
             \<Longrightarrow> 0 < length ?as\<close>
  notes theorem
    "unit_wfactors" =
      (\<open>?a \<in> Units G \<Longrightarrow> wfactors G [] ?a\<close>)
      ["simp"]
  notes theorem
    "wfactors_cong_r" =
      (\<open>\<lbrakk>wfactors G ?fs ?a; ?a \<sim> ?a'; ?a \<in> carrier G;
               ?a' \<in> carrier G; set ?fs \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> wfactors G ?fs ?a'\<close>)
      ["trans"]
  notes theorem
    "wfactors_prod_exists" =
      (\<open>\<lbrakk>\<forall>a\<in>set ?as. Divisibility.irreducible G a;
               set ?as \<subseteq> carrier G\<rbrakk>
              \<Longrightarrow> \<exists>a.
                                   a \<in> carrier G \<and>
                                   wfactors G ?as a\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "factors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible G ?a; factors G ?fb ?b;
              ?a \<in> carrier G\<rbrakk>
             \<Longrightarrow> factors G (?a # ?fb)
                                (?a \<otimes> ?b)\<close>
  notes theorem
    "factors_mult" =
      \<open>\<lbrakk>factors G ?fa ?a; factors G ?fb ?b;
              set ?fa \<subseteq> carrier G;
              set ?fb \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> factors G (?fa @ ?fb)
                                (?a \<otimes> ?b)\<close>
  notes theorem
    "assocs_repr_independence" =
      \<open>\<lbrakk>?y \<in> assocs G ?x; ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> assocs G ?x = assocs G ?y\<close>
  notes theorem
    "assocs_self" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x \<in> assocs G ?x\<close>
  notes theorem
    "assocs_repr_independenceD" =
      \<open>\<lbrakk>assocs G ?x = assocs G ?y; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?y \<in> assocs G ?x\<close>
  notes theorem
    "fmset_perm_cong" =
      \<open>mset ?as = mset ?bs \<Longrightarrow>
             fmset G ?as = fmset G ?bs\<close>
  notes theorem
    "mset_fmsetEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x. ?P x \<and> X = assocs G x) \<Longrightarrow>
             \<exists>cs.
                (\<forall>c\<in>set cs. ?P c) \<and>
                fmset G cs = ?Cs\<close>
  notes theorem
    "mset_wfactorsEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    (x \<in> carrier G \<and>
                     Divisibility.irreducible G x) \<and>
                    X = assocs G x) \<Longrightarrow>
             \<exists>c cs.
                c \<in> carrier G \<and>
                set cs \<subseteq> carrier G \<and>
                wfactors G cs c \<and> fmset G cs = ?Cs\<close>
  notes theorem
    "isgcd_divides_l" =
      \<open>\<lbrakk>?a divides ?b; ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a gcdof ?a ?b\<close>
  notes theorem
    "isgcd_divides_r" =
      \<open>\<lbrakk>?b divides ?a; ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?b gcdof ?a ?b\<close>
  notes theorem
    "assoc_subst" =
      \<open>\<lbrakk>?a \<sim> ?b;
              \<forall>a b.
                 a \<in> carrier G \<and>
                 b \<in> carrier G \<and> a \<sim> b \<longrightarrow>
                 ?f a \<in> carrier G \<and>
                 ?f b \<in> carrier G \<and> ?f a \<sim> ?f b;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?f ?a \<sim> ?f ?b\<close>
  notes theorem
    "ee_length" =
      \<open>essentially_equal G ?as ?bs \<Longrightarrow>
             length ?as = length ?bs\<close>
  notes theorem
    "nat_pow_eone" =
      (\<open>?x \<in> carrier G \<Longrightarrow> ?x [^] 1 = ?x\<close>)
      ["simp"]
  notes theorem
    "Units_pow_closed" =
      \<open>?x \<in> Units G \<Longrightarrow>
             ?x [^] ?d \<in> Units G\<close>
  notes
    "comm_monoid_axioms" = (\<open>Group.comm_monoid G\<close>)
      ["attribute" "internal"]
  notes
    "m_comm" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<otimes> ?y = ?y \<otimes> ?x\<close>
  notes theorem
    "m_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<otimes> (?y \<otimes> ?z) =
                               ?y \<otimes> (?x \<otimes> ?z)\<close>
  notes theorem
    "m_ac" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<otimes> ?y \<otimes> ?z =
                               ?x \<otimes> (?y \<otimes> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<otimes> ?y = ?y \<otimes> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?z \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x \<otimes> (?y \<otimes> ?z) =
                               ?y \<otimes> (?x \<otimes> ?z)\<close>
  notes theorem
    "submonoid_is_comm_monoid" =
      \<open>submonoid ?H G \<Longrightarrow>
             Group.comm_monoid (G\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "nat_pow_distrib" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> (?x \<otimes> ?y) [^] ?n =
                               ?x [^] ?n \<otimes> ?y [^] ?n\<close>
  notes theorem
    "hom_imp_img_comm_monoid" =
      \<open>?h \<in> hom G ?H \<Longrightarrow>
             Group.comm_monoid
              (?H\<lparr>carrier := ?h ` carrier G,
                    one := ?h \<one>\<rparr>)\<close>
  notes theorem "units_comm_group" = \<open>comm_group (units_of G)\<close>
  notes theorem
    "finprod_empty" = (\<open>finprod G ?f {} = \<one>\<close>) ["simp"]
  notes theorem
    "finprod_infinite" =
      (\<open>infinite ?A \<Longrightarrow>
              finprod G ?f ?A = \<one>\<close>)
      ["simp"]
  notes theorem
    "finprod_insert" =
      (\<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
               ?f \<in> ?F \<rightarrow> carrier G;
               ?f ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> finprod G ?f (insert ?a ?F) =
                                ?f ?a \<otimes> finprod G ?f ?F\<close>)
      ["simp"]
  notes theorem
    "finprod_one_eqI" =
      \<open>(\<And>x.
                 x \<in> ?A \<Longrightarrow>
                 ?f x = \<one>) \<Longrightarrow>
             finprod G ?f ?A = \<one>\<close>
  notes theorem
    "finprod_one" = (\<open>(\<Otimes>i\<in>?A. \<one>) = \<one>\<close>)
      ["simp"]
  notes theorem
    "finprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier G \<Longrightarrow>
              finprod G ?f ?A \<in> carrier G\<close>)
      ["simp"]
  notes theorem
    "funcset_Int_left" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> ?C;
               ?f \<in> ?B \<rightarrow> ?C\<rbrakk>
              \<Longrightarrow> ?f \<in> ?A \<inter> ?B \<rightarrow>
   ?C\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "funcset_Un_left" =
      (\<open>(?f \<in> ?A \<union> ?B \<rightarrow> ?C) =
              (?f \<in> ?A \<rightarrow> ?C \<and>
               ?f \<in> ?B \<rightarrow> ?C)\<close>)
      ["iff"]
  notes theorem
    "finprod_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier G;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finprod G ?g (?A \<union> ?B) \<otimes>
                               finprod G ?g (?A \<inter> ?B) =
                               finprod G ?g ?A \<otimes>
                               finprod G ?g ?B\<close>
  notes theorem
    "finprod_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier G;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finprod G ?g (?A \<union> ?B) =
                               finprod G ?g ?A \<otimes>
                               finprod G ?g ?B\<close>
  notes theorem
    "finprod_multf" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier G;
               ?g \<in> ?A \<rightarrow> carrier G\<rbrakk>
              \<Longrightarrow> (\<Otimes>x\<in>?A. ?f x \<otimes> ?g x) =
                                finprod G ?f ?A \<otimes>
                                finprod G ?g ?A\<close>)
      ["simp"]
  notes theorem
    "finprod_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier G;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finprod G ?f ?A = finprod G ?g ?B\<close>
  notes theorem
    "finprod_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier G) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finprod G ?f ?A = finprod G ?g ?B\<close>
  notes theorem
    "finprod_0" =
      (\<open>?f \<in> {0} \<rightarrow> carrier G \<Longrightarrow>
              finprod G ?f {..0} = ?f 0\<close>)
      ["simp"]
  notes theorem
    "finprod_0'" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier G \<Longrightarrow>
             ?f 0 \<otimes> finprod G ?f {Suc 0..?n} =
             finprod G ?f {..?n}\<close>
  notes theorem
    "finprod_Suc" =
      (\<open>?f \<in> {..Suc ?n} \<rightarrow> carrier G \<Longrightarrow>
              finprod G ?f {..Suc ?n} =
              ?f (Suc ?n) \<otimes> finprod G ?f {..?n}\<close>)
      ["simp"]
  notes theorem
    "finprod_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier G \<Longrightarrow>
             finprod G ?f {..Suc ?n} =
             (\<Otimes>i\<in>{..?n}. ?f (Suc i)) \<otimes> ?f 0\<close>
  notes theorem
    "finprod_Suc3" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier G \<Longrightarrow>
             finprod G ?f {..?n} =
             ?f ?n \<otimes> finprod G ?f {..<?n}\<close>
  notes theorem
    "finprod_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier G;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finprod G ?f (?h ` ?A) =
                               (\<Otimes>x\<in>?A. ?f (?h x))\<close>
  notes theorem
    "finprod_const" =
      \<open>?a \<in> carrier G \<Longrightarrow>
             (\<Otimes>x\<in>?A. ?a) = ?a [^] card ?A\<close>
  notes theorem
    "finprod_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> (\<Otimes>j\<in>?A. if ?i = j then ?f j
             else \<one>) =
                               ?f ?i\<close>
  notes theorem
    "finprod_singleton_swap" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> (\<Otimes>j\<in>?A. if j = ?i then ?f j
             else \<one>) =
                               ?f ?i\<close>
  notes theorem
    "finprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<one>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finprod G ?g ?A = finprod G ?h ?B\<close>
  notes theorem
    "finprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?g i = \<one>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finprod G ?g ?B = finprod G ?h ?A\<close>
  notes theorem
    "finprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<one>;
              \<And>i. i \<in> ?A - ?B \<Longrightarrow> ?g i = \<one>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier G;
              ?h \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> finprod G ?g ?A = finprod G ?h ?B\<close>
  notes theorem
    "finprod_UN_disjoint" =
      \<open>\<lbrakk>finite ?I;
              \<And>i. i \<in> ?I \<Longrightarrow> finite (?A i);
              pairwise (\<lambda>i j. disjnt (?A i) (?A j)) ?I;
              \<And>i x.
                 \<lbrakk>i \<in> ?I; x \<in> ?A i\<rbrakk>
                 \<Longrightarrow> ?g x \<in> carrier G\<rbrakk>
             \<Longrightarrow> finprod G ?g (\<Union> (?A ` ?I)) =
                               (\<Otimes>i\<in>?I. finprod G ?g
              (?A i))\<close>
  notes theorem
    "finprod_Union_disjoint" =
      \<open>\<lbrakk>finite ?C;
              \<And>A.
                 A \<in> ?C \<Longrightarrow>
                 finite A \<and> (\<forall>x\<in>A. ?f x \<in> carrier G);
              disjoint ?C\<rbrakk>
             \<Longrightarrow> finprod G ?f (\<Union> ?C) =
                               finprod G (finprod G ?f) ?C\<close>
  notes theorem
    "comm_inv_char" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?x \<otimes> ?y = \<one>\<rbrakk>
             \<Longrightarrow> inv ?x = ?y\<close>
  notes theorem
    "unit_factor" =
      \<open>\<lbrakk>?a \<otimes> ?b \<in> Units G; ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<in> Units G\<close>
  notes theorem
    "divides_mult_rI" =
      (\<open>\<lbrakk>?a divides ?b; ?a \<in> carrier G;
               ?b \<in> carrier G; ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?a \<otimes> ?c divides
                                ?b \<otimes> ?c\<close>)
      ["HOL.intro"]
  notes theorem
    "divides_prod_l" =
      \<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G;
              ?c \<in> carrier G; ?a divides ?b\<rbrakk>
             \<Longrightarrow> ?a divides ?c \<otimes> ?b\<close>
  notes theorem
    "divides_unit" =
      \<open>\<lbrakk>?a divides ?u; ?a \<in> carrier G;
              ?u \<in> Units G\<rbrakk>
             \<Longrightarrow> ?a \<in> Units G\<close>
  notes theorem
    "Unit_eq_dividesone" =
      \<open>?u \<in> carrier G \<Longrightarrow>
             (?u \<in> Units G) = ?u divides \<one>\<close>
  notes theorem
    "mult_cong_l" =
      \<open>\<lbrakk>?a \<sim> ?a'; ?a \<in> carrier G;
              ?a' \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<otimes> ?b \<sim>
                               ?a' \<otimes> ?b\<close>
  notes theorem
    "Units_cong" =
      \<open>\<lbrakk>?a \<in> Units G; ?a \<sim> ?b;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?b \<in> Units G\<close>
  notes theorem
    "Units_Lower" =
      \<open>Units G = Lower (division_rel G) (carrier G)\<close>
  notes theorem
    "properfactor_prod_l" =
      \<open>\<lbrakk>properfactor G ?a ?b; ?a \<in> carrier G;
              ?b \<in> carrier G; ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> properfactor G ?a (?c \<otimes> ?b)\<close>
  notes theorem
    "irreducible_prod_lI" =
      \<open>\<lbrakk>Divisibility.irreducible G ?b; ?a \<in> Units G;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible G
                                (?a \<otimes> ?b)\<close>
  notes theorem
    "multlist_dividesI" =
      \<open>\<lbrakk>?f \<in> set ?fs;
              set ?fs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?f divides
                               foldr (\<otimes>) ?fs \<one>\<close>
  notes theorem
    "multlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> foldr (\<otimes>) ?as \<one> =
                               foldr (\<otimes>) ?bs \<one>\<close>
  notes theorem
    "wfactors_perm_cong_l" =
      \<open>\<lbrakk>wfactors G ?fs ?a; mset ?fs = mset ?fs';
              set ?fs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> wfactors G ?fs' ?a\<close>
  notes theorem
    "perm_wfactorsD" =
      \<open>\<lbrakk>mset ?as = mset ?bs; wfactors G ?as ?a;
              wfactors G ?bs ?b; ?a \<in> carrier G; ?b \<in> carrier G;
              set ?as \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "factors_dividesI" =
      \<open>\<lbrakk>factors G ?fs ?a; ?f \<in> set ?fs;
              set ?fs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?f divides ?a\<close>
  notes theorem
    "wfactors_dividesI" =
      \<open>\<lbrakk>wfactors G ?fs ?a; set ?fs \<subseteq> carrier G;
              ?a \<in> carrier G; ?f \<in> set ?fs\<rbrakk>
             \<Longrightarrow> ?f divides ?a\<close>
  notes theorem
    "assocs_assoc" =
      \<open>\<lbrakk>?a \<in> assocs G ?b; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "assocs_eqD" =
      \<open>\<lbrakk>assocs G ?b = assocs G ?a; ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "gfinprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier G \<Longrightarrow>
              gfinprod G ?f ?A \<in> carrier G\<close>)
      ["simp"]
  notes theorem
    "gfinprod_cong" =
      \<open>\<lbrakk>?A = ?B; ?f \<in> ?B \<rightarrow> carrier G;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> gfinprod G ?f ?A = gfinprod G ?g ?B\<close>
  notes theorem
    "gfinprod_eq_finprod" =
      (\<open>\<lbrakk>finite ?A;
               ?f \<in> ?A \<rightarrow> carrier G\<rbrakk>
              \<Longrightarrow> gfinprod G ?f ?A = finprod G ?f ?A\<close>)
      ["simp"]
  notes theorem
    "gfinprod_insert" =
      (\<open>\<lbrakk>finite {x \<in> ?A. ?f x \<noteq> \<one>};
               ?f \<in> ?A \<rightarrow> carrier G;
               ?f ?i \<in> carrier G\<rbrakk>
              \<Longrightarrow> gfinprod G ?f (insert ?i ?A) =
                                (if ?i \<in> ?A then gfinprod G ?f ?A
                                 else ?f ?i \<otimes>
gfinprod G ?f ?A)\<close>)
      ["simp"]
  notes theorem
    "gfinprod_distrib" =
      \<open>\<lbrakk>finite {x \<in> ?A. ?f x \<noteq> \<one>};
              finite {x \<in> ?A. ?g x \<noteq> \<one>};
              ?f \<in> ?A \<rightarrow> carrier G;
              ?g \<in> ?A \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> gfinprod G (\<lambda>i. ?f i \<otimes> ?g i)
                                ?A =
                               gfinprod G ?f ?A \<otimes>
                               gfinprod G ?g ?A\<close>
  notes theorem
    "gfinprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<one>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> gfinprod G ?g ?A = gfinprod G ?h ?B\<close>
  notes theorem
    "gfinprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?g i = \<one>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> gfinprod G ?g ?B = gfinprod G ?h ?A\<close>
  notes theorem
    "gfinprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<one>;
              \<And>i. i \<in> ?A - ?B \<Longrightarrow> ?g i = \<one>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier G;
              ?h \<in> ?B \<rightarrow> carrier G\<rbrakk>
             \<Longrightarrow> gfinprod G ?g ?A = gfinprod G ?h ?B\<close>
  notes
    "monoid_cancel_axioms" = (\<open>monoid_cancel G\<close>)
      ["attribute" "internal"]
  notes
    "l_cancel" =
      \<open>\<lbrakk>?c \<otimes> ?a = ?c \<otimes> ?b; ?a \<in> carrier G;
              ?b \<in> carrier G; ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a = ?b\<close>
  notes
    "r_cancel" =
      \<open>\<lbrakk>?a \<otimes> ?c = ?b \<otimes> ?c; ?a \<in> carrier G;
              ?b \<in> carrier G; ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a = ?b\<close>
  notes theorem "is_monoid_cancel" = \<open>monoid_cancel G\<close>
  notes theorem
    "divides_mult_l" =
      (\<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?c \<otimes> ?a divides ?c \<otimes> ?b =
                                ?a divides ?b\<close>)
      ["simp"]
  notes theorem
    "associatedD2" =
      \<open>\<lbrakk>?a \<sim> ?b; ?a \<in> carrier G;
              ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> \<exists>u\<in>Units G.
                                  ?a = ?b \<otimes> u\<close>
  notes theorem
    "associatedE2" =
      \<open>\<lbrakk>?a \<sim> ?b;
              \<And>u.
                 \<lbrakk>?a = ?b \<otimes> u; u \<in> Units G\<rbrakk>
                 \<Longrightarrow> ?P;
              ?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "assoc_l_cancel" =
      \<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G;
              ?b' \<in> carrier G;
              ?a \<otimes> ?b \<sim> ?a \<otimes> ?b'\<rbrakk>
             \<Longrightarrow> ?b \<sim> ?b'\<close>
  notes theorem
    "assoc_unit_l" =
      (\<open>\<lbrakk>?a \<sim> ?b; ?b \<in> Units G;
               ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?a \<in> Units G\<close>)
      ["trans"]
  notes theorem
    "assoc_unit_r" =
      (\<open>\<lbrakk>?a \<in> Units G; ?a \<sim> ?b;
               ?b \<in> carrier G\<rbrakk>
              \<Longrightarrow> ?b \<in> Units G\<close>)
      ["trans"]
  notes theorem
    "associated_iff" =
      \<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b =
                               (\<exists>c\<in>Units G.
                                   ?a = ?b \<otimes> c)\<close>
  notes theorem
    "properfactor_mult_lI" =
      (\<open>\<lbrakk>properfactor G ?a ?b; ?a \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G (?c \<otimes> ?a)
                                 (?c \<otimes> ?b)\<close>)
      ["HOL.intro"]
  notes theorem
    "properfactor_mult_l" =
      (\<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G;
               ?c \<in> carrier G\<rbrakk>
              \<Longrightarrow> properfactor G (?c \<otimes> ?a)
                                 (?c \<otimes> ?b) =
                                properfactor G ?a ?b\<close>)
      ["simp"]
  notes theorem
    "irreducible_cong" =
      (\<open>\<lbrakk>Divisibility.irreducible G ?a; ?a \<sim> ?a';
               ?a \<in> carrier G; ?a' \<in> carrier G\<rbrakk>
              \<Longrightarrow> Divisibility.irreducible G ?a'\<close>)
      ["trans"]
  notes theorem
    "prime_cong" =
      (\<open>\<lbrakk>Divisibility.prime G ?p; ?p \<sim> ?p';
               ?p \<in> carrier G; ?p' \<in> carrier G\<rbrakk>
              \<Longrightarrow> Divisibility.prime G ?p'\<close>)
      ["trans"]
  notes theorem
    "irrlist_listassoc_cong" =
      \<open>\<lbrakk>\<forall>a\<in>set ?as. Divisibility.irreducible G a;
              ?as [\<sim>] ?bs; set ?as \<subseteq> carrier G;
              set ?bs \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible G a\<close>
  notes theorem
    "wfactors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible G ?a; wfactors G ?fb ?b;
              ?a \<in> carrier G; ?b \<in> carrier G;
              set ?fb \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> wfactors G (?a # ?fb)
                                (?a \<otimes> ?b)\<close>
  notes
    "group_axioms" = (\<open>Group.group G\<close>) ["attribute" "internal"]
  notes "Units" = \<open>carrier G \<subseteq> Units G\<close>
  notes theorem "is_group" = (\<open>Group.group G\<close>) ["iff"]
  notes theorem "is_monoid" = (\<open>Group.monoid G\<close>) ["iff"]
  notes theorem "Units_eq" = (\<open>Units G = carrier G\<close>) ["simp"]
  notes theorem
    "inv_closed" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              inv ?x \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "l_inv_ex" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              \<exists>y\<in>carrier G. y \<otimes> ?x = \<one>\<close>)
      ["simp"]
  notes theorem
    "r_inv_ex" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              \<exists>y\<in>carrier G. ?x \<otimes> y = \<one>\<close>)
      ["simp"]
  notes theorem
    "l_inv" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              inv ?x \<otimes> ?x = \<one>\<close>)
      ["simp"]
  notes theorem
    "inv_eq_1_iff" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              (inv ?x = \<one>) = (?x = \<one>)\<close>)
      ["simp"]
  notes theorem
    "r_inv" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              ?x \<otimes> inv ?x = \<one>\<close>)
      ["simp"]
  notes theorem
    "right_cancel" =
      (\<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
               ?z \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?y \<otimes> ?x = ?z \<otimes> ?x) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "inv_inv" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              inv (inv ?x) = ?x\<close>)
      ["simp"]
  notes theorem "inv_inj" = \<open>inj_on (m_inv G) (carrier G)\<close>
  notes theorem
    "inv_mult_group" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> inv (?x \<otimes> ?y) =
                               inv ?y \<otimes> inv ?x\<close>
  notes theorem
    "inv_comm" =
      \<open>\<lbrakk>?x \<otimes> ?y = \<one>; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?y \<otimes> ?x = \<one>\<close>
  notes theorem
    "inv_equality" =
      \<open>\<lbrakk>?y \<otimes> ?x = \<one>; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> inv ?x = ?y\<close>
  notes theorem
    "inv_solve_left" =
      \<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G;
              ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> (?a = inv ?b \<otimes> ?c) =
                               (?c = ?b \<otimes> ?a)\<close>
  notes theorem
    "inv_solve_left'" =
      \<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G;
              ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> (inv ?b \<otimes> ?c = ?a) =
                               (?c = ?b \<otimes> ?a)\<close>
  notes theorem
    "inv_solve_right" =
      \<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G;
              ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> (?a = ?b \<otimes> inv ?c) =
                               (?b = ?a \<otimes> ?c)\<close>
  notes theorem
    "inv_solve_right'" =
      \<open>\<lbrakk>?a \<in> carrier G; ?b \<in> carrier G;
              ?c \<in> carrier G\<rbrakk>
             \<Longrightarrow> (?b \<otimes> inv ?c = ?a) =
                               (?b = ?a \<otimes> ?c)\<close>
  notes theorem
    "nat_pow_inv" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             inv ?x [^] ?i = inv (?x [^] ?i)\<close>
  notes theorem
    "int_pow_one" = (\<open>\<one> [^] ?z = \<one>\<close>) ["simp"]
  notes theorem
    "int_pow_closed" =
      (\<open>?x \<in> carrier G \<Longrightarrow>
              ?x [^] ?i \<in> carrier G\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "int_pow_1" =
      (\<open>?x \<in> carrier G \<Longrightarrow> ?x [^] 1 = ?x\<close>)
      ["simp"]
  notes theorem
    "int_pow_neg" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] - ?i = inv (?x [^] ?i)\<close>
  notes theorem
    "int_pow_neg_int" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] - int ?n = inv (?x [^] ?n)\<close>
  notes theorem
    "int_pow_mult" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] (?i + ?j) = ?x [^] ?i \<otimes> ?x [^] ?j\<close>
  notes theorem
    "int_pow_inv" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             inv ?x [^] ?i = inv (?x [^] ?i)\<close>
  notes theorem
    "int_pow_pow" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             (?x [^] ?n) [^] ?m = ?x [^] (?n * ?m)\<close>
  notes theorem
    "int_pow_diff" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ?x [^] (?n - ?m) = ?x [^] ?n \<otimes> inv (?x [^] ?m)\<close>
  notes theorem
    "inj_on_multc" =
      \<open>?c \<in> carrier G \<Longrightarrow>
             inj_on (\<lambda>x. x \<otimes> ?c) (carrier G)\<close>
  notes theorem
    "inj_on_cmult" =
      \<open>?c \<in> carrier G \<Longrightarrow>
             inj_on ((\<otimes>) ?c) (carrier G)\<close>
  notes theorem
    "int_pow_mult_distrib" =
      \<open>\<lbrakk>?x \<otimes> ?y = ?y \<otimes> ?x; ?x \<in> carrier G;
              ?y \<in> carrier G\<rbrakk>
             \<Longrightarrow> (?x \<otimes> ?y) [^] ?i =
                               ?x [^] ?i \<otimes> ?y [^] ?i\<close>
  notes theorem
    "pow_eq_div2" =
      \<open>\<lbrakk>?x \<in> carrier G; ?x [^] ?m = ?x [^] ?n\<rbrakk>
             \<Longrightarrow> ?x [^] (?m - ?n) = \<one>\<close>
  notes theorem "triv_subgroup" = \<open>subgroup {\<one>} G\<close>
  notes theorem
    "subgroup_Units" =
      \<open>subgroup ?H G \<Longrightarrow>
             ?H \<subseteq> Units (G\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "m_inv_consistent" =
      (\<open>\<lbrakk>subgroup ?H G; ?x \<in> ?H\<rbrakk>
              \<Longrightarrow> inv\<^bsub>G\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                                inv ?x\<close>)
      ["simp"]
  notes theorem
    "int_pow_consistent" =
      \<open>\<lbrakk>subgroup ?H G; ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?x [^] ?n =
                               ?x [^]\<^bsub>G\<lparr>carrier := ?H\<rparr>\<^esub>
                               ?n\<close>
  notes theorem
    "one_in_subset" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?H \<noteq> {};
              \<forall>a\<in>?H. inv a \<in> ?H;
              \<forall>a\<in>?H.
                 \<forall>b\<in>?H. a \<otimes> b \<in> ?H\<rbrakk>
             \<Longrightarrow> \<one> \<in> ?H\<close>
  notes theorem
    "subgroupI" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?H \<noteq> {};
              \<And>a. a \<in> ?H \<Longrightarrow> inv a \<in> ?H;
              \<And>a b.
                 \<lbrakk>a \<in> ?H; b \<in> ?H\<rbrakk>
                 \<Longrightarrow> a \<otimes> b \<in> ?H\<rbrakk>
             \<Longrightarrow> subgroup ?H G\<close>
  notes theorem
    "subgroupE" =
      \<open>subgroup ?H G \<Longrightarrow>
             ?H \<subseteq> carrier G\<close>
      \<open>subgroup ?H G \<Longrightarrow> ?H \<noteq> {}\<close>
      \<open>\<lbrakk>subgroup ?H G; ?a \<in> ?H\<rbrakk>
             \<Longrightarrow> inv ?a \<in> ?H\<close>
      \<open>\<lbrakk>subgroup ?H G; ?a \<in> ?H; ?b \<in> ?H\<rbrakk>
             \<Longrightarrow> ?a \<otimes> ?b \<in> ?H\<close>
  notes theorem
    "submonoid_subgroupI" =
      \<open>\<lbrakk>submonoid ?H G;
              \<And>a. a \<in> ?H \<Longrightarrow> inv a \<in> ?H\<rbrakk>
             \<Longrightarrow> subgroup ?H G\<close>
  notes theorem
    "group_incl_imp_subgroup" =
      \<open>\<lbrakk>?H \<subseteq> carrier G;
              Group.group (G\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> subgroup ?H G\<close>
  notes theorem
    "hom_restrict" =
      \<open>\<lbrakk>?h \<in> hom G ?H;
              \<And>g.
                 g \<in> carrier G \<Longrightarrow> ?h g = ?t g\<rbrakk>
             \<Longrightarrow> ?t \<in> hom G ?H\<close>
  notes theorem
    "hom_compose" =
      \<open>\<lbrakk>?h \<in> hom G ?H; ?i \<in> hom ?H ?I\<rbrakk>
             \<Longrightarrow> compose (carrier G) ?i ?h
                               \<in> hom G ?I\<close>
  notes theorem
    "restrict_hom_iff" =
      (\<open>((\<lambda>x. if x \<in> carrier G then ?f x else ?g x)
               \<in> hom G ?H) =
              (?f \<in> hom G ?H)\<close>)
      ["simp"]
  notes theorem
    "hom_eq" =
      \<open>\<lbrakk>?f \<in> hom G ?H;
              \<And>x.
                 x \<in> carrier G \<Longrightarrow> ?f' x = ?f x\<rbrakk>
             \<Longrightarrow> ?f' \<in> hom G ?H\<close>
  notes theorem
    "iso_eq" =
      \<open>\<lbrakk>?f \<in> Group.iso G ?H;
              \<And>x.
                 x \<in> carrier G \<Longrightarrow> ?f' x = ?f x\<rbrakk>
             \<Longrightarrow> ?f' \<in> Group.iso G ?H\<close>
  notes theorem
    "iso_set_sym" =
      \<open>?h \<in> Group.iso G ?H \<Longrightarrow>
             inv_into (carrier G) ?h \<in> Group.iso ?H G\<close>
  notes theorem
    "iso_sym" = \<open>G \<cong> ?H \<Longrightarrow> ?H \<cong> G\<close>
  notes theorem
    "hom_imp_img_group" =
      \<open>?h \<in> hom G ?H \<Longrightarrow>
             Group.group
              (?H\<lparr>carrier := ?h ` carrier G,
                    one := ?h \<one>\<rparr>)\<close>
  notes theorem
    "iso_imp_group" =
      \<open>\<lbrakk>G \<cong> ?H; Group.monoid ?H\<rbrakk>
             \<Longrightarrow> Group.group ?H\<close>
  notes theorem
    "iso_imp_img_group" =
      \<open>?h \<in> Group.iso G ?H \<Longrightarrow>
             Group.group (?H\<lparr>one := ?h \<one>\<rparr>)\<close>
  notes theorem
    "iso_iff_group_isomorphisms" =
      \<open>(?f \<in> Group.iso G ?H) =
             (\<exists>g. group_isomorphisms G ?H ?f g)\<close>
  notes theorem
    "DirProd_iso_set_trans" =
      \<open>\<lbrakk>?g \<in> Group.iso G ?G2.0;
              ?h \<in> Group.iso ?H ?I\<rbrakk>
             \<Longrightarrow> (\<lambda>(x, y). (?g x, ?h y))
                               \<in> Group.iso (G \<times>\<times> ?H)
(?G2.0 \<times>\<times> ?I)\<close>
  notes theorem
    "DirProd_iso_trans" =
      \<open>\<lbrakk>G \<cong> ?G2.0; ?H \<cong> ?I\<rbrakk>
             \<Longrightarrow> G \<times>\<times> ?H \<cong>
                               ?G2.0 \<times>\<times> ?I\<close>
  notes theorem
    "int_pow_is_hom" =
      \<open>?x \<in> carrier G \<Longrightarrow>
             ([^]) ?x
             \<in> hom \<lparr>carrier = UNIV, monoid.mult = (+),
                          one = 0\<rparr>
                    G\<close>
  notes theorem
    "canonical_inj_is_hom" =
      \<open>subgroup ?H G \<Longrightarrow>
             group_hom (G\<lparr>carrier := ?H\<rparr>) G id\<close>
  notes theorem
    "group_comm_groupI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier G; y \<in> carrier G\<rbrakk>
                 \<Longrightarrow> x \<otimes> y =
                                   y \<otimes> x) \<Longrightarrow>
             comm_group G\<close>
  notes theorem
    "incl_subgroup" =
      \<open>\<lbrakk>subgroup ?J G;
              subgroup ?I (G\<lparr>carrier := ?J\<rparr>)\<rbrakk>
             \<Longrightarrow> subgroup ?I G\<close>
  notes theorem
    "subgroup_incl" =
      \<open>\<lbrakk>subgroup ?I G; subgroup ?J G;
              ?I \<subseteq> ?J\<rbrakk>
             \<Longrightarrow> subgroup ?I
                                (G\<lparr>carrier := ?J\<rparr>)\<close>
  notes theorem
    "subgroups_partial_order" =
      \<open>partial_order
              \<lparr>carrier = {H. subgroup H G}, eq = (=),
                 le = (\<subseteq>)\<rparr>\<close>
  notes theorem "subgroup_self" = \<open>subgroup (carrier G) G\<close>
  notes theorem
    "subgroup_imp_group" =
      \<open>subgroup ?H G \<Longrightarrow>
             Group.group (G\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "subgroup_mult_equality" =
      \<open>\<lbrakk>subgroup ?H G; ?h1.0 \<in> ?H; ?h2.0 \<in> ?H\<rbrakk>
             \<Longrightarrow> ?h1.0 \<otimes>\<^bsub>G\<lparr>carrier := ?H\<rparr>\<^esub>
                               ?h2.0 =
                               ?h1.0 \<otimes> ?h2.0\<close>
  notes theorem
    "subgroups_Inter" =
      \<open>\<lbrakk>\<And>H. H \<in> ?A \<Longrightarrow> subgroup H G;
              ?A \<noteq> {}\<rbrakk>
             \<Longrightarrow> subgroup (\<Inter> ?A) G\<close>
  notes theorem
    "subgroups_Inter_pair" =
      \<open>\<lbrakk>subgroup ?I G; subgroup ?J G\<rbrakk>
             \<Longrightarrow> subgroup (?I \<inter> ?J) G\<close>
  notes theorem
    "subgroups_complete_lattice" =
      \<open>complete_lattice
              \<lparr>carrier = {H. subgroup H G}, eq = (=),
                 le = (\<subseteq>)\<rparr>\<close>
  notes theorem
    "surj_const_mult" =
      \<open>?a \<in> carrier G \<Longrightarrow>
             (\<otimes>) ?a ` carrier G = carrier G\<close>
  notes theorem
    "l_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier G; ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?x \<otimes> ?a = ?x) =
                                (?a = \<one>)\<close>)
      ["simp"]
  notes theorem
    "r_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier G; ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?a \<otimes> ?x = ?x) =
                                (?a = \<one>)\<close>)
      ["simp"]
  notes theorem
    "l_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier G; ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?x = ?x \<otimes> ?a) =
                                (?a = \<one>)\<close>)
      ["simp"]
  notes theorem
    "r_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier G; ?a \<in> carrier G\<rbrakk>
              \<Longrightarrow> (?x = ?a \<otimes> ?x) =
                                (?a = \<one>)\<close>)
      ["simp"]
  notes theorem
    "diff_neutralizes" =
      \<open>\<lbrakk>subgroup ?H G; ?R \<in> rcosets ?H; ?r1.0 \<in> ?R;
              ?r2.0 \<in> ?R\<rbrakk>
             \<Longrightarrow> ?r1.0 \<otimes> inv ?r2.0 \<in> ?H\<close>
  notes theorem
    "setmult_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier G;
              ?K \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?H <#> ?K \<subseteq> carrier G\<close>
  notes theorem
    "set_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier G; ?H \<subseteq> carrier G;
              ?K \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?M <#> ?H <#> ?K = ?M <#> (?H <#> ?K)\<close>
  notes theorem
    "coset_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier G; ?g \<in> carrier G;
              ?h \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?M #> ?g #> ?h =
                               ?M #> ?g \<otimes> ?h\<close>
  notes theorem
    "coset_assoc" =
      \<open>\<lbrakk>?x \<in> carrier G; ?y \<in> carrier G;
              ?H \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?x <# (?H #> ?y) = ?x <# ?H #> ?y\<close>
  notes theorem
    "coset_mult_one" =
      (\<open>?M \<subseteq> carrier G \<Longrightarrow>
              ?M #> \<one> = ?M\<close>)
      ["simp"]
  notes theorem
    "coset_mult_inv1" =
      \<open>\<lbrakk>?M #> ?x \<otimes> inv ?y = ?M; ?x \<in> carrier G;
              ?y \<in> carrier G; ?M \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?M #> ?x = ?M #> ?y\<close>
  notes theorem
    "coset_mult_inv2" =
      \<open>\<lbrakk>?M #> ?x = ?M #> ?y; ?x \<in> carrier G;
              ?y \<in> carrier G; ?M \<subseteq> carrier G\<rbrakk>
             \<Longrightarrow> ?M #> ?x \<otimes> inv ?y = ?M\<close>
  notes theorem
    "coset_join1" =
      \<open>\<lbrakk>?H #> ?x = ?H; ?x \<in> carrier G;
              subgroup ?H G\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H\<close>
  notes theorem
    "solve_equation" =
      \<open>\<lbrakk>subgroup ?H G; ?x \<in> ?H; ?y \<in> ?H\<rbrakk>
             \<Longrightarrow> \<exists>h\<in>?H.
                                  ?y = h \<otimes> ?x\<close>
  notes theorem
    "repr_independence" =
      \<open>\<lbrakk>?y \<in> ?H #> ?x; ?x \<in> carrier G;
              subgroup ?H G\<rbrakk>
             \<Longrightarrow> ?H #> ?x = ?H #> ?y\<close>
  notes theorem
    "coset_join2" =
      \<open>\<lbrakk>?x \<in> carrier G; subgroup ?H G;
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?H #> ?x = ?H\<close>
  notes theorem
    "coset_join3" =
      \<open>\<lbrakk>?x \<in> carrier G; subgroup ?H G;
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?x <# ?H = ?H\<close>
  notes theorem
    "rcosI" =
      \<open>\<lbrakk>?h \<in> ?H; ?H \<subseteq> carrier G;
              ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?h \<otimes> ?x \<in> ?H #> ?x\<close>
  notes theorem
    "rcosetsI" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?H #> ?x \<in> rcosets ?H\<close>
  notes theorem
    "rcos_self" =
      \<open>\<lbrakk>?x \<in> carrier G; subgroup ?H G\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H #> ?x\<close>
  notes theorem
    "repr_independenceD" =
      \<open>\<lbrakk>subgroup ?H G; ?y \<in> carrier G;
              ?H #> ?x = ?H #> ?y\<rbrakk>
             \<Longrightarrow> ?y \<in> ?H #> ?x\<close>
  notes theorem
    "normalI" =
      \<open>\<lbrakk>subgroup ?H G;
              \<forall>x\<in>carrier G. ?H #> x = x <# ?H\<rbrakk>
             \<Longrightarrow> ?H \<lhd> G\<close>
  notes theorem
    "normal_inv_iff" =
      \<open>?N \<lhd> G =
             (subgroup ?N G \<and>
              (\<forall>x\<in>carrier G.
                  \<forall>h\<in>?N.
                     x \<otimes> h \<otimes> inv x \<in> ?N))\<close>
  notes theorem
    "normal_invI" =
      \<open>\<lbrakk>subgroup ?N G;
              \<And>x h.
                 \<lbrakk>x \<in> carrier G; h \<in> ?N\<rbrakk>
                 \<Longrightarrow> x \<otimes> h \<otimes> inv x
                                   \<in> ?N\<rbrakk>
             \<Longrightarrow> ?N \<lhd> G\<close>
  notes theorem
    "normal_invE" =
      \<open>?N \<lhd> G \<Longrightarrow> subgroup ?N G\<close>
      \<open>\<lbrakk>?N \<lhd> G; ?x \<in> carrier G; ?h \<in> ?N\<rbrakk>
             \<Longrightarrow> ?x \<otimes> ?h \<otimes> inv ?x
                               \<in> ?N\<close>
  notes theorem "one_is_normal" = \<open>{\<one>} \<lhd> G\<close>
  notes theorem
    "normal_subgroup_intersect" =
      \<open>\<lbrakk>?M \<lhd> G; ?N \<lhd> G\<rbrakk>
             \<Longrightarrow> ?M \<inter> ?N \<lhd> G\<close>
  notes theorem
    "setmult_lcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?K \<subseteq> carrier G;
              ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x <# ?H <#> ?K = ?x <# (?H <#> ?K)\<close>
  notes theorem
    "l_repr_independence" =
      \<open>\<lbrakk>?y \<in> ?x <# ?H; ?x \<in> carrier G;
              subgroup ?H G\<rbrakk>
             \<Longrightarrow> ?x <# ?H = ?y <# ?H\<close>
  notes theorem
    "lcos_m_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier G; ?g \<in> carrier G;
              ?h \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?g <# (?h <# ?M) =
                               ?g \<otimes> ?h <# ?M\<close>
  notes theorem
    "lcos_mult_one" =
      \<open>?M \<subseteq> carrier G \<Longrightarrow>
             \<one> <# ?M = ?M\<close>
  notes theorem
    "l_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?x <# ?H \<subseteq> carrier G\<close>
  notes theorem
    "l_coset_carrier" =
      \<open>\<lbrakk>?y \<in> ?x <# ?H; ?x \<in> carrier G;
              subgroup ?H G\<rbrakk>
             \<Longrightarrow> ?y \<in> carrier G\<close>
  notes theorem
    "l_coset_swap" =
      \<open>\<lbrakk>?y \<in> ?x <# ?H; ?x \<in> carrier G;
              subgroup ?H G\<rbrakk>
             \<Longrightarrow> ?x \<in> ?y <# ?H\<close>
  notes theorem
    "subgroup_mult_id" =
      \<open>subgroup ?H G \<Longrightarrow> ?H <#> ?H = ?H\<close>
  notes theorem
    "setmult_rcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?K \<subseteq> carrier G;
              ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?H <#> (?K #> ?x) = ?H <#> ?K #> ?x\<close>
  notes theorem
    "rcos_assoc_lcos" =
      \<open>\<lbrakk>?H \<subseteq> carrier G; ?K \<subseteq> carrier G;
              ?x \<in> carrier G\<rbrakk>
             \<Longrightarrow> ?H #> ?x <#> ?K = ?H <#> (?x <# ?K)\<close>
  notes theorem
    "rcos_equation" =
