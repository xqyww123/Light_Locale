               ?b \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?b \<in> Units (add_monoid R)\<close>)
      ["trans"]
  notes theorem
    "add.associated_iff" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
