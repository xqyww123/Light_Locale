                               ?H #>\<^bsub>add_monoid R\<^esub> ?y\<close>
  notes theorem
    "a_coset_add_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier R; ?g \<in> carrier R;
              ?h \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?M +> ?g +> ?h = ?M +> ?g \<oplus> ?h\<close>
  notes theorem
    "a_coset_add_zero" =
      (\<open>?M \<subseteq> carrier R \<Longrightarrow>
              ?M +> \<zero> = ?M\<close>)
      ["simp"]
  notes theorem
    "a_coset_add_inv1" =
      \<open>\<lbrakk>?M +> ?x \<oplus> \<ominus> ?y = ?M;
              ?x \<in> carrier R; ?y \<in> carrier R;
              ?M \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?M +> ?x = ?M +> ?y\<close>
  notes theorem
    "a_coset_add_inv2" =
      \<open>\<lbrakk>?M +> ?x = ?M +> ?y; ?x \<in> carrier R;
              ?y \<in> carrier R; ?M \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?M +> ?x \<oplus> \<ominus> ?y = ?M\<close>
  notes theorem
    "a_coset_join1" =
      \<open>\<lbrakk>?H +> ?x = ?H; ?x \<in> carrier R;
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H\<close>
  notes theorem
    "a_solve_equation" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?x \<in> ?H;
              ?y \<in> ?H\<rbrakk>
             \<Longrightarrow> \<exists>h\<in>?H. ?y = h \<oplus> ?x\<close>
  notes theorem
    "a_repr_independence" =
      \<open>\<lbrakk>?y \<in> ?H +> ?x; ?x \<in> carrier R;
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?H +> ?x = ?H +> ?y\<close>
  notes theorem
    "a_coset_join2" =
      \<open>\<lbrakk>?x \<in> carrier R; subgroup ?H (add_monoid R);
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?H +> ?x = ?H\<close>
  notes theorem
    "a_rcosI" =
      \<open>\<lbrakk>?h \<in> ?H; ?H \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?h \<oplus> ?x \<in> ?H +> ?x\<close>
  notes theorem
    "a_rcosetsI" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H +> ?x \<in> a_rcosets ?H\<close>
  notes theorem
    "a_transpose_inv" =
      \<open>\<lbrakk>?x \<oplus> ?y = ?z; ?x \<in> carrier R;
              ?y \<in> carrier R; ?z \<in> carrier R\<rbrakk>
             \<Longrightarrow> \<ominus> ?x \<oplus> ?z = ?y\<close>
  notes theorem
    "a_lcos_m_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier R; ?g \<in> carrier R;
              ?h \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?g <+ (?h <+ ?M) =
                               ?g \<oplus> ?h <+ ?M\<close>
  notes theorem
    "a_lcos_mult_one" =
      \<open>?M \<subseteq> carrier R \<Longrightarrow>
             \<zero> <+ ?M = ?M\<close>
  notes theorem
    "a_l_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
