    "P.fmset_perm_cong" =
      \<open>mset ?as = mset ?bs \<Longrightarrow>
             fmset P ?as = fmset P ?bs\<close>
  notes theorem
    "P.mset_fmsetEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x. ?P x \<and> X = assocs P x) \<Longrightarrow>
             \<exists>cs.
                (\<forall>c\<in>set cs. ?P c) \<and>
                fmset P cs = ?Cs\<close>
  notes theorem
    "P.mset_wfactorsEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    (x \<in> carrier P \<and>
                     Divisibility.irreducible P x) \<and>
                    X = assocs P x) \<Longrightarrow>
             \<exists>c cs.
                c \<in> carrier P \<and>
                set cs \<subseteq> carrier P \<and>
                wfactors P cs c \<and> fmset P cs = ?Cs\<close>
  notes theorem
    "P.isgcd_divides_l" =
      \<open>\<lbrakk>?a divides\<^bsub>P\<^esub> ?b; ?a \<in> carrier P;
