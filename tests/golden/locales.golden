             up_ring.monom P \<one> ?m\<close>
  notes theorem
    "monom_one_mult_comm" =
      \<open>up_ring.monom P \<one> ?n \<otimes>\<^bsub>P\<^esub>
             up_ring.monom P \<one> ?m =
             up_ring.monom P \<one> ?m \<otimes>\<^bsub>P\<^esub>
             up_ring.monom P \<one> ?n\<close>
  notes theorem
    "monom_mult" =
      (\<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
              \<Longrightarrow> up_ring.monom P (?a \<otimes> ?b)
                                 (?n + ?m) =
                                up_ring.monom P ?a
                                 ?n \<otimes>\<^bsub>P\<^esub>
                                up_ring.monom P ?b ?m\<close>)
      ["simp"]
  notes theorem
    "monom_a_inv" =
      (\<open>?a \<in> carrier R \<Longrightarrow>
              up_ring.monom P (\<ominus> ?a) ?n =
              \<ominus>\<^bsub>P\<^esub> up_ring.monom P ?a ?n\<close>)
      ["simp"]
  notes theorem
    "monom_inj" =
