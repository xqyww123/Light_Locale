      ["simp"]
  notes theorem
    "S.add.nat_pow_one" =
      (\<open>[?n] \<cdot>\<^bsub>S\<^esub> \<zero>\<^bsub>S\<^esub> =
              \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.add.nat_pow_mult" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             [?n] \<cdot>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub>
             [?m] \<cdot>\<^bsub>S\<^esub> ?x =
             [(?n + ?m)] \<cdot>\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.add.nat_pow_comm" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             [?n] \<cdot>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub>
             [?m] \<cdot>\<^bsub>S\<^esub> ?x =
             [?m] \<cdot>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub>
             [?n] \<cdot>\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.add.nat_pow_Suc2" =
