                               ?H <#>\<^bsub>add_monoid P\<^esub>
                               ?K =
                               ?x <#\<^bsub>add_monoid P\<^esub>
                               (?H <#>\<^bsub>add_monoid P\<^esub>
                                ?K)\<close>
  notes theorem
    "P.add.l_repr_independence" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid P\<^esub> ?H;
              ?x \<in> carrier P; subgroup ?H (add_monoid P)\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid P\<^esub> ?H =
                               ?y <#\<^bsub>add_monoid P\<^esub> ?H\<close>
  notes theorem
    "P.add.lcos_m_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier P; ?g \<in> carrier P;
              ?h \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?g <#\<^bsub>add_monoid P\<^esub>
                               (?h <#\<^bsub>add_monoid P\<^esub> ?M) =
                               ?g \<oplus>\<^bsub>P\<^esub>
                               ?h <#\<^bsub>add_monoid P\<^esub>
                               ?M\<close>
  notes theorem
    "P.add.lcos_mult_one" =
      \<open>?M \<subseteq> carrier P \<Longrightarrow>
             \<zero>\<^bsub>P\<^esub> <#\<^bsub>add_monoid P\<^esub> ?M =
             ?M\<close>
  notes theorem
    "P.add.l_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid P\<^esub> ?H
                               \<subseteq> carrier P\<close>
  notes theorem
    "P.add.l_coset_carrier" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid P\<^esub> ?H;
              ?x \<in> carrier P; subgroup ?H (add_monoid P)\<rbrakk>
             \<Longrightarrow> ?y \<in> carrier P\<close>
  notes theorem
    "P.add.l_coset_swap" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid P\<^esub> ?H;
              ?x \<in> carrier P; subgroup ?H (add_monoid P)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?y <#\<^bsub>add_monoid P\<^esub>
  ?H\<close>
  notes theorem
    "P.add.subgroup_mult_id" =
      \<open>subgroup ?H (add_monoid P) \<Longrightarrow>
             ?H <#>\<^bsub>add_monoid P\<^esub> ?H = ?H\<close>
  notes theorem
    "P.add.setmult_rcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?K \<subseteq> carrier P;
              ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid P\<^esub>
                               (?K #>\<^bsub>add_monoid P\<^esub> ?x) =
                               ?H <#>\<^bsub>add_monoid P\<^esub>
                               ?K #>\<^bsub>add_monoid P\<^esub>
                               ?x\<close>
  notes theorem
    "P.add.rcos_assoc_lcos" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?K \<subseteq> carrier P;
              ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid P\<^esub>
                               ?x <#>\<^bsub>add_monoid P\<^esub>
                               ?K =
                               ?H <#>\<^bsub>add_monoid P\<^esub>
                               (?x <#\<^bsub>add_monoid P\<^esub>
                                ?K)\<close>
  notes theorem
    "P.add.rcos_equation" =
      \<open>\<lbrakk>subgroup ?H (add_monoid P);
              ?ha \<oplus>\<^bsub>P\<^esub> ?a =
              ?h \<oplus>\<^bsub>P\<^esub> ?b;
              ?a \<in> carrier P; ?b \<in> carrier P; ?h \<in> ?H;
              ?ha \<in> ?H; ?hb \<in> ?H\<rbrakk>
             \<Longrightarrow> ?hb \<oplus>\<^bsub>P\<^esub> ?a
                               \<in> (\<Union>h\<in>?H.
   {h \<oplus>\<^bsub>P\<^esub> ?b})\<close>
  notes theorem
    "P.add.rcos_disjoint" =
      \<open>subgroup ?H (add_monoid P) \<Longrightarrow>
             disjoint (rcosets\<^bsub>add_monoid P\<^esub> ?H)\<close>
  notes theorem
    "P.add.order_one_triv_iff" =
      \<open>(Coset.order (add_monoid P) = 1) =
             (carrier P = {\<zero>\<^bsub>P\<^esub>})\<close>
  notes theorem
    "P.add.rcosets_part_G" =
      \<open>subgroup ?H (add_monoid P) \<Longrightarrow>
             \<Union> (rcosets\<^bsub>add_monoid P\<^esub> ?H) =
             carrier P\<close>
  notes theorem
    "P.add.cosets_finite" =
      \<open>\<lbrakk>?c \<in> rcosets\<^bsub>add_monoid P\<^esub> ?H;
              ?H \<subseteq> carrier P; finite (carrier P)\<rbrakk>
             \<Longrightarrow> finite ?c\<close>
  notes theorem
    "P.add.inj_on_f" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> inj_on
                                (\<lambda>y.
                                    y \<oplus>\<^bsub>P\<^esub>
                                    \<ominus>\<^bsub>P\<^esub> ?a)
                                (?H #>\<^bsub>add_monoid P\<^esub>
                                 ?a)\<close>
  notes theorem
    "P.add.inj_on_g" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> inj_on
                                (\<lambda>y. y \<oplus>\<^bsub>P\<^esub> ?a)
                                ?H\<close>
  notes theorem
    "P.add.card_cosets_equal" =
      \<open>\<lbrakk>?R \<in> rcosets\<^bsub>add_monoid P\<^esub> ?H;
              ?H \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> \<exists>f. bij_betw f ?H ?R\<close>
  notes theorem
    "P.add.card_rcosets_equal" =
      \<open>\<lbrakk>?R \<in> rcosets\<^bsub>add_monoid P\<^esub> ?H;
              ?H \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> card ?H = card ?R\<close>
  notes theorem
    "P.add.rcosets_finite" =
      \<open>\<lbrakk>?R \<in> rcosets\<^bsub>add_monoid P\<^esub> ?H;
              ?H \<subseteq> carrier P; finite ?H\<rbrakk>
             \<Longrightarrow> finite ?R\<close>
  notes theorem
