                                ?as =
                               map (\<lambda>x.
 closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
  {x})
                                ?bs\<close>
  notes theorem
    "P.add.fmset_listassoc_cong" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid P\<^esub> ?bs;
              set ?as \<subseteq> carrier P;
              set ?bs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> fmset (add_monoid P) ?as =
                               fmset (add_monoid P) ?bs\<close>
  notes theorem
    "P.add.ee_fmset" =
      \<open>\<lbrakk>essentially_equal (add_monoid P) ?as ?bs;
              set ?as \<subseteq> carrier P;
              set ?bs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> fmset (add_monoid P) ?as =
                               fmset (add_monoid P) ?bs\<close>
  notes theorem
    "P.add.fmset_ee" =
      \<open>\<lbrakk>fmset (add_monoid P) ?as = fmset (add_monoid P) ?bs;
              set ?as \<subseteq> carrier P;
              set ?bs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> essentially_equal (add_monoid P) ?as
                                ?bs\<close>
  notes theorem
    "P.add.ee_is_fmset" =
      \<open>\<lbrakk>set ?as \<subseteq> carrier P;
              set ?bs \<subseteq> carrier P\<rbrakk>
