             \<Longrightarrow> (\<lambda>(x, y). (?g x, ?h y))
                               \<in> Group.iso
(add_monoid R \<times>\<times> ?H) (?G2.0 \<times>\<times> ?I)\<close>
  notes theorem
    "R.add.DirProd_iso_trans" =
      \<open>\<lbrakk>add_monoid R \<cong> ?G2.0; ?H \<cong> ?I\<rbrakk>
             \<Longrightarrow> add_monoid R \<times>\<times> ?H \<cong>
                               ?G2.0 \<times>\<times> ?I\<close>
  notes theorem
    "R.add.int_pow_is_hom" =
      \<open>?x \<in> carrier R \<Longrightarrow>
