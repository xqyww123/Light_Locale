                             (add_monoid R
                              \<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "R.add.m_inv_consistent" =
      (\<open>\<lbrakk>subgroup ?H (add_monoid R); ?x \<in> ?H\<rbrakk>
