  notes theorem
    "R.add.is_group" = (\<open>Group.group (add_monoid R)\<close>) ["iff"]
  notes theorem
    "R.add.is_monoid" = (\<open>Group.monoid (add_monoid R)\<close>) ["iff"]
  notes theorem
    "R.add.Units_eq" = (\<open>Units (add_monoid R) = carrier R\<close>)
      ["simp"]
  notes theorem
    "R.add.inv_closed" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<ominus> ?x \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "R.add.l_inv_ex" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<exists>y\<in>carrier R. y \<oplus> ?x = \<zero>\<close>)
      ["simp"]
  notes theorem
    "R.add.r_inv_ex" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<exists>y\<in>carrier R. ?x \<oplus> y = \<zero>\<close>)
      ["simp"]
  notes theorem
    "R.add.l_inv" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<ominus> ?x \<oplus> ?x = \<zero>\<close>)
      ["simp"]
  notes theorem
    "R.add.inv_eq_1_iff" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              (\<ominus> ?x = \<zero>) = (?x = \<zero>)\<close>)
      ["simp"]
  notes theorem
    "R.add.r_inv" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              ?x \<oplus> \<ominus> ?x = \<zero>\<close>)
      ["simp"]
  notes theorem
    "R.add.right_cancel" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?y \<oplus> ?x = ?z \<oplus> ?x) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "R.add.inv_inv" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
