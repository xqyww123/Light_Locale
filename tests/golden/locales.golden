         \<one>\<^bsub>P\<^esub> (\<otimes>\<^bsub>P\<^esub>)]
      (\<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
              \<Longrightarrow> \<ominus>\<^bsub>P\<^esub> ?x \<otimes>\<^bsub>P\<^esub>
                                ?y =
                                \<ominus>\<^bsub>P\<^esub> (?x \<otimes>\<^bsub>P\<^esub>
                      ?y)\<close>)
      ["Ring.algebra" add : cring \<zero>\<^bsub>P\<^esub>
         (\<oplus>\<^bsub>P\<^esub>) a_inv P a_minus P
         \<one>\<^bsub>P\<^esub> (\<otimes>\<^bsub>P\<^esub>)]
      (\<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?x \<otimes>\<^bsub>P\<^esub>
                                \<ominus>\<^bsub>P\<^esub> ?y =
                                \<ominus>\<^bsub>P\<^esub> (?x \<otimes>\<^bsub>P\<^esub>
                      ?y)\<close>)
      ["Ring.algebra" add : cring \<zero>\<^bsub>P\<^esub>
         (\<oplus>\<^bsub>P\<^esub>) a_inv P a_minus P
         \<one>\<^bsub>P\<^esub> (\<otimes>\<^bsub>P\<^esub>)]
  notes theorem
    "P.cring_fieldI" =
      \<open>Units P =
             carrier P - {\<zero>\<^bsub>P\<^esub>} \<Longrightarrow>
             field P\<close>
  notes theorem
    "P.cring_fieldI2" =
      \<open>\<lbrakk>\<zero>\<^bsub>P\<^esub> \<noteq>
                      \<one>\<^bsub>P\<^esub>;
              \<And>a.
                 \<lbrakk>a \<in> carrier P;
                  a \<noteq> \<zero>\<^bsub>P\<^esub>\<rbrakk>
                 \<Longrightarrow> \<exists>b\<in>carrier P.
a \<otimes>\<^bsub>P\<^esub> b = \<one>\<^bsub>P\<^esub>\<rbrakk>
             \<Longrightarrow> field P\<close>
  notes theorem
    "P.sum_zero_eq_neg" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?x \<oplus>\<^bsub>P\<^esub> ?y =
              \<zero>\<^bsub>P\<^esub>\<rbrakk>
             \<Longrightarrow> ?x = \<ominus>\<^bsub>P\<^esub> ?y\<close>
  notes theorem
    "P.units_power_order_eq_one" =
      \<open>\<lbrakk>finite (Units P); ?a \<in> Units P\<rbrakk>
             \<Longrightarrow> ?a [^]\<^bsub>P\<^esub> card (Units P) =
                               \<one>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.field_intro2" =
      \<open>\<lbrakk>\<zero>\<^bsub>P\<^esub> \<noteq>
                      \<one>\<^bsub>P\<^esub>;
              \<And>x.
                 x \<in> carrier P -
                         {\<zero>\<^bsub>P\<^esub>} \<Longrightarrow>
                 x \<in> Units P\<rbrakk>
             \<Longrightarrow> field P\<close>
  notes theorem
    "P.cgenideal_ideal" =
      \<open>?a \<in> carrier P \<Longrightarrow>
             ideal (PIdl\<^bsub>P\<^esub> ?a) P\<close>
  notes theorem
    "P.cgenideal_eq_genideal" =
      \<open>?i \<in> carrier P \<Longrightarrow>
             PIdl\<^bsub>P\<^esub> ?i = Idl\<^bsub>P\<^esub> {?i}\<close>
  notes theorem
    "P.cgenideal_eq_rcos" =
      \<open>PIdl\<^bsub>P\<^esub> ?i =
             carrier P #>\<^bsub>P\<^esub> ?i\<close>
  notes theorem
    "P.cgenideal_is_principalideal" =
      \<open>?i \<in> carrier P \<Longrightarrow>
             principalideal (PIdl\<^bsub>P\<^esub> ?i) P\<close>
  notes theorem
    "P.cgenideal_prod" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> PIdl\<^bsub>P\<^esub> ?a <#>\<^bsub>P\<^esub>
                               PIdl\<^bsub>P\<^esub> ?b =
                               PIdl\<^bsub>P\<^esub> (?a \<otimes>\<^bsub>P\<^esub>
                ?b)\<close>
  notes theorem
    "P.zeroprimeideal_domainI" =
      \<open>primeideal {\<zero>\<^bsub>P\<^esub>} P \<Longrightarrow>
             domain P\<close>
  notes theorem
    "P.domain_eq_zeroprimeideal" =
      \<open>domain P = primeideal {\<zero>\<^bsub>P\<^esub>} P\<close>
  notes theorem
    "P.maximalideal_prime" =
      \<open>maximalideal ?I P \<Longrightarrow> primeideal ?I P\<close>
  notes theorem
    "P.trivialideals_fieldI" =
      \<open>\<lbrakk>carrier P \<noteq> {\<zero>\<^bsub>P\<^esub>};
              {I. ideal I P} =
              {{\<zero>\<^bsub>P\<^esub>}, carrier P}\<rbrakk>
             \<Longrightarrow> field P\<close>
  notes theorem
    "P.trivialideals_eq_field" =
      \<open>carrier P \<noteq> {\<zero>\<^bsub>P\<^esub>} \<Longrightarrow>
             ({I. ideal I P} = {{\<zero>\<^bsub>P\<^esub>}, carrier P}) =
             field P\<close>
  notes theorem
    "P.zeromaximalideal_fieldI" =
      \<open>maximalideal {\<zero>\<^bsub>P\<^esub>} P \<Longrightarrow>
             field P\<close>
  notes theorem
    "P.zeromaximalideal_eq_field" =
      \<open>maximalideal {\<zero>\<^bsub>P\<^esub>} P = field P\<close>
  notes theorem
    "P.quot_domain_imp_primeideal" =
      \<open>\<lbrakk>ideal ?P P; domain (P Quot ?P)\<rbrakk>
             \<Longrightarrow> primeideal ?P P\<close>
  notes theorem
    "P.quot_domain_iff_primeideal" =
      \<open>ideal ?P P \<Longrightarrow>
             domain (P Quot ?P) = primeideal ?P P\<close>
  notes theorem
    "P.ring_iso_imp_img_cring" =
      \<open>?h \<in> ring_iso P ?S \<Longrightarrow>
             cring
              (?S\<lparr>zero :=
                           ?h \<zero>\<^bsub>P\<^esub>\<rparr>)\<close>
  notes theorem
    "P.divides_one" =
      \<open>?a \<in> carrier P \<Longrightarrow>
             ?a divides\<^bsub>P\<^esub> \<one>\<^bsub>P\<^esub> =
             (?a \<in> Units P)\<close>
  notes theorem
    "P.to_contain_is_to_divide" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> (PIdl\<^bsub>P\<^esub> ?b
                                \<subseteq> PIdl\<^bsub>P\<^esub> ?a) =
                               ?a divides\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.associated_iff_same_ideal" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>P\<^esub> ?b =
                               (PIdl\<^bsub>P\<^esub> ?a =
                                PIdl\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.ideal_eq_carrier_iff" =
      \<open>?a \<in> carrier P \<Longrightarrow>
             (carrier P = PIdl\<^bsub>P\<^esub> ?a) =
             (?a \<in> Units P)\<close>
  notes theorem
    "P.subcringI'" =
      \<open>subring ?H P \<Longrightarrow> subcring ?H P\<close>
  notes theorem
    "P.carrier_is_subcring" = \<open>subcring (carrier P) P\<close>
  notes theorem
    "P.eval_poly_mult" =
      \<open>\<lbrakk>set ?p \<subseteq> carrier P;
              set ?q \<subseteq> carrier P; ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> P.eval (P.poly_mult ?p ?q) ?a =
                               P.eval ?p ?a \<otimes>\<^bsub>P\<^esub>
                               P.eval ?q ?a\<close>
  notes theorem
    "P.eval_is_hom" =
      \<open>\<lbrakk>subring ?K P; ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> (\<lambda>p. P.eval p ?a)
                               \<in> ring_hom (?K [X]\<^bsub>P\<^esub>)
P\<close>
  notes theorem
    "P.const_term_simprules" =
      \<open>set ?p \<subseteq> carrier P \<Longrightarrow>
             P.const_term ?p \<in> carrier P\<close>
      \<open>\<lbrakk>set ?p \<subseteq> carrier P;
              set ?q \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> P.const_term (P.poly_mult ?p ?q) =
                               P.const_term ?p \<otimes>\<^bsub>P\<^esub>
                               P.const_term ?q\<close>
      \<open>\<lbrakk>set ?p \<subseteq> carrier P;
              set ?q \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> P.const_term (P.poly_add ?p ?q) =
                               P.const_term ?p \<oplus>\<^bsub>P\<^esub>
                               P.const_term ?q\<close>
  notes theorem
    "P.ideal_prod_commute" =
      \<open>\<lbrakk>ideal ?I P; ideal ?J P\<rbrakk>
             \<Longrightarrow> ?I \<cdot>\<^bsub>P\<^esub> ?J =
                               ?J \<cdot>\<^bsub>P\<^esub> ?I\<close>
  notes theorem
    "P.ideal_prod_distr" =
      \<open>\<lbrakk>ideal ?I P; ideal ?J P; ideal ?K P\<rbrakk>
             \<Longrightarrow> ?I \<cdot>\<^bsub>P\<^esub>
                               (?J <+>\<^bsub>P\<^esub> ?K) =
                               ?I \<cdot>\<^bsub>P\<^esub>
                               ?J <+>\<^bsub>P\<^esub>
                               ?I \<cdot>\<^bsub>P\<^esub> ?K\<close>
      \<open>\<lbrakk>ideal ?I P; ideal ?J P; ideal ?K P\<rbrakk>
             \<Longrightarrow> (?J <+>\<^bsub>P\<^esub>
                                ?K) \<cdot>\<^bsub>P\<^esub>
                               ?I =
                               ?J \<cdot>\<^bsub>P\<^esub>
                               ?I <+>\<^bsub>P\<^esub>
                               ?K \<cdot>\<^bsub>P\<^esub> ?I\<close>
  notes theorem
    "P.ideal_prod_eq_inter" =
      \<open>\<lbrakk>ideal ?I P; ideal ?J P;
              ?I <+>\<^bsub>P\<^esub> ?J = carrier P\<rbrakk>
             \<Longrightarrow> ?I \<cdot>\<^bsub>P\<^esub> ?J =
                               ?I \<inter> ?J\<close>
  notes theorem
    "P.ideals_set_is_semiring" = \<open>semiring (ideals_set P)\<close>
  notes theorem
    "P.ideals_set_is_comm_monoid" =
      \<open>Group.comm_monoid (ideals_set P)\<close>
  notes theorem
    "P.ideal_prod_eq_Inter_aux" =
      \<open>\<lbrakk>?I \<in> {..Suc ?n} \<rightarrow> {J. ideal J P};
              \<And>i j.
                 \<lbrakk>i \<le> Suc ?n; j \<le> Suc ?n;
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>P\<^esub> ?I j =
                                   carrier P\<rbrakk>
             \<Longrightarrow> finprod (ideals_set P) ?I
                                {..?n} <+>\<^bsub>P\<^esub>
                               ?I (Suc ?n) =
                               carrier P\<close>
  notes theorem
    "P.ideal_prod_eq_Inter" =
      \<open>\<lbrakk>?I \<in> {..?n} \<rightarrow> {J. ideal J P};
              \<And>i j.
                 \<lbrakk>i \<in> {..?n}; j \<in> {..?n};
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>P\<^esub> ?I j =
                                   carrier P\<rbrakk>
             \<Longrightarrow> finprod (ideals_set P) ?I {..?n} =
                               \<Inter> (?I ` {..?n})\<close>
  notes theorem
    "P.inter_plus_ideal_eq_carrier" =
      \<open>\<lbrakk>\<And>i.
                         i \<le> Suc ?n \<Longrightarrow> ideal (?I i) P;
              \<And>i j.
                 \<lbrakk>i \<le> Suc ?n; j \<le> Suc ?n;
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>P\<^esub> ?I j =
                                   carrier P\<rbrakk>
             \<Longrightarrow> \<Inter> (?I ` {..?n}) <+>\<^bsub>P\<^esub>
                               ?I (Suc ?n) =
                               carrier P\<close>
  notes theorem
    "P.inter_plus_ideal_eq_carrier_arbitrary" =
      \<open>\<lbrakk>\<And>i.
                         i \<le> Suc ?n \<Longrightarrow> ideal (?I i) P;
              \<And>i j.
                 \<lbrakk>i \<le> Suc ?n; j \<le> Suc ?n;
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>P\<^esub> ?I j =
                                   carrier P;
              ?j \<le> Suc ?n\<rbrakk>
             \<Longrightarrow> \<Inter>
                                (?I `
                                 ({..Suc ?n} - {?j})) <+>\<^bsub>P\<^esub>
                               ?I ?j =
                               carrier P\<close>
  notes theorem
    "P.divides_ideal_prod_imp_primeideal" =
      \<open>\<lbrakk>ideal ?P P; ?P \<noteq> carrier P;
              \<And>I J.
                 \<lbrakk>ideal I P; ideal J P;
                  I \<cdot>\<^bsub>P\<^esub> J \<subseteq> ?P\<rbrakk>
                 \<Longrightarrow> I \<subseteq> ?P \<or>
                                   J \<subseteq> ?P\<rbrakk>
             \<Longrightarrow> primeideal ?P P\<close>
  notes theorem
    "P.canonical_proj_ext_is_surj" =
      \<open>\<lbrakk>\<And>i. i \<le> ?n \<Longrightarrow> ideal (?I i) P;
              \<And>i j.
                 \<lbrakk>i \<le> ?n; j \<le> ?n; i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>P\<^esub> ?I j =
                                   carrier P\<rbrakk>
             \<Longrightarrow> P.canonical_proj_ext ?I ?n ` carrier P =
                               carrier
                                (RDirProd_list
                                  (map (\<lambda>i. P Quot ?I i)
                                    [0..<Suc ?n]))\<close>
  notes theorem
    "P.chinese_remainder" =
      \<open>\<lbrakk>\<And>i. i \<le> ?n \<Longrightarrow> ideal (?I i) P;
              \<And>i j.
                 \<lbrakk>i \<le> ?n; j \<le> ?n; i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+>\<^bsub>P\<^esub> ?I j =
                                   carrier P\<rbrakk>
             \<Longrightarrow> P Quot \<Inter> (?I ` {..?n}) \<simeq>
                               RDirProd_list
                                (map (\<lambda>i. P Quot ?I i)
                                  [0..<Suc ?n])\<close>
  notes
    "module_axioms" = (\<open>Module.module R P\<close>)
      ["attribute" "internal"]
  notes
    "smult_closed" =
      (\<open>\<lbrakk>?a \<in> carrier R; ?x \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?a \<odot>\<^bsub>P\<^esub> ?x
                                \<in> carrier P\<close>)
      ["simp", "HOL.intro"]
  notes
    "smult_l_distr" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R;
              ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> (?a \<oplus> ?b) \<odot>\<^bsub>P\<^esub>
                               ?x =
                               ?a \<odot>\<^bsub>P\<^esub>
                               ?x \<oplus>\<^bsub>P\<^esub>
                               ?b \<odot>\<^bsub>P\<^esub> ?x\<close>
  notes
    "smult_r_distr" =
      \<open>\<lbrakk>?a \<in> carrier R; ?x \<in> carrier P;
              ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<odot>\<^bsub>P\<^esub>
                               (?x \<oplus>\<^bsub>P\<^esub> ?y) =
                               ?a \<odot>\<^bsub>P\<^esub>
                               ?x \<oplus>\<^bsub>P\<^esub>
                               ?a \<odot>\<^bsub>P\<^esub> ?y\<close>
  notes
    "smult_assoc1" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R;
              ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<otimes> ?b \<odot>\<^bsub>P\<^esub> ?x =
                               ?a \<odot>\<^bsub>P\<^esub>
                               (?b \<odot>\<^bsub>P\<^esub> ?x)\<close>
  notes
    "smult_one" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              \<one> \<odot>\<^bsub>P\<^esub> ?x = ?x\<close>)
      ["simp"]
  notes theorem
    "smult_l_null" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              \<zero> \<odot>\<^bsub>P\<^esub> ?x =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "smult_r_null" =
      (\<open>?a \<in> carrier R \<Longrightarrow>
              ?a \<odot>\<^bsub>P\<^esub> \<zero>\<^bsub>P\<^esub> =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "smult_l_minus" =
      \<open>\<lbrakk>?a \<in> carrier R; ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> \<ominus> ?a \<odot>\<^bsub>P\<^esub> ?x =
                               \<ominus>\<^bsub>P\<^esub> (?a \<odot>\<^bsub>P\<^esub>
                     ?x)\<close>
  notes theorem
    "smult_r_minus" =
      \<open>\<lbrakk>?a \<in> carrier R; ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<odot>\<^bsub>P\<^esub>
                               \<ominus>\<^bsub>P\<^esub> ?x =
                               \<ominus>\<^bsub>P\<^esub> (?a \<odot>\<^bsub>P\<^esub>
                     ?x)\<close>
  notes theorem
    "finsum_smult_ldistr" =
      \<open>\<lbrakk>finite ?A; ?a \<in> carrier R;
              ?f \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<odot>\<^bsub>P\<^esub> finsum P ?f ?A =
                               (\<Oplus>\<^bsub>P\<^esub>i\<in>?A. ?a \<odot>\<^bsub>P\<^esub>
                             ?f i)\<close>
  notes theorem
    "submoduleI" =
      \<open>\<lbrakk>?H \<subseteq> carrier P;
              \<zero>\<^bsub>P\<^esub> \<in> ?H;
              \<And>a.
                 a \<in> ?H \<Longrightarrow>
                 \<ominus>\<^bsub>P\<^esub> a \<in> ?H;
              \<And>a b.
                 \<lbrakk>a \<in> ?H; b \<in> ?H\<rbrakk>
                 \<Longrightarrow> a \<oplus>\<^bsub>P\<^esub> b \<in> ?H;
              \<And>a x.
                 \<lbrakk>a \<in> carrier R; x \<in> ?H\<rbrakk>
                 \<Longrightarrow> a \<odot>\<^bsub>P\<^esub> x
                                   \<in> ?H\<rbrakk>
             \<Longrightarrow> submodule ?H R P\<close>
  notes theorem
    "submoduleE" =
      \<open>submodule ?H R P \<Longrightarrow>
             ?H \<subseteq> carrier P\<close>
      \<open>submodule ?H R P \<Longrightarrow> ?H \<noteq> {}\<close>
      \<open>\<lbrakk>submodule ?H R P; ?aa \<in> ?H\<rbrakk>
             \<Longrightarrow> \<ominus>\<^bsub>P\<^esub> ?aa
                               \<in> ?H\<close>
      \<open>\<lbrakk>submodule ?H R P; ?a \<in> carrier R;
              ?b \<in> ?H\<rbrakk>
             \<Longrightarrow> ?a \<odot>\<^bsub>P\<^esub> ?b
                               \<in> ?H\<close>
      \<open>\<lbrakk>submodule ?H R P; ?aa \<in> ?H; ?b \<in> ?H\<rbrakk>
             \<Longrightarrow> ?aa \<oplus>\<^bsub>P\<^esub> ?b
                               \<in> ?H\<close>
      \<open>\<lbrakk>submodule ?H R P; ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> \<ominus>\<^bsub>P\<^esub> ?x
                               \<in> ?H\<close>
  notes theorem
    "carrier_is_submodule" = \<open>submodule (carrier P) R P\<close>
  notes theorem
    "module_incl_imp_submodule" =
      \<open>\<lbrakk>?H \<subseteq> carrier P;
              Module.module R (P\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> submodule ?H R P\<close>
  notes
    "algebra_axioms" = (\<open>algebra R P\<close>) ["attribute" "internal"]
  notes
    "smult_assoc2" =
      \<open>\<lbrakk>?a \<in> carrier R; ?x \<in> carrier P;
              ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<odot>\<^bsub>P\<^esub>
                               ?x \<otimes>\<^bsub>P\<^esub>
                               ?y =
                               ?a \<odot>\<^bsub>P\<^esub>
                               (?x \<otimes>\<^bsub>P\<^esub> ?y)\<close>
  notes theorem "R_cring" = \<open>cring R\<close>
  notes theorem "M_cring" = \<open>cring P\<close>
  notes theorem "module" = \<open>Module.module R P\<close>
  notes
    "UP_cring_axioms" = (\<open>UP_cring R\<close>) ["attribute" "internal"]
  notes theorem
    "UP_m_comm" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?p \<otimes>\<^bsub>P\<^esub> ?q =
                               ?q \<otimes>\<^bsub>P\<^esub> ?p\<close>
  notes theorem "UP_cring" = \<open>cring P\<close>
  notes theorem "UP_algebra" = \<open>algebra R P\<close>
  notes theorem
    "monom_pow" =
      \<open>?a \<in> carrier R \<Longrightarrow>
             up_ring.monom P ?a ?n [^]\<^bsub>P\<^esub> ?m =
             up_ring.monom P (?a [^] ?m) (?n * ?m)\<close>
  notes theorem
    "exI3" =
      \<open>?Pred ?x ?y ?z \<Longrightarrow>
             \<exists>x y z. ?Pred x y z\<close>
  notes theorem
    "long_div_theorem" =
      \<open>\<lbrakk>?g \<in> carrier P; ?f \<in> carrier P;
              ?g \<noteq> \<zero>\<^bsub>P\<^esub>\<rbrakk>
             \<Longrightarrow> \<exists>q r k.
                                  q \<in> carrier P \<and>
                                  r \<in> carrier P \<and>
                                  lcoeff ?g [^] k \<odot>\<^bsub>P\<^esub>
                                  ?f =
                                  ?g \<otimes>\<^bsub>P\<^esub>
                                  q \<oplus>\<^bsub>P\<^esub>
                                  r \<and>
                                  (r = \<zero>\<^bsub>P\<^esub> \<or>
                                   deg R r < deg R ?g)\<close>
  notes theorem
    "deg_minus_monom" =
      \<open>\<lbrakk>?a \<in> carrier R;
              carrier R \<noteq> {\<zero>}\<rbrakk>
             \<Longrightarrow> deg R
                                (up_ring.monom P \<one>
                                  1 \<ominus>\<^bsub>P\<^esub> up_ring.monom
                          P ?a 0) =
                               1\<close>
  notes theorem
    "lcoeff_monom" =
      \<open>\<lbrakk>?a \<in> carrier R;
              carrier R \<noteq> {\<zero>}\<rbrakk>
             \<Longrightarrow> lcoeff
                                (up_ring.monom P \<one>
                                  1 \<ominus>\<^bsub>P\<^esub> up_ring.monom
                          P ?a 0) =
                               \<one>\<close>
  notes theorem
    "deg_nzero_nzero" =
      \<open>deg R ?p \<noteq> 0 \<Longrightarrow>
             ?p \<noteq> \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "deg_monom_minus" =
      \<open>\<lbrakk>?a \<in> carrier R;
              carrier R \<noteq> {\<zero>}\<rbrakk>
             \<Longrightarrow> deg R
                                (up_ring.monom P \<one>
                                  1 \<ominus>\<^bsub>P\<^esub> up_ring.monom
                          P ?a 0) =
                               1\<close>
  notes theorem
    "eval_monom_expr" =
      \<open>?a \<in> carrier R \<Longrightarrow>
             UnivPoly.eval R R id ?a
              (up_ring.monom P \<one>
                1 \<ominus>\<^bsub>P\<^esub> up_ring.monom P ?a 0) =
             \<zero>\<close>
  notes theorem
    "remainder_theorem_exist" =
      \<open>\<lbrakk>?f \<in> carrier P; ?a \<in> carrier R;
              carrier R \<noteq> {\<zero>}\<rbrakk>
             \<Longrightarrow> \<exists>q r.
                                  q \<in> carrier P \<and>
                                  r \<in> carrier P \<and>
                                  ?f =
                                  (up_ring.monom P \<one>
                                    1 \<ominus>\<^bsub>P\<^esub> up_ring.monom
                            P ?a 0) \<otimes>\<^bsub>P\<^esub>
                                  q \<oplus>\<^bsub>P\<^esub>
                                  r \<and>
                                  deg R r = 0\<close>
  notes theorem
    "remainder_theorem_expression" =
      \<open>\<lbrakk>?f \<in> carrier P; ?a \<in> carrier R;
              ?q \<in> carrier P; ?r \<in> carrier P;
              carrier R \<noteq> {\<zero>};
              ?f =
              (up_ring.monom P \<one>
                1 \<ominus>\<^bsub>P\<^esub> up_ring.monom P ?a
        0) \<otimes>\<^bsub>P\<^esub>
              ?q \<oplus>\<^bsub>P\<^esub>
              ?r;
              deg R ?r = 0\<rbrakk>
             \<Longrightarrow> ?r =
                               up_ring.monom P (UnivPoly.eval R R id ?a ?f)
                                0\<close>
  notes theorem
    "remainder_theorem" =
      \<open>\<lbrakk>?f \<in> carrier P; ?a \<in> carrier R;
              carrier R \<noteq> {\<zero>}\<rbrakk>
             \<Longrightarrow> \<exists>q r.
                                  q \<in> carrier P \<and>
                                  r \<in> carrier P \<and>
                                  ?f =
                                  (up_ring.monom P \<one>
                                    1 \<ominus>\<^bsub>P\<^esub> up_ring.monom
                            P ?a 0) \<otimes>\<^bsub>P\<^esub>
                                  q \<oplus>\<^bsub>P\<^esub>
                                  up_ring.monom P
                                   (UnivPoly.eval R R id ?a ?f) 0\<close>
  notes theorem
    "evalRR_add" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x
                                (?p \<oplus>\<^bsub>P\<^esub> ?q) =
                               UnivPoly.eval R R id ?x ?p \<oplus>
                               UnivPoly.eval R R id ?x ?q\<close>
  notes theorem
    "evalRR_sub" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x
                                (?p \<ominus>\<^bsub>P\<^esub> ?q) =
                               UnivPoly.eval R R id ?x
                                ?p \<ominus> UnivPoly.eval R R id ?x
        ?q\<close>
  notes theorem
    "evalRR_mult" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x
                                (?p \<otimes>\<^bsub>P\<^esub> ?q) =
                               UnivPoly.eval R R id ?x ?p \<otimes>
                               UnivPoly.eval R R id ?x ?q\<close>
  notes theorem
    "evalRR_monom" =
      \<open>\<lbrakk>?a \<in> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x
                                (up_ring.monom P ?a ?d) =
                               ?a \<otimes> ?x [^] ?d\<close>
  notes theorem
    "evalRR_one" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             UnivPoly.eval R R id ?x \<one>\<^bsub>P\<^esub> =
             \<one>\<close>
  notes theorem
    "carrier_evalRR" =
      \<open>\<lbrakk>?x \<in> carrier R; ?p \<in> carrier P\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x ?p
                               \<in> carrier R\<close>
  notes theorem
    "evalRR_simps" =
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x
                                (?p \<oplus>\<^bsub>P\<^esub> ?q) =
                               UnivPoly.eval R R id ?x ?p \<oplus>
                               UnivPoly.eval R R id ?x ?q\<close>
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x
                                (?p \<ominus>\<^bsub>P\<^esub> ?q) =
                               UnivPoly.eval R R id ?x
                                ?p \<ominus> UnivPoly.eval R R id ?x
        ?q\<close>
      \<open>\<lbrakk>?p \<in> carrier P; ?q \<in> carrier P;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x
                                (?p \<otimes>\<^bsub>P\<^esub> ?q) =
                               UnivPoly.eval R R id ?x ?p \<otimes>
                               UnivPoly.eval R R id ?x ?q\<close>
      \<open>\<lbrakk>?a \<in> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x
                                (up_ring.monom P ?a ?d) =
                               ?a \<otimes> ?x [^] ?d\<close>
      \<open>?x \<in> carrier R \<Longrightarrow>
             UnivPoly.eval R R id ?x \<one>\<^bsub>P\<^esub> =
             \<one>\<close>
      \<open>\<lbrakk>?x \<in> carrier R; ?p \<in> carrier P\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R R id ?x ?p
                               \<in> carrier R\<close>
  notes theorem "is_UP_cring" = \<open>UP_cring R\<close>
  notes theorem "is_UP_ring" = \<open>UP_ring R\<close>
  notes
    "UP_pre_univ_prop_axioms" = (\<open>UP_pre_univ_prop R S h\<close>)
      ["attribute" "internal"]
  notes theorem
    "eval_ring_hom" =
      \<open>?s \<in> carrier S \<Longrightarrow>
             UnivPoly.eval R S h ?s \<in> ring_hom P S\<close>
  notes theorem
    "eval_const" =
      \<open>\<lbrakk>?s \<in> carrier S; ?r \<in> carrier R\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R S h ?s
                                (up_ring.monom P ?r 0) =
                               h ?r\<close>
  notes theorem
    "eval_monom1" =
      \<open>?s \<in> carrier S \<Longrightarrow>
             UnivPoly.eval R S h ?s (up_ring.monom P \<one> 1) = ?s\<close>
  notes theorem
    "eval_monom" =
      \<open>\<lbrakk>?r \<in> carrier R; ?s \<in> carrier S\<rbrakk>
             \<Longrightarrow> UnivPoly.eval R S h ?s
                                (up_ring.monom P ?r ?n) =
                               h ?r \<otimes>\<^bsub>S\<^esub>
                               ?s [^]\<^bsub>S\<^esub> ?n\<close>
  notes theorem
    "UP_hom_unique" =
      \<open>\<lbrakk>ring_hom_cring P S ?Phi;
              ?Phi (up_ring.monom P \<one> (Suc 0)) = ?s;
              \<And>r.
                 r \<in> carrier R \<Longrightarrow>
                 ?Phi (up_ring.monom P r 0) = h r;
              ring_hom_cring P S ?Psi;
              ?Psi (up_ring.monom P \<one> (Suc 0)) = ?s;
              \<And>r.
                 r \<in> carrier R \<Longrightarrow>
                 ?Psi (up_ring.monom P r 0) = h r;
              ?p \<in> carrier P; ?s \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?Phi ?p = ?Psi ?p\<close>
  notes theorem
    "ring_homD" =
      \<open>?Phi \<in> ring_hom P S \<Longrightarrow>
             ring_hom_cring P S ?Phi\<close>
  notes theorem
    "UP_universal_property" =
      \<open>?s \<in> carrier S \<Longrightarrow>
             \<exists>!Phi.
                Phi
                \<in> ring_hom P S \<inter> extensional (carrier P) \<and>
                Phi (up_ring.monom P \<one> 1) = ?s \<and>
                (\<forall>r\<in>carrier R.
                    Phi (up_ring.monom P r 0) = h r)\<close>
