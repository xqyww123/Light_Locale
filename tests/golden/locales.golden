      ["simp"]
  notes theorem
    "R.add.inv_inj" = \<open>inj_on (a_inv R) (carrier R)\<close>
  notes theorem
    "R.add.inv_mult_group" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> \<ominus> (?x \<oplus> ?y) =
                               \<ominus> ?y \<oplus> \<ominus> ?x\<close>
  notes theorem
    "R.add.inv_comm" =
