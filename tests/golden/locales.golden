              (?H\<lparr>one := ?h \<zero>\<^bsub>S\<^esub>\<rparr>)\<close>
  notes theorem
    "S.add.iso_imp_comm_group" =
      \<open>\<lbrakk>add_monoid S \<cong> ?H; Group.monoid ?H\<rbrakk>
             \<Longrightarrow> comm_group ?H\<close>
  notes theorem
    "S.add.subgroup_imp_normal" =
      \<open>subgroup ?A (add_monoid S) \<Longrightarrow>
             ?A \<lhd> add_monoid S\<close>
  notes theorem
    "S.add.mult_subgroups" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              subgroup ?K (add_monoid S)\<rbrakk>
             \<Longrightarrow> subgroup
                                (?H <#>\<^bsub>add_monoid S\<^esub> ?K)
                                (add_monoid S)\<close>
  notes theorem
    "S.add.normal_iff_subgroup" =
      \<open>?N \<lhd> add_monoid S = subgroup ?N (add_monoid S)\<close>
  notes theorem
    "S.add.set_mult_commute" =
      \<open>\<lbrakk>?N \<subseteq> carrier S;
              ?x \<in> rcosets\<^bsub>add_monoid S\<^esub> ?N;
              ?y \<in> rcosets\<^bsub>add_monoid S\<^esub> ?N\<rbrakk>
             \<Longrightarrow> ?x <#>\<^bsub>add_monoid S\<^esub> ?y =
                               ?y <#>\<^bsub>add_monoid S\<^esub> ?x\<close>
  notes theorem
    "S.add.abelian_FactGroup" =
