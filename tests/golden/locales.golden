      ["simp", "HOL.intro" !]
  notes theorem
    "S.add.mult_cong_r" =
      \<open>\<lbrakk>?b \<sim>\<^bsub>add_monoid S\<^esub> ?b';
              ?a \<in> carrier S; ?b \<in> carrier S;
              ?b' \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<oplus>\<^bsub>S\<^esub>
