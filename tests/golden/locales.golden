                  eq = (\<sim>\<^bsub>add_monoid P\<^esub>),
                  le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "P.add.mult_cong_r" =
      \<open>\<lbrakk>?b \<sim>\<^bsub>add_monoid P\<^esub> ?b';
              ?a \<in> carrier P; ?b \<in> carrier P;
              ?b' \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<oplus>\<^bsub>P\<^esub>
                               ?b \<sim>\<^bsub>add_monoid P\<^esub>
                               ?a \<oplus>\<^bsub>P\<^esub> ?b'\<close>
  notes theorem
    "P.add.Units_assoc" =
      \<open>\<lbrakk>?a \<in> Units (add_monoid P);
              ?b \<in> Units (add_monoid P)\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid P\<^esub>
                               ?b\<close>
  notes theorem
    "P.add.Units_are_ones" =
      \<open>Units
              (add_monoid
                P) {.=}\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
             {\<zero>\<^bsub>P\<^esub>}\<close>
  notes theorem
    "P.add.properfactor_unitE" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid P);
              properfactor (add_monoid P) ?a ?u; ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "P.add.properfactor_divides" =
      \<open>properfactor (add_monoid P) ?a ?b \<Longrightarrow>
             ?a divides\<^bsub>add_monoid P\<^esub> ?b\<close>
  notes theorem
    "P.add.properfactor_trans1" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid P\<^esub> ?b;
               properfactor (add_monoid P) ?b ?c; ?a \<in> carrier P;
               ?c \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid P) ?a ?c\<close>)
      ["trans"]
  notes theorem
    "P.add.properfactor_trans2" =
      (\<open>\<lbrakk>properfactor (add_monoid P) ?a ?b;
               ?b divides\<^bsub>add_monoid P\<^esub> ?c;
               ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid P) ?a ?c\<close>)
      ["trans"]
  notes theorem
    "P.add.properfactor_cong_l" =
      (\<open>\<lbrakk>?x' \<sim>\<^bsub>add_monoid P\<^esub> ?x;
               properfactor (add_monoid P) ?x ?y; ?x \<in> carrier P;
               ?x' \<in> carrier P; ?y \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid P) ?x' ?y\<close>)
      ["trans"]
  notes theorem
    "P.add.properfactor_cong_r" =
      (\<open>\<lbrakk>properfactor (add_monoid P) ?x ?y;
               ?y \<sim>\<^bsub>add_monoid P\<^esub> ?y';
               ?x \<in> carrier P; ?y \<in> carrier P;
               ?y' \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid P) ?x ?y'\<close>)
      ["trans"]
  notes theorem
    "P.add.properfactor_prod_r" =
      \<open>\<lbrakk>properfactor (add_monoid P) ?a ?b; ?a \<in> carrier P;
              ?b \<in> carrier P; ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> properfactor (add_monoid P) ?a
                                (?b \<oplus>\<^bsub>P\<^esub> ?c)\<close>
  notes theorem
    "P.add.irreducible_prod_rI" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid P) ?a;
              ?b \<in> Units (add_monoid P); ?a \<in> carrier P;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible (add_monoid P)
                                (?a \<oplus>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.add.listassoc_refl" =
      (\<open>set ?as \<subseteq> carrier P \<Longrightarrow>
              ?as [\<sim>]\<^bsub>add_monoid P\<^esub> ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "P.add.listassoc_sym" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid P\<^esub> ?bs;
               set ?as \<subseteq> carrier P;
               set ?bs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> ?bs [\<sim>]\<^bsub>add_monoid P\<^esub>
                                ?as\<close>)
      ["sym"]
  notes theorem
    "P.add.listassoc_trans" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid P\<^esub> ?bs;
               ?bs [\<sim>]\<^bsub>add_monoid P\<^esub> ?cs;
               set ?as \<subseteq> carrier P; set ?bs \<subseteq> carrier P;
               set ?cs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> ?as [\<sim>]\<^bsub>add_monoid P\<^esub>
                                ?cs\<close>)
      ["trans"]
  notes theorem
    "P.add.perm_assoc_switch" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid P\<^esub> ?bs;
              mset ?bs = mset ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  mset ?as = mset bs' \<and>
                                  bs' [\<sim>]\<^bsub>add_monoid P\<^esub>
                                  ?cs\<close>
  notes theorem
    "P.add.perm_assoc_switch_r" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              ?bs [\<sim>]\<^bsub>add_monoid P\<^esub> ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  ?as [\<sim>]\<^bsub>add_monoid P\<^esub>
                                  bs' \<and>
                                  mset bs' = mset ?cs\<close>
  notes theorem
    "P.add.perm_closed" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> set ?bs \<subseteq> carrier P\<close>
  notes theorem
    "P.add.irrlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              \<forall>a\<in>set ?as.
                 Divisibility.irreducible (add_monoid P) a\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible (add_monoid P)
                                   a\<close>
  notes theorem
    "P.add.essentially_equalI" =
      \<open>\<lbrakk>mset ?fs1.0 = mset ?fs1';
              ?fs1' [\<sim>]\<^bsub>add_monoid P\<^esub> ?fs2.0\<rbrakk>
             \<Longrightarrow> essentially_equal (add_monoid P) ?fs1.0
                                ?fs2.0\<close>
  notes theorem
    "P.add.essentially_equalE" =
      \<open>\<lbrakk>essentially_equal (add_monoid P) ?fs1.0 ?fs2.0;
              \<And>fs1'.
                 \<lbrakk>mset ?fs1.0 = mset fs1';
                  fs1' [\<sim>]\<^bsub>add_monoid P\<^esub> ?fs2.0\<rbrakk>
                 \<Longrightarrow> ?P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "P.add.ee_refl" =
      (\<open>set ?as \<subseteq> carrier P \<Longrightarrow>
              essentially_equal (add_monoid P) ?as ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "P.add.ee_sym" =
      (\<open>\<lbrakk>essentially_equal (add_monoid P) ?as ?bs;
               set ?as \<subseteq> carrier P;
               set ?bs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> essentially_equal (add_monoid P) ?bs
                                 ?as\<close>)
      ["sym"]
  notes theorem
    "P.add.ee_trans" =
      (\<open>\<lbrakk>essentially_equal (add_monoid P) ?as ?bs;
               essentially_equal (add_monoid P) ?bs ?cs;
               set ?as \<subseteq> carrier P; set ?bs \<subseteq> carrier P;
               set ?cs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> essentially_equal (add_monoid P) ?as
                                 ?cs\<close>)
      ["trans"]
  notes theorem
    "P.add.multlist_closed" =
      (\<open>set ?fs \<subseteq> carrier P \<Longrightarrow>
              foldr (\<oplus>\<^bsub>P\<^esub>) ?fs \<zero>\<^bsub>P\<^esub>
              \<in> carrier P\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "P.add.factorsI" =
      \<open>\<lbrakk>\<forall>f\<in>set ?fs.
                         Divisibility.irreducible (add_monoid P) f;
              foldr (\<oplus>\<^bsub>P\<^esub>) ?fs
               \<zero>\<^bsub>P\<^esub> =
              ?a\<rbrakk>
             \<Longrightarrow> factors (add_monoid P) ?fs ?a\<close>
  notes theorem
    "P.add.factors_wfactors" =
      \<open>\<lbrakk>factors (add_monoid P) ?as ?a;
              set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid P) ?as ?a\<close>
  notes theorem
    "P.add.wfactors_factors" =
      \<open>\<lbrakk>wfactors (add_monoid P) ?as ?a;
              set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> \<exists>a'.
                                  factors (add_monoid P) ?as a' \<and>
                                  a' \<sim>\<^bsub>add_monoid P\<^esub>
                                  ?a\<close>
  notes theorem
    "P.add.factors_closed" =
      (\<open>\<lbrakk>factors (add_monoid P) ?fs ?a;
               set ?fs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> ?a \<in> carrier P\<close>)
      ["HOL.dest"]
  notes theorem
    "P.add.nunit_factors" =
      \<open>\<lbrakk>?a \<notin> Units (add_monoid P);
              factors (add_monoid P) ?as ?a\<rbrakk>
             \<Longrightarrow> 0 < length ?as\<close>
  notes theorem
    "P.add.unit_wfactors" =
      (\<open>?a \<in> Units (add_monoid P) \<Longrightarrow>
              wfactors (add_monoid P) [] ?a\<close>)
      ["simp"]
  notes theorem
    "P.add.wfactors_cong_r" =
      (\<open>\<lbrakk>wfactors (add_monoid P) ?fs ?a;
               ?a \<sim>\<^bsub>add_monoid P\<^esub> ?a';
               ?a \<in> carrier P; ?a' \<in> carrier P;
               set ?fs \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> wfactors (add_monoid P) ?fs ?a'\<close>)
      ["trans"]
  notes theorem
    "P.add.wfactors_prod_exists" =
      (\<open>\<lbrakk>\<forall>a\<in>set ?as.
                          Divisibility.irreducible (add_monoid P) a;
               set ?as \<subseteq> carrier P\<rbrakk>
              \<Longrightarrow> \<exists>a.
                                   a \<in> carrier P \<and>
                                   wfactors (add_monoid P) ?as a\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.add.factors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid P) ?a;
              factors (add_monoid P) ?fb ?b; ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> factors (add_monoid P) (?a # ?fb)
                                (?a \<oplus>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.add.factors_mult" =
      \<open>\<lbrakk>factors (add_monoid P) ?fa ?a;
              factors (add_monoid P) ?fb ?b; set ?fa \<subseteq> carrier P;
              set ?fb \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> factors (add_monoid P) (?fa @ ?fb)
                                (?a \<oplus>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.add.assocs_repr_independence" =
      \<open>\<lbrakk>?y \<in> closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                                {?x};
              ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                                {?x} =
                               closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                                {?y}\<close>
  notes theorem
    "P.add.assocs_self" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             ?x \<in> closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                       {?x}\<close>
  notes theorem
    "P.add.assocs_repr_independenceD" =
      \<open>\<lbrakk>closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                       {?x} =
                      closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                       {?y};
              ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?y \<in> closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
   {?x}\<close>
  notes theorem
    "P.add.fmset_perm_cong" =
      \<open>mset ?as = mset ?bs \<Longrightarrow>
             fmset (add_monoid P) ?as = fmset (add_monoid P) ?bs\<close>
  notes theorem
    "P.add.mset_fmsetEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    ?P x \<and>
                    X =
                    closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                     {x}) \<Longrightarrow>
             \<exists>cs.
                (\<forall>c\<in>set cs. ?P c) \<and>
                fmset (add_monoid P) cs = ?Cs\<close>
  notes theorem
    "P.add.mset_wfactorsEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    (x \<in> carrier P \<and>
                     Divisibility.irreducible (add_monoid P) x) \<and>
                    X =
                    closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                     {x}) \<Longrightarrow>
             \<exists>c cs.
                c \<in> carrier P \<and>
                set cs \<subseteq> carrier P \<and>
                wfactors (add_monoid P) cs c \<and>
                fmset (add_monoid P) cs = ?Cs\<close>
  notes theorem
    "P.add.isgcd_divides_l" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid P\<^esub> ?b;
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a gcdof\<^bsub>add_monoid P\<^esub> ?a ?b\<close>
  notes theorem
    "P.add.isgcd_divides_r" =
      \<open>\<lbrakk>?b divides\<^bsub>add_monoid P\<^esub> ?a;
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?b gcdof\<^bsub>add_monoid P\<^esub> ?a ?b\<close>
  notes theorem
    "P.add.assoc_subst" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid P\<^esub> ?b;
              \<forall>a b.
                 a \<in> carrier P \<and>
                 b \<in> carrier P \<and>
                 a \<sim>\<^bsub>add_monoid P\<^esub> b \<longrightarrow>
                 ?f a \<in> carrier P \<and>
                 ?f b \<in> carrier P \<and>
                 ?f a \<sim>\<^bsub>add_monoid P\<^esub> ?f b;
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?f ?a \<sim>\<^bsub>add_monoid P\<^esub>
                               ?f ?b\<close>
  notes theorem
    "P.add.ee_length" =
      \<open>essentially_equal (add_monoid P) ?as ?bs \<Longrightarrow>
             length ?as = length ?bs\<close>
  notes theorem
    "P.add.nat_pow_eone" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              [1] \<cdot>\<^bsub>P\<^esub> ?x = ?x\<close>)
      ["simp"]
  notes theorem
    "P.add.Units_pow_closed" =
      \<open>?x \<in> Units (add_monoid P) \<Longrightarrow>
             [?d] \<cdot>\<^bsub>P\<^esub> ?x
             \<in> Units (add_monoid P)\<close>
  notes
    "P.add.comm_monoid_axioms" =
      (\<open>Group.comm_monoid (add_monoid P)\<close>)
      ["attribute" "internal"]
  notes
    "P.add.m_comm" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub> ?y =
                               ?y \<oplus>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.add.m_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub>
                               (?y \<oplus>\<^bsub>P\<^esub> ?z) =
                               ?y \<oplus>\<^bsub>P\<^esub>
                               (?x \<oplus>\<^bsub>P\<^esub> ?z)\<close>
  notes theorem
    "P.add.m_ac" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub>
                               ?y \<oplus>\<^bsub>P\<^esub>
                               ?z =
                               ?x \<oplus>\<^bsub>P\<^esub>
                               (?y \<oplus>\<^bsub>P\<^esub> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub> ?y =
                               ?y \<oplus>\<^bsub>P\<^esub> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub>
                               (?y \<oplus>\<^bsub>P\<^esub> ?z) =
                               ?y \<oplus>\<^bsub>P\<^esub>
                               (?x \<oplus>\<^bsub>P\<^esub> ?z)\<close>
  notes theorem
    "P.add.submonoid_is_comm_monoid" =
      \<open>submonoid ?H (add_monoid P) \<Longrightarrow>
             Group.comm_monoid
              (add_monoid P\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "P.add.nat_pow_distrib" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> [?n] \<cdot>\<^bsub>P\<^esub> (?x \<oplus>\<^bsub>P\<^esub>
                        ?y) =
                               [?n] \<cdot>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
                               [?n] \<cdot>\<^bsub>P\<^esub> ?y\<close>
  notes theorem
    "P.add.hom_imp_img_comm_monoid" =
      \<open>?h \<in> hom (add_monoid P) ?H \<Longrightarrow>
             Group.comm_monoid
              (?H\<lparr>carrier := ?h ` carrier P,
                    one := ?h \<zero>\<^bsub>P\<^esub>\<rparr>)\<close>
  notes theorem
    "P.add.units_comm_group" =
      \<open>comm_group (units_of (add_monoid P))\<close>
  notes theorem
    "P.add.finprod_empty" =
      (\<open>finsum P ?f {} = \<zero>\<^bsub>P\<^esub>\<close>) ["simp"]
  notes theorem
    "P.add.finprod_infinite" =
      (\<open>infinite ?A \<Longrightarrow>
              finsum P ?f ?A = \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.finprod_insert" =
      (\<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
               ?f \<in> ?F \<rightarrow> carrier P;
               ?f ?a \<in> carrier P\<rbrakk>
              \<Longrightarrow> finsum P ?f (insert ?a ?F) =
                                ?f ?a \<oplus>\<^bsub>P\<^esub>
                                finsum P ?f ?F\<close>)
      ["simp"]
  notes theorem
    "P.add.finprod_one_eqI" =
      \<open>(\<And>x.
                 x \<in> ?A \<Longrightarrow>
                 ?f x = \<zero>\<^bsub>P\<^esub>) \<Longrightarrow>
             finsum P ?f ?A = \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.add.finprod_one" =
      (\<open>(\<Oplus>\<^bsub>P\<^esub>i\<in>?A. \<zero>\<^bsub>P\<^esub>) =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.finprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier P \<Longrightarrow>
              finsum P ?f ?A \<in> carrier P\<close>)
      ["simp"]
  notes theorem
    "P.add.funcset_Int_left" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> ?C;
               ?f \<in> ?B \<rightarrow> ?C\<rbrakk>
              \<Longrightarrow> ?f \<in> ?A \<inter> ?B \<rightarrow>
   ?C\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "P.add.funcset_Un_left" =
      (\<open>(?f \<in> ?A \<union> ?B \<rightarrow> ?C) =
              (?f \<in> ?A \<rightarrow> ?C \<and>
               ?f \<in> ?B \<rightarrow> ?C)\<close>)
      ["iff"]
  notes theorem
    "P.add.finprod_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier P;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finsum P ?g
                                (?A \<union> ?B) \<oplus>\<^bsub>P\<^esub>
                               finsum P ?g (?A \<inter> ?B) =
                               finsum P ?g ?A \<oplus>\<^bsub>P\<^esub>
                               finsum P ?g ?B\<close>
  notes theorem
    "P.add.finprod_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier P;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finsum P ?g (?A \<union> ?B) =
                               finsum P ?g ?A \<oplus>\<^bsub>P\<^esub>
                               finsum P ?g ?B\<close>
  notes theorem
    "P.add.finprod_multf" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier P;
               ?g \<in> ?A \<rightarrow> carrier P\<rbrakk>
              \<Longrightarrow> (\<Oplus>\<^bsub>P\<^esub>x\<in>?A. ?f
                               x \<oplus>\<^bsub>P\<^esub>
                              ?g x) =
                                finsum P ?f ?A \<oplus>\<^bsub>P\<^esub>
                                finsum P ?g ?A\<close>)
      ["simp"]
  notes theorem
    "P.add.finprod_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier P;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum P ?f ?A = finsum P ?g ?B\<close>
  notes theorem
    "P.add.finprod_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier P) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum P ?f ?A = finsum P ?g ?B\<close>
  notes theorem
    "P.add.finprod_0" =
      (\<open>?f \<in> {0} \<rightarrow> carrier P \<Longrightarrow>
              finsum P ?f {..0} = ?f 0\<close>)
      ["simp"]
  notes theorem
    "P.add.finprod_0'" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier P \<Longrightarrow>
             ?f 0 \<oplus>\<^bsub>P\<^esub> finsum P ?f {Suc 0..?n} =
             finsum P ?f {..?n}\<close>
  notes theorem
    "P.add.finprod_Suc" =
      (\<open>?f \<in> {..Suc ?n} \<rightarrow> carrier P \<Longrightarrow>
              finsum P ?f {..Suc ?n} =
              ?f (Suc ?n) \<oplus>\<^bsub>P\<^esub>
              finsum P ?f {..?n}\<close>)
      ["simp"]
  notes theorem
    "P.add.finprod_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier P \<Longrightarrow>
             finsum P ?f {..Suc ?n} =
             (\<Oplus>\<^bsub>P\<^esub>i\<in>{..?n}. ?f
                (Suc i)) \<oplus>\<^bsub>P\<^esub>
             ?f 0\<close>
  notes theorem
    "P.add.finprod_Suc3" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier P \<Longrightarrow>
             finsum P ?f {..?n} =
             ?f ?n \<oplus>\<^bsub>P\<^esub> finsum P ?f {..<?n}\<close>
  notes theorem
    "P.add.finprod_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier P;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finsum P ?f (?h ` ?A) =
                               (\<Oplus>\<^bsub>P\<^esub>x\<in>?A. ?f
                              (?h x))\<close>
  notes theorem
    "P.add.finprod_const" =
      \<open>?a \<in> carrier P \<Longrightarrow>
             (\<Oplus>\<^bsub>P\<^esub>x\<in>?A. ?a) =
             [card ?A] \<cdot>\<^bsub>P\<^esub> ?a\<close>
  notes theorem
    "P.add.finprod_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> (\<Oplus>\<^bsub>P\<^esub>j\<in>?A. if ?i = j
                             then ?f j else \<zero>\<^bsub>P\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "P.add.finprod_singleton_swap" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> (\<Oplus>\<^bsub>P\<^esub>j\<in>?A. if j = ?i
                             then ?f j else \<zero>\<^bsub>P\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "P.add.finprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<zero>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finsum P ?g ?A = finsum P ?h ?B\<close>
  notes theorem
    "P.add.finprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?g i = \<zero>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finsum P ?g ?B = finsum P ?h ?A\<close>
  notes theorem
    "P.add.finprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<zero>\<^bsub>P\<^esub>;
              \<And>i.
                 i \<in> ?A - ?B \<Longrightarrow>
                 ?g i = \<zero>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier P;
              ?h \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finsum P ?g ?A = finsum P ?h ?B\<close>
  notes theorem
    "P.add.finprod_UN_disjoint" =
      \<open>\<lbrakk>finite ?I;
              \<And>i. i \<in> ?I \<Longrightarrow> finite (?A i);
              pairwise (\<lambda>i j. disjnt (?A i) (?A j)) ?I;
              \<And>i x.
                 \<lbrakk>i \<in> ?I; x \<in> ?A i\<rbrakk>
                 \<Longrightarrow> ?g x \<in> carrier P\<rbrakk>
             \<Longrightarrow> finsum P ?g (\<Union> (?A ` ?I)) =
                               (\<Oplus>\<^bsub>P\<^esub>i\<in>?I. finsum P
                              ?g (?A i))\<close>
  notes theorem
    "P.add.finprod_Union_disjoint" =
      \<open>\<lbrakk>finite ?C;
              \<And>A.
                 A \<in> ?C \<Longrightarrow>
                 finite A \<and> (\<forall>x\<in>A. ?f x \<in> carrier P);
              disjoint ?C\<rbrakk>
             \<Longrightarrow> finsum P ?f (\<Union> ?C) =
                               finsum P (finsum P ?f) ?C\<close>
  notes theorem
    "P.add.comm_inv_char" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?x \<oplus>\<^bsub>P\<^esub> ?y =
              \<zero>\<^bsub>P\<^esub>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid P\<^esub> ?x =
                               ?y\<close>
  notes theorem
    "P.add.unit_factor" =
      \<open>\<lbrakk>?a \<oplus>\<^bsub>P\<^esub> ?b
                      \<in> Units (add_monoid P);
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid P)\<close>
  notes theorem
    "P.add.divides_mult_rI" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid P\<^esub> ?b;
               ?a \<in> carrier P; ?b \<in> carrier P;
               ?c \<in> carrier P\<rbrakk>
              \<Longrightarrow> (?a \<oplus>\<^bsub>P\<^esub>
                                 ?c) divides\<^bsub>add_monoid P\<^esub>
                                (?b \<oplus>\<^bsub>P\<^esub> ?c)\<close>)
      ["HOL.intro"]
  notes theorem
    "P.add.divides_prod_l" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P;
              ?c \<in> carrier P;
              ?a divides\<^bsub>add_monoid P\<^esub> ?b\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>add_monoid P\<^esub>
                               (?c \<oplus>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.add.divides_unit" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid P\<^esub> ?u;
              ?a \<in> carrier P; ?u \<in> Units (add_monoid P)\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid P)\<close>
  notes theorem
    "P.add.Unit_eq_dividesone" =
      \<open>?u \<in> carrier P \<Longrightarrow>
             (?u \<in> Units (add_monoid P)) =
             ?u divides\<^bsub>add_monoid P\<^esub>
             \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.add.mult_cong_l" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid P\<^esub> ?a';
              ?a \<in> carrier P; ?a' \<in> carrier P;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<oplus>\<^bsub>P\<^esub>
                               ?b \<sim>\<^bsub>add_monoid P\<^esub>
                               ?a' \<oplus>\<^bsub>P\<^esub> ?b\<close>
  notes theorem
    "P.add.Units_cong" =
      \<open>\<lbrakk>?a \<in> Units (add_monoid P);
              ?a \<sim>\<^bsub>add_monoid P\<^esub> ?b;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?b \<in> Units (add_monoid P)\<close>
  notes theorem
    "P.add.Units_Lower" =
      \<open>Units (add_monoid P) =
             Lower
              \<lparr>carrier = carrier P,
                 eq = (\<sim>\<^bsub>add_monoid P\<^esub>),
                 le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>
              (carrier P)\<close>
  notes theorem
    "P.add.properfactor_prod_l" =
      \<open>\<lbrakk>properfactor (add_monoid P) ?a ?b; ?a \<in> carrier P;
              ?b \<in> carrier P; ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> properfactor (add_monoid P) ?a
                                (?c \<oplus>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.add.irreducible_prod_lI" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid P) ?b;
              ?a \<in> Units (add_monoid P); ?a \<in> carrier P;
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible (add_monoid P)
                                (?a \<oplus>\<^bsub>P\<^esub> ?b)\<close>
  notes theorem
    "P.add.multlist_dividesI" =
      \<open>\<lbrakk>?f \<in> set ?fs;
              set ?fs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid P\<^esub>
                               foldr (\<oplus>\<^bsub>P\<^esub>) ?fs
                                \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.add.multlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> foldr (\<oplus>\<^bsub>P\<^esub>) ?as
                                \<zero>\<^bsub>P\<^esub> =
                               foldr (\<oplus>\<^bsub>P\<^esub>) ?bs
                                \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.add.wfactors_perm_cong_l" =
      \<open>\<lbrakk>wfactors (add_monoid P) ?fs ?a; mset ?fs = mset ?fs';
              set ?fs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid P) ?fs' ?a\<close>
  notes theorem
    "P.add.perm_wfactorsD" =
      \<open>\<lbrakk>mset ?as = mset ?bs; wfactors (add_monoid P) ?as ?a;
              wfactors (add_monoid P) ?bs ?b; ?a \<in> carrier P;
              ?b \<in> carrier P; set ?as \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid P\<^esub>
                               ?b\<close>
  notes theorem
    "P.add.factors_dividesI" =
      \<open>\<lbrakk>factors (add_monoid P) ?fs ?a; ?f \<in> set ?fs;
              set ?fs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid P\<^esub>
                               ?a\<close>
  notes theorem
    "P.add.wfactors_dividesI" =
      \<open>\<lbrakk>wfactors (add_monoid P) ?fs ?a;
              set ?fs \<subseteq> carrier P; ?a \<in> carrier P;
              ?f \<in> set ?fs\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid P\<^esub>
                               ?a\<close>
  notes theorem
    "P.add.assocs_assoc" =
      \<open>\<lbrakk>?a \<in> closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                                {?b};
              ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid P\<^esub>
                               ?b\<close>
  notes theorem
    "P.add.assocs_eqD" =
      \<open>\<lbrakk>closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                       {?b} =
                      closure_of\<^bsub>\<lparr>carrier = carrier P, eq = (\<sim>\<^bsub>add_monoid P\<^esub>), le = (divides\<^bsub>add_monoid P\<^esub>)\<rparr>\<^esub>
                       {?a};
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid P\<^esub>
                               ?b\<close>
  notes theorem
    "P.add.gfinprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier P \<Longrightarrow>
              gfinprod (add_monoid P) ?f ?A \<in> carrier P\<close>)
      ["simp"]
  notes theorem
    "P.add.gfinprod_cong" =
      \<open>\<lbrakk>?A = ?B; ?f \<in> ?B \<rightarrow> carrier P;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid P) ?f ?A =
                               gfinprod (add_monoid P) ?g ?B\<close>
  notes theorem
    "P.add.gfinprod_eq_finprod" =
      (\<open>\<lbrakk>finite ?A;
               ?f \<in> ?A \<rightarrow> carrier P\<rbrakk>
              \<Longrightarrow> gfinprod (add_monoid P) ?f ?A =
                                finsum P ?f ?A\<close>)
      ["simp"]
  notes theorem
    "P.add.gfinprod_insert" =
      (\<open>\<lbrakk>finite
                        {x \<in> ?A.
                         ?f x \<noteq> \<zero>\<^bsub>P\<^esub>};
               ?f \<in> ?A \<rightarrow> carrier P;
               ?f ?i \<in> carrier P\<rbrakk>
              \<Longrightarrow> gfinprod (add_monoid P) ?f (insert ?i ?A) =
                                (if ?i \<in> ?A
                                 then gfinprod (add_monoid P) ?f ?A
                                 else ?f ?i \<oplus>\<^bsub>P\<^esub>
gfinprod (add_monoid P) ?f ?A)\<close>)
      ["simp"]
  notes theorem
    "P.add.gfinprod_distrib" =
      \<open>\<lbrakk>finite
                       {x \<in> ?A. ?f x \<noteq> \<zero>\<^bsub>P\<^esub>};
              finite {x \<in> ?A. ?g x \<noteq> \<zero>\<^bsub>P\<^esub>};
              ?f \<in> ?A \<rightarrow> carrier P;
              ?g \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid P)
                                (\<lambda>i.
                                    ?f i \<oplus>\<^bsub>P\<^esub> ?g i)
                                ?A =
                               gfinprod (add_monoid P) ?f
                                ?A \<oplus>\<^bsub>P\<^esub>
                               gfinprod (add_monoid P) ?g ?A\<close>
  notes theorem
    "P.add.gfinprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<zero>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid P) ?g ?A =
                               gfinprod (add_monoid P) ?h ?B\<close>
  notes theorem
    "P.add.gfinprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?g i = \<zero>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid P) ?g ?B =
                               gfinprod (add_monoid P) ?h ?A\<close>
  notes theorem
    "P.add.gfinprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<zero>\<^bsub>P\<^esub>;
              \<And>i.
                 i \<in> ?A - ?B \<Longrightarrow>
                 ?g i = \<zero>\<^bsub>P\<^esub>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier P;
              ?h \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid P) ?g ?A =
                               gfinprod (add_monoid P) ?h ?B\<close>
  notes
    "P.abelian_monoid_axioms" = (\<open>abelian_monoid P\<close>)
      ["attribute" "internal"]
  notes "P.a_comm_monoid" = \<open>Group.comm_monoid (add_monoid P)\<close>
  notes theorem "P.a_monoid" = \<open>Group.monoid (add_monoid P)\<close>
  notes theorem
    "P.a_closed" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub> ?y
                               \<in> carrier P\<close>
  notes theorem
    "P.zero_closed" =
      \<open>\<zero>\<^bsub>P\<^esub> \<in> carrier P\<close>
  notes theorem
    "P.a_assoc" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub>
                               ?y \<oplus>\<^bsub>P\<^esub>
                               ?z =
                               ?x \<oplus>\<^bsub>P\<^esub>
                               (?y \<oplus>\<^bsub>P\<^esub> ?z)\<close>
  notes theorem
    "P.l_zero" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             \<zero>\<^bsub>P\<^esub> \<oplus>\<^bsub>P\<^esub> ?x =
             ?x\<close>
  notes theorem
    "P.r_zero" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             ?x \<oplus>\<^bsub>P\<^esub> \<zero>\<^bsub>P\<^esub> =
             ?x\<close>
  notes theorem
    "P.minus_unique" =
      \<open>\<lbrakk>?y \<oplus>\<^bsub>P\<^esub> ?x =
                      \<zero>\<^bsub>P\<^esub>;
              ?x \<oplus>\<^bsub>P\<^esub> ?y' = \<zero>\<^bsub>P\<^esub>;
              ?x \<in> carrier P; ?y \<in> carrier P;
              ?y' \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "P.a_comm" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub> ?y =
                               ?y \<oplus>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.a_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub>
                               (?y \<oplus>\<^bsub>P\<^esub> ?z) =
                               ?y \<oplus>\<^bsub>P\<^esub>
                               (?x \<oplus>\<^bsub>P\<^esub> ?z)\<close>
  notes theorem
    "P.a_ac" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub>
                               ?y \<oplus>\<^bsub>P\<^esub>
                               ?z =
                               ?x \<oplus>\<^bsub>P\<^esub>
                               (?y \<oplus>\<^bsub>P\<^esub> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub> ?y =
                               ?y \<oplus>\<^bsub>P\<^esub> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
              ?z \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>P\<^esub>
                               (?y \<oplus>\<^bsub>P\<^esub> ?z) =
                               ?y \<oplus>\<^bsub>P\<^esub>
                               (?x \<oplus>\<^bsub>P\<^esub> ?z)\<close>
  notes theorem
    "P.finsum_empty" =
      \<open>finsum P ?f {} = \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.finsum_insert" =
      \<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
              ?f \<in> ?F \<rightarrow> carrier P;
              ?f ?a \<in> carrier P\<rbrakk>
             \<Longrightarrow> finsum P ?f (insert ?a ?F) =
                               ?f ?a \<oplus>\<^bsub>P\<^esub>
                               finsum P ?f ?F\<close>
  notes theorem
    "P.finsum_zero" =
      \<open>(\<Oplus>\<^bsub>P\<^esub>i\<in>?A. \<zero>\<^bsub>P\<^esub>) =
             \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.finsum_closed" =
      \<open>?f \<in> ?A \<rightarrow> carrier P \<Longrightarrow>
             finsum P ?f ?A \<in> carrier P\<close>
  notes theorem
    "P.finsum_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier P;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finsum P ?g
                                (?A \<union> ?B) \<oplus>\<^bsub>P\<^esub>
                               finsum P ?g (?A \<inter> ?B) =
                               finsum P ?g ?A \<oplus>\<^bsub>P\<^esub>
                               finsum P ?g ?B\<close>
  notes theorem
    "P.finsum_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier P;
              ?g \<in> ?B \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> finsum P ?g (?A \<union> ?B) =
                               finsum P ?g ?A \<oplus>\<^bsub>P\<^esub>
                               finsum P ?g ?B\<close>
  notes theorem
    "P.finsum_addf" =
      \<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier P;
              ?g \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> (\<Oplus>\<^bsub>P\<^esub>x\<in>?A. ?f
                              x \<oplus>\<^bsub>P\<^esub>
                             ?g x) =
                               finsum P ?f ?A \<oplus>\<^bsub>P\<^esub>
                               finsum P ?g ?A\<close>
  notes theorem
    "P.finsum_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier P;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum P ?f ?A = finsum P ?g ?B\<close>
  notes theorem
    "P.finsum_0" =
      \<open>?f \<in> {0} \<rightarrow> carrier P \<Longrightarrow>
             finsum P ?f {..0} = ?f 0\<close>
  notes theorem
    "P.finsum_Suc" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier P \<Longrightarrow>
             finsum P ?f {..Suc ?n} =
             ?f (Suc ?n) \<oplus>\<^bsub>P\<^esub>
             finsum P ?f {..?n}\<close>
  notes theorem
    "P.finsum_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier P \<Longrightarrow>
             finsum P ?f {..Suc ?n} =
             (\<Oplus>\<^bsub>P\<^esub>i\<in>{..?n}. ?f
                (Suc i)) \<oplus>\<^bsub>P\<^esub>
             ?f 0\<close>
  notes theorem
    "P.finsum_infinite" =
      \<open>infinite ?A \<Longrightarrow>
             finsum P ?f ?A = \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.finsum_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier P) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum P ?f ?A = finsum P ?g ?B\<close>
  notes theorem
    "P.finsum_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier P;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finsum P ?f (?h ` ?A) =
                               (\<Oplus>\<^bsub>P\<^esub>x\<in>?A. ?f
                              (?h x))\<close>
  notes theorem
    "P.finsum_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier P\<rbrakk>
             \<Longrightarrow> (\<Oplus>\<^bsub>P\<^esub>j\<in>?A. if ?i = j
                             then ?f j else \<zero>\<^bsub>P\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "P.a_r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?x \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?H +>\<^bsub>P\<^esub> ?x
                               \<subseteq> carrier P\<close>
  notes theorem
    "P.set_add_closed" =
      \<open>\<lbrakk>?A \<subseteq> carrier P;
              ?B \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?A <+>\<^bsub>P\<^esub> ?B
                               \<subseteq> carrier P\<close>
  notes theorem
    "P.boundD_carrier" =
      \<open>\<lbrakk>bound \<zero>\<^bsub>P\<^esub> ?n ?f; ?n < ?m\<rbrakk>
             \<Longrightarrow> ?f ?m \<in> carrier P\<close>
  notes
    "P.add.monoid_cancel_axioms" =
      (\<open>monoid_cancel (add_monoid P)\<close>) ["attribute" "internal"]
  notes
    "P.add.l_cancel" =
      \<open>\<lbrakk>?c \<oplus>\<^bsub>P\<^esub> ?a =
                      ?c \<oplus>\<^bsub>P\<^esub> ?b;
              ?a \<in> carrier P; ?b \<in> carrier P;
              ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a = ?b\<close>
  notes
    "P.add.r_cancel" =
      \<open>\<lbrakk>?a \<oplus>\<^bsub>P\<^esub> ?c =
                      ?b \<oplus>\<^bsub>P\<^esub> ?c;
              ?a \<in> carrier P; ?b \<in> carrier P;
              ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a = ?b\<close>
  notes theorem
    "P.add.is_monoid_cancel" = \<open>monoid_cancel (add_monoid P)\<close>
  notes theorem
    "P.add.divides_mult_l" =
      (\<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P;
               ?c \<in> carrier P\<rbrakk>
              \<Longrightarrow> (?c \<oplus>\<^bsub>P\<^esub>
                                 ?a) divides\<^bsub>add_monoid P\<^esub>
                                (?c \<oplus>\<^bsub>P\<^esub> ?b) =
                                ?a divides\<^bsub>add_monoid P\<^esub>
                                ?b\<close>)
      ["simp"]
  notes theorem
    "P.add.associatedD2" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid P\<^esub> ?b;
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> \<exists>u\<in>Units (add_monoid P).
                                  ?a =
                                  ?b \<oplus>\<^bsub>P\<^esub> u\<close>
  notes theorem
    "P.add.associatedE2" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid P\<^esub> ?b;
              \<And>u.
                 \<lbrakk>?a = ?b \<oplus>\<^bsub>P\<^esub> u;
                  u \<in> Units (add_monoid P)\<rbrakk>
                 \<Longrightarrow> ?P;
              ?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "P.add.assoc_l_cancel" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P;
              ?b' \<in> carrier P;
              ?a \<oplus>\<^bsub>P\<^esub>
              ?b \<sim>\<^bsub>add_monoid P\<^esub>
              ?a \<oplus>\<^bsub>P\<^esub> ?b'\<rbrakk>
             \<Longrightarrow> ?b \<sim>\<^bsub>add_monoid P\<^esub>
                               ?b'\<close>
  notes theorem
    "P.add.assoc_unit_l" =
      (\<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid P\<^esub> ?b;
               ?b \<in> Units (add_monoid P); ?a \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?a \<in> Units (add_monoid P)\<close>)
      ["trans"]
  notes theorem
    "P.add.assoc_unit_r" =
      (\<open>\<lbrakk>?a \<in> Units (add_monoid P);
               ?a \<sim>\<^bsub>add_monoid P\<^esub> ?b;
               ?b \<in> carrier P\<rbrakk>
              \<Longrightarrow> ?b \<in> Units (add_monoid P)\<close>)
      ["trans"]
  notes theorem
    "P.add.associated_iff" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid P\<^esub> ?b =
                               (\<exists>c\<in>Units (add_monoid P).
                                   ?a =
                                   ?b \<oplus>\<^bsub>P\<^esub> c)\<close>
  notes theorem
    "P.add.properfactor_mult_lI" =
      (\<open>\<lbrakk>properfactor (add_monoid P) ?a ?b;
               ?a \<in> carrier P; ?c \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid P)
                                 (?c \<oplus>\<^bsub>P\<^esub> ?a)
                                 (?c \<oplus>\<^bsub>P\<^esub> ?b)\<close>)
      ["HOL.intro"]
  notes theorem
    "P.add.properfactor_mult_l" =
      (\<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P;
               ?c \<in> carrier P\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid P)
                                 (?c \<oplus>\<^bsub>P\<^esub> ?a)
                                 (?c \<oplus>\<^bsub>P\<^esub> ?b) =
                                properfactor (add_monoid P) ?a ?b\<close>)
      ["simp"]
  notes theorem
    "P.add.irreducible_cong" =
      (\<open>\<lbrakk>Divisibility.irreducible (add_monoid P) ?a;
               ?a \<sim>\<^bsub>add_monoid P\<^esub> ?a';
               ?a \<in> carrier P; ?a' \<in> carrier P\<rbrakk>
              \<Longrightarrow> Divisibility.irreducible (add_monoid P)
                                 ?a'\<close>)
      ["trans"]
  notes theorem
    "P.add.prime_cong" =
      (\<open>\<lbrakk>Divisibility.prime (add_monoid P) ?p;
               ?p \<sim>\<^bsub>add_monoid P\<^esub> ?p';
               ?p \<in> carrier P; ?p' \<in> carrier P\<rbrakk>
              \<Longrightarrow> Divisibility.prime (add_monoid P)
                                 ?p'\<close>)
      ["trans"]
  notes theorem
    "P.add.irrlist_listassoc_cong" =
      \<open>\<lbrakk>\<forall>a\<in>set ?as.
                         Divisibility.irreducible (add_monoid P) a;
              ?as [\<sim>]\<^bsub>add_monoid P\<^esub> ?bs;
              set ?as \<subseteq> carrier P;
              set ?bs \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible (add_monoid P)
                                   a\<close>
  notes theorem
    "P.add.wfactors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid P) ?a;
              wfactors (add_monoid P) ?fb ?b; ?a \<in> carrier P;
              ?b \<in> carrier P; set ?fb \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid P) (?a # ?fb)
                                (?a \<oplus>\<^bsub>P\<^esub> ?b)\<close>
  notes
    "P.add.group_axioms" = (\<open>Group.group (add_monoid P)\<close>)
      ["attribute" "internal"]
  notes
    "P.add.Units" =
      \<open>carrier P \<subseteq> Units (add_monoid P)\<close>
  notes theorem
    "P.add.is_group" = (\<open>Group.group (add_monoid P)\<close>) ["iff"]
  notes theorem
    "P.add.is_monoid" = (\<open>Group.monoid (add_monoid P)\<close>) ["iff"]
  notes theorem
    "P.add.Units_eq" = (\<open>Units (add_monoid P) = carrier P\<close>)
      ["simp"]
  notes theorem
    "P.add.inv_closed" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              \<ominus>\<^bsub>P\<^esub> ?x \<in> carrier P\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.add.l_inv_ex" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              \<exists>y\<in>carrier P.
                 y \<oplus>\<^bsub>P\<^esub> ?x =
                 \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.r_inv_ex" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              \<exists>y\<in>carrier P.
                 ?x \<oplus>\<^bsub>P\<^esub> y =
                 \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.l_inv" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              \<ominus>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub> ?x =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.inv_eq_1_iff" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              (\<ominus>\<^bsub>P\<^esub> ?x = \<zero>\<^bsub>P\<^esub>) =
              (?x = \<zero>\<^bsub>P\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "P.add.r_inv" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              ?x \<oplus>\<^bsub>P\<^esub> \<ominus>\<^bsub>P\<^esub> ?x =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.right_cancel" =
      (\<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
               ?z \<in> carrier P\<rbrakk>
              \<Longrightarrow> (?y \<oplus>\<^bsub>P\<^esub> ?x =
                                 ?z \<oplus>\<^bsub>P\<^esub> ?x) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "P.add.inv_inv" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              \<ominus>\<^bsub>P\<^esub> (\<ominus>\<^bsub>P\<^esub> ?x) =
              ?x\<close>)
      ["simp"]
  notes theorem
    "P.add.inv_inj" = \<open>inj_on (a_inv P) (carrier P)\<close>
  notes theorem
    "P.add.inv_mult_group" =
      \<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> \<ominus>\<^bsub>P\<^esub> (?x \<oplus>\<^bsub>P\<^esub>
                     ?y) =
                               \<ominus>\<^bsub>P\<^esub> ?y \<oplus>\<^bsub>P\<^esub>
                               \<ominus>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.add.inv_comm" =
      \<open>\<lbrakk>?x \<oplus>\<^bsub>P\<^esub> ?y =
                      \<zero>\<^bsub>P\<^esub>;
              ?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> ?y \<oplus>\<^bsub>P\<^esub> ?x =
                               \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.add.inv_equality" =
      \<open>\<lbrakk>?y \<oplus>\<^bsub>P\<^esub> ?x =
                      \<zero>\<^bsub>P\<^esub>;
              ?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> \<ominus>\<^bsub>P\<^esub> ?x = ?y\<close>
  notes theorem
    "P.add.inv_solve_left" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P;
              ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> (?a =
                                \<ominus>\<^bsub>P\<^esub> ?b \<oplus>\<^bsub>P\<^esub>
                                ?c) =
                               (?c =
                                ?b \<oplus>\<^bsub>P\<^esub> ?a)\<close>
  notes theorem
    "P.add.inv_solve_left'" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P;
              ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> (\<ominus>\<^bsub>P\<^esub> ?b \<oplus>\<^bsub>P\<^esub>
                                ?c =
                                ?a) =
                               (?c =
                                ?b \<oplus>\<^bsub>P\<^esub> ?a)\<close>
  notes theorem
    "P.add.inv_solve_right" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P;
              ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> (?a =
                                ?b \<oplus>\<^bsub>P\<^esub>
                                \<ominus>\<^bsub>P\<^esub> ?c) =
                               (?b =
                                ?a \<oplus>\<^bsub>P\<^esub> ?c)\<close>
  notes theorem
    "P.add.inv_solve_right'" =
      \<open>\<lbrakk>?a \<in> carrier P; ?b \<in> carrier P;
              ?c \<in> carrier P\<rbrakk>
             \<Longrightarrow> (?b \<oplus>\<^bsub>P\<^esub>
                                \<ominus>\<^bsub>P\<^esub> ?c =
                                ?a) =
                               (?b =
                                ?a \<oplus>\<^bsub>P\<^esub> ?c)\<close>
  notes theorem
    "P.add.nat_pow_inv" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             [?i] \<cdot>\<^bsub>P\<^esub> (\<ominus>\<^bsub>P\<^esub> ?x) =
             \<ominus>\<^bsub>P\<^esub> ([?i] \<cdot>\<^bsub>P\<^esub> ?x)\<close>
  notes theorem
    "P.add.int_pow_one" =
      (\<open>[?z] \<cdot>\<^bsub>P\<^esub> \<zero>\<^bsub>P\<^esub> =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.int_pow_closed" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              [?i] \<cdot>\<^bsub>P\<^esub> ?x \<in> carrier P\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "P.add.int_pow_1" =
      (\<open>?x \<in> carrier P \<Longrightarrow>
              [1] \<cdot>\<^bsub>P\<^esub> ?x = ?x\<close>)
      ["simp"]
  notes theorem
    "P.add.int_pow_neg" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             [(- ?i)] \<cdot>\<^bsub>P\<^esub> ?x =
             \<ominus>\<^bsub>P\<^esub> ([?i] \<cdot>\<^bsub>P\<^esub> ?x)\<close>
  notes theorem
    "P.add.int_pow_neg_int" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             [(- int ?n)] \<cdot>\<^bsub>P\<^esub> ?x =
             \<ominus>\<^bsub>P\<^esub> ([?n] \<cdot>\<^bsub>P\<^esub> ?x)\<close>
  notes theorem
    "P.add.int_pow_mult" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             [(?i + ?j)] \<cdot>\<^bsub>P\<^esub> ?x =
             [?i] \<cdot>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
             [?j] \<cdot>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.add.int_pow_inv" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             [?i] \<cdot>\<^bsub>P\<^esub> (\<ominus>\<^bsub>P\<^esub> ?x) =
             \<ominus>\<^bsub>P\<^esub> ([?i] \<cdot>\<^bsub>P\<^esub> ?x)\<close>
  notes theorem
    "P.add.int_pow_pow" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             [?m] \<cdot>\<^bsub>P\<^esub> ([?n] \<cdot>\<^bsub>P\<^esub> ?x) =
             [(?n * ?m)] \<cdot>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.add.int_pow_diff" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             [(?n - ?m)] \<cdot>\<^bsub>P\<^esub> ?x =
             [?n] \<cdot>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
             \<ominus>\<^bsub>P\<^esub> ([?m] \<cdot>\<^bsub>P\<^esub> ?x)\<close>
  notes theorem
    "P.add.inj_on_multc" =
      \<open>?c \<in> carrier P \<Longrightarrow>
             inj_on (\<lambda>x. x \<oplus>\<^bsub>P\<^esub> ?c)
              (carrier P)\<close>
  notes theorem
    "P.add.inj_on_cmult" =
      \<open>?c \<in> carrier P \<Longrightarrow>
             inj_on ((\<oplus>\<^bsub>P\<^esub>) ?c) (carrier P)\<close>
  notes theorem
    "P.add.int_pow_mult_distrib" =
      \<open>\<lbrakk>?x \<oplus>\<^bsub>P\<^esub> ?y =
                      ?y \<oplus>\<^bsub>P\<^esub> ?x;
              ?x \<in> carrier P; ?y \<in> carrier P\<rbrakk>
             \<Longrightarrow> [?i] \<cdot>\<^bsub>P\<^esub> (?x \<oplus>\<^bsub>P\<^esub>
                        ?y) =
                               [?i] \<cdot>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
                               [?i] \<cdot>\<^bsub>P\<^esub> ?y\<close>
  notes theorem
    "P.add.pow_eq_div2" =
      \<open>\<lbrakk>?x \<in> carrier P;
              [?m] \<cdot>\<^bsub>P\<^esub> ?x =
              [?n] \<cdot>\<^bsub>P\<^esub> ?x\<rbrakk>
             \<Longrightarrow> [(?m - ?n)] \<cdot>\<^bsub>P\<^esub> ?x =
                               \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.add.triv_subgroup" =
      \<open>subgroup {\<zero>\<^bsub>P\<^esub>} (add_monoid P)\<close>
  notes theorem
    "P.add.subgroup_Units" =
      \<open>subgroup ?H (add_monoid P) \<Longrightarrow>
             ?H \<subseteq> Units
                             (add_monoid P
                              \<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "P.add.m_inv_consistent" =
      (\<open>\<lbrakk>subgroup ?H (add_monoid P); ?x \<in> ?H\<rbrakk>
              \<Longrightarrow> inv\<^bsub>add_monoid P\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                                \<ominus>\<^bsub>P\<^esub> ?x\<close>)
      ["simp"]
  notes theorem
    "P.add.int_pow_consistent" =
      \<open>\<lbrakk>subgroup ?H (add_monoid P); ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> [?n] \<cdot>\<^bsub>P\<^esub> ?x =
                               ?x [^]\<^bsub>add_monoid P\<lparr>carrier := ?H\<rparr>\<^esub>
                               ?n\<close>
  notes theorem
    "P.add.one_in_subset" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?H \<noteq> {};
              \<forall>a\<in>?H. \<ominus>\<^bsub>P\<^esub> a \<in> ?H;
              \<forall>a\<in>?H.
                 \<forall>b\<in>?H.
                    a \<oplus>\<^bsub>P\<^esub> b \<in> ?H\<rbrakk>
             \<Longrightarrow> \<zero>\<^bsub>P\<^esub> \<in> ?H\<close>
  notes theorem
    "P.add.subgroupI" =
      \<open>\<lbrakk>?H \<subseteq> carrier P; ?H \<noteq> {};
              \<And>a.
                 a \<in> ?H \<Longrightarrow>
                 \<ominus>\<^bsub>P\<^esub> a \<in> ?H;
              \<And>a b.
                 \<lbrakk>a \<in> ?H; b \<in> ?H\<rbrakk>
                 \<Longrightarrow> a \<oplus>\<^bsub>P\<^esub> b
                                   \<in> ?H\<rbrakk>
             \<Longrightarrow> subgroup ?H (add_monoid P)\<close>
  notes theorem
    "P.add.subgroupE" =
      \<open>subgroup ?H (add_monoid P) \<Longrightarrow>
             ?H \<subseteq> carrier P\<close>
      \<open>subgroup ?H (add_monoid P) \<Longrightarrow>
             ?H \<noteq> {}\<close>
      \<open>\<lbrakk>subgroup ?H (add_monoid P); ?a \<in> ?H\<rbrakk>
             \<Longrightarrow> \<ominus>\<^bsub>P\<^esub> ?a
                               \<in> ?H\<close>
      \<open>\<lbrakk>subgroup ?H (add_monoid P); ?a \<in> ?H;
              ?b \<in> ?H\<rbrakk>
             \<Longrightarrow> ?a \<oplus>\<^bsub>P\<^esub> ?b
                               \<in> ?H\<close>
  notes theorem
    "P.add.submonoid_subgroupI" =
      \<open>\<lbrakk>submonoid ?H (add_monoid P);
              \<And>a.
                 a \<in> ?H \<Longrightarrow>
                 \<ominus>\<^bsub>P\<^esub> a \<in> ?H\<rbrakk>
             \<Longrightarrow> subgroup ?H (add_monoid P)\<close>
  notes theorem
    "P.add.group_incl_imp_subgroup" =
      \<open>\<lbrakk>?H \<subseteq> carrier P;
              Group.group
               (add_monoid P\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> subgroup ?H (add_monoid P)\<close>
  notes theorem
    "P.add.hom_restrict" =
      \<open>\<lbrakk>?h \<in> hom (add_monoid P) ?H;
              \<And>g.
                 g \<in> carrier P \<Longrightarrow> ?h g = ?t g\<rbrakk>
             \<Longrightarrow> ?t \<in> hom (add_monoid P) ?H\<close>
  notes theorem
    "P.add.hom_compose" =
      \<open>\<lbrakk>?h \<in> hom (add_monoid P) ?H;
              ?i \<in> hom ?H ?I\<rbrakk>
             \<Longrightarrow> compose (carrier P) ?i ?h
                               \<in> hom (add_monoid P) ?I\<close>
  notes theorem
    "P.add.restrict_hom_iff" =
      (\<open>((\<lambda>x. if x \<in> carrier P then ?f x else ?g x)
               \<in> hom (add_monoid P) ?H) =
              (?f \<in> hom (add_monoid P) ?H)\<close>)
      ["simp"]
  notes theorem
    "P.add.hom_eq" =
      \<open>\<lbrakk>?f \<in> hom (add_monoid P) ?H;
              \<And>x.
                 x \<in> carrier P \<Longrightarrow> ?f' x = ?f x\<rbrakk>
             \<Longrightarrow> ?f' \<in> hom (add_monoid P) ?H\<close>
  notes theorem
    "P.add.iso_eq" =
      \<open>\<lbrakk>?f \<in> Group.iso (add_monoid P) ?H;
              \<And>x.
                 x \<in> carrier P \<Longrightarrow> ?f' x = ?f x\<rbrakk>
             \<Longrightarrow> ?f' \<in> Group.iso (add_monoid P) ?H\<close>
  notes theorem
    "P.add.iso_set_sym" =
      \<open>?h \<in> Group.iso (add_monoid P) ?H \<Longrightarrow>
             inv_into (carrier P) ?h
             \<in> Group.iso ?H (add_monoid P)\<close>
  notes theorem
    "P.add.iso_sym" =
      \<open>add_monoid P \<cong> ?H \<Longrightarrow>
             ?H \<cong> add_monoid P\<close>
  notes theorem
    "P.add.hom_imp_img_group" =
      \<open>?h \<in> hom (add_monoid P) ?H \<Longrightarrow>
             Group.group
              (?H\<lparr>carrier := ?h ` carrier P,
                    one := ?h \<zero>\<^bsub>P\<^esub>\<rparr>)\<close>
  notes theorem
    "P.add.iso_imp_group" =
      \<open>\<lbrakk>add_monoid P \<cong> ?H; Group.monoid ?H\<rbrakk>
             \<Longrightarrow> Group.group ?H\<close>
  notes theorem
    "P.add.iso_imp_img_group" =
      \<open>?h \<in> Group.iso (add_monoid P) ?H \<Longrightarrow>
             Group.group
              (?H\<lparr>one := ?h \<zero>\<^bsub>P\<^esub>\<rparr>)\<close>
  notes theorem
    "P.add.iso_iff_group_isomorphisms" =
      \<open>(?f \<in> Group.iso (add_monoid P) ?H) =
             (\<exists>g. group_isomorphisms (add_monoid P) ?H ?f g)\<close>
  notes theorem
    "P.add.DirProd_iso_set_trans" =
      \<open>\<lbrakk>?g \<in> Group.iso (add_monoid P) ?G2.0;
              ?h \<in> Group.iso ?H ?I\<rbrakk>
             \<Longrightarrow> (\<lambda>(x, y). (?g x, ?h y))
                               \<in> Group.iso
(add_monoid P \<times>\<times> ?H) (?G2.0 \<times>\<times> ?I)\<close>
  notes theorem
    "P.add.DirProd_iso_trans" =
      \<open>\<lbrakk>add_monoid P \<cong> ?G2.0; ?H \<cong> ?I\<rbrakk>
             \<Longrightarrow> add_monoid P \<times>\<times> ?H \<cong>
                               ?G2.0 \<times>\<times> ?I\<close>
  notes theorem
    "P.add.int_pow_is_hom" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             (\<lambda>k. [k] \<cdot>\<^bsub>P\<^esub> ?x)
             \<in> hom \<lparr>carrier = UNIV, monoid.mult = (+),
                          one = 0\<rparr>
                    (add_monoid P)\<close>
  notes theorem
    "P.add.canonical_inj_is_hom" =
      \<open>subgroup ?H (add_monoid P) \<Longrightarrow>
             group_hom (add_monoid P\<lparr>carrier := ?H\<rparr>)
              (add_monoid P) id\<close>
  notes theorem
    "P.add.group_comm_groupI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier P; y \<in> carrier P\<rbrakk>
                 \<Longrightarrow> x \<oplus>\<^bsub>P\<^esub> y =
                                   y \<oplus>\<^bsub>P\<^esub>
                                   x) \<Longrightarrow>
             comm_group (add_monoid P)\<close>
  notes theorem
    "P.add.incl_subgroup" =
      \<open>\<lbrakk>subgroup ?J (add_monoid P);
              subgroup ?I
               (add_monoid P\<lparr>carrier := ?J\<rparr>)\<rbrakk>
             \<Longrightarrow> subgroup ?I (add_monoid P)\<close>
  notes theorem
    "P.add.subgroup_incl" =
      \<open>\<lbrakk>subgroup ?I (add_monoid P);
              subgroup ?J (add_monoid P); ?I \<subseteq> ?J\<rbrakk>
             \<Longrightarrow> subgroup ?I
                                (add_monoid P
                                 \<lparr>carrier := ?J\<rparr>)\<close>
  notes theorem
    "P.add.subgroups_partial_order" =
      \<open>partial_order
              \<lparr>carrier = {H. subgroup H (add_monoid P)}, eq = (=),
                 le = (\<subseteq>)\<rparr>\<close>
  notes theorem
    "P.add.subgroup_self" =
      \<open>subgroup (carrier P) (add_monoid P)\<close>
  notes theorem
    "P.add.subgroup_imp_group" =
      \<open>subgroup ?H (add_monoid P) \<Longrightarrow>
             Group.group (add_monoid P\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "P.add.subgroup_mult_equality" =
      \<open>\<lbrakk>subgroup ?H (add_monoid P); ?h1.0 \<in> ?H;
              ?h2.0 \<in> ?H\<rbrakk>
             \<Longrightarrow> ?h1.0 \<otimes>\<^bsub>add_monoid P\<lparr>carrier := ?H\<rparr>\<^esub>
                               ?h2.0 =
                               ?h1.0 \<oplus>\<^bsub>P\<^esub> ?h2.0\<close>
  notes theorem
    "P.add.subgroups_Inter" =
      \<open>\<lbrakk>\<And>H.
                         H \<in> ?A \<Longrightarrow>
                         subgroup H (add_monoid P);
              ?A \<noteq> {}\<rbrakk>
             \<Longrightarrow> subgroup (\<Inter> ?A) (add_monoid P)\<close>
  notes theorem
    "P.add.subgroups_Inter_pair" =
      \<open>\<lbrakk>subgroup ?I (add_monoid P);
              subgroup ?J (add_monoid P)\<rbrakk>
             \<Longrightarrow> subgroup (?I \<inter> ?J)
                                (add_monoid P)\<close>
  notes theorem
    "P.add.subgroups_complete_lattice" =
      \<open>complete_lattice
              \<lparr>carrier = {H. subgroup H (add_monoid P)}, eq = (=),
