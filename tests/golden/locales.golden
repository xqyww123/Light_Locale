  notes theorem
    "S.add.associated_refl" =
      (\<open>?a \<in> carrier S \<Longrightarrow>
              ?a \<sim>\<^bsub>add_monoid S\<^esub> ?a\<close>)
      ["simp", "HOL.intro" !]
  notes theorem
    "S.add.associated_sym" =
      (\<open>?a \<sim>\<^bsub>add_monoid S\<^esub> ?b \<Longrightarrow>
              ?b \<sim>\<^bsub>add_monoid S\<^esub> ?a\<close>)
      ["sym"]
  notes theorem
    "S.add.associated_trans" =
      (\<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid S\<^esub> ?b;
               ?b \<sim>\<^bsub>add_monoid S\<^esub> ?c; ?a \<in> carrier S;
