  notes theorem
    "P.add.coset_mult_inv2" =
      \<open>\<lbrakk>?M #>\<^bsub>add_monoid P\<^esub> ?x =
                      ?M #>\<^bsub>add_monoid P\<^esub> ?y;
              ?x \<in> carrier P; ?y \<in> carrier P;
              ?M \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid P\<^esub>
