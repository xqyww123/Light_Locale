  notes theorem
    "core_chain_is_chain" =
      \<open>\<lbrakk>law_restrict ` ?C
                      \<in> Chains (relation_of (\<lesssim>) \<S>);
              ?R \<in> ?C; ?S \<in> ?C\<rbrakk>
             \<Longrightarrow> ?R \<lesssim> ?S \<or>
                               ?S \<lesssim> ?R\<close>
  notes theorem
    "indexed_const_eq_iff" =
      (\<open>(indexed_const ?x = indexed_const ?y) = (?x = ?y)\<close>)
      ["simp"]
  notes theorem
    "ideal_prod_in_carrier" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R\<rbrakk>
             \<Longrightarrow> ?I \<cdot> ?J \<subseteq> carrier R\<close>
  notes theorem
    "ideal_prod_inter" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R\<rbrakk>
             \<Longrightarrow> ?I \<cdot> ?J
                               \<subseteq> ?I \<inter> ?J\<close>
  notes theorem
    "ideal_prod_is_ideal" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R\<rbrakk>
             \<Longrightarrow> ideal (?I \<cdot> ?J) R\<close>
  notes theorem
    "ideal_prod_eq_genideal" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R\<rbrakk>
             \<Longrightarrow> ?I \<cdot> ?J = Idl (?I <#> ?J)\<close>
  notes theorem
    "ideal_prod_simp" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R\<rbrakk>
             \<Longrightarrow> ?I = ?I <+> ?I \<cdot> ?J\<close>
  notes theorem
    "ideal_prod_one" =
      \<open>ideal ?I R \<Longrightarrow> ?I \<cdot> carrier R = ?I\<close>
  notes theorem
    "ideal_prod_zero" =
      \<open>ideal ?I R \<Longrightarrow>
             ?I \<cdot> {\<zero>} = {\<zero>}\<close>
  notes theorem
    "ideal_prod_assoc" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R; ideal ?K R\<rbrakk>
             \<Longrightarrow> ?I \<cdot> ?J \<cdot> ?K =
                               ?I \<cdot> (?J \<cdot> ?K)\<close>
  notes theorem
    "ideal_prod_r_distr" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R; ideal ?K R\<rbrakk>
             \<Longrightarrow> ?I \<cdot> (?J <+> ?K) =
                               ?I \<cdot> ?J <+> ?I \<cdot> ?K\<close>
  notes theorem
    "primeideal_divides_ideal_prod" =
      \<open>\<lbrakk>primeideal ?P R; ideal ?I R; ideal ?J R;
              ?I \<cdot> ?J \<subseteq> ?P\<rbrakk>
             \<Longrightarrow> ?I \<subseteq> ?P \<or>
                               ?J \<subseteq> ?P\<close>
  notes (\<open>TERM _\<close>) ["attribute" "declaration"]
  notes (\<open>TERM _\<close>) ["attribute" "declaration"]
  notes
    "canonical_proj_ext_def" =
      (\<open>canonical_proj_ext ?I ?n =
              (\<lambda>a.
                  map (\<lambda>i. ?I i +> a) [0..<Suc ?n])\<close>)
      ["attribute" "internal"]
  notes (\<open>TERM _\<close>) ["attribute" "declaration"]
  notes theorem
    "canonical_proj_is_surj" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R; ?I <+> ?J = carrier R\<rbrakk>
             \<Longrightarrow> canonical_proj ?I ?J ` carrier R =
                               carrier
                                (RDirProd (R Quot ?I) (R Quot ?J))\<close>
  notes theorem
    "canonical_proj_ker" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R\<rbrakk>
             \<Longrightarrow> a_kernel R (RDirProd (R Quot ?I) (R Quot ?J))
                                (canonical_proj ?I ?J) =
                               ?I \<inter> ?J\<close>
  notes theorem
    "canonical_proj_is_hom" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R\<rbrakk>
             \<Longrightarrow> canonical_proj ?I ?J
                               \<in> ring_hom R
(RDirProd (R Quot ?I) (R Quot ?J))\<close>
  notes theorem
    "canonical_proj_ring_hom" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R\<rbrakk>
             \<Longrightarrow> ring_hom_ring R
                                (RDirProd (R Quot ?I) (R Quot ?J))
                                (canonical_proj ?I ?J)\<close>
  notes theorem
    "chinese_remainder_simple" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R; ?I <+> ?J = carrier R\<rbrakk>
             \<Longrightarrow> R Quot ?I \<inter> ?J \<simeq>
                               RDirProd (R Quot ?I) (R Quot ?J)\<close>
  notes theorem
    "canonical_proj_ext_zero" =
      (\<open>canonical_proj_ext ?I 0 = (\<lambda>a. [?I 0 +> a])\<close>)
      ["simp"]
  notes theorem
    "canonical_proj_ext_tl" =
      \<open>canonical_proj_ext ?I (Suc ?n) =
             (\<lambda>a.
                 (?I 0 +> a) #
                 canonical_proj_ext (\<lambda>i. ?I (Suc i)) ?n a)\<close>
  notes theorem
    "canonical_proj_ext_is_hom" =
      \<open>(\<And>i.
                 i \<le> ?n \<Longrightarrow>
                 ideal (?I i) R) \<Longrightarrow>
             canonical_proj_ext ?I ?n
             \<in> ring_hom R
                    (RDirProd_list
                      (map (\<lambda>i. R Quot ?I i) [0..<Suc ?n]))\<close>
  notes theorem
    "RDirProd_Quot_list_is_ring" =
      \<open>(\<And>i.
                 i \<le> ?n \<Longrightarrow>
                 ideal (?I i) R) \<Longrightarrow>
             ring
              (RDirProd_list
                (map (\<lambda>i. R Quot ?I i) [0..<Suc ?n]))\<close>
  notes theorem
    "canonical_proj_ext_ring_hom" =
      \<open>(\<And>i.
                 i \<le> ?n \<Longrightarrow>
                 ideal (?I i) R) \<Longrightarrow>
             ring_hom_ring R
              (RDirProd_list (map (\<lambda>i. R Quot ?I i) [0..<Suc ?n]))
              (canonical_proj_ext ?I ?n)\<close>
  notes theorem
    "canonical_proj_ext_ker" =
      \<open>(\<And>i.
                 i \<le> ?n \<Longrightarrow>
                 ideal (?I i) R) \<Longrightarrow>
             a_kernel R
              (RDirProd_list (map (\<lambda>i. R Quot ?I i) [0..<Suc ?n]))
              (canonical_proj_ext ?I ?n) =
             \<Inter> (?I ` {..?n})\<close>
  notes theorem
    "generate_ring_in_carrier" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              ?h \<in> generate_ring R ?H\<rbrakk>
             \<Longrightarrow> ?h \<in> carrier R\<close>
  notes theorem
    "generate_ring_incl" =
      \<open>?H \<subseteq> carrier R \<Longrightarrow>
             generate_ring R ?H \<subseteq> carrier R\<close>
  notes theorem
    "zero_in_generate" = \<open>\<zero> \<in> generate_ring R ?H\<close>
  notes theorem
    "generate_ring_is_subring" =
      \<open>?H \<subseteq> carrier R \<Longrightarrow>
             subring (generate_ring R ?H) R\<close>
  notes theorem
    "generate_ring_is_ring" =
      \<open>?H \<subseteq> carrier R \<Longrightarrow>
             ring (R\<lparr>carrier := generate_ring R ?H\<rparr>)\<close>
  notes theorem
    "generate_ring_min_subring1" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; subring ?E R;
              ?H \<subseteq> ?E\<rbrakk>
             \<Longrightarrow> generate_ring R ?H \<subseteq> ?E\<close>
  notes theorem
    "generate_ringI" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; subring ?E R;
              ?H \<subseteq> ?E;
              \<And>K.
                 \<lbrakk>subring K R; ?H \<subseteq> K\<rbrakk>
                 \<Longrightarrow> ?E \<subseteq> K\<rbrakk>
             \<Longrightarrow> ?E = generate_ring R ?H\<close>
  notes theorem
    "generate_ringE" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              ?E = generate_ring R ?H\<rbrakk>
             \<Longrightarrow> subring ?E R\<close>
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              ?E = generate_ring R ?H\<rbrakk>
             \<Longrightarrow> ?H \<subseteq> ?E\<close>
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?E = generate_ring R ?H;
              subring ?K R; ?H \<subseteq> ?K\<rbrakk>
             \<Longrightarrow> ?E \<subseteq> ?K\<close>
  notes theorem
    "generate_ring_min_subring2" =
      \<open>?H \<subseteq> carrier R \<Longrightarrow>
             generate_ring R ?H =
             \<Inter> {K. subring K R \<and> ?H \<subseteq> K}\<close>
  notes theorem
    "mono_generate_ring" =
      \<open>\<lbrakk>?I \<subseteq> ?J; ?J \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> generate_ring R ?I
                               \<subseteq> generate_ring R ?J\<close>
  notes theorem
    "subring_gen_incl" =
      \<open>\<lbrakk>subring ?H R; subring ?K R; ?I \<subseteq> ?H;
              ?I \<subseteq> ?K\<rbrakk>
             \<Longrightarrow> generate_ring
                                (R\<lparr>carrier := ?K\<rparr>) ?I
                               \<subseteq> generate_ring
      (R\<lparr>carrier := ?H\<rparr>) ?I\<close>
  notes theorem
    "subring_gen_equality" =
      \<open>\<lbrakk>subring ?H R; ?K \<subseteq> ?H\<rbrakk>
             \<Longrightarrow> generate_ring R ?K =
                               generate_ring
                                (R\<lparr>carrier := ?H\<rparr>) ?K\<close>
locale UP_pre_univ_prop
  fixes R :: "('a, 'b) ring_scheme"  (structure)
    and S :: "('c, 'd) ring_scheme"  (structure)
    and h :: "'a \<Rightarrow> 'c"
    and P :: "('a, nat \<Rightarrow> 'a) up_ring"  (structure)
  assumes "UP_pre_univ_prop R S h"
  defines "P \<equiv> UP R"
  notes
    "R.add.monoid_axioms" = (\<open>Group.monoid (add_monoid R)\<close>)
      ["attribute" "internal"]
  notes
    "R.add.m_closed" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<oplus> ?y \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes
    "R.add.m_assoc" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?z \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?y \<oplus> ?z =
                               ?x \<oplus> (?y \<oplus> ?z)\<close>
  notes
    "R.add.one_closed" = (\<open>\<zero> \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes
    "R.add.l_one" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<zero> \<oplus> ?x = ?x\<close>)
      ["simp"]
  notes
    "R.add.r_one" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              ?x \<oplus> \<zero> = ?x\<close>)
      ["simp"]
  notes theorem
    "R.add.Units_closed" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              ?x \<in> carrier R\<close>)
      ["HOL.dest"]
  notes theorem
    "R.add.one_unique" =
      \<open>\<lbrakk>?u \<in> carrier R;
              \<And>x.
                 x \<in> carrier R \<Longrightarrow>
                 ?u \<oplus> x = x\<rbrakk>
             \<Longrightarrow> ?u = \<zero>\<close>
  notes theorem
    "R.add.inv_unique" =
      \<open>\<lbrakk>?y \<oplus> ?x = \<zero>; ?x \<oplus> ?y' = \<zero>;
              ?x \<in> carrier R; ?y \<in> carrier R;
              ?y' \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "R.add.Units_m_closed" =
      (\<open>\<lbrakk>?x \<in> Units (add_monoid R);
               ?y \<in> Units (add_monoid R)\<rbrakk>
              \<Longrightarrow> ?x \<oplus> ?y
                                \<in> Units (add_monoid R)\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "R.add.Units_one_closed" =
      (\<open>\<zero> \<in> Units (add_monoid R)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "R.add.Units_inv_closed" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              inv\<^bsub>add_monoid R\<^esub> ?x \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "R.add.Units_l_inv_ex" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             \<exists>y\<in>carrier R. y \<oplus> ?x = \<zero>\<close>
  notes theorem
    "R.add.Units_r_inv_ex" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             \<exists>y\<in>carrier R. ?x \<oplus> y = \<zero>\<close>
  notes theorem
    "R.add.Units_l_inv" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              inv\<^bsub>add_monoid R\<^esub> ?x \<oplus> ?x =
              \<zero>\<close>)
      ["simp"]
  notes theorem
    "R.add.Units_r_inv" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              ?x \<oplus> inv\<^bsub>add_monoid R\<^esub> ?x =
              \<zero>\<close>)
      ["simp"]
  notes theorem
    "R.add.inv_one" =
      (\<open>inv\<^bsub>add_monoid R\<^esub> \<zero> = \<zero>\<close>)
      ["simp"]
  notes theorem
    "R.add.Units_inv_Units" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              inv\<^bsub>add_monoid R\<^esub> ?x
              \<in> Units (add_monoid R)\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "R.add.Units_l_cancel" =
      (\<open>\<lbrakk>?x \<in> Units (add_monoid R); ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x \<oplus> ?y = ?x \<oplus> ?z) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "R.add.Units_inv_inv" =
      (\<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
              inv\<^bsub>add_monoid R\<^esub> (inv\<^bsub>add_monoid R\<^esub> ?x) =
              ?x\<close>)
      ["simp"]
  notes theorem
    "R.add.inv_inj_on_Units" =
      \<open>inj_on (m_inv (add_monoid R)) (Units (add_monoid R))\<close>
  notes theorem
    "R.add.Units_inv_comm" =
      \<open>\<lbrakk>?x \<oplus> ?y = \<zero>;
              ?x \<in> Units (add_monoid R);
              ?y \<in> Units (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?y \<oplus> ?x = \<zero>\<close>
  notes theorem
    "R.add.carrier_not_empty" = \<open>carrier R \<noteq> {}\<close>
  notes theorem
    "R.add.group_l_invI" =
      \<open>(\<And>x.
                 x \<in> carrier R \<Longrightarrow>
                 \<exists>y\<in>carrier R.
                    y \<oplus> x = \<zero>) \<Longrightarrow>
             Group.group (add_monoid R)\<close>
  notes theorem
    "R.add.nat_pow_closed" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              [?n] \<cdot> ?x \<in> carrier R\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "R.add.nat_pow_0" = (\<open>[0] \<cdot> ?x = \<zero>\<close>) ["simp"]
  notes theorem
    "R.add.nat_pow_Suc" =
      (\<open>[Suc ?n] \<cdot> ?x = [?n] \<cdot> ?x \<oplus> ?x\<close>)
      ["simp"]
  notes theorem
    "R.add.nat_pow_one" = (\<open>[?n] \<cdot> \<zero> = \<zero>\<close>)
      ["simp"]
  notes theorem
    "R.add.nat_pow_mult" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?n] \<cdot> ?x \<oplus> [?m] \<cdot> ?x =
             [(?n + ?m)] \<cdot> ?x\<close>
  notes theorem
    "R.add.nat_pow_comm" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?n] \<cdot> ?x \<oplus> [?m] \<cdot> ?x =
             [?m] \<cdot> ?x \<oplus> [?n] \<cdot> ?x\<close>
  notes theorem
    "R.add.nat_pow_Suc2" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [Suc ?n] \<cdot> ?x = ?x \<oplus> [?n] \<cdot> ?x\<close>
  notes theorem
    "R.add.nat_pow_pow" =
      \<open>?x \<in> carrier R \<Longrightarrow>
             [?m] \<cdot> ([?n] \<cdot> ?x) = [(?n * ?m)] \<cdot> ?x\<close>
  notes theorem
    "R.add.nat_pow_consistent" =
      \<open>[?n] \<cdot> ?x =
             ?x [^]\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub>
             ?n\<close>
  notes theorem
    "R.add.group_commutes_pow" =
      \<open>\<lbrakk>?x \<oplus> ?y = ?y \<oplus> ?x; ?x \<in> carrier R;
              ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> [?n] \<cdot> ?x \<oplus> ?y =
                               ?y \<oplus> [?n] \<cdot> ?x\<close>
  notes theorem
    "R.add.pow_mult_distrib" =
      \<open>\<lbrakk>?x \<oplus> ?y = ?y \<oplus> ?x; ?x \<in> carrier R;
              ?y \<in> carrier R\<rbrakk>
             \<Longrightarrow> [?n] \<cdot> (?x \<oplus> ?y) =
                               [?n] \<cdot> ?x \<oplus>
                               [?n] \<cdot> ?y\<close>
  notes theorem
    "R.add.monoid_incl_imp_submonoid" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              Group.monoid
               (add_monoid R\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> submonoid ?H (add_monoid R)\<close>
  notes theorem
    "R.add.inv_unique'" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?x \<oplus> ?y = \<zero>; ?y \<oplus> ?x = \<zero>\<rbrakk>
             \<Longrightarrow> ?y =
                               inv\<^bsub>add_monoid R\<^esub> ?x\<close>
  notes theorem
    "R.add.m_inv_monoid_consistent" =
      \<open>\<lbrakk>?x \<in> Units
                                (add_monoid R\<lparr>carrier := ?H\<rparr>);
              submonoid ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                               inv\<^bsub>add_monoid R\<^esub> ?x\<close>
  notes theorem
    "R.add.hom_imp_img_monoid" =
      \<open>?h \<in> hom (add_monoid R) ?H \<Longrightarrow>
             Group.monoid
              (?H\<lparr>carrier := ?h ` carrier R,
                    one := ?h \<zero>\<rparr>)\<close>
  notes theorem
    "R.add.monoid_comm_monoidI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier R; y \<in> carrier R\<rbrakk>
                 \<Longrightarrow> x \<oplus> y =
                                   y \<oplus> x) \<Longrightarrow>
             Group.comm_monoid (add_monoid R)\<close>
  notes theorem
    "R.add.units_group" =
      \<open>Group.group (units_of (add_monoid R))\<close>
  notes theorem
    "R.add.units_of_inv" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             inv\<^bsub>units_of (add_monoid R)\<^esub> ?x =
             inv\<^bsub>add_monoid R\<^esub> ?x\<close>
  notes theorem
    "R.add.set_mult_closed" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              ?K \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid R\<^esub> ?K
                               \<subseteq> carrier R\<close>
  notes theorem
    "R.add.r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid R\<^esub> ?x
                               \<subseteq> carrier R\<close>
  notes theorem
    "R.add.order_gt_0_iff_finite" =
      \<open>(0 < Coset.order (add_monoid R)) = finite (carrier R)\<close>
  notes theorem
    "R.add.units_of_pow" =
      \<open>?x \<in> Units (add_monoid R) \<Longrightarrow>
             ?x [^]\<^bsub>units_of (add_monoid R)\<^esub> ?n =
             [?n] \<cdot> ?x\<close>
  notes theorem
    "R.add.inv_char" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?x \<oplus> ?y = \<zero>; ?y \<oplus> ?x = \<zero>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid R\<^esub> ?x =
                               ?y\<close>
  notes theorem
    "R.add.inv_eq_imp_eq" =
      (\<open>\<lbrakk>inv\<^bsub>add_monoid R\<^esub> ?x =
