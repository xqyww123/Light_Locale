  notes theorem
    "S.add.hom_imp_img_comm_group" =
      \<open>?h \<in> hom (add_monoid S) ?H \<Longrightarrow>
             comm_group
              (?H\<lparr>carrier := ?h ` carrier S,
                    one := ?h \<zero>\<^bsub>S\<^esub>\<rparr>)\<close>
  notes theorem
    "S.add.iso_imp_img_comm_group" =
