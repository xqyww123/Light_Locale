              ?x =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.Units_r_inv" =
      (\<open>?x \<in> Units (add_monoid P) \<Longrightarrow>
              ?x \<oplus>\<^bsub>P\<^esub>
              inv\<^bsub>add_monoid P\<^esub> ?x =
              \<zero>\<^bsub>P\<^esub>\<close>)
      ["simp"]
  notes theorem
    "P.add.inv_one" =
      (\<open>inv\<^bsub>add_monoid P\<^esub> \<zero>\<^bsub>P\<^esub> =
