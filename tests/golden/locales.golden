                               ?a' \<otimes> ?b\<close>
  notes theorem
    "R.Units_cong" =
      \<open>\<lbrakk>?a \<in> Units R; ?a \<sim> ?b;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?b \<in> Units R\<close>
  notes theorem
    "R.Units_Lower" =
      \<open>Units R = Lower (division_rel R) (carrier R)\<close>
  notes theorem
    "R.properfactor_prod_l" =
      \<open>\<lbrakk>properfactor R ?a ?b; ?a \<in> carrier R;
              ?b \<in> carrier R; ?c \<in> carrier R\<rbrakk>
             \<Longrightarrow> properfactor R ?a (?c \<otimes> ?b)\<close>
  notes theorem
    "R.irreducible_prod_lI" =
      \<open>\<lbrakk>Divisibility.irreducible R ?b; ?a \<in> Units R;
              ?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible R
                                (?a \<otimes> ?b)\<close>
  notes theorem
    "R.multlist_dividesI" =
      \<open>\<lbrakk>?f \<in> set ?fs;
              set ?fs \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?f divides
                               foldr (\<otimes>) ?fs \<one>\<close>
  notes theorem
    "R.multlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> foldr (\<otimes>) ?as \<one> =
                               foldr (\<otimes>) ?bs \<one>\<close>
  notes theorem
    "R.wfactors_perm_cong_l" =
      \<open>\<lbrakk>wfactors R ?fs ?a; mset ?fs = mset ?fs';
              set ?fs \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> wfactors R ?fs' ?a\<close>
  notes theorem
    "R.perm_wfactorsD" =
      \<open>\<lbrakk>mset ?as = mset ?bs; wfactors R ?as ?a;
              wfactors R ?bs ?b; ?a \<in> carrier R; ?b \<in> carrier R;
              set ?as \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "R.factors_dividesI" =
      \<open>\<lbrakk>factors R ?fs ?a; ?f \<in> set ?fs;
              set ?fs \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?f divides ?a\<close>
  notes theorem
    "R.wfactors_dividesI" =
      \<open>\<lbrakk>wfactors R ?fs ?a; set ?fs \<subseteq> carrier R;
              ?a \<in> carrier R; ?f \<in> set ?fs\<rbrakk>
             \<Longrightarrow> ?f divides ?a\<close>
  notes theorem
    "R.assocs_assoc" =
      \<open>\<lbrakk>?a \<in> assocs R ?b; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "R.assocs_eqD" =
      \<open>\<lbrakk>assocs R ?b = assocs R ?a; ?a \<in> carrier R;
              ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b\<close>
  notes theorem
    "R.gfinprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier R \<Longrightarrow>
              gfinprod R ?f ?A \<in> carrier R\<close>)
      ["simp"]
  notes theorem
    "R.gfinprod_cong" =
      \<open>\<lbrakk>?A = ?B; ?f \<in> ?B \<rightarrow> carrier R;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> gfinprod R ?f ?A = gfinprod R ?g ?B\<close>
  notes theorem
    "R.gfinprod_eq_finprod" =
      (\<open>\<lbrakk>finite ?A;
               ?f \<in> ?A \<rightarrow> carrier R\<rbrakk>
              \<Longrightarrow> gfinprod R ?f ?A = finprod R ?f ?A\<close>)
      ["simp"]
  notes theorem
    "R.gfinprod_insert" =
      (\<open>\<lbrakk>finite {x \<in> ?A. ?f x \<noteq> \<one>};
               ?f \<in> ?A \<rightarrow> carrier R;
               ?f ?i \<in> carrier R\<rbrakk>
              \<Longrightarrow> gfinprod R ?f (insert ?i ?A) =
                                (if ?i \<in> ?A then gfinprod R ?f ?A
                                 else ?f ?i \<otimes>
gfinprod R ?f ?A)\<close>)
      ["simp"]
  notes theorem
    "R.gfinprod_distrib" =
      \<open>\<lbrakk>finite {x \<in> ?A. ?f x \<noteq> \<one>};
              finite {x \<in> ?A. ?g x \<noteq> \<one>};
              ?f \<in> ?A \<rightarrow> carrier R;
              ?g \<in> ?A \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> gfinprod R (\<lambda>i. ?f i \<otimes> ?g i)
                                ?A =
                               gfinprod R ?f ?A \<otimes>
                               gfinprod R ?g ?A\<close>
  notes theorem
    "R.gfinprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<one>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> gfinprod R ?g ?A = gfinprod R ?h ?B\<close>
  notes theorem
    "R.gfinprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?g i = \<one>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> gfinprod R ?g ?B = gfinprod R ?h ?A\<close>
  notes theorem
    "R.gfinprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i. i \<in> ?B - ?A \<Longrightarrow> ?h i = \<one>;
              \<And>i. i \<in> ?A - ?B \<Longrightarrow> ?g i = \<one>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier R;
              ?h \<in> ?B \<rightarrow> carrier R\<rbrakk>
             \<Longrightarrow> gfinprod R ?g ?A = gfinprod R ?h ?B\<close>
  notes "R.cring_axioms" = (\<open>cring R\<close>) ["attribute" "internal"]
  notes theorem "R.is_cring" = \<open>cring R\<close>
  notes theorem
    (\<open>PROP ?psi \<Longrightarrow> PROP ?psi\<close>)
      ["Ring.algebra" del : ring \<zero> (\<oplus>) a_inv R a_minus R \<one>
         (\<otimes>)]
  notes theorem
    "R.cring_simprules" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<oplus> ?y \<in> carrier R\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<zero> \<in> carrier R\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<ominus> ?x \<in> carrier R\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<ominus> ?y \<in> carrier R\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<otimes> ?y \<in> carrier R\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<one> \<in> carrier R\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<oplus> ?y \<oplus> ?z =
                                ?x \<oplus> (?y \<oplus> ?z)\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<zero> \<oplus> ?x = ?x\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<ominus> ?x \<oplus> ?x = \<zero>\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<oplus> ?y = ?y \<oplus> ?x\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<otimes> ?y \<otimes> ?z =
                                ?x \<otimes> (?y \<otimes> ?z)\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<one> \<otimes> ?x = ?x\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x \<oplus> ?y) \<otimes> ?z =
                                ?x \<otimes> ?z \<oplus>
                                ?y \<otimes> ?z\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<otimes> ?y = ?y \<otimes> ?x\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<ominus> ?y = ?x \<oplus> \<ominus> ?y\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<in> carrier R \<Longrightarrow>
              ?x \<oplus> \<zero> = ?x\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<in> carrier R \<Longrightarrow>
              ?x \<oplus> \<ominus> ?x = \<zero>\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<oplus> (\<ominus> ?x \<oplus> ?y) =
                                ?y\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> \<ominus> ?x \<oplus> (?x \<oplus> ?y) =
                                ?y\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> \<ominus> (?x \<oplus> ?y) =
                                \<ominus> ?x \<oplus> \<ominus> ?y\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<ominus> (\<ominus> ?x) = ?x\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<ominus> \<zero> = \<zero>\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<oplus> (?y \<oplus> ?z) =
                                ?y \<oplus> (?x \<oplus> ?z)\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<otimes> (?y \<otimes> ?z) =
                                ?y \<otimes> (?x \<otimes> ?z)\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
               ?z \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?z \<otimes> (?x \<oplus> ?y) =
                                ?z \<otimes> ?x \<oplus>
                                ?z \<otimes> ?y\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<in> carrier R \<Longrightarrow>
              \<zero> \<otimes> ?x = \<zero>\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>?x \<in> carrier R \<Longrightarrow>
              ?x \<otimes> \<zero> = \<zero>\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> \<ominus> ?x \<otimes> ?y =
                                \<ominus> (?x \<otimes> ?y)\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
      (\<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R\<rbrakk>
              \<Longrightarrow> ?x \<otimes> \<ominus> ?y =
                                \<ominus> (?x \<otimes> ?y)\<close>)
      ["Ring.algebra" add : cring \<zero> (\<oplus>) a_inv R a_minus R
         \<one> (\<otimes>)]
  notes theorem
    "R.cring_fieldI" =
      \<open>Units R = carrier R - {\<zero>} \<Longrightarrow>
             field R\<close>
  notes theorem
    "R.cring_fieldI2" =
      \<open>\<lbrakk>\<zero> \<noteq> \<one>;
              \<And>a.
                 \<lbrakk>a \<in> carrier R; a \<noteq> \<zero>\<rbrakk>
                 \<Longrightarrow> \<exists>b\<in>carrier R.
a \<otimes> b = \<one>\<rbrakk>
             \<Longrightarrow> field R\<close>
  notes theorem
    "R.sum_zero_eq_neg" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?x \<oplus> ?y = \<zero>\<rbrakk>
             \<Longrightarrow> ?x = \<ominus> ?y\<close>
  notes theorem
    "R.units_power_order_eq_one" =
      \<open>\<lbrakk>finite (Units R); ?a \<in> Units R\<rbrakk>
             \<Longrightarrow> ?a [^] card (Units R) = \<one>\<close>
  notes theorem
    "R.field_intro2" =
      \<open>\<lbrakk>\<zero> \<noteq> \<one>;
              \<And>x.
                 x \<in> carrier R - {\<zero>} \<Longrightarrow>
                 x \<in> Units R\<rbrakk>
             \<Longrightarrow> field R\<close>
  notes theorem
    "R.cgenideal_ideal" =
      \<open>?a \<in> carrier R \<Longrightarrow> ideal (PIdl ?a) R\<close>
  notes theorem
    "R.cgenideal_eq_genideal" =
      \<open>?i \<in> carrier R \<Longrightarrow> PIdl ?i = Idl {?i}\<close>
  notes theorem
    "R.cgenideal_eq_rcos" = \<open>PIdl ?i = carrier R #> ?i\<close>
  notes theorem
    "R.cgenideal_is_principalideal" =
      \<open>?i \<in> carrier R \<Longrightarrow>
             principalideal (PIdl ?i) R\<close>
  notes theorem
    "R.cgenideal_prod" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> PIdl ?a <#> PIdl ?b =
                               PIdl (?a \<otimes> ?b)\<close>
  notes theorem
    "R.zeroprimeideal_domainI" =
      \<open>primeideal {\<zero>} R \<Longrightarrow> domain R\<close>
  notes theorem
    "R.domain_eq_zeroprimeideal" =
      \<open>domain R = primeideal {\<zero>} R\<close>
  notes theorem
    "R.maximalideal_prime" =
      \<open>maximalideal ?I R \<Longrightarrow> primeideal ?I R\<close>
  notes theorem
    "R.trivialideals_fieldI" =
      \<open>\<lbrakk>carrier R \<noteq> {\<zero>};
              {I. ideal I R} = {{\<zero>}, carrier R}\<rbrakk>
             \<Longrightarrow> field R\<close>
  notes theorem
    "R.trivialideals_eq_field" =
      \<open>carrier R \<noteq> {\<zero>} \<Longrightarrow>
             ({I. ideal I R} = {{\<zero>}, carrier R}) = field R\<close>
  notes theorem
    "R.zeromaximalideal_fieldI" =
      \<open>maximalideal {\<zero>} R \<Longrightarrow> field R\<close>
  notes theorem
    "R.zeromaximalideal_eq_field" =
      \<open>maximalideal {\<zero>} R = field R\<close>
  notes theorem
    "R.quot_domain_imp_primeideal" =
      \<open>\<lbrakk>ideal ?P R; domain (R Quot ?P)\<rbrakk>
             \<Longrightarrow> primeideal ?P R\<close>
  notes theorem
    "R.quot_domain_iff_primeideal" =
      \<open>ideal ?P R \<Longrightarrow>
             domain (R Quot ?P) = primeideal ?P R\<close>
  notes theorem
    "R.ring_iso_imp_img_cring" =
      \<open>?h \<in> ring_iso R ?S \<Longrightarrow>
             cring (?S\<lparr>zero := ?h \<zero>\<rparr>)\<close>
  notes theorem
    "R.divides_one" =
      \<open>?a \<in> carrier R \<Longrightarrow>
             ?a divides \<one> = (?a \<in> Units R)\<close>
  notes theorem
    "R.to_contain_is_to_divide" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> (PIdl ?b \<subseteq> PIdl ?a) =
                               ?a divides ?b\<close>
  notes theorem
    "R.associated_iff_same_ideal" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?a \<sim> ?b = (PIdl ?a = PIdl ?b)\<close>
  notes theorem
    "R.ideal_eq_carrier_iff" =
      \<open>?a \<in> carrier R \<Longrightarrow>
             (carrier R = PIdl ?a) = (?a \<in> Units R)\<close>
  notes theorem
    "R.subcringI'" =
      \<open>subring ?H R \<Longrightarrow> subcring ?H R\<close>
  notes theorem
    "R.carrier_is_subcring" = \<open>subcring (carrier R) R\<close>
  notes theorem
    "R.eval_poly_mult" =
      \<open>\<lbrakk>set ?p \<subseteq> carrier R;
              set ?q \<subseteq> carrier R; ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> R.eval (R.poly_mult ?p ?q) ?a =
                               R.eval ?p ?a \<otimes> R.eval ?q ?a\<close>
  notes theorem
    "R.eval_is_hom" =
      \<open>\<lbrakk>subring ?K R; ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> (\<lambda>p. R.eval p ?a)
                               \<in> ring_hom (?K [X]) R\<close>
  notes theorem
    "R.const_term_simprules" =
      \<open>set ?p \<subseteq> carrier R \<Longrightarrow>
             R.const_term ?p \<in> carrier R\<close>
      \<open>\<lbrakk>set ?p \<subseteq> carrier R;
              set ?q \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> R.const_term (R.poly_mult ?p ?q) =
                               R.const_term ?p \<otimes>
                               R.const_term ?q\<close>
      \<open>\<lbrakk>set ?p \<subseteq> carrier R;
              set ?q \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> R.const_term (R.poly_add ?p ?q) =
                               R.const_term ?p \<oplus>
                               R.const_term ?q\<close>
  notes theorem
    "R.ideal_prod_commute" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R\<rbrakk>
             \<Longrightarrow> ?I \<cdot> ?J = ?J \<cdot> ?I\<close>
  notes theorem
    "R.ideal_prod_distr" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R; ideal ?K R\<rbrakk>
             \<Longrightarrow> ?I \<cdot> (?J <+> ?K) =
                               ?I \<cdot> ?J <+> ?I \<cdot> ?K\<close>
      \<open>\<lbrakk>ideal ?I R; ideal ?J R; ideal ?K R\<rbrakk>
             \<Longrightarrow> (?J <+> ?K) \<cdot> ?I =
                               ?J \<cdot> ?I <+> ?K \<cdot> ?I\<close>
  notes theorem
    "R.ideal_prod_eq_inter" =
      \<open>\<lbrakk>ideal ?I R; ideal ?J R; ?I <+> ?J = carrier R\<rbrakk>
             \<Longrightarrow> ?I \<cdot> ?J = ?I \<inter> ?J\<close>
  notes theorem
    "R.ideals_set_is_semiring" = \<open>semiring (ideals_set R)\<close>
  notes theorem
    "R.ideals_set_is_comm_monoid" =
      \<open>Group.comm_monoid (ideals_set R)\<close>
  notes theorem
    "R.ideal_prod_eq_Inter_aux" =
      \<open>\<lbrakk>?I \<in> {..Suc ?n} \<rightarrow> {J. ideal J R};
              \<And>i j.
                 \<lbrakk>i \<le> Suc ?n; j \<le> Suc ?n;
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+> ?I j = carrier R\<rbrakk>
             \<Longrightarrow> finprod (ideals_set R) ?I {..?n} <+>
                               ?I (Suc ?n) =
                               carrier R\<close>
  notes theorem
    "R.ideal_prod_eq_Inter" =
      \<open>\<lbrakk>?I \<in> {..?n} \<rightarrow> {J. ideal J R};
              \<And>i j.
                 \<lbrakk>i \<in> {..?n}; j \<in> {..?n};
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+> ?I j = carrier R\<rbrakk>
             \<Longrightarrow> finprod (ideals_set R) ?I {..?n} =
                               \<Inter> (?I ` {..?n})\<close>
  notes theorem
    "R.inter_plus_ideal_eq_carrier" =
      \<open>\<lbrakk>\<And>i.
                         i \<le> Suc ?n \<Longrightarrow> ideal (?I i) R;
              \<And>i j.
                 \<lbrakk>i \<le> Suc ?n; j \<le> Suc ?n;
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+> ?I j = carrier R\<rbrakk>
             \<Longrightarrow> \<Inter> (?I ` {..?n}) <+> ?I (Suc ?n) =
                               carrier R\<close>
  notes theorem
    "R.inter_plus_ideal_eq_carrier_arbitrary" =
      \<open>\<lbrakk>\<And>i.
                         i \<le> Suc ?n \<Longrightarrow> ideal (?I i) R;
              \<And>i j.
                 \<lbrakk>i \<le> Suc ?n; j \<le> Suc ?n;
                  i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+> ?I j = carrier R;
              ?j \<le> Suc ?n\<rbrakk>
             \<Longrightarrow> \<Inter> (?I ` ({..Suc ?n} - {?j})) <+>
                               ?I ?j =
                               carrier R\<close>
  notes theorem
    "R.divides_ideal_prod_imp_primeideal" =
      \<open>\<lbrakk>ideal ?P R; ?P \<noteq> carrier R;
              \<And>I J.
                 \<lbrakk>ideal I R; ideal J R;
                  I \<cdot> J \<subseteq> ?P\<rbrakk>
                 \<Longrightarrow> I \<subseteq> ?P \<or>
                                   J \<subseteq> ?P\<rbrakk>
             \<Longrightarrow> primeideal ?P R\<close>
  notes theorem
    "R.canonical_proj_ext_is_surj" =
      \<open>\<lbrakk>\<And>i. i \<le> ?n \<Longrightarrow> ideal (?I i) R;
              \<And>i j.
                 \<lbrakk>i \<le> ?n; j \<le> ?n; i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+> ?I j = carrier R\<rbrakk>
             \<Longrightarrow> R.canonical_proj_ext ?I ?n ` carrier R =
                               carrier
                                (RDirProd_list
                                  (map (\<lambda>i. R Quot ?I i)
                                    [0..<Suc ?n]))\<close>
  notes theorem
    "R.chinese_remainder" =
      \<open>\<lbrakk>\<And>i. i \<le> ?n \<Longrightarrow> ideal (?I i) R;
              \<And>i j.
                 \<lbrakk>i \<le> ?n; j \<le> ?n; i \<noteq> j\<rbrakk>
                 \<Longrightarrow> ?I i <+> ?I j = carrier R\<rbrakk>
             \<Longrightarrow> R Quot \<Inter> (?I ` {..?n}) \<simeq>
                               RDirProd_list
                                (map (\<lambda>i. R Quot ?I i)
                                  [0..<Suc ?n])\<close>
  notes
    "S.add.monoid_axioms" = (\<open>Group.monoid (add_monoid S)\<close>)
      ["attribute" "internal"]
  notes
    "S.add.m_closed" =
      (\<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub> ?y
                                \<in> carrier S\<close>)
      ["HOL.intro", "simp"]
  notes
    "S.add.m_assoc" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                               ?y \<oplus>\<^bsub>S\<^esub>
                               ?z =
                               ?x \<oplus>\<^bsub>S\<^esub>
                               (?y \<oplus>\<^bsub>S\<^esub> ?z)\<close>
  notes
    "S.add.one_closed" =
      (\<open>\<zero>\<^bsub>S\<^esub> \<in> carrier S\<close>)
      ["HOL.intro", "simp"]
  notes
    "S.add.l_one" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
