             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.Units_are_ones" =
      \<open>Units
              (add_monoid
                S) {.=}\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
             {\<zero>\<^bsub>S\<^esub>}\<close>
  notes theorem
    "S.add.properfactor_unitE" =
      \<open>\<lbrakk>?u \<in> Units (add_monoid S);
              properfactor (add_monoid S) ?a ?u; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "S.add.properfactor_divides" =
      \<open>properfactor (add_monoid S) ?a ?b \<Longrightarrow>
             ?a divides\<^bsub>add_monoid S\<^esub> ?b\<close>
  notes theorem
    "S.add.properfactor_trans1" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid S\<^esub> ?b;
               properfactor (add_monoid S) ?b ?c; ?a \<in> carrier S;
               ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid S) ?a ?c\<close>)
      ["trans"]
  notes theorem
    "S.add.properfactor_trans2" =
      (\<open>\<lbrakk>properfactor (add_monoid S) ?a ?b;
               ?b divides\<^bsub>add_monoid S\<^esub> ?c;
               ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid S) ?a ?c\<close>)
      ["trans"]
  notes theorem
    "S.add.properfactor_cong_l" =
      (\<open>\<lbrakk>?x' \<sim>\<^bsub>add_monoid S\<^esub> ?x;
               properfactor (add_monoid S) ?x ?y; ?x \<in> carrier S;
               ?x' \<in> carrier S; ?y \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid S) ?x' ?y\<close>)
      ["trans"]
  notes theorem
    "S.add.properfactor_cong_r" =
      (\<open>\<lbrakk>properfactor (add_monoid S) ?x ?y;
               ?y \<sim>\<^bsub>add_monoid S\<^esub> ?y';
               ?x \<in> carrier S; ?y \<in> carrier S;
               ?y' \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid S) ?x ?y'\<close>)
      ["trans"]
  notes theorem
    "S.add.properfactor_prod_r" =
      \<open>\<lbrakk>properfactor (add_monoid S) ?a ?b; ?a \<in> carrier S;
              ?b \<in> carrier S; ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> properfactor (add_monoid S) ?a
                                (?b \<oplus>\<^bsub>S\<^esub> ?c)\<close>
  notes theorem
    "S.add.irreducible_prod_rI" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid S) ?a;
              ?b \<in> Units (add_monoid S); ?a \<in> carrier S;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible (add_monoid S)
                                (?a \<oplus>\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.add.listassoc_refl" =
      (\<open>set ?as \<subseteq> carrier S \<Longrightarrow>
              ?as [\<sim>]\<^bsub>add_monoid S\<^esub> ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "S.add.listassoc_sym" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid S\<^esub> ?bs;
               set ?as \<subseteq> carrier S;
               set ?bs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> ?bs [\<sim>]\<^bsub>add_monoid S\<^esub>
                                ?as\<close>)
      ["sym"]
  notes theorem
    "S.add.listassoc_trans" =
      (\<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid S\<^esub> ?bs;
               ?bs [\<sim>]\<^bsub>add_monoid S\<^esub> ?cs;
               set ?as \<subseteq> carrier S; set ?bs \<subseteq> carrier S;
               set ?cs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> ?as [\<sim>]\<^bsub>add_monoid S\<^esub>
                                ?cs\<close>)
      ["trans"]
  notes theorem
    "S.add.perm_assoc_switch" =
      \<open>\<lbrakk>?as [\<sim>]\<^bsub>add_monoid S\<^esub> ?bs;
              mset ?bs = mset ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  mset ?as = mset bs' \<and>
                                  bs' [\<sim>]\<^bsub>add_monoid S\<^esub>
                                  ?cs\<close>
  notes theorem
    "S.add.perm_assoc_switch_r" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              ?bs [\<sim>]\<^bsub>add_monoid S\<^esub> ?cs\<rbrakk>
             \<Longrightarrow> \<exists>bs'.
                                  ?as [\<sim>]\<^bsub>add_monoid S\<^esub>
                                  bs' \<and>
                                  mset bs' = mset ?cs\<close>
  notes theorem
    "S.add.perm_closed" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> set ?bs \<subseteq> carrier S\<close>
  notes theorem
    "S.add.irrlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              \<forall>a\<in>set ?as.
                 Divisibility.irreducible (add_monoid S) a\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible (add_monoid S)
                                   a\<close>
  notes theorem
    "S.add.essentially_equalI" =
      \<open>\<lbrakk>mset ?fs1.0 = mset ?fs1';
              ?fs1' [\<sim>]\<^bsub>add_monoid S\<^esub> ?fs2.0\<rbrakk>
             \<Longrightarrow> essentially_equal (add_monoid S) ?fs1.0
                                ?fs2.0\<close>
  notes theorem
    "S.add.essentially_equalE" =
      \<open>\<lbrakk>essentially_equal (add_monoid S) ?fs1.0 ?fs2.0;
              \<And>fs1'.
                 \<lbrakk>mset ?fs1.0 = mset fs1';
                  fs1' [\<sim>]\<^bsub>add_monoid S\<^esub> ?fs2.0\<rbrakk>
                 \<Longrightarrow> ?P\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "S.add.ee_refl" =
      (\<open>set ?as \<subseteq> carrier S \<Longrightarrow>
              essentially_equal (add_monoid S) ?as ?as\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "S.add.ee_sym" =
      (\<open>\<lbrakk>essentially_equal (add_monoid S) ?as ?bs;
               set ?as \<subseteq> carrier S;
               set ?bs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> essentially_equal (add_monoid S) ?bs
                                 ?as\<close>)
      ["sym"]
  notes theorem
    "S.add.ee_trans" =
      (\<open>\<lbrakk>essentially_equal (add_monoid S) ?as ?bs;
               essentially_equal (add_monoid S) ?bs ?cs;
               set ?as \<subseteq> carrier S; set ?bs \<subseteq> carrier S;
               set ?cs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> essentially_equal (add_monoid S) ?as
                                 ?cs\<close>)
      ["trans"]
  notes theorem
    "S.add.multlist_closed" =
      (\<open>set ?fs \<subseteq> carrier S \<Longrightarrow>
              foldr (\<oplus>\<^bsub>S\<^esub>) ?fs \<zero>\<^bsub>S\<^esub>
              \<in> carrier S\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "S.add.factorsI" =
      \<open>\<lbrakk>\<forall>f\<in>set ?fs.
                         Divisibility.irreducible (add_monoid S) f;
              foldr (\<oplus>\<^bsub>S\<^esub>) ?fs
               \<zero>\<^bsub>S\<^esub> =
              ?a\<rbrakk>
             \<Longrightarrow> factors (add_monoid S) ?fs ?a\<close>
  notes theorem
    "S.add.factors_wfactors" =
      \<open>\<lbrakk>factors (add_monoid S) ?as ?a;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid S) ?as ?a\<close>
  notes theorem
    "S.add.wfactors_factors" =
      \<open>\<lbrakk>wfactors (add_monoid S) ?as ?a;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> \<exists>a'.
                                  factors (add_monoid S) ?as a' \<and>
                                  a' \<sim>\<^bsub>add_monoid S\<^esub>
                                  ?a\<close>
  notes theorem
    "S.add.factors_closed" =
      (\<open>\<lbrakk>factors (add_monoid S) ?fs ?a;
               set ?fs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> ?a \<in> carrier S\<close>)
      ["HOL.dest"]
  notes theorem
    "S.add.nunit_factors" =
      \<open>\<lbrakk>?a \<notin> Units (add_monoid S);
              factors (add_monoid S) ?as ?a\<rbrakk>
             \<Longrightarrow> 0 < length ?as\<close>
  notes theorem
    "S.add.unit_wfactors" =
      (\<open>?a \<in> Units (add_monoid S) \<Longrightarrow>
              wfactors (add_monoid S) [] ?a\<close>)
      ["simp"]
  notes theorem
    "S.add.wfactors_cong_r" =
      (\<open>\<lbrakk>wfactors (add_monoid S) ?fs ?a;
               ?a \<sim>\<^bsub>add_monoid S\<^esub> ?a';
               ?a \<in> carrier S; ?a' \<in> carrier S;
               set ?fs \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> wfactors (add_monoid S) ?fs ?a'\<close>)
      ["trans"]
  notes theorem
    "S.add.wfactors_prod_exists" =
      (\<open>\<lbrakk>\<forall>a\<in>set ?as.
                          Divisibility.irreducible (add_monoid S) a;
               set ?as \<subseteq> carrier S\<rbrakk>
              \<Longrightarrow> \<exists>a.
                                   a \<in> carrier S \<and>
                                   wfactors (add_monoid S) ?as a\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "S.add.factors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid S) ?a;
              factors (add_monoid S) ?fb ?b; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> factors (add_monoid S) (?a # ?fb)
                                (?a \<oplus>\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.add.factors_mult" =
      \<open>\<lbrakk>factors (add_monoid S) ?fa ?a;
              factors (add_monoid S) ?fb ?b; set ?fa \<subseteq> carrier S;
              set ?fb \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> factors (add_monoid S) (?fa @ ?fb)
                                (?a \<oplus>\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.add.assocs_repr_independence" =
      \<open>\<lbrakk>?y \<in> closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                                {?x};
              ?x \<in> carrier S\<rbrakk>
             \<Longrightarrow> closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                                {?x} =
                               closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                                {?y}\<close>
  notes theorem
    "S.add.assocs_self" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             ?x \<in> closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                       {?x}\<close>
  notes theorem
    "S.add.assocs_repr_independenceD" =
      \<open>\<lbrakk>closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                       {?x} =
                      closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                       {?y};
              ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?y \<in> closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
   {?x}\<close>
  notes theorem
    "S.add.fmset_perm_cong" =
      \<open>mset ?as = mset ?bs \<Longrightarrow>
             fmset (add_monoid S) ?as = fmset (add_monoid S) ?bs\<close>
  notes theorem
    "S.add.mset_fmsetEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    ?P x \<and>
                    X =
                    closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                     {x}) \<Longrightarrow>
             \<exists>cs.
                (\<forall>c\<in>set cs. ?P c) \<and>
                fmset (add_monoid S) cs = ?Cs\<close>
  notes theorem
    "S.add.mset_wfactorsEx" =
      \<open>(\<And>X.
                 X \<in># ?Cs \<Longrightarrow>
                 \<exists>x.
                    (x \<in> carrier S \<and>
                     Divisibility.irreducible (add_monoid S) x) \<and>
                    X =
                    closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                     {x}) \<Longrightarrow>
             \<exists>c cs.
                c \<in> carrier S \<and>
                set cs \<subseteq> carrier S \<and>
                wfactors (add_monoid S) cs c \<and>
                fmset (add_monoid S) cs = ?Cs\<close>
  notes theorem
    "S.add.isgcd_divides_l" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid S\<^esub> ?b;
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a gcdof\<^bsub>add_monoid S\<^esub> ?a ?b\<close>
  notes theorem
    "S.add.isgcd_divides_r" =
      \<open>\<lbrakk>?b divides\<^bsub>add_monoid S\<^esub> ?a;
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?b gcdof\<^bsub>add_monoid S\<^esub> ?a ?b\<close>
  notes theorem
    "S.add.assoc_subst" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid S\<^esub> ?b;
              \<forall>a b.
                 a \<in> carrier S \<and>
                 b \<in> carrier S \<and>
                 a \<sim>\<^bsub>add_monoid S\<^esub> b \<longrightarrow>
                 ?f a \<in> carrier S \<and>
                 ?f b \<in> carrier S \<and>
                 ?f a \<sim>\<^bsub>add_monoid S\<^esub> ?f b;
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?f ?a \<sim>\<^bsub>add_monoid S\<^esub>
                               ?f ?b\<close>
  notes theorem
    "S.add.ee_length" =
      \<open>essentially_equal (add_monoid S) ?as ?bs \<Longrightarrow>
             length ?as = length ?bs\<close>
  notes theorem
    "S.add.nat_pow_eone" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              [1] \<cdot>\<^bsub>S\<^esub> ?x = ?x\<close>)
      ["simp"]
  notes theorem
    "S.add.Units_pow_closed" =
      \<open>?x \<in> Units (add_monoid S) \<Longrightarrow>
             [?d] \<cdot>\<^bsub>S\<^esub> ?x
             \<in> Units (add_monoid S)\<close>
  notes
    "S.add.comm_monoid_axioms" =
      (\<open>Group.comm_monoid (add_monoid S)\<close>)
      ["attribute" "internal"]
  notes
    "S.add.m_comm" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub> ?y =
                               ?y \<oplus>\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.add.m_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                               (?y \<oplus>\<^bsub>S\<^esub> ?z) =
                               ?y \<oplus>\<^bsub>S\<^esub>
                               (?x \<oplus>\<^bsub>S\<^esub> ?z)\<close>
  notes theorem
    "S.add.m_ac" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                               ?y \<oplus>\<^bsub>S\<^esub>
                               ?z =
                               ?x \<oplus>\<^bsub>S\<^esub>
                               (?y \<oplus>\<^bsub>S\<^esub> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub> ?y =
                               ?y \<oplus>\<^bsub>S\<^esub> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                               (?y \<oplus>\<^bsub>S\<^esub> ?z) =
                               ?y \<oplus>\<^bsub>S\<^esub>
                               (?x \<oplus>\<^bsub>S\<^esub> ?z)\<close>
  notes theorem
    "S.add.submonoid_is_comm_monoid" =
      \<open>submonoid ?H (add_monoid S) \<Longrightarrow>
             Group.comm_monoid
              (add_monoid S\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "S.add.nat_pow_distrib" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> [?n] \<cdot>\<^bsub>S\<^esub> (?x \<oplus>\<^bsub>S\<^esub>
                        ?y) =
                               [?n] \<cdot>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub>
                               [?n] \<cdot>\<^bsub>S\<^esub> ?y\<close>
  notes theorem
    "S.add.hom_imp_img_comm_monoid" =
      \<open>?h \<in> hom (add_monoid S) ?H \<Longrightarrow>
             Group.comm_monoid
              (?H\<lparr>carrier := ?h ` carrier S,
                    one := ?h \<zero>\<^bsub>S\<^esub>\<rparr>)\<close>
  notes theorem
    "S.add.units_comm_group" =
      \<open>comm_group (units_of (add_monoid S))\<close>
  notes theorem
    "S.add.finprod_empty" =
      (\<open>finsum S ?f {} = \<zero>\<^bsub>S\<^esub>\<close>) ["simp"]
  notes theorem
    "S.add.finprod_infinite" =
      (\<open>infinite ?A \<Longrightarrow>
              finsum S ?f ?A = \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.add.finprod_insert" =
      (\<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
               ?f \<in> ?F \<rightarrow> carrier S;
               ?f ?a \<in> carrier S\<rbrakk>
              \<Longrightarrow> finsum S ?f (insert ?a ?F) =
                                ?f ?a \<oplus>\<^bsub>S\<^esub>
                                finsum S ?f ?F\<close>)
      ["simp"]
  notes theorem
    "S.add.finprod_one_eqI" =
      \<open>(\<And>x.
                 x \<in> ?A \<Longrightarrow>
                 ?f x = \<zero>\<^bsub>S\<^esub>) \<Longrightarrow>
             finsum S ?f ?A = \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.add.finprod_one" =
      (\<open>(\<Oplus>\<^bsub>S\<^esub>i\<in>?A. \<zero>\<^bsub>S\<^esub>) =
              \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.add.finprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier S \<Longrightarrow>
              finsum S ?f ?A \<in> carrier S\<close>)
      ["simp"]
  notes theorem
    "S.add.funcset_Int_left" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> ?C;
               ?f \<in> ?B \<rightarrow> ?C\<rbrakk>
              \<Longrightarrow> ?f \<in> ?A \<inter> ?B \<rightarrow>
   ?C\<close>)
      ["simp", "HOL.intro"]
  notes theorem
    "S.add.funcset_Un_left" =
      (\<open>(?f \<in> ?A \<union> ?B \<rightarrow> ?C) =
              (?f \<in> ?A \<rightarrow> ?C \<and>
               ?f \<in> ?B \<rightarrow> ?C)\<close>)
      ["iff"]
  notes theorem
    "S.add.finprod_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier S;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finsum S ?g
                                (?A \<union> ?B) \<oplus>\<^bsub>S\<^esub>
                               finsum S ?g (?A \<inter> ?B) =
                               finsum S ?g ?A \<oplus>\<^bsub>S\<^esub>
                               finsum S ?g ?B\<close>
  notes theorem
    "S.add.finprod_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier S;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finsum S ?g (?A \<union> ?B) =
                               finsum S ?g ?A \<oplus>\<^bsub>S\<^esub>
                               finsum S ?g ?B\<close>
  notes theorem
    "S.add.finprod_multf" =
      (\<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier S;
               ?g \<in> ?A \<rightarrow> carrier S\<rbrakk>
              \<Longrightarrow> (\<Oplus>\<^bsub>S\<^esub>x\<in>?A. ?f
                               x \<oplus>\<^bsub>S\<^esub>
                              ?g x) =
                                finsum S ?f ?A \<oplus>\<^bsub>S\<^esub>
                                finsum S ?g ?A\<close>)
      ["simp"]
  notes theorem
    "S.add.finprod_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier S;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum S ?f ?A = finsum S ?g ?B\<close>
  notes theorem
    "S.add.finprod_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier S) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum S ?f ?A = finsum S ?g ?B\<close>
  notes theorem
    "S.add.finprod_0" =
      (\<open>?f \<in> {0} \<rightarrow> carrier S \<Longrightarrow>
              finsum S ?f {..0} = ?f 0\<close>)
      ["simp"]
  notes theorem
    "S.add.finprod_0'" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier S \<Longrightarrow>
             ?f 0 \<oplus>\<^bsub>S\<^esub> finsum S ?f {Suc 0..?n} =
             finsum S ?f {..?n}\<close>
  notes theorem
    "S.add.finprod_Suc" =
      (\<open>?f \<in> {..Suc ?n} \<rightarrow> carrier S \<Longrightarrow>
              finsum S ?f {..Suc ?n} =
              ?f (Suc ?n) \<oplus>\<^bsub>S\<^esub>
              finsum S ?f {..?n}\<close>)
      ["simp"]
  notes theorem
    "S.add.finprod_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier S \<Longrightarrow>
             finsum S ?f {..Suc ?n} =
             (\<Oplus>\<^bsub>S\<^esub>i\<in>{..?n}. ?f
                (Suc i)) \<oplus>\<^bsub>S\<^esub>
             ?f 0\<close>
  notes theorem
    "S.add.finprod_Suc3" =
      \<open>?f \<in> {..?n} \<rightarrow> carrier S \<Longrightarrow>
             finsum S ?f {..?n} =
             ?f ?n \<oplus>\<^bsub>S\<^esub> finsum S ?f {..<?n}\<close>
  notes theorem
    "S.add.finprod_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier S;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finsum S ?f (?h ` ?A) =
                               (\<Oplus>\<^bsub>S\<^esub>x\<in>?A. ?f
                              (?h x))\<close>
  notes theorem
    "S.add.finprod_const" =
      \<open>?a \<in> carrier S \<Longrightarrow>
             (\<Oplus>\<^bsub>S\<^esub>x\<in>?A. ?a) =
             [card ?A] \<cdot>\<^bsub>S\<^esub> ?a\<close>
  notes theorem
    "S.add.finprod_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> (\<Oplus>\<^bsub>S\<^esub>j\<in>?A. if ?i = j
                             then ?f j else \<zero>\<^bsub>S\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "S.add.finprod_singleton_swap" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> (\<Oplus>\<^bsub>S\<^esub>j\<in>?A. if j = ?i
                             then ?f j else \<zero>\<^bsub>S\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "S.add.finprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<zero>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finsum S ?g ?A = finsum S ?h ?B\<close>
  notes theorem
    "S.add.finprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>finite ?B; ?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?g i = \<zero>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finsum S ?g ?B = finsum S ?h ?A\<close>
  notes theorem
    "S.add.finprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<zero>\<^bsub>S\<^esub>;
              \<And>i.
                 i \<in> ?A - ?B \<Longrightarrow>
                 ?g i = \<zero>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier S;
              ?h \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finsum S ?g ?A = finsum S ?h ?B\<close>
  notes theorem
    "S.add.finprod_UN_disjoint" =
      \<open>\<lbrakk>finite ?I;
              \<And>i. i \<in> ?I \<Longrightarrow> finite (?A i);
              pairwise (\<lambda>i j. disjnt (?A i) (?A j)) ?I;
              \<And>i x.
                 \<lbrakk>i \<in> ?I; x \<in> ?A i\<rbrakk>
                 \<Longrightarrow> ?g x \<in> carrier S\<rbrakk>
             \<Longrightarrow> finsum S ?g (\<Union> (?A ` ?I)) =
                               (\<Oplus>\<^bsub>S\<^esub>i\<in>?I. finsum S
                              ?g (?A i))\<close>
  notes theorem
    "S.add.finprod_Union_disjoint" =
      \<open>\<lbrakk>finite ?C;
              \<And>A.
                 A \<in> ?C \<Longrightarrow>
                 finite A \<and> (\<forall>x\<in>A. ?f x \<in> carrier S);
              disjoint ?C\<rbrakk>
             \<Longrightarrow> finsum S ?f (\<Union> ?C) =
                               finsum S (finsum S ?f) ?C\<close>
  notes theorem
    "S.add.comm_inv_char" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?x \<oplus>\<^bsub>S\<^esub> ?y =
              \<zero>\<^bsub>S\<^esub>\<rbrakk>
             \<Longrightarrow> inv\<^bsub>add_monoid S\<^esub> ?x =
                               ?y\<close>
  notes theorem
    "S.add.unit_factor" =
      \<open>\<lbrakk>?a \<oplus>\<^bsub>S\<^esub> ?b
                      \<in> Units (add_monoid S);
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid S)\<close>
  notes theorem
    "S.add.divides_mult_rI" =
      (\<open>\<lbrakk>?a divides\<^bsub>add_monoid S\<^esub> ?b;
               ?a \<in> carrier S; ?b \<in> carrier S;
               ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> (?a \<oplus>\<^bsub>S\<^esub>
                                 ?c) divides\<^bsub>add_monoid S\<^esub>
                                (?b \<oplus>\<^bsub>S\<^esub> ?c)\<close>)
      ["HOL.intro"]
  notes theorem
    "S.add.divides_prod_l" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
              ?c \<in> carrier S;
              ?a divides\<^bsub>add_monoid S\<^esub> ?b\<rbrakk>
             \<Longrightarrow> ?a divides\<^bsub>add_monoid S\<^esub>
                               (?c \<oplus>\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.add.divides_unit" =
      \<open>\<lbrakk>?a divides\<^bsub>add_monoid S\<^esub> ?u;
              ?a \<in> carrier S; ?u \<in> Units (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?a \<in> Units (add_monoid S)\<close>
  notes theorem
    "S.add.Unit_eq_dividesone" =
      \<open>?u \<in> carrier S \<Longrightarrow>
             (?u \<in> Units (add_monoid S)) =
             ?u divides\<^bsub>add_monoid S\<^esub>
             \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.add.mult_cong_l" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid S\<^esub> ?a';
              ?a \<in> carrier S; ?a' \<in> carrier S;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<oplus>\<^bsub>S\<^esub>
                               ?b \<sim>\<^bsub>add_monoid S\<^esub>
                               ?a' \<oplus>\<^bsub>S\<^esub> ?b\<close>
  notes theorem
    "S.add.Units_cong" =
      \<open>\<lbrakk>?a \<in> Units (add_monoid S);
              ?a \<sim>\<^bsub>add_monoid S\<^esub> ?b;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?b \<in> Units (add_monoid S)\<close>
  notes theorem
    "S.add.Units_Lower" =
      \<open>Units (add_monoid S) =
             Lower
              \<lparr>carrier = carrier S,
                 eq = (\<sim>\<^bsub>add_monoid S\<^esub>),
                 le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>
              (carrier S)\<close>
  notes theorem
    "S.add.properfactor_prod_l" =
      \<open>\<lbrakk>properfactor (add_monoid S) ?a ?b; ?a \<in> carrier S;
              ?b \<in> carrier S; ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> properfactor (add_monoid S) ?a
                                (?c \<oplus>\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.add.irreducible_prod_lI" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid S) ?b;
              ?a \<in> Units (add_monoid S); ?a \<in> carrier S;
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> Divisibility.irreducible (add_monoid S)
                                (?a \<oplus>\<^bsub>S\<^esub> ?b)\<close>
  notes theorem
    "S.add.multlist_dividesI" =
      \<open>\<lbrakk>?f \<in> set ?fs;
              set ?fs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid S\<^esub>
                               foldr (\<oplus>\<^bsub>S\<^esub>) ?fs
                                \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.add.multlist_perm_cong" =
      \<open>\<lbrakk>mset ?as = mset ?bs;
              set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> foldr (\<oplus>\<^bsub>S\<^esub>) ?as
                                \<zero>\<^bsub>S\<^esub> =
                               foldr (\<oplus>\<^bsub>S\<^esub>) ?bs
                                \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.add.wfactors_perm_cong_l" =
      \<open>\<lbrakk>wfactors (add_monoid S) ?fs ?a; mset ?fs = mset ?fs';
              set ?fs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid S) ?fs' ?a\<close>
  notes theorem
    "S.add.perm_wfactorsD" =
      \<open>\<lbrakk>mset ?as = mset ?bs; wfactors (add_monoid S) ?as ?a;
              wfactors (add_monoid S) ?bs ?b; ?a \<in> carrier S;
              ?b \<in> carrier S; set ?as \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.factors_dividesI" =
      \<open>\<lbrakk>factors (add_monoid S) ?fs ?a; ?f \<in> set ?fs;
              set ?fs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid S\<^esub>
                               ?a\<close>
  notes theorem
    "S.add.wfactors_dividesI" =
      \<open>\<lbrakk>wfactors (add_monoid S) ?fs ?a;
              set ?fs \<subseteq> carrier S; ?a \<in> carrier S;
              ?f \<in> set ?fs\<rbrakk>
             \<Longrightarrow> ?f divides\<^bsub>add_monoid S\<^esub>
                               ?a\<close>
  notes theorem
    "S.add.assocs_assoc" =
      \<open>\<lbrakk>?a \<in> closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                                {?b};
              ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.assocs_eqD" =
      \<open>\<lbrakk>closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                       {?b} =
                      closure_of\<^bsub>\<lparr>carrier = carrier S, eq = (\<sim>\<^bsub>add_monoid S\<^esub>), le = (divides\<^bsub>add_monoid S\<^esub>)\<rparr>\<^esub>
                       {?a};
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid S\<^esub>
                               ?b\<close>
  notes theorem
    "S.add.gfinprod_closed" =
      (\<open>?f \<in> ?A \<rightarrow> carrier S \<Longrightarrow>
              gfinprod (add_monoid S) ?f ?A \<in> carrier S\<close>)
      ["simp"]
  notes theorem
    "S.add.gfinprod_cong" =
      \<open>\<lbrakk>?A = ?B; ?f \<in> ?B \<rightarrow> carrier S;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid S) ?f ?A =
                               gfinprod (add_monoid S) ?g ?B\<close>
  notes theorem
    "S.add.gfinprod_eq_finprod" =
      (\<open>\<lbrakk>finite ?A;
               ?f \<in> ?A \<rightarrow> carrier S\<rbrakk>
              \<Longrightarrow> gfinprod (add_monoid S) ?f ?A =
                                finsum S ?f ?A\<close>)
      ["simp"]
  notes theorem
    "S.add.gfinprod_insert" =
      (\<open>\<lbrakk>finite
                        {x \<in> ?A.
                         ?f x \<noteq> \<zero>\<^bsub>S\<^esub>};
               ?f \<in> ?A \<rightarrow> carrier S;
               ?f ?i \<in> carrier S\<rbrakk>
              \<Longrightarrow> gfinprod (add_monoid S) ?f (insert ?i ?A) =
                                (if ?i \<in> ?A
                                 then gfinprod (add_monoid S) ?f ?A
                                 else ?f ?i \<oplus>\<^bsub>S\<^esub>
gfinprod (add_monoid S) ?f ?A)\<close>)
      ["simp"]
  notes theorem
    "S.add.gfinprod_distrib" =
      \<open>\<lbrakk>finite
                       {x \<in> ?A. ?f x \<noteq> \<zero>\<^bsub>S\<^esub>};
              finite {x \<in> ?A. ?g x \<noteq> \<zero>\<^bsub>S\<^esub>};
              ?f \<in> ?A \<rightarrow> carrier S;
              ?g \<in> ?A \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid S)
                                (\<lambda>i.
                                    ?f i \<oplus>\<^bsub>S\<^esub> ?g i)
                                ?A =
                               gfinprod (add_monoid S) ?f
                                ?A \<oplus>\<^bsub>S\<^esub>
                               gfinprod (add_monoid S) ?g ?A\<close>
  notes theorem
    "S.add.gfinprod_mono_neutral_cong_left" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<zero>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?h \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid S) ?g ?A =
                               gfinprod (add_monoid S) ?h ?B\<close>
  notes theorem
    "S.add.gfinprod_mono_neutral_cong_right" =
      \<open>\<lbrakk>?A \<subseteq> ?B;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?g i = \<zero>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid S) ?g ?B =
                               gfinprod (add_monoid S) ?h ?A\<close>
  notes theorem
    "S.add.gfinprod_mono_neutral_cong" =
      \<open>\<lbrakk>finite ?B; finite ?A;
              \<And>i.
                 i \<in> ?B - ?A \<Longrightarrow>
                 ?h i = \<zero>\<^bsub>S\<^esub>;
              \<And>i.
                 i \<in> ?A - ?B \<Longrightarrow>
                 ?g i = \<zero>\<^bsub>S\<^esub>;
              \<And>x. x \<in> ?A \<inter> ?B \<Longrightarrow> ?g x = ?h x;
              ?g \<in> ?A \<rightarrow> carrier S;
              ?h \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> gfinprod (add_monoid S) ?g ?A =
                               gfinprod (add_monoid S) ?h ?B\<close>
  notes
    "S.abelian_monoid_axioms" = (\<open>abelian_monoid S\<close>)
      ["attribute" "internal"]
  notes "S.a_comm_monoid" = \<open>Group.comm_monoid (add_monoid S)\<close>
  notes theorem "S.a_monoid" = \<open>Group.monoid (add_monoid S)\<close>
  notes theorem
    "S.a_closed" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub> ?y
                               \<in> carrier S\<close>
  notes theorem
    "S.zero_closed" =
      \<open>\<zero>\<^bsub>S\<^esub> \<in> carrier S\<close>
  notes theorem
    "S.a_assoc" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                               ?y \<oplus>\<^bsub>S\<^esub>
                               ?z =
                               ?x \<oplus>\<^bsub>S\<^esub>
                               (?y \<oplus>\<^bsub>S\<^esub> ?z)\<close>
  notes theorem
    "S.l_zero" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             \<zero>\<^bsub>S\<^esub> \<oplus>\<^bsub>S\<^esub> ?x =
             ?x\<close>
  notes theorem
    "S.r_zero" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             ?x \<oplus>\<^bsub>S\<^esub> \<zero>\<^bsub>S\<^esub> =
             ?x\<close>
  notes theorem
    "S.minus_unique" =
      \<open>\<lbrakk>?y \<oplus>\<^bsub>S\<^esub> ?x =
                      \<zero>\<^bsub>S\<^esub>;
              ?x \<oplus>\<^bsub>S\<^esub> ?y' = \<zero>\<^bsub>S\<^esub>;
              ?x \<in> carrier S; ?y \<in> carrier S;
              ?y' \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?y = ?y'\<close>
  notes theorem
    "S.a_comm" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub> ?y =
                               ?y \<oplus>\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.a_lcomm" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                               (?y \<oplus>\<^bsub>S\<^esub> ?z) =
                               ?y \<oplus>\<^bsub>S\<^esub>
                               (?x \<oplus>\<^bsub>S\<^esub> ?z)\<close>
  notes theorem
    "S.a_ac" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                               ?y \<oplus>\<^bsub>S\<^esub>
                               ?z =
                               ?x \<oplus>\<^bsub>S\<^esub>
                               (?y \<oplus>\<^bsub>S\<^esub> ?z)\<close>
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub> ?y =
                               ?y \<oplus>\<^bsub>S\<^esub> ?x\<close>
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?z \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                               (?y \<oplus>\<^bsub>S\<^esub> ?z) =
                               ?y \<oplus>\<^bsub>S\<^esub>
                               (?x \<oplus>\<^bsub>S\<^esub> ?z)\<close>
  notes theorem
    "S.finsum_empty" =
      \<open>finsum S ?f {} = \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.finsum_insert" =
      \<open>\<lbrakk>finite ?F; ?a \<notin> ?F;
              ?f \<in> ?F \<rightarrow> carrier S;
              ?f ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> finsum S ?f (insert ?a ?F) =
                               ?f ?a \<oplus>\<^bsub>S\<^esub>
                               finsum S ?f ?F\<close>
  notes theorem
    "S.finsum_zero" =
      \<open>(\<Oplus>\<^bsub>S\<^esub>i\<in>?A. \<zero>\<^bsub>S\<^esub>) =
             \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.finsum_closed" =
      \<open>?f \<in> ?A \<rightarrow> carrier S \<Longrightarrow>
             finsum S ?f ?A \<in> carrier S\<close>
  notes theorem
    "S.finsum_Un_Int" =
      \<open>\<lbrakk>finite ?A; finite ?B;
              ?g \<in> ?A \<rightarrow> carrier S;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finsum S ?g
                                (?A \<union> ?B) \<oplus>\<^bsub>S\<^esub>
                               finsum S ?g (?A \<inter> ?B) =
                               finsum S ?g ?A \<oplus>\<^bsub>S\<^esub>
                               finsum S ?g ?B\<close>
  notes theorem
    "S.finsum_Un_disjoint" =
      \<open>\<lbrakk>finite ?A; finite ?B; ?A \<inter> ?B = {};
              ?g \<in> ?A \<rightarrow> carrier S;
              ?g \<in> ?B \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> finsum S ?g (?A \<union> ?B) =
                               finsum S ?g ?A \<oplus>\<^bsub>S\<^esub>
                               finsum S ?g ?B\<close>
  notes theorem
    "S.finsum_addf" =
      \<open>\<lbrakk>?f \<in> ?A \<rightarrow> carrier S;
              ?g \<in> ?A \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> (\<Oplus>\<^bsub>S\<^esub>x\<in>?A. ?f
                              x \<oplus>\<^bsub>S\<^esub>
                             ?g x) =
                               finsum S ?f ?A \<oplus>\<^bsub>S\<^esub>
                               finsum S ?g ?A\<close>
  notes theorem
    "S.finsum_cong'" =
      \<open>\<lbrakk>?A = ?B; ?g \<in> ?B \<rightarrow> carrier S;
              \<And>i. i \<in> ?B \<Longrightarrow> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum S ?f ?A = finsum S ?g ?B\<close>
  notes theorem
    "S.finsum_0" =
      \<open>?f \<in> {0} \<rightarrow> carrier S \<Longrightarrow>
             finsum S ?f {..0} = ?f 0\<close>
  notes theorem
    "S.finsum_Suc" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier S \<Longrightarrow>
             finsum S ?f {..Suc ?n} =
             ?f (Suc ?n) \<oplus>\<^bsub>S\<^esub>
             finsum S ?f {..?n}\<close>
  notes theorem
    "S.finsum_Suc2" =
      \<open>?f \<in> {..Suc ?n} \<rightarrow> carrier S \<Longrightarrow>
             finsum S ?f {..Suc ?n} =
             (\<Oplus>\<^bsub>S\<^esub>i\<in>{..?n}. ?f
                (Suc i)) \<oplus>\<^bsub>S\<^esub>
             ?f 0\<close>
  notes theorem
    "S.finsum_infinite" =
      \<open>infinite ?A \<Longrightarrow>
             finsum S ?f ?A = \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.finsum_cong" =
      \<open>\<lbrakk>?A = ?B; (?f \<in> ?B \<rightarrow> carrier S) = True;
              \<And>i. i \<in> ?B =simp=> ?f i = ?g i\<rbrakk>
             \<Longrightarrow> finsum S ?f ?A = finsum S ?g ?B\<close>
  notes theorem
    "S.finsum_reindex" =
      \<open>\<lbrakk>?f \<in> ?h ` ?A \<rightarrow> carrier S;
              inj_on ?h ?A\<rbrakk>
             \<Longrightarrow> finsum S ?f (?h ` ?A) =
                               (\<Oplus>\<^bsub>S\<^esub>x\<in>?A. ?f
                              (?h x))\<close>
  notes theorem
    "S.finsum_singleton" =
      \<open>\<lbrakk>?i \<in> ?A; finite ?A;
              ?f \<in> ?A \<rightarrow> carrier S\<rbrakk>
             \<Longrightarrow> (\<Oplus>\<^bsub>S\<^esub>j\<in>?A. if ?i = j
                             then ?f j else \<zero>\<^bsub>S\<^esub>) =
                               ?f ?i\<close>
  notes theorem
    "S.a_r_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?x \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?H +>\<^bsub>S\<^esub> ?x
                               \<subseteq> carrier S\<close>
  notes theorem
    "S.set_add_closed" =
      \<open>\<lbrakk>?A \<subseteq> carrier S;
              ?B \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?A <+>\<^bsub>S\<^esub> ?B
                               \<subseteq> carrier S\<close>
  notes theorem
    "S.boundD_carrier" =
      \<open>\<lbrakk>bound \<zero>\<^bsub>S\<^esub> ?n ?f; ?n < ?m\<rbrakk>
             \<Longrightarrow> ?f ?m \<in> carrier S\<close>
  notes
    "S.add.monoid_cancel_axioms" =
      (\<open>monoid_cancel (add_monoid S)\<close>) ["attribute" "internal"]
  notes
    "S.add.l_cancel" =
      \<open>\<lbrakk>?c \<oplus>\<^bsub>S\<^esub> ?a =
                      ?c \<oplus>\<^bsub>S\<^esub> ?b;
              ?a \<in> carrier S; ?b \<in> carrier S;
              ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a = ?b\<close>
  notes
    "S.add.r_cancel" =
      \<open>\<lbrakk>?a \<oplus>\<^bsub>S\<^esub> ?c =
                      ?b \<oplus>\<^bsub>S\<^esub> ?c;
              ?a \<in> carrier S; ?b \<in> carrier S;
              ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a = ?b\<close>
  notes theorem
    "S.add.is_monoid_cancel" = \<open>monoid_cancel (add_monoid S)\<close>
  notes theorem
    "S.add.divides_mult_l" =
      (\<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
               ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> (?c \<oplus>\<^bsub>S\<^esub>
                                 ?a) divides\<^bsub>add_monoid S\<^esub>
                                (?c \<oplus>\<^bsub>S\<^esub> ?b) =
                                ?a divides\<^bsub>add_monoid S\<^esub>
                                ?b\<close>)
      ["simp"]
  notes theorem
    "S.add.associatedD2" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid S\<^esub> ?b;
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> \<exists>u\<in>Units (add_monoid S).
                                  ?a =
                                  ?b \<oplus>\<^bsub>S\<^esub> u\<close>
  notes theorem
    "S.add.associatedE2" =
      \<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid S\<^esub> ?b;
              \<And>u.
                 \<lbrakk>?a = ?b \<oplus>\<^bsub>S\<^esub> u;
                  u \<in> Units (add_monoid S)\<rbrakk>
                 \<Longrightarrow> ?P;
              ?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?P\<close>
  notes theorem
    "S.add.assoc_l_cancel" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
              ?b' \<in> carrier S;
              ?a \<oplus>\<^bsub>S\<^esub>
              ?b \<sim>\<^bsub>add_monoid S\<^esub>
              ?a \<oplus>\<^bsub>S\<^esub> ?b'\<rbrakk>
             \<Longrightarrow> ?b \<sim>\<^bsub>add_monoid S\<^esub>
                               ?b'\<close>
  notes theorem
    "S.add.assoc_unit_l" =
      (\<open>\<lbrakk>?a \<sim>\<^bsub>add_monoid S\<^esub> ?b;
               ?b \<in> Units (add_monoid S); ?a \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?a \<in> Units (add_monoid S)\<close>)
      ["trans"]
  notes theorem
    "S.add.assoc_unit_r" =
      (\<open>\<lbrakk>?a \<in> Units (add_monoid S);
               ?a \<sim>\<^bsub>add_monoid S\<^esub> ?b;
               ?b \<in> carrier S\<rbrakk>
              \<Longrightarrow> ?b \<in> Units (add_monoid S)\<close>)
      ["trans"]
  notes theorem
    "S.add.associated_iff" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?a \<sim>\<^bsub>add_monoid S\<^esub> ?b =
                               (\<exists>c\<in>Units (add_monoid S).
                                   ?a =
                                   ?b \<oplus>\<^bsub>S\<^esub> c)\<close>
  notes theorem
    "S.add.properfactor_mult_lI" =
      (\<open>\<lbrakk>properfactor (add_monoid S) ?a ?b;
               ?a \<in> carrier S; ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid S)
                                 (?c \<oplus>\<^bsub>S\<^esub> ?a)
                                 (?c \<oplus>\<^bsub>S\<^esub> ?b)\<close>)
      ["HOL.intro"]
  notes theorem
    "S.add.properfactor_mult_l" =
      (\<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
               ?c \<in> carrier S\<rbrakk>
              \<Longrightarrow> properfactor (add_monoid S)
                                 (?c \<oplus>\<^bsub>S\<^esub> ?a)
                                 (?c \<oplus>\<^bsub>S\<^esub> ?b) =
                                properfactor (add_monoid S) ?a ?b\<close>)
      ["simp"]
  notes theorem
    "S.add.irreducible_cong" =
      (\<open>\<lbrakk>Divisibility.irreducible (add_monoid S) ?a;
               ?a \<sim>\<^bsub>add_monoid S\<^esub> ?a';
               ?a \<in> carrier S; ?a' \<in> carrier S\<rbrakk>
              \<Longrightarrow> Divisibility.irreducible (add_monoid S)
                                 ?a'\<close>)
      ["trans"]
  notes theorem
    "S.add.prime_cong" =
      (\<open>\<lbrakk>Divisibility.prime (add_monoid S) ?p;
               ?p \<sim>\<^bsub>add_monoid S\<^esub> ?p';
               ?p \<in> carrier S; ?p' \<in> carrier S\<rbrakk>
              \<Longrightarrow> Divisibility.prime (add_monoid S)
                                 ?p'\<close>)
      ["trans"]
  notes theorem
    "S.add.irrlist_listassoc_cong" =
      \<open>\<lbrakk>\<forall>a\<in>set ?as.
                         Divisibility.irreducible (add_monoid S) a;
              ?as [\<sim>]\<^bsub>add_monoid S\<^esub> ?bs;
              set ?as \<subseteq> carrier S;
              set ?bs \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> \<forall>a\<in>set ?bs.
                                  Divisibility.irreducible (add_monoid S)
                                   a\<close>
  notes theorem
    "S.add.wfactors_mult_single" =
      \<open>\<lbrakk>Divisibility.irreducible (add_monoid S) ?a;
              wfactors (add_monoid S) ?fb ?b; ?a \<in> carrier S;
              ?b \<in> carrier S; set ?fb \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> wfactors (add_monoid S) (?a # ?fb)
                                (?a \<oplus>\<^bsub>S\<^esub> ?b)\<close>
  notes
    "S.add.group_axioms" = (\<open>Group.group (add_monoid S)\<close>)
      ["attribute" "internal"]
  notes
    "S.add.Units" =
      \<open>carrier S \<subseteq> Units (add_monoid S)\<close>
  notes theorem
    "S.add.is_group" = (\<open>Group.group (add_monoid S)\<close>) ["iff"]
  notes theorem
    "S.add.is_monoid" = (\<open>Group.monoid (add_monoid S)\<close>) ["iff"]
  notes theorem
    "S.add.Units_eq" = (\<open>Units (add_monoid S) = carrier S\<close>)
      ["simp"]
  notes theorem
    "S.add.inv_closed" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              \<ominus>\<^bsub>S\<^esub> ?x \<in> carrier S\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "S.add.l_inv_ex" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              \<exists>y\<in>carrier S.
                 y \<oplus>\<^bsub>S\<^esub> ?x =
                 \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.add.r_inv_ex" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              \<exists>y\<in>carrier S.
                 ?x \<oplus>\<^bsub>S\<^esub> y =
                 \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.add.l_inv" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              \<ominus>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub> ?x =
              \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.add.inv_eq_1_iff" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              (\<ominus>\<^bsub>S\<^esub> ?x = \<zero>\<^bsub>S\<^esub>) =
              (?x = \<zero>\<^bsub>S\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "S.add.r_inv" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              ?x \<oplus>\<^bsub>S\<^esub> \<ominus>\<^bsub>S\<^esub> ?x =
              \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.add.right_cancel" =
      (\<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
               ?z \<in> carrier S\<rbrakk>
              \<Longrightarrow> (?y \<oplus>\<^bsub>S\<^esub> ?x =
                                 ?z \<oplus>\<^bsub>S\<^esub> ?x) =
                                (?y = ?z)\<close>)
      ["simp"]
  notes theorem
    "S.add.inv_inv" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              \<ominus>\<^bsub>S\<^esub> (\<ominus>\<^bsub>S\<^esub> ?x) =
              ?x\<close>)
      ["simp"]
  notes theorem
    "S.add.inv_inj" = \<open>inj_on (a_inv S) (carrier S)\<close>
  notes theorem
    "S.add.inv_mult_group" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> \<ominus>\<^bsub>S\<^esub> (?x \<oplus>\<^bsub>S\<^esub>
                     ?y) =
                               \<ominus>\<^bsub>S\<^esub> ?y \<oplus>\<^bsub>S\<^esub>
                               \<ominus>\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.add.inv_comm" =
      \<open>\<lbrakk>?x \<oplus>\<^bsub>S\<^esub> ?y =
                      \<zero>\<^bsub>S\<^esub>;
              ?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?y \<oplus>\<^bsub>S\<^esub> ?x =
                               \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.add.inv_equality" =
      \<open>\<lbrakk>?y \<oplus>\<^bsub>S\<^esub> ?x =
                      \<zero>\<^bsub>S\<^esub>;
              ?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> \<ominus>\<^bsub>S\<^esub> ?x = ?y\<close>
  notes theorem
    "S.add.inv_solve_left" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
              ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> (?a =
                                \<ominus>\<^bsub>S\<^esub> ?b \<oplus>\<^bsub>S\<^esub>
                                ?c) =
                               (?c =
                                ?b \<oplus>\<^bsub>S\<^esub> ?a)\<close>
  notes theorem
    "S.add.inv_solve_left'" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
              ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> (\<ominus>\<^bsub>S\<^esub> ?b \<oplus>\<^bsub>S\<^esub>
                                ?c =
                                ?a) =
                               (?c =
                                ?b \<oplus>\<^bsub>S\<^esub> ?a)\<close>
  notes theorem
    "S.add.inv_solve_right" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
              ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> (?a =
                                ?b \<oplus>\<^bsub>S\<^esub>
                                \<ominus>\<^bsub>S\<^esub> ?c) =
                               (?b =
                                ?a \<oplus>\<^bsub>S\<^esub> ?c)\<close>
  notes theorem
    "S.add.inv_solve_right'" =
      \<open>\<lbrakk>?a \<in> carrier S; ?b \<in> carrier S;
              ?c \<in> carrier S\<rbrakk>
             \<Longrightarrow> (?b \<oplus>\<^bsub>S\<^esub>
                                \<ominus>\<^bsub>S\<^esub> ?c =
                                ?a) =
                               (?b =
                                ?a \<oplus>\<^bsub>S\<^esub> ?c)\<close>
  notes theorem
    "S.add.nat_pow_inv" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             [?i] \<cdot>\<^bsub>S\<^esub> (\<ominus>\<^bsub>S\<^esub> ?x) =
             \<ominus>\<^bsub>S\<^esub> ([?i] \<cdot>\<^bsub>S\<^esub> ?x)\<close>
  notes theorem
    "S.add.int_pow_one" =
      (\<open>[?z] \<cdot>\<^bsub>S\<^esub> \<zero>\<^bsub>S\<^esub> =
              \<zero>\<^bsub>S\<^esub>\<close>)
      ["simp"]
  notes theorem
    "S.add.int_pow_closed" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              [?i] \<cdot>\<^bsub>S\<^esub> ?x \<in> carrier S\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "S.add.int_pow_1" =
      (\<open>?x \<in> carrier S \<Longrightarrow>
              [1] \<cdot>\<^bsub>S\<^esub> ?x = ?x\<close>)
      ["simp"]
  notes theorem
    "S.add.int_pow_neg" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             [(- ?i)] \<cdot>\<^bsub>S\<^esub> ?x =
             \<ominus>\<^bsub>S\<^esub> ([?i] \<cdot>\<^bsub>S\<^esub> ?x)\<close>
  notes theorem
    "S.add.int_pow_neg_int" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             [(- int ?n)] \<cdot>\<^bsub>S\<^esub> ?x =
             \<ominus>\<^bsub>S\<^esub> ([?n] \<cdot>\<^bsub>S\<^esub> ?x)\<close>
  notes theorem
    "S.add.int_pow_mult" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             [(?i + ?j)] \<cdot>\<^bsub>S\<^esub> ?x =
             [?i] \<cdot>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub>
             [?j] \<cdot>\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.add.int_pow_inv" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             [?i] \<cdot>\<^bsub>S\<^esub> (\<ominus>\<^bsub>S\<^esub> ?x) =
             \<ominus>\<^bsub>S\<^esub> ([?i] \<cdot>\<^bsub>S\<^esub> ?x)\<close>
  notes theorem
    "S.add.int_pow_pow" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             [?m] \<cdot>\<^bsub>S\<^esub> ([?n] \<cdot>\<^bsub>S\<^esub> ?x) =
             [(?n * ?m)] \<cdot>\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.add.int_pow_diff" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             [(?n - ?m)] \<cdot>\<^bsub>S\<^esub> ?x =
             [?n] \<cdot>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub>
             \<ominus>\<^bsub>S\<^esub> ([?m] \<cdot>\<^bsub>S\<^esub> ?x)\<close>
  notes theorem
    "S.add.inj_on_multc" =
      \<open>?c \<in> carrier S \<Longrightarrow>
             inj_on (\<lambda>x. x \<oplus>\<^bsub>S\<^esub> ?c)
              (carrier S)\<close>
  notes theorem
    "S.add.inj_on_cmult" =
      \<open>?c \<in> carrier S \<Longrightarrow>
             inj_on ((\<oplus>\<^bsub>S\<^esub>) ?c) (carrier S)\<close>
  notes theorem
    "S.add.int_pow_mult_distrib" =
      \<open>\<lbrakk>?x \<oplus>\<^bsub>S\<^esub> ?y =
                      ?y \<oplus>\<^bsub>S\<^esub> ?x;
              ?x \<in> carrier S; ?y \<in> carrier S\<rbrakk>
             \<Longrightarrow> [?i] \<cdot>\<^bsub>S\<^esub> (?x \<oplus>\<^bsub>S\<^esub>
                        ?y) =
                               [?i] \<cdot>\<^bsub>S\<^esub> ?x \<oplus>\<^bsub>S\<^esub>
                               [?i] \<cdot>\<^bsub>S\<^esub> ?y\<close>
  notes theorem
    "S.add.pow_eq_div2" =
      \<open>\<lbrakk>?x \<in> carrier S;
              [?m] \<cdot>\<^bsub>S\<^esub> ?x =
              [?n] \<cdot>\<^bsub>S\<^esub> ?x\<rbrakk>
             \<Longrightarrow> [(?m - ?n)] \<cdot>\<^bsub>S\<^esub> ?x =
                               \<zero>\<^bsub>S\<^esub>\<close>
  notes theorem
    "S.add.triv_subgroup" =
      \<open>subgroup {\<zero>\<^bsub>S\<^esub>} (add_monoid S)\<close>
  notes theorem
    "S.add.subgroup_Units" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             ?H \<subseteq> Units
                             (add_monoid S
                              \<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "S.add.m_inv_consistent" =
      (\<open>\<lbrakk>subgroup ?H (add_monoid S); ?x \<in> ?H\<rbrakk>
              \<Longrightarrow> inv\<^bsub>add_monoid S\<lparr>carrier := ?H\<rparr>\<^esub> ?x =
                                \<ominus>\<^bsub>S\<^esub> ?x\<close>)
      ["simp"]
  notes theorem
    "S.add.int_pow_consistent" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S); ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> [?n] \<cdot>\<^bsub>S\<^esub> ?x =
                               ?x [^]\<^bsub>add_monoid S\<lparr>carrier := ?H\<rparr>\<^esub>
                               ?n\<close>
  notes theorem
    "S.add.one_in_subset" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?H \<noteq> {};
              \<forall>a\<in>?H. \<ominus>\<^bsub>S\<^esub> a \<in> ?H;
              \<forall>a\<in>?H.
                 \<forall>b\<in>?H.
                    a \<oplus>\<^bsub>S\<^esub> b \<in> ?H\<rbrakk>
             \<Longrightarrow> \<zero>\<^bsub>S\<^esub> \<in> ?H\<close>
  notes theorem
    "S.add.subgroupI" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?H \<noteq> {};
              \<And>a.
                 a \<in> ?H \<Longrightarrow>
                 \<ominus>\<^bsub>S\<^esub> a \<in> ?H;
              \<And>a b.
                 \<lbrakk>a \<in> ?H; b \<in> ?H\<rbrakk>
                 \<Longrightarrow> a \<oplus>\<^bsub>S\<^esub> b
                                   \<in> ?H\<rbrakk>
             \<Longrightarrow> subgroup ?H (add_monoid S)\<close>
  notes theorem
    "S.add.subgroupE" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             ?H \<subseteq> carrier S\<close>
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             ?H \<noteq> {}\<close>
      \<open>\<lbrakk>subgroup ?H (add_monoid S); ?a \<in> ?H\<rbrakk>
             \<Longrightarrow> \<ominus>\<^bsub>S\<^esub> ?a
                               \<in> ?H\<close>
      \<open>\<lbrakk>subgroup ?H (add_monoid S); ?a \<in> ?H;
              ?b \<in> ?H\<rbrakk>
             \<Longrightarrow> ?a \<oplus>\<^bsub>S\<^esub> ?b
                               \<in> ?H\<close>
  notes theorem
    "S.add.submonoid_subgroupI" =
      \<open>\<lbrakk>submonoid ?H (add_monoid S);
              \<And>a.
                 a \<in> ?H \<Longrightarrow>
                 \<ominus>\<^bsub>S\<^esub> a \<in> ?H\<rbrakk>
             \<Longrightarrow> subgroup ?H (add_monoid S)\<close>
  notes theorem
    "S.add.group_incl_imp_subgroup" =
      \<open>\<lbrakk>?H \<subseteq> carrier S;
              Group.group
               (add_monoid S\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> subgroup ?H (add_monoid S)\<close>
  notes theorem
    "S.add.hom_restrict" =
      \<open>\<lbrakk>?h \<in> hom (add_monoid S) ?H;
              \<And>g.
                 g \<in> carrier S \<Longrightarrow> ?h g = ?t g\<rbrakk>
             \<Longrightarrow> ?t \<in> hom (add_monoid S) ?H\<close>
  notes theorem
    "S.add.hom_compose" =
      \<open>\<lbrakk>?h \<in> hom (add_monoid S) ?H;
              ?i \<in> hom ?H ?I\<rbrakk>
             \<Longrightarrow> compose (carrier S) ?i ?h
                               \<in> hom (add_monoid S) ?I\<close>
  notes theorem
    "S.add.restrict_hom_iff" =
      (\<open>((\<lambda>x. if x \<in> carrier S then ?f x else ?g x)
               \<in> hom (add_monoid S) ?H) =
              (?f \<in> hom (add_monoid S) ?H)\<close>)
      ["simp"]
  notes theorem
    "S.add.hom_eq" =
      \<open>\<lbrakk>?f \<in> hom (add_monoid S) ?H;
              \<And>x.
                 x \<in> carrier S \<Longrightarrow> ?f' x = ?f x\<rbrakk>
             \<Longrightarrow> ?f' \<in> hom (add_monoid S) ?H\<close>
  notes theorem
    "S.add.iso_eq" =
      \<open>\<lbrakk>?f \<in> Group.iso (add_monoid S) ?H;
              \<And>x.
                 x \<in> carrier S \<Longrightarrow> ?f' x = ?f x\<rbrakk>
             \<Longrightarrow> ?f' \<in> Group.iso (add_monoid S) ?H\<close>
  notes theorem
    "S.add.iso_set_sym" =
      \<open>?h \<in> Group.iso (add_monoid S) ?H \<Longrightarrow>
             inv_into (carrier S) ?h
             \<in> Group.iso ?H (add_monoid S)\<close>
  notes theorem
    "S.add.iso_sym" =
      \<open>add_monoid S \<cong> ?H \<Longrightarrow>
             ?H \<cong> add_monoid S\<close>
  notes theorem
    "S.add.hom_imp_img_group" =
      \<open>?h \<in> hom (add_monoid S) ?H \<Longrightarrow>
             Group.group
              (?H\<lparr>carrier := ?h ` carrier S,
                    one := ?h \<zero>\<^bsub>S\<^esub>\<rparr>)\<close>
  notes theorem
    "S.add.iso_imp_group" =
      \<open>\<lbrakk>add_monoid S \<cong> ?H; Group.monoid ?H\<rbrakk>
             \<Longrightarrow> Group.group ?H\<close>
  notes theorem
    "S.add.iso_imp_img_group" =
      \<open>?h \<in> Group.iso (add_monoid S) ?H \<Longrightarrow>
             Group.group
              (?H\<lparr>one := ?h \<zero>\<^bsub>S\<^esub>\<rparr>)\<close>
  notes theorem
    "S.add.iso_iff_group_isomorphisms" =
      \<open>(?f \<in> Group.iso (add_monoid S) ?H) =
             (\<exists>g. group_isomorphisms (add_monoid S) ?H ?f g)\<close>
  notes theorem
    "S.add.DirProd_iso_set_trans" =
      \<open>\<lbrakk>?g \<in> Group.iso (add_monoid S) ?G2.0;
              ?h \<in> Group.iso ?H ?I\<rbrakk>
             \<Longrightarrow> (\<lambda>(x, y). (?g x, ?h y))
                               \<in> Group.iso
(add_monoid S \<times>\<times> ?H) (?G2.0 \<times>\<times> ?I)\<close>
  notes theorem
    "S.add.DirProd_iso_trans" =
      \<open>\<lbrakk>add_monoid S \<cong> ?G2.0; ?H \<cong> ?I\<rbrakk>
             \<Longrightarrow> add_monoid S \<times>\<times> ?H \<cong>
                               ?G2.0 \<times>\<times> ?I\<close>
  notes theorem
    "S.add.int_pow_is_hom" =
      \<open>?x \<in> carrier S \<Longrightarrow>
             (\<lambda>k. [k] \<cdot>\<^bsub>S\<^esub> ?x)
             \<in> hom \<lparr>carrier = UNIV, monoid.mult = (+),
                          one = 0\<rparr>
                    (add_monoid S)\<close>
  notes theorem
    "S.add.canonical_inj_is_hom" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             group_hom (add_monoid S\<lparr>carrier := ?H\<rparr>)
              (add_monoid S) id\<close>
  notes theorem
    "S.add.group_comm_groupI" =
      \<open>(\<And>x y.
                 \<lbrakk>x \<in> carrier S; y \<in> carrier S\<rbrakk>
                 \<Longrightarrow> x \<oplus>\<^bsub>S\<^esub> y =
                                   y \<oplus>\<^bsub>S\<^esub>
                                   x) \<Longrightarrow>
             comm_group (add_monoid S)\<close>
  notes theorem
    "S.add.incl_subgroup" =
      \<open>\<lbrakk>subgroup ?J (add_monoid S);
              subgroup ?I
               (add_monoid S\<lparr>carrier := ?J\<rparr>)\<rbrakk>
             \<Longrightarrow> subgroup ?I (add_monoid S)\<close>
  notes theorem
    "S.add.subgroup_incl" =
      \<open>\<lbrakk>subgroup ?I (add_monoid S);
              subgroup ?J (add_monoid S); ?I \<subseteq> ?J\<rbrakk>
             \<Longrightarrow> subgroup ?I
                                (add_monoid S
                                 \<lparr>carrier := ?J\<rparr>)\<close>
  notes theorem
    "S.add.subgroups_partial_order" =
      \<open>partial_order
              \<lparr>carrier = {H. subgroup H (add_monoid S)}, eq = (=),
                 le = (\<subseteq>)\<rparr>\<close>
  notes theorem
    "S.add.subgroup_self" =
      \<open>subgroup (carrier S) (add_monoid S)\<close>
  notes theorem
    "S.add.subgroup_imp_group" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             Group.group (add_monoid S\<lparr>carrier := ?H\<rparr>)\<close>
  notes theorem
    "S.add.subgroup_mult_equality" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S); ?h1.0 \<in> ?H;
              ?h2.0 \<in> ?H\<rbrakk>
             \<Longrightarrow> ?h1.0 \<otimes>\<^bsub>add_monoid S\<lparr>carrier := ?H\<rparr>\<^esub>
                               ?h2.0 =
                               ?h1.0 \<oplus>\<^bsub>S\<^esub> ?h2.0\<close>
  notes theorem
    "S.add.subgroups_Inter" =
      \<open>\<lbrakk>\<And>H.
                         H \<in> ?A \<Longrightarrow>
                         subgroup H (add_monoid S);
              ?A \<noteq> {}\<rbrakk>
             \<Longrightarrow> subgroup (\<Inter> ?A) (add_monoid S)\<close>
  notes theorem
    "S.add.subgroups_Inter_pair" =
      \<open>\<lbrakk>subgroup ?I (add_monoid S);
              subgroup ?J (add_monoid S)\<rbrakk>
             \<Longrightarrow> subgroup (?I \<inter> ?J)
                                (add_monoid S)\<close>
  notes theorem
    "S.add.subgroups_complete_lattice" =
      \<open>complete_lattice
              \<lparr>carrier = {H. subgroup H (add_monoid S)}, eq = (=),
                 le = (\<subseteq>)\<rparr>\<close>
  notes theorem
    "S.add.surj_const_mult" =
      \<open>?a \<in> carrier S \<Longrightarrow>
             (\<oplus>\<^bsub>S\<^esub>) ?a ` carrier S = carrier S\<close>
  notes theorem
    "S.add.l_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier S; ?a \<in> carrier S\<rbrakk>
              \<Longrightarrow> (?x \<oplus>\<^bsub>S\<^esub> ?a = ?x) =
                                (?a = \<zero>\<^bsub>S\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "S.add.r_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier S; ?a \<in> carrier S\<rbrakk>
              \<Longrightarrow> (?a \<oplus>\<^bsub>S\<^esub> ?x = ?x) =
                                (?a = \<zero>\<^bsub>S\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "S.add.l_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier S; ?a \<in> carrier S\<rbrakk>
              \<Longrightarrow> (?x = ?x \<oplus>\<^bsub>S\<^esub> ?a) =
                                (?a = \<zero>\<^bsub>S\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "S.add.r_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier S; ?a \<in> carrier S\<rbrakk>
              \<Longrightarrow> (?x = ?a \<oplus>\<^bsub>S\<^esub> ?x) =
                                (?a = \<zero>\<^bsub>S\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "S.add.diff_neutralizes" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              ?R \<in> rcosets\<^bsub>add_monoid S\<^esub> ?H;
              ?r1.0 \<in> ?R; ?r2.0 \<in> ?R\<rbrakk>
             \<Longrightarrow> ?r1.0 \<oplus>\<^bsub>S\<^esub>
                               \<ominus>\<^bsub>S\<^esub> ?r2.0
                               \<in> ?H\<close>
  notes theorem
    "S.add.setmult_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier S;
              ?K \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid S\<^esub> ?K
                               \<subseteq> carrier S\<close>
  notes theorem
    "S.add.set_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier S; ?H \<subseteq> carrier S;
              ?K \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?M <#>\<^bsub>add_monoid S\<^esub>
                               ?H <#>\<^bsub>add_monoid S\<^esub>
                               ?K =
                               ?M <#>\<^bsub>add_monoid S\<^esub>
                               (?H <#>\<^bsub>add_monoid S\<^esub>
                                ?K)\<close>
  notes theorem
    "S.add.coset_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier S; ?g \<in> carrier S;
              ?h \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid S\<^esub>
                               ?g #>\<^bsub>add_monoid S\<^esub>
                               ?h =
                               ?M #>\<^bsub>add_monoid S\<^esub>
                               ?g \<oplus>\<^bsub>S\<^esub> ?h\<close>
  notes theorem
    "S.add.coset_assoc" =
      \<open>\<lbrakk>?x \<in> carrier S; ?y \<in> carrier S;
              ?H \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid S\<^esub>
                               (?H #>\<^bsub>add_monoid S\<^esub> ?y) =
                               ?x <#\<^bsub>add_monoid S\<^esub>
                               ?H #>\<^bsub>add_monoid S\<^esub>
                               ?y\<close>
  notes theorem
    "S.add.coset_mult_one" =
      (\<open>?M \<subseteq> carrier S \<Longrightarrow>
              ?M #>\<^bsub>add_monoid S\<^esub> \<zero>\<^bsub>S\<^esub> =
              ?M\<close>)
      ["simp"]
  notes theorem
    "S.add.coset_mult_inv1" =
      \<open>\<lbrakk>?M #>\<^bsub>add_monoid S\<^esub>
                      ?x \<oplus>\<^bsub>S\<^esub>
                      \<ominus>\<^bsub>S\<^esub> ?y =
                      ?M;
              ?x \<in> carrier S; ?y \<in> carrier S;
              ?M \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid S\<^esub> ?x =
                               ?M #>\<^bsub>add_monoid S\<^esub> ?y\<close>
  notes theorem
    "S.add.coset_mult_inv2" =
      \<open>\<lbrakk>?M #>\<^bsub>add_monoid S\<^esub> ?x =
                      ?M #>\<^bsub>add_monoid S\<^esub> ?y;
              ?x \<in> carrier S; ?y \<in> carrier S;
              ?M \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid S\<^esub>
                               ?x \<oplus>\<^bsub>S\<^esub>
                               \<ominus>\<^bsub>S\<^esub> ?y =
                               ?M\<close>
  notes theorem
    "S.add.coset_join1" =
      \<open>\<lbrakk>?H #>\<^bsub>add_monoid S\<^esub> ?x = ?H;
              ?x \<in> carrier S; subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H\<close>
  notes theorem
    "S.add.solve_equation" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S); ?x \<in> ?H;
              ?y \<in> ?H\<rbrakk>
             \<Longrightarrow> \<exists>h\<in>?H.
                                  ?y =
                                  h \<oplus>\<^bsub>S\<^esub> ?x\<close>
  notes theorem
    "S.add.repr_independence" =
      \<open>\<lbrakk>?y \<in> ?H #>\<^bsub>add_monoid S\<^esub> ?x;
              ?x \<in> carrier S; subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid S\<^esub> ?x =
                               ?H #>\<^bsub>add_monoid S\<^esub> ?y\<close>
  notes theorem
    "S.add.coset_join2" =
      \<open>\<lbrakk>?x \<in> carrier S; subgroup ?H (add_monoid S);
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid S\<^esub> ?x =
                               ?H\<close>
  notes theorem
    "S.add.coset_join3" =
      \<open>\<lbrakk>?x \<in> carrier S; subgroup ?H (add_monoid S);
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid S\<^esub> ?H =
                               ?H\<close>
  notes theorem
    "S.add.rcosI" =
      \<open>\<lbrakk>?h \<in> ?H; ?H \<subseteq> carrier S;
              ?x \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?h \<oplus>\<^bsub>S\<^esub> ?x
                               \<in> ?H #>\<^bsub>add_monoid S\<^esub>
                                     ?x\<close>
  notes theorem
    "S.add.rcosetsI" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?x \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid S\<^esub> ?x
                               \<in> rcosets\<^bsub>add_monoid S\<^esub> ?H\<close>
  notes theorem
    "S.add.rcos_self" =
      \<open>\<lbrakk>?x \<in> carrier S;
              subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H #>\<^bsub>add_monoid S\<^esub>
  ?x\<close>
  notes theorem
    "S.add.repr_independenceD" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S); ?y \<in> carrier S;
              ?H #>\<^bsub>add_monoid S\<^esub> ?x =
              ?H #>\<^bsub>add_monoid S\<^esub> ?y\<rbrakk>
             \<Longrightarrow> ?y \<in> ?H #>\<^bsub>add_monoid S\<^esub>
  ?x\<close>
  notes theorem
    "S.add.normalI" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              \<forall>x\<in>carrier S.
                 ?H #>\<^bsub>add_monoid S\<^esub> x =
                 x <#\<^bsub>add_monoid S\<^esub> ?H\<rbrakk>
             \<Longrightarrow> ?H \<lhd> add_monoid S\<close>
  notes theorem
    "S.add.normal_inv_iff" =
      \<open>?N \<lhd> add_monoid S =
             (subgroup ?N (add_monoid S) \<and>
              (\<forall>x\<in>carrier S.
                  \<forall>h\<in>?N.
                     x \<oplus>\<^bsub>S\<^esub> h \<oplus>\<^bsub>S\<^esub>
                     \<ominus>\<^bsub>S\<^esub> x
                     \<in> ?N))\<close>
  notes theorem
    "S.add.normal_invI" =
      \<open>\<lbrakk>subgroup ?N (add_monoid S);
              \<And>x h.
                 \<lbrakk>x \<in> carrier S; h \<in> ?N\<rbrakk>
                 \<Longrightarrow> x \<oplus>\<^bsub>S\<^esub>
                                   h \<oplus>\<^bsub>S\<^esub>
                                   \<ominus>\<^bsub>S\<^esub> x
                                   \<in> ?N\<rbrakk>
             \<Longrightarrow> ?N \<lhd> add_monoid S\<close>
  notes theorem
    "S.add.normal_invE" =
      \<open>?N \<lhd> add_monoid S \<Longrightarrow>
             subgroup ?N (add_monoid S)\<close>
      \<open>\<lbrakk>?N \<lhd> add_monoid S; ?x \<in> carrier S;
              ?h \<in> ?N\<rbrakk>
             \<Longrightarrow> ?x \<oplus>\<^bsub>S\<^esub>
                               ?h \<oplus>\<^bsub>S\<^esub>
                               \<ominus>\<^bsub>S\<^esub> ?x
                               \<in> ?N\<close>
  notes theorem
    "S.add.one_is_normal" =
      \<open>{\<zero>\<^bsub>S\<^esub>} \<lhd> add_monoid S\<close>
  notes theorem
    "S.add.normal_subgroup_intersect" =
      \<open>\<lbrakk>?M \<lhd> add_monoid S;
              ?N \<lhd> add_monoid S\<rbrakk>
             \<Longrightarrow> ?M \<inter> ?N \<lhd> add_monoid S\<close>
  notes theorem
    "S.add.setmult_lcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?K \<subseteq> carrier S;
              ?x \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid S\<^esub>
                               ?H <#>\<^bsub>add_monoid S\<^esub>
                               ?K =
                               ?x <#\<^bsub>add_monoid S\<^esub>
                               (?H <#>\<^bsub>add_monoid S\<^esub>
                                ?K)\<close>
  notes theorem
    "S.add.l_repr_independence" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid S\<^esub> ?H;
              ?x \<in> carrier S; subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid S\<^esub> ?H =
                               ?y <#\<^bsub>add_monoid S\<^esub> ?H\<close>
  notes theorem
    "S.add.lcos_m_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier S; ?g \<in> carrier S;
              ?h \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?g <#\<^bsub>add_monoid S\<^esub>
                               (?h <#\<^bsub>add_monoid S\<^esub> ?M) =
                               ?g \<oplus>\<^bsub>S\<^esub>
                               ?h <#\<^bsub>add_monoid S\<^esub>
                               ?M\<close>
  notes theorem
    "S.add.lcos_mult_one" =
      \<open>?M \<subseteq> carrier S \<Longrightarrow>
             \<zero>\<^bsub>S\<^esub> <#\<^bsub>add_monoid S\<^esub> ?M =
             ?M\<close>
  notes theorem
    "S.add.l_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?x \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid S\<^esub> ?H
                               \<subseteq> carrier S\<close>
  notes theorem
    "S.add.l_coset_carrier" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid S\<^esub> ?H;
              ?x \<in> carrier S; subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?y \<in> carrier S\<close>
  notes theorem
    "S.add.l_coset_swap" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid S\<^esub> ?H;
              ?x \<in> carrier S; subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?y <#\<^bsub>add_monoid S\<^esub>
  ?H\<close>
  notes theorem
    "S.add.subgroup_mult_id" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             ?H <#>\<^bsub>add_monoid S\<^esub> ?H = ?H\<close>
  notes theorem
    "S.add.setmult_rcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?K \<subseteq> carrier S;
              ?x \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid S\<^esub>
                               (?K #>\<^bsub>add_monoid S\<^esub> ?x) =
                               ?H <#>\<^bsub>add_monoid S\<^esub>
                               ?K #>\<^bsub>add_monoid S\<^esub>
                               ?x\<close>
  notes theorem
    "S.add.rcos_assoc_lcos" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?K \<subseteq> carrier S;
              ?x \<in> carrier S\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid S\<^esub>
                               ?x <#>\<^bsub>add_monoid S\<^esub>
                               ?K =
                               ?H <#>\<^bsub>add_monoid S\<^esub>
                               (?x <#\<^bsub>add_monoid S\<^esub>
                                ?K)\<close>
  notes theorem
    "S.add.rcos_equation" =
      \<open>\<lbrakk>subgroup ?H (add_monoid S);
              ?ha \<oplus>\<^bsub>S\<^esub> ?a =
              ?h \<oplus>\<^bsub>S\<^esub> ?b;
              ?a \<in> carrier S; ?b \<in> carrier S; ?h \<in> ?H;
              ?ha \<in> ?H; ?hb \<in> ?H\<rbrakk>
             \<Longrightarrow> ?hb \<oplus>\<^bsub>S\<^esub> ?a
                               \<in> (\<Union>h\<in>?H.
   {h \<oplus>\<^bsub>S\<^esub> ?b})\<close>
  notes theorem
    "S.add.rcos_disjoint" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             disjoint (rcosets\<^bsub>add_monoid S\<^esub> ?H)\<close>
  notes theorem
    "S.add.order_one_triv_iff" =
      \<open>(Coset.order (add_monoid S) = 1) =
             (carrier S = {\<zero>\<^bsub>S\<^esub>})\<close>
  notes theorem
    "S.add.rcosets_part_G" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             \<Union> (rcosets\<^bsub>add_monoid S\<^esub> ?H) =
             carrier S\<close>
  notes theorem
    "S.add.cosets_finite" =
      \<open>\<lbrakk>?c \<in> rcosets\<^bsub>add_monoid S\<^esub> ?H;
              ?H \<subseteq> carrier S; finite (carrier S)\<rbrakk>
             \<Longrightarrow> finite ?c\<close>
  notes theorem
    "S.add.inj_on_f" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> inj_on
                                (\<lambda>y.
                                    y \<oplus>\<^bsub>S\<^esub>
                                    \<ominus>\<^bsub>S\<^esub> ?a)
                                (?H #>\<^bsub>add_monoid S\<^esub>
                                 ?a)\<close>
  notes theorem
    "S.add.inj_on_g" =
      \<open>\<lbrakk>?H \<subseteq> carrier S; ?a \<in> carrier S\<rbrakk>
             \<Longrightarrow> inj_on
                                (\<lambda>y. y \<oplus>\<^bsub>S\<^esub> ?a)
                                ?H\<close>
  notes theorem
    "S.add.card_cosets_equal" =
      \<open>\<lbrakk>?R \<in> rcosets\<^bsub>add_monoid S\<^esub> ?H;
              ?H \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> \<exists>f. bij_betw f ?H ?R\<close>
  notes theorem
    "S.add.card_rcosets_equal" =
      \<open>\<lbrakk>?R \<in> rcosets\<^bsub>add_monoid S\<^esub> ?H;
              ?H \<subseteq> carrier S\<rbrakk>
             \<Longrightarrow> card ?H = card ?R\<close>
  notes theorem
    "S.add.rcosets_finite" =
      \<open>\<lbrakk>?R \<in> rcosets\<^bsub>add_monoid S\<^esub> ?H;
              ?H \<subseteq> carrier S; finite ?H\<rbrakk>
             \<Longrightarrow> finite ?R\<close>
  notes theorem
    "S.add.rcosets_subset_PowG" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             rcosets\<^bsub>add_monoid S\<^esub> ?H
             \<subseteq> Pow (carrier S)\<close>
  notes theorem
    "S.add.lagrange_finite" =
      \<open>\<lbrakk>finite (carrier S);
              subgroup ?H (add_monoid S)\<rbrakk>
             \<Longrightarrow> card
                                (rcosets\<^bsub>add_monoid S\<^esub> ?H) *
                               card ?H =
                               Coset.order (add_monoid S)\<close>
  notes theorem
    "S.add.lagrange" =
      \<open>subgroup ?H (add_monoid S) \<Longrightarrow>
             card (rcosets\<^bsub>add_monoid S\<^esub> ?H) * card ?H =
             Coset.order (add_monoid S)\<close>
  notes theorem
    "S.add.card_rcosets_triv" =
      \<open>finite (carrier S) \<Longrightarrow>
             card
              (rcosets\<^bsub>add_monoid S\<^esub> {\<zero>\<^bsub>S\<^esub>}) =
             Coset.order (add_monoid S)\<close>
  notes theorem
    "S.add.trivial_homomorphism_image" =
      \<open>trivial_homomorphism (add_monoid S) ?H ?f =
             (?f \<in> hom (add_monoid S) ?H \<and>
              ?f ` carrier S = {\<one>\<^bsub>?H\<^esub>})\<close>
  notes theorem
    "S.add.DirProd_normal" =
      \<open>\<lbrakk>Group.group ?K; ?H \<lhd> add_monoid S;
              ?N \<lhd> ?K\<rbrakk>
             \<Longrightarrow> ?H \<times> ?N \<lhd>
                               add_monoid S \<times>\<times> ?K\<close>
  notes theorem
    "S.add.FactGroup_DirProd_multiplication_iso_set" =
