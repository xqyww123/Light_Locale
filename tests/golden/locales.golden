             [(?n + ?m)] \<cdot>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.add.nat_pow_comm" =
      \<open>?x \<in> carrier P \<Longrightarrow>
             [?n] \<cdot>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
             [?m] \<cdot>\<^bsub>P\<^esub> ?x =
             [?m] \<cdot>\<^bsub>P\<^esub> ?x \<oplus>\<^bsub>P\<^esub>
             [?n] \<cdot>\<^bsub>P\<^esub> ?x\<close>
  notes theorem
    "P.add.nat_pow_Suc2" =
