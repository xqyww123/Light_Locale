                 x \<in> carrier P \<Longrightarrow>
                 ?u \<oplus>\<^bsub>P\<^esub> x = x\<rbrakk>
             \<Longrightarrow> ?u = \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.add.inv_unique" =
      \<open>\<lbrakk>?y \<oplus>\<^bsub>P\<^esub> ?x =
