  notes theorem
    "R.add.surj_const_mult" =
      \<open>?a \<in> carrier R \<Longrightarrow>
             (\<oplus>) ?a ` carrier R = carrier R\<close>
  notes theorem
    "R.add.l_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x \<oplus> ?a = ?x) =
                                (?a = \<zero>)\<close>)
      ["simp"]
  notes theorem
    "R.add.r_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?a \<oplus> ?x = ?x) =
                                (?a = \<zero>)\<close>)
      ["simp"]
  notes theorem
    "R.add.l_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x = ?x \<oplus> ?a) =
                                (?a = \<zero>)\<close>)
      ["simp"]
  notes theorem
    "R.add.r_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier R; ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> (?x = ?a \<oplus> ?x) =
                                (?a = \<zero>)\<close>)
      ["simp"]
  notes theorem
    "R.add.diff_neutralizes" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              ?R \<in> rcosets\<^bsub>add_monoid R\<^esub> ?H;
              ?r1.0 \<in> ?R; ?r2.0 \<in> ?R\<rbrakk>
             \<Longrightarrow> ?r1.0 \<oplus> \<ominus> ?r2.0
                               \<in> ?H\<close>
  notes theorem
    "R.add.setmult_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R;
              ?K \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid R\<^esub> ?K
                               \<subseteq> carrier R\<close>
  notes theorem
    "R.add.set_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier R; ?H \<subseteq> carrier R;
              ?K \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?M <#>\<^bsub>add_monoid R\<^esub>
                               ?H <#>\<^bsub>add_monoid R\<^esub>
                               ?K =
                               ?M <#>\<^bsub>add_monoid R\<^esub>
                               (?H <#>\<^bsub>add_monoid R\<^esub>
                                ?K)\<close>
  notes theorem
    "R.add.coset_mult_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier R; ?g \<in> carrier R;
              ?h \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid R\<^esub>
                               ?g #>\<^bsub>add_monoid R\<^esub>
                               ?h =
                               ?M #>\<^bsub>add_monoid R\<^esub>
                               ?g \<oplus> ?h\<close>
  notes theorem
    "R.add.coset_assoc" =
      \<open>\<lbrakk>?x \<in> carrier R; ?y \<in> carrier R;
              ?H \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub>
                               (?H #>\<^bsub>add_monoid R\<^esub> ?y) =
                               ?x <#\<^bsub>add_monoid R\<^esub>
                               ?H #>\<^bsub>add_monoid R\<^esub>
                               ?y\<close>
  notes theorem
    "R.add.coset_mult_one" =
      (\<open>?M \<subseteq> carrier R \<Longrightarrow>
              ?M #>\<^bsub>add_monoid R\<^esub> \<zero> = ?M\<close>)
      ["simp"]
  notes theorem
    "R.add.coset_mult_inv1" =
      \<open>\<lbrakk>?M #>\<^bsub>add_monoid R\<^esub>
                      ?x \<oplus> \<ominus> ?y =
                      ?M;
              ?x \<in> carrier R; ?y \<in> carrier R;
              ?M \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid R\<^esub> ?x =
                               ?M #>\<^bsub>add_monoid R\<^esub> ?y\<close>
  notes theorem
    "R.add.coset_mult_inv2" =
      \<open>\<lbrakk>?M #>\<^bsub>add_monoid R\<^esub> ?x =
                      ?M #>\<^bsub>add_monoid R\<^esub> ?y;
              ?x \<in> carrier R; ?y \<in> carrier R;
              ?M \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> ?M #>\<^bsub>add_monoid R\<^esub>
                               ?x \<oplus> \<ominus> ?y =
                               ?M\<close>
  notes theorem
    "R.add.coset_join1" =
      \<open>\<lbrakk>?H #>\<^bsub>add_monoid R\<^esub> ?x = ?H;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H\<close>
  notes theorem
    "R.add.solve_equation" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?x \<in> ?H;
              ?y \<in> ?H\<rbrakk>
             \<Longrightarrow> \<exists>h\<in>?H. ?y = h \<oplus> ?x\<close>
  notes theorem
    "R.add.repr_independence" =
      \<open>\<lbrakk>?y \<in> ?H #>\<^bsub>add_monoid R\<^esub> ?x;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid R\<^esub> ?x =
                               ?H #>\<^bsub>add_monoid R\<^esub> ?y\<close>
  notes theorem
    "R.add.coset_join2" =
      \<open>\<lbrakk>?x \<in> carrier R; subgroup ?H (add_monoid R);
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid R\<^esub> ?x =
                               ?H\<close>
  notes theorem
    "R.add.coset_join3" =
      \<open>\<lbrakk>?x \<in> carrier R; subgroup ?H (add_monoid R);
              ?x \<in> ?H\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub> ?H =
                               ?H\<close>
  notes theorem
    "R.add.rcosI" =
      \<open>\<lbrakk>?h \<in> ?H; ?H \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?h \<oplus> ?x
                               \<in> ?H #>\<^bsub>add_monoid R\<^esub>
                                     ?x\<close>
  notes theorem
    "R.add.rcosetsI" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid R\<^esub> ?x
                               \<in> rcosets\<^bsub>add_monoid R\<^esub> ?H\<close>
  notes theorem
    "R.add.rcos_self" =
      \<open>\<lbrakk>?x \<in> carrier R;
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?H #>\<^bsub>add_monoid R\<^esub>
  ?x\<close>
  notes theorem
    "R.add.repr_independenceD" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R); ?y \<in> carrier R;
              ?H #>\<^bsub>add_monoid R\<^esub> ?x =
              ?H #>\<^bsub>add_monoid R\<^esub> ?y\<rbrakk>
             \<Longrightarrow> ?y \<in> ?H #>\<^bsub>add_monoid R\<^esub>
  ?x\<close>
  notes theorem
    "R.add.normalI" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              \<forall>x\<in>carrier R.
                 ?H #>\<^bsub>add_monoid R\<^esub> x =
                 x <#\<^bsub>add_monoid R\<^esub> ?H\<rbrakk>
             \<Longrightarrow> ?H \<lhd> add_monoid R\<close>
  notes theorem
    "R.add.normal_inv_iff" =
      \<open>?N \<lhd> add_monoid R =
             (subgroup ?N (add_monoid R) \<and>
              (\<forall>x\<in>carrier R.
                  \<forall>h\<in>?N.
                     x \<oplus> h \<oplus> \<ominus> x \<in> ?N))\<close>
  notes theorem
    "R.add.normal_invI" =
      \<open>\<lbrakk>subgroup ?N (add_monoid R);
              \<And>x h.
                 \<lbrakk>x \<in> carrier R; h \<in> ?N\<rbrakk>
                 \<Longrightarrow> x \<oplus> h \<oplus> \<ominus> x
                                   \<in> ?N\<rbrakk>
             \<Longrightarrow> ?N \<lhd> add_monoid R\<close>
  notes theorem
    "R.add.normal_invE" =
      \<open>?N \<lhd> add_monoid R \<Longrightarrow>
             subgroup ?N (add_monoid R)\<close>
      \<open>\<lbrakk>?N \<lhd> add_monoid R; ?x \<in> carrier R;
              ?h \<in> ?N\<rbrakk>
             \<Longrightarrow> ?x \<oplus> ?h \<oplus> \<ominus> ?x
                               \<in> ?N\<close>
  notes theorem
    "R.add.one_is_normal" = \<open>{\<zero>} \<lhd> add_monoid R\<close>
  notes theorem
    "R.add.normal_subgroup_intersect" =
      \<open>\<lbrakk>?M \<lhd> add_monoid R;
              ?N \<lhd> add_monoid R\<rbrakk>
             \<Longrightarrow> ?M \<inter> ?N \<lhd> add_monoid R\<close>
  notes theorem
    "R.add.setmult_lcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?K \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub>
                               ?H <#>\<^bsub>add_monoid R\<^esub>
                               ?K =
                               ?x <#\<^bsub>add_monoid R\<^esub>
                               (?H <#>\<^bsub>add_monoid R\<^esub>
                                ?K)\<close>
  notes theorem
    "R.add.l_repr_independence" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid R\<^esub> ?H;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub> ?H =
                               ?y <#\<^bsub>add_monoid R\<^esub> ?H\<close>
  notes theorem
    "R.add.lcos_m_assoc" =
      \<open>\<lbrakk>?M \<subseteq> carrier R; ?g \<in> carrier R;
              ?h \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?g <#\<^bsub>add_monoid R\<^esub>
                               (?h <#\<^bsub>add_monoid R\<^esub> ?M) =
                               ?g \<oplus> ?h <#\<^bsub>add_monoid R\<^esub>
                               ?M\<close>
  notes theorem
    "R.add.lcos_mult_one" =
      \<open>?M \<subseteq> carrier R \<Longrightarrow>
             \<zero> <#\<^bsub>add_monoid R\<^esub> ?M = ?M\<close>
  notes theorem
    "R.add.l_coset_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?x <#\<^bsub>add_monoid R\<^esub> ?H
                               \<subseteq> carrier R\<close>
  notes theorem
    "R.add.l_coset_carrier" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid R\<^esub> ?H;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?y \<in> carrier R\<close>
  notes theorem
    "R.add.l_coset_swap" =
      \<open>\<lbrakk>?y \<in> ?x <#\<^bsub>add_monoid R\<^esub> ?H;
              ?x \<in> carrier R; subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> ?x \<in> ?y <#\<^bsub>add_monoid R\<^esub>
  ?H\<close>
  notes theorem
    "R.add.subgroup_mult_id" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             ?H <#>\<^bsub>add_monoid R\<^esub> ?H = ?H\<close>
  notes theorem
    "R.add.setmult_rcos_assoc" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?K \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid R\<^esub>
                               (?K #>\<^bsub>add_monoid R\<^esub> ?x) =
                               ?H <#>\<^bsub>add_monoid R\<^esub>
                               ?K #>\<^bsub>add_monoid R\<^esub>
                               ?x\<close>
  notes theorem
    "R.add.rcos_assoc_lcos" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?K \<subseteq> carrier R;
              ?x \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?H #>\<^bsub>add_monoid R\<^esub>
                               ?x <#>\<^bsub>add_monoid R\<^esub>
                               ?K =
                               ?H <#>\<^bsub>add_monoid R\<^esub>
                               (?x <#\<^bsub>add_monoid R\<^esub>
                                ?K)\<close>
  notes theorem
    "R.add.rcos_equation" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              ?ha \<oplus> ?a = ?h \<oplus> ?b; ?a \<in> carrier R;
              ?b \<in> carrier R; ?h \<in> ?H; ?ha \<in> ?H;
              ?hb \<in> ?H\<rbrakk>
             \<Longrightarrow> ?hb \<oplus> ?a
                               \<in> (\<Union>h\<in>?H.
   {h \<oplus> ?b})\<close>
  notes theorem
    "R.add.rcos_disjoint" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             disjoint (rcosets\<^bsub>add_monoid R\<^esub> ?H)\<close>
  notes theorem
    "R.add.order_one_triv_iff" =
      \<open>(Coset.order (add_monoid R) = 1) =
             (carrier R = {\<zero>})\<close>
  notes theorem
    "R.add.rcosets_part_G" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             \<Union> (rcosets\<^bsub>add_monoid R\<^esub> ?H) =
             carrier R\<close>
  notes theorem
    "R.add.cosets_finite" =
      \<open>\<lbrakk>?c \<in> rcosets\<^bsub>add_monoid R\<^esub> ?H;
              ?H \<subseteq> carrier R; finite (carrier R)\<rbrakk>
             \<Longrightarrow> finite ?c\<close>
  notes theorem
    "R.add.inj_on_f" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> inj_on (\<lambda>y. y \<oplus> \<ominus> ?a)
                                (?H #>\<^bsub>add_monoid R\<^esub>
                                 ?a)\<close>
  notes theorem
    "R.add.inj_on_g" =
      \<open>\<lbrakk>?H \<subseteq> carrier R; ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> inj_on (\<lambda>y. y \<oplus> ?a) ?H\<close>
  notes theorem
    "R.add.card_cosets_equal" =
      \<open>\<lbrakk>?R \<in> rcosets\<^bsub>add_monoid R\<^esub> ?H;
              ?H \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> \<exists>f. bij_betw f ?H ?R\<close>
  notes theorem
    "R.add.card_rcosets_equal" =
      \<open>\<lbrakk>?R \<in> rcosets\<^bsub>add_monoid R\<^esub> ?H;
              ?H \<subseteq> carrier R\<rbrakk>
             \<Longrightarrow> card ?H = card ?R\<close>
  notes theorem
    "R.add.rcosets_finite" =
      \<open>\<lbrakk>?R \<in> rcosets\<^bsub>add_monoid R\<^esub> ?H;
              ?H \<subseteq> carrier R; finite ?H\<rbrakk>
             \<Longrightarrow> finite ?R\<close>
  notes theorem
    "R.add.rcosets_subset_PowG" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             rcosets\<^bsub>add_monoid R\<^esub> ?H
             \<subseteq> Pow (carrier R)\<close>
  notes theorem
    "R.add.lagrange_finite" =
      \<open>\<lbrakk>finite (carrier R);
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> card
                                (rcosets\<^bsub>add_monoid R\<^esub> ?H) *
                               card ?H =
                               Coset.order (add_monoid R)\<close>
  notes theorem
    "R.add.lagrange" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             card (rcosets\<^bsub>add_monoid R\<^esub> ?H) * card ?H =
             Coset.order (add_monoid R)\<close>
  notes theorem
    "R.add.card_rcosets_triv" =
      \<open>finite (carrier R) \<Longrightarrow>
             card (rcosets\<^bsub>add_monoid R\<^esub> {\<zero>}) =
             Coset.order (add_monoid R)\<close>
  notes theorem
    "R.add.trivial_homomorphism_image" =
      \<open>trivial_homomorphism (add_monoid R) ?H ?f =
             (?f \<in> hom (add_monoid R) ?H \<and>
              ?f ` carrier R = {\<one>\<^bsub>?H\<^esub>})\<close>
  notes theorem
    "R.add.DirProd_normal" =
      \<open>\<lbrakk>Group.group ?K; ?H \<lhd> add_monoid R;
              ?N \<lhd> ?K\<rbrakk>
             \<Longrightarrow> ?H \<times> ?N \<lhd>
                               add_monoid R \<times>\<times> ?K\<close>
  notes theorem
    "R.add.FactGroup_DirProd_multiplication_iso_set" =
      \<open>\<lbrakk>Group.group ?K; ?H \<lhd> add_monoid R;
              ?N \<lhd> ?K\<rbrakk>
             \<Longrightarrow> (\<lambda>(X, Y). X \<times> Y)
                               \<in> Group.iso
((add_monoid R Mod ?H) \<times>\<times> (?K Mod ?N))
(add_monoid R \<times>\<times> ?K Mod ?H \<times> ?N)\<close>
  notes theorem
    "R.add.FactGroup_DirProd_multiplication_iso_1" =
      \<open>\<lbrakk>Group.group ?K; ?H \<lhd> add_monoid R;
              ?N \<lhd> ?K\<rbrakk>
             \<Longrightarrow> (add_monoid R Mod ?H) \<times>\<times>
                               (?K Mod ?N) \<cong>
                               add_monoid R \<times>\<times> ?K Mod
                               ?H \<times> ?N\<close>
  notes theorem
    "R.add.FactGroup_DirProd_multiplication_iso_2" =
      \<open>\<lbrakk>Group.group ?K; ?H \<lhd> add_monoid R;
              ?N \<lhd> ?K\<rbrakk>
             \<Longrightarrow> add_monoid R \<times>\<times> ?K Mod
                               ?H \<times> ?N \<cong>
                               (add_monoid R Mod ?H) \<times>\<times>
                               (?K Mod ?N)\<close>
  notes theorem
    "R.add.set_mult_carrier_idem" =
      \<open>subgroup ?H (add_monoid R) \<Longrightarrow>
             carrier R <#>\<^bsub>add_monoid R\<^esub> ?H =
             carrier R\<close>
  notes theorem
    "R.add.set_mult_subgroup_idem" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              subgroup ?N
               (add_monoid R\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid R\<^esub> ?N =
                               ?H\<close>
  notes theorem
    "R.add.commut_normal" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              ?N \<lhd> add_monoid R\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid R\<^esub> ?N =
                               ?N <#>\<^bsub>add_monoid R\<^esub> ?H\<close>
  notes theorem
    "R.add.commut_normal_subgroup" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              ?N \<lhd> add_monoid R\<lparr>carrier := ?H\<rparr>;
              subgroup ?K
               (add_monoid R\<lparr>carrier := ?H\<rparr>)\<rbrakk>
             \<Longrightarrow> ?K <#>\<^bsub>add_monoid R\<^esub> ?N =
                               ?N <#>\<^bsub>add_monoid R\<^esub> ?K\<close>
  notes theorem
    "R.add.normal_inter" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              subgroup ?K (add_monoid R);
              ?H1.0 \<lhd>
              add_monoid R\<lparr>carrier := ?H\<rparr>\<rbrakk>
             \<Longrightarrow> ?H1.0 \<inter> ?K \<lhd>
                               add_monoid R
                               \<lparr>carrier :=
   ?H \<inter> ?K\<rparr>\<close>
  notes theorem
    "R.add.normal_Int_subgroup" =
      \<open>\<lbrakk>subgroup ?H (add_monoid R);
              ?N \<lhd> add_monoid R\<rbrakk>
             \<Longrightarrow> ?N \<inter> ?H \<lhd>
                               add_monoid R
                               \<lparr>carrier := ?H\<rparr>\<close>
  notes theorem
    "R.add.normal_restrict_supergroup" =
      \<open>\<lbrakk>subgroup ?S (add_monoid R); ?N \<lhd> add_monoid R;
              ?N \<subseteq> ?S\<rbrakk>
             \<Longrightarrow> ?N \<lhd>
                               add_monoid R
                               \<lparr>carrier := ?S\<rparr>\<close>
  notes theorem
    "R.add.normal_subgroup_factorize" =
      \<open>\<lbrakk>?N \<lhd> add_monoid R; ?N \<subseteq> ?H;
              subgroup ?H (add_monoid R)\<rbrakk>
             \<Longrightarrow> subgroup
                                (rcosets\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub> ?N)
                                (add_monoid R Mod ?N)\<close>
  notes theorem
    "R.add.normality_factorization" =
      \<open>\<lbrakk>?N \<lhd> add_monoid R; ?N \<subseteq> ?H;
              ?H \<lhd> add_monoid R\<rbrakk>
             \<Longrightarrow> rcosets\<^bsub>add_monoid R\<lparr>carrier := ?H\<rparr>\<^esub> ?N \<lhd>
                               add_monoid R Mod ?N\<close>
  notes theorem
    "R.add.trivial_factor_iso" =
      \<open>the_elem
             \<in> Group.iso (add_monoid R Mod {\<zero>})
                    (add_monoid R)\<close>
  notes theorem
    "R.add.self_factor_iso" =
      \<open>(\<lambda>X. the_elem ((\<lambda>x. \<zero>) ` X))
             \<in> Group.iso (add_monoid R Mod carrier R)
                    (add_monoid R
                     \<lparr>carrier := {\<zero>}\<rparr>)\<close>
  notes theorem
    "R.add.weak_group_morphism_range" =
      \<open>\<lbrakk>weak_group_morphism ?f ?H (add_monoid R);
              ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> ?f ` (?H #>\<^bsub>add_monoid R\<^esub> ?a) =
                               {?f ?a}\<close>
  notes theorem
    "R.add.vimage_eq_rcoset" =
      \<open>\<lbrakk>weak_group_morphism ?f ?H (add_monoid R);
              ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> {b \<in> carrier R. ?f b = ?f ?a} =
                               ?H #>\<^bsub>add_monoid R\<^esub> ?a\<close>
      \<open>\<lbrakk>weak_group_morphism ?f ?H (add_monoid R);
              ?a \<in> carrier R\<rbrakk>
             \<Longrightarrow> {b \<in> carrier R. ?f b = ?f ?a} =
                               ?a <#\<^bsub>add_monoid R\<^esub> ?H\<close>
  notes theorem
    "R.add.weak_group_morphism_ker" =
      \<open>weak_group_morphism ?f ?H (add_monoid R) \<Longrightarrow>
             Coset.kernel (add_monoid R) (image_group ?f (add_monoid R))
              ?f =
             ?H\<close>
  notes theorem
    "R.add.weak_group_morphism_inv_into" =
      (\<open>\<lbrakk>weak_group_morphism ?f ?H (add_monoid R);
               ?a \<in> carrier R;
               \<And>h h'.
                  \<lbrakk>h \<in> ?H;
