              ?a divides\<^bsub>add_monoid P\<^esub>
              foldr (\<oplus>\<^bsub>P\<^esub>) ?as
               \<zero>\<^bsub>P\<^esub>\<rbrakk>
             \<Longrightarrow> \<exists>i<length ?as.
                                  ?a divides\<^bsub>add_monoid P\<^esub>
                                  ?as ! i\<close>
  notes
    "P.add.comm_group_axioms" = (\<open>comm_group (add_monoid P)\<close>)
