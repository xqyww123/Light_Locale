  notes theorem
    "R.add.int_pow_1" =
      (\<open>?x \<in> carrier R \<Longrightarrow>
              [1] \<cdot> ?x = ?x\<close>)
      ["simp"]
  notes theorem
    "R.add.int_pow_neg" =
      \<open>?x \<in> carrier R \<Longrightarrow>
