  notes theorem
    "deg_monom" =
      (\<open>\<lbrakk>?a \<noteq> \<zero>; ?a \<in> carrier R\<rbrakk>
              \<Longrightarrow> deg R (up_ring.monom P ?a ?n) = ?n\<close>)
      ["simp"]
  notes theorem
    "deg_const" =
      (\<open>?a \<in> carrier R \<Longrightarrow>
