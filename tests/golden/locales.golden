             up_ring.monom P \<one> ?n\<close>
  notes theorem
    "monom_one_comm" =
      \<open>up_ring.monom P \<one> ?k \<otimes>\<^bsub>P\<^esub>
             up_ring.monom P \<one> 1 =
             up_ring.monom P \<one> 1 \<otimes>\<^bsub>P\<^esub>
             up_ring.monom P \<one> ?k\<close>
  notes theorem
    "monom_mult_smult" =
      \<open>\<lbrakk>?a \<in> carrier R; ?b \<in> carrier R\<rbrakk>
             \<Longrightarrow> up_ring.monom P (?a \<otimes> ?b) ?n =
                               ?a \<odot>\<^bsub>P\<^esub>
                               up_ring.monom P ?b ?n\<close>
  notes theorem
    "monom_one_mult" =
      \<open>up_ring.monom P \<one> (?n + ?m) =
