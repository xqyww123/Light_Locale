                               \<subseteq> carrier P\<close>
  notes theorem
    "P.add.order_gt_0_iff_finite" =
      \<open>(0 < Coset.order (add_monoid P)) = finite (carrier P)\<close>
  notes theorem
    "P.add.units_of_pow" =
      \<open>?x \<in> Units (add_monoid P) \<Longrightarrow>
