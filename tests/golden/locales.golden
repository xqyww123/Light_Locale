                \<lparr>carrier :=
                          normalizer (add_monoid R) ?N\<rparr>)\<rbrakk>
             \<Longrightarrow> add_monoid R
                               \<lparr>carrier :=
   ?H <#>\<^bsub>add_monoid R\<^esub> ?N\<rparr> Mod
