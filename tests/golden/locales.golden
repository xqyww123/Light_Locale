             \<Longrightarrow> ?f' \<in> hom (add_monoid R) ?H\<close>
  notes theorem
    "R.add.iso_eq" =
      \<open>\<lbrakk>?f \<in> Group.iso (add_monoid R) ?H;
              \<And>x.
                 x \<in> carrier R \<Longrightarrow> ?f' x = ?f x\<rbrakk>
             \<Longrightarrow> ?f' \<in> Group.iso (add_monoid R) ?H\<close>
  notes theorem
    "R.add.iso_set_sym" =
      \<open>?h \<in> Group.iso (add_monoid R) ?H \<Longrightarrow>
