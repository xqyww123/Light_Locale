              ?x \<in> Units (add_monoid P);
              ?y \<in> Units (add_monoid P)\<rbrakk>
             \<Longrightarrow> ?y \<oplus>\<^bsub>P\<^esub> ?x =
                               \<zero>\<^bsub>P\<^esub>\<close>
  notes theorem
    "P.add.carrier_not_empty" = \<open>carrier P \<noteq> {}\<close>
  notes theorem
    "P.add.group_l_invI" =
      \<open>(\<And>x.
                 x \<in> carrier P \<Longrightarrow>
