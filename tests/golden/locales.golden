  notes theorem
    "P.add.l_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier P; ?a \<in> carrier P\<rbrakk>
              \<Longrightarrow> (?x \<oplus>\<^bsub>P\<^esub> ?a = ?x) =
                                (?a = \<zero>\<^bsub>P\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "P.add.r_cancel_one" =
      (\<open>\<lbrakk>?x \<in> carrier P; ?a \<in> carrier P\<rbrakk>
              \<Longrightarrow> (?a \<oplus>\<^bsub>P\<^esub> ?x = ?x) =
                                (?a = \<zero>\<^bsub>P\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "P.add.l_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier P; ?a \<in> carrier P\<rbrakk>
              \<Longrightarrow> (?x = ?x \<oplus>\<^bsub>P\<^esub> ?a) =
                                (?a = \<zero>\<^bsub>P\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "P.add.r_cancel_one'" =
      (\<open>\<lbrakk>?x \<in> carrier P; ?a \<in> carrier P\<rbrakk>
              \<Longrightarrow> (?x = ?a \<oplus>\<^bsub>P\<^esub> ?x) =
                                (?a = \<zero>\<^bsub>P\<^esub>)\<close>)
      ["simp"]
  notes theorem
    "P.add.diff_neutralizes" =
      \<open>\<lbrakk>subgroup ?H (add_monoid P);
              ?R \<in> rcosets\<^bsub>add_monoid P\<^esub> ?H;
              ?r1.0 \<in> ?R; ?r2.0 \<in> ?R\<rbrakk>
             \<Longrightarrow> ?r1.0 \<oplus>\<^bsub>P\<^esub>
                               \<ominus>\<^bsub>P\<^esub> ?r2.0
                               \<in> ?H\<close>
  notes theorem
    "P.add.setmult_subset_G" =
      \<open>\<lbrakk>?H \<subseteq> carrier P;
              ?K \<subseteq> carrier P\<rbrakk>
             \<Longrightarrow> ?H <#>\<^bsub>add_monoid P\<^esub> ?K
