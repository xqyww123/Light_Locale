              \<Longrightarrow> ?x \<otimes>\<^bsub>P\<^esub>
                                ?y \<otimes>\<^bsub>P\<^esub>
                                ?z =
                                ?x \<otimes>\<^bsub>P\<^esub>
                                (?y \<otimes>\<^bsub>P\<^esub> ?z)\<close>)
      ["Ring.algebra" ring \<zero>\<^bsub>P\<^esub>
         (\<oplus>\<^bsub>P\<^esub>) a_inv P a_minus P
         \<one>\<^bsub>P\<^esub> (\<otimes>\<^bsub>P\<^esub>)]
      (\<open>?x \<in> carrier P \<Longrightarrow>
              \<one>\<^bsub>P\<^esub> \<otimes>\<^bsub>P\<^esub> ?x =
              ?x\<close>)
      ["Ring.algebra" ring \<zero>\<^bsub>P\<^esub>
         (\<oplus>\<^bsub>P\<^esub>) a_inv P a_minus P
         \<one>\<^bsub>P\<^esub> (\<otimes>\<^bsub>P\<^esub>)]
      (\<open>\<lbrakk>?x \<in> carrier P; ?y \<in> carrier P;
               ?z \<in> carrier P\<rbrakk>
              \<Longrightarrow> (?x \<oplus>\<^bsub>P\<^esub>
