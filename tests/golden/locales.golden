      ["HOL.intro", "simp"]
  notes theorem
    "S.add.Units_inv_closed" =
      (\<open>?x \<in> Units (add_monoid S) \<Longrightarrow>
              inv\<^bsub>add_monoid S\<^esub> ?x \<in> carrier S\<close>)
      ["HOL.intro", "simp"]
  notes theorem
    "S.add.Units_l_inv_ex" =
      \<open>?x \<in> Units (add_monoid S) \<Longrightarrow>
